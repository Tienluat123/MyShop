<Page
  x:Class="MyShop.Views.MainPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:MyShop.Views.Controls"
  xmlns:comp="using:MyShop.Views.Components"
  RequestedTheme="Light"
  Background="#FFFFFF">

  <Grid>
    <NavigationView x:Name="NavView"
                    RequestedTheme="Light"
                    PaneDisplayMode="Left"
                    CompactPaneLength="72"
                    Background="{StaticResource SidebarBackgroundColor}"
                    IsPaneToggleButtonVisible="True"
                    IsSettingsVisible="False"
                    IsBackButtonVisible="Collapsed"
                    ItemInvoked="NavView_ItemInvoked">

      <NavigationView.PaneHeader>
        <Grid Height="60">
          <TextBlock Text="LOGO"
                     Style="{StaticResource HeaderTextStyle}"/>
        </Grid>
      </NavigationView.PaneHeader>

      <NavigationView.MenuItems>
        <NavigationViewItem Content="DASHBOARD"
                            Tag="DashboardPage"
                            Style="{StaticResource SidebarItemStyle}">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE7C3;"/>
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="REPORTS"
                            Tag="ReportPage"
                            Style="{StaticResource SidebarItemStyle}">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE9D2;"/>
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="POS"
                            Tag="PosPage"
                            Style="{StaticResource SidebarItemStyle}">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE8EF;"/>
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="SẢN PHẨM"
                            Tag="ManageProductPage"
                            Style="{StaticResource SidebarItemStyle}">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE7B8;"/>
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="KHÁCH HÀNG"
                            Tag="CustomersPage"
                            Style="{StaticResource SidebarItemStyle}">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE716;"/>
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="KHUYẾN MÃI"
                            Tag="PromotionsPage"
                            Style="{StaticResource SidebarItemStyle}">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE8EC;"/>
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="NHÂN VIÊN"
                            Tag="StaffSchedulePage"
                            Style="{StaticResource SidebarItemStyle}">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE8A4;"/>
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="CÀI ĐẶT"
                            Tag="AppConfigPage"
                            Style="{StaticResource SidebarItemStyle}">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE713;"/>
          </NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>

      <NavigationView.PaneFooter>
        <Grid Margin="12,0"
              VerticalAlignment="Center"
              Height="72">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <PersonPicture ProfilePicture="https://myshop.com/avatar_an.png"
                         DisplayName="Nguyễn Văn An"
                         Width="40"
                         Height="40"
                         VerticalAlignment="Center"/>

          <StackPanel Grid.Column="2"
                      VerticalAlignment="Center"
                      Visibility="{x:Bind NavView.IsPaneOpen, Mode=OneWay}">
            <TextBlock x:Name="ProfileNameText"
                       Text="Nguyễn Văn An"
                       Style="{StaticResource BodyTextStyle}"
                       FontWeight="Bold"/>
            <Border Style="{StaticResource RoleTagStyle}">
              <TextBlock x:Name="ProfileRoleText"
                         Text="Admin"
                         Style="{StaticResource CaptionTextStyle}"/>
            </Border>
          </StackPanel>

          <Button Grid.Column="3"
                  ToolTipService.ToolTip="Đăng xuất"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="8"
                  Visibility="{x:Bind NavView.IsPaneOpen, Mode=OneWay}"
                  Click="LogoutButton_Click">
            <StackPanel Orientation="Horizontal"
                Spacing="8">
              <TextBlock Text="Đăng xuất"
                         VerticalAlignment="Center"
                         Style="{StaticResource CaptionTextStyle}"
                         Foreground="#EF4444"/>
              <FontIcon Glyph="&#xE7E8;"
                        FontFamily="Segoe MDL2 Assets"
                        Foreground="#EF4444"
                        FontSize="16"/>
            </StackPanel>
          </Button>
        </Grid>
      </NavigationView.PaneFooter>

      <Grid Background="#F3F4F6">
        <Border BorderBrush="#E5E7EB"
                BorderThickness="1,0,0,0"
                HorizontalAlignment="Left"/>
        <Frame x:Name="ContentFrame"
               Margin="0"/>
      </Grid>

    </NavigationView>

    <comp:NotificationView x:Name="NotificationViewControl"/>
  </Grid>
</Page>
