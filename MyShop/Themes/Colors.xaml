<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Neutral Grays: dùng cho nền, viền, text phụ (hệ xám thống nhất) -->
    <SolidColorBrush x:Key="Gray100"
                     Color="#F3F4F6"/>
    <SolidColorBrush x:Key="Gray200"
                     Color="#E5E7EB"/>
    <SolidColorBrush x:Key="Gray300"
                     Color="#D1D5DB"/>
    <SolidColorBrush x:Key="Gray500"
                     Color="#6B7280"/>
    <SolidColorBrush x:Key="Gray700"
                     Color="#374151"/>
    <SolidColorBrush x:Key="Gray900"
                     Color="#111827"/>

    <!-- Brand: màu chủ đạo của app -->
    <SolidColorBrush x:Key="BrandPrimary"
                     Color="#D97706"/>
    <SolidColorBrush x:Key="BrandPrimaryForeground"
                     Color="White"/>
    <SolidColorBrush x:Key="IconSelectedBgBrush"
                     Color="#D97706"/>

    <!-- Surface: nền và trạng thái hover/pressed -->
    <SolidColorBrush x:Key="SurfaceBackground"
                     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceHover"
                     Color="#F3F4F6"/>
    <SolidColorBrush x:Key="SurfacePressed"
                     Color="#E5E7EB"/>
    <SolidColorBrush x:Key="SurfaceAlt"
                     Color="#F9FAFB"/>
    <SolidColorBrush x:Key="SurfaceBorderAlt"
                     Color="#F3F4FB"/>

    <!-- Border: viền chuẩn cho card/input -->
    <SolidColorBrush x:Key="BorderBrush"
                     Color="#E5E7EB"/>

    <!-- Text: text chính, phụ, mờ -->
    <SolidColorBrush x:Key="TextPrimary"
                     Color="#111827"/>
    <SolidColorBrush x:Key="TextSecondary"
                     Color="#6B7280"/>
    <SolidColorBrush x:Key="TextMuted"
                     Color="#9CA3AF"/>

    <!-- Semantic: trạng thái thành công/cảnh báo/lỗi/thông tin -->
    <SolidColorBrush x:Key="Success"
                     Color="#10B981"/>
    <SolidColorBrush x:Key="SuccessStrong"
                     Color="#059669"/>
    <SolidColorBrush x:Key="SuccessSurface"
                     Color="#D1FAE5"/>

    <SolidColorBrush x:Key="Warning"
                     Color="#F59E0B"/>
    <SolidColorBrush x:Key="WarningStrong"
                     Color="#D97706"/>
    <SolidColorBrush x:Key="WarningSurface"
                     Color="#FEF3C7"/>
    <SolidColorBrush x:Key="WarningSurfaceSoft"
                     Color="#FFF7ED"/>
    <SolidColorBrush x:Key="WarningTextDark"
                     Color="#92400E"/>

    <SolidColorBrush x:Key="Error"
                     Color="#EF4444"/>
    <SolidColorBrush x:Key="ErrorStrong"
                     Color="#DC2626"/>
    <SolidColorBrush x:Key="ErrorSurface"
                     Color="#FEE2E2"/>
    <SolidColorBrush x:Key="ErrorSurfaceSoft"
                     Color="#FEF2F2"/>

    <SolidColorBrush x:Key="Info"
                     Color="#0EA5E9"/>
    <SolidColorBrush x:Key="InfoStrong"
                     Color="#2563EB"/>
    <SolidColorBrush x:Key="InfoSurface"
                     Color="#DBEAFE"/>
    <SolidColorBrush x:Key="InfoDeep"
                     Color="#1D4ED8"/>

    <!-- Accent: nhóm màu nhấn theo ngữ cảnh (POS, tag, chip) -->
    <SolidColorBrush x:Key="AccentPinkSurface"
                     Color="#FDF2F8"/>
    <SolidColorBrush x:Key="AccentPink"
                     Color="#EC4899"/>
    <SolidColorBrush x:Key="AccentBlueSurface"
                     Color="#EFF6FF"/>
    <SolidColorBrush x:Key="AccentBlue"
                     Color="#3B82F6"/>
    <SolidColorBrush x:Key="AccentPurpleSurface"
                     Color="#F3E8FF"/>
    <SolidColorBrush x:Key="AccentPurple"
                     Color="#7E22CE"/>
    <SolidColorBrush x:Key="AccentPurpleBorder"
                     Color="#E9D5FF"/>
    <SolidColorBrush x:Key="AccentIndigo"
                     Color="#6366F1"/>
    <SolidColorBrush x:Key="AccentGold"
                     Color="#FBBF24"/>
    <SolidColorBrush x:Key="AccentTealSurface"
                     Color="#ECFEFF"/>
    <SolidColorBrush x:Key="AccentTeal"
                     Color="#0E7490"/>

    <!-- Overlay: dùng cho lớp phủ hoặc gradient tối -->
    <SolidColorBrush x:Key="OverlayBlack20"
                     Color="#20000000"/>
    <SolidColorBrush x:Key="OverlayBlack40"
                     Color="#40000000"/>
    <SolidColorBrush x:Key="OverlayBlack80"
                     Color="#CC000000"/>
    <SolidColorBrush x:Key="OverlayWhite12"
                     Color="#20FFFFFF"/>
    <SolidColorBrush x:Key="OverlayWhite25"
                     Color="#40FFFFFF"/>

    <!-- Misc: màu nền trang chính -->
    <SolidColorBrush x:Key="BgPage"
                     Color="#F3F4F6"/>
    <SolidColorBrush x:Key="TransparentBrush"
                     Color="Transparent"/>

</ResourceDictionary>
