<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Size Scale (4/8/12/16/24/32/48): dùng làm đơn vị chuẩn cho spacing, radius -->
    <x:Double x:Key="SizeXSmall">4</x:Double>
    <x:Double x:Key="SizeSmall">8</x:Double>
    <x:Double x:Key="SizeMedium">12</x:Double>
    <x:Double x:Key="SizeLarge">16</x:Double>
    <x:Double x:Key="SizeXLarge">24</x:Double>
    <x:Double x:Key="Size2XLarge">32</x:Double>
    <x:Double x:Key="Size3XLarge">48</x:Double>

    <!-- Corner Radius: dùng cho bo góc bề mặt, thẻ, nút -->
    <CornerRadius x:Key="RadiusXSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusSmall">8</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">12</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">16</CornerRadius>
    <CornerRadius x:Key="RadiusXLarge">24</CornerRadius>
    <CornerRadius x:Key="Radius2XLarge">32</CornerRadius>
    <CornerRadius x:Key="Radius3XLarge">48</CornerRadius>

    <!-- Spacing (Uniform): dùng cho padding/margin đồng đều -->
    <Thickness x:Key="SpaceXSmall">4</Thickness>
    <Thickness x:Key="SpaceSmall">8</Thickness>
    <Thickness x:Key="SpaceMedium">12</Thickness>
    <Thickness x:Key="SpaceLarge">16</Thickness>
    <Thickness x:Key="SpaceXLarge">24</Thickness>
    <Thickness x:Key="Space2XLarge">32</Thickness>
    <Thickness x:Key="Space3XLarge">48</Thickness>

    <!-- Spacing (Composite): dùng cho layout dọc/ngang phổ biến, chỉ dùng các mốc chuẩn -->
    <Thickness x:Key="SpaceLarge_Small">16,8</Thickness>
    <Thickness x:Key="SpaceLarge_Medium">16,12</Thickness>
    <Thickness x:Key="SpaceXLarge_Large">24,16</Thickness>
    <Thickness x:Key="SpaceXLarge_Medium">24,12</Thickness>
    <Thickness x:Key="SpaceXLarge_Small">24,8</Thickness>
    <Thickness x:Key="SpaceMedium_Small">12,8</Thickness>
    <Thickness x:Key="SpaceSmall_XSmall">8,4</Thickness>
    <Thickness x:Key="SpaceLarge_Zero">16,0</Thickness>
    <Thickness x:Key="SpaceHeaderIndent">16,0,0,0</Thickness>
    <Thickness x:Key="SpaceSidebarItem">12,4,12,4</Thickness>
    <Thickness x:Key="SpaceRoleTag">0,4,0,0</Thickness>
    <Thickness x:Key="SpaceTextIndent">8,0,0,0</Thickness>

</ResourceDictionary>
