<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Typography Scale: Caption (ghi chú), Body (nội dung), Subtitle (tiêu đề phụ), Header (tiêu đề màn), Title (tiêu đề lớn) -->
    <x:Double x:Key="FontCaption">12</x:Double>
    <x:Double x:Key="FontBody">14</x:Double>
    <x:Double x:Key="FontSubtitle">16</x:Double>
    <x:Double x:Key="FontHeader">20</x:Double>
    <x:Double x:Key="FontTitle">24</x:Double>

    <!-- Font Weights: dùng cho nhấn mạnh cấp độ nội dung -->
    <FontWeight x:Key="FontWeightRegular">Normal</FontWeight>
    <FontWeight x:Key="FontWeightMedium">Medium</FontWeight>
    <FontWeight x:Key="FontWeightSemiBold">SemiBold</FontWeight>
    <FontWeight x:Key="FontWeightBold">Bold</FontWeight>
    <FontWeight x:Key="FontWeightBlack">Black</FontWeight>

</ResourceDictionary>
