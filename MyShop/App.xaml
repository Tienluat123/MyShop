<Application x:Class="MyShop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Microsoft.UI.Xaml.Controls"
             xmlns:converters="using:MyShop.Converters"
             RequestedTheme="Light">

        <Application.Resources>
                <ResourceDictionary>
                        <ResourceDictionary.MergedDictionaries>
                                <ResourceDictionary Source="ms-appx:///Resources/IconLibrary.xaml"/>

                                <ResourceDictionary Source="ms-appx:///Themes/Colors.xaml"/>
                                <ResourceDictionary Source="ms-appx:///Themes/Typography.xaml"/>
                                <ResourceDictionary Source="ms-appx:///Themes/Dimensions.xaml"/>
                                <ResourceDictionary Source="ms-appx:///Themes/Styles.xaml"/>


                                <ResourceDictionary Source="ms-appx:///Styles/Texts.xaml"/>
                                <ResourceDictionary Source="ms-appx:///Styles/Navigation.xaml"/>
                                <ResourceDictionary Source="ms-appx:///Styles/Components.xaml"/>

                                <converters:ImageSourceConverter x:Key="ImageSourceConverter" DecodeWidth="300" />
                                <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
                        </ResourceDictionary.MergedDictionaries>

                        <!-- Fallback keys for TeachingTip styles on Uno -->
                        <SolidColorBrush x:Key="TeachingTipAlternateCloseButtonBorderBrush" Color="Transparent"/>
                        <Thickness x:Key="TeachingTipAlternateCloseButtonBorderThickness">0</Thickness>
                        <x:Double x:Key="TeachingTipAlternateCloseButtonGlyphSize">12</x:Double>
                        <x:Double x:Key="Size40">40</x:Double>
                </ResourceDictionary>
        </Application.Resources>
</Application>