<Application x:Class="MyShop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             RequestedTheme="Light">

        <Application.Resources>
                <ResourceDictionary>
                        <ResourceDictionary.MergedDictionaries>
                                <ResourceDictionary Source="ms-appx:///Resources/IconLibrary.xaml"/>

                                <ResourceDictionary Source="ms-appx:///Themes/Colors.xaml"/>
                                <ResourceDictionary Source="ms-appx:///Themes/Typography.xaml"/>
                                <ResourceDictionary Source="ms-appx:///Themes/Dimensions.xaml"/>
                                <ResourceDictionary Source="ms-appx:///Themes/Styles.xaml"/>


                                <ResourceDictionary Source="ms-appx:///Styles/Texts.xaml"/>
                                <ResourceDictionary Source="ms-appx:///Styles/Navigation.xaml"/>
                                <ResourceDictionary Source="ms-appx:///Styles/Components.xaml"/>

                        </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
        </Application.Resources>
</Application>