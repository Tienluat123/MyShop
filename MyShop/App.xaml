<Application
    x:Class="MyShop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Light">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Resources/IconLibrary.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="SidebarBackgroundColor" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />
            <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#F3F4F6" />
            <SolidColorBrush x:Key="PressedBackgroundBrush" Color="#E5E7EB" />

            <SolidColorBrush x:Key="IconSelectedBgBrush" Color="#D97706" />
            <SolidColorBrush x:Key="IconSelectedFgBrush" Color="White" />
            <SolidColorBrush x:Key="TextSelectedBrush" Color="#1F2937" />
            <SolidColorBrush x:Key="TextUnselectedBrush" Color="#6B7280" />
            <Style x:Key="BodyTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{StaticResource TextSelectedBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource TextUnselectedBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="RoleTagStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="Margin" Value="0,4,0,0" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>

            <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="Black" />
                <Setter Property="Foreground" Value="{StaticResource TextSelectedBrush}" />
                <Setter Property="Margin" Value="16,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>


            <Style x:Key="SidebarItemStyle" TargetType="NavigationViewItem">
                <Setter Property="Margin" Value="12,4,12,4" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="NavigationViewItem">
                            <Grid
                                x:Name="RootGrid"
                                Height="48"
                                Background="Transparent"
                                CornerRadius="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    x:Name="IconBox"
                                    Grid.Column="0"
                                    Width="36"
                                    Height="36"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    CornerRadius="12">
                                    <ContentPresenter
                                        x:Name="IconPresenter"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Content="{TemplateBinding Icon}"
                                        Foreground="#6B7280" />
                                </Border>

                                <TextBlock
                                    x:Name="TextPresenter"
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Foreground="#6B7280"
                                    Text="{TemplateBinding Content}" />

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">

                                        <VisualState x:Name="Normal">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Background" Value="Transparent" />
                                                <Setter Target="IconBox.Background" Value="Transparent" />
                                                <Setter Target="IconPresenter.(TextElement.Foreground)" Value="#6B7280" />
                                                <Setter Target="TextPresenter.Foreground" Value="#6B7280" />
                                                <Setter Target="TextPresenter.FontWeight" Value="Normal" />
                                            </VisualState.Setters>
                                        </VisualState>

                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Background" Value="#F3F4F6" />
                                                <Setter Target="IconBox.Background" Value="Transparent" />
                                                <Setter Target="IconPresenter.(TextElement.Foreground)" Value="#6B7280" />
                                                <Setter Target="TextPresenter.Foreground" Value="#6B7280" />
                                                <Setter Target="TextPresenter.FontWeight" Value="Normal" />
                                            </VisualState.Setters>
                                        </VisualState>

                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Background" Value="Transparent" />
                                                <Setter Target="IconBox.Background" Value="#D97706" />
                                                <Setter Target="IconPresenter.(TextElement.Foreground)" Value="White" />
                                                <Setter Target="TextPresenter.Foreground" Value="#1F2937" />
                                                <Setter Target="TextPresenter.FontWeight" Value="Bold" />
                                            </VisualState.Setters>
                                        </VisualState>

                                        <VisualState x:Name="PointerOverSelected">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Background" Value="#F3F4F6" />
                                                <Setter Target="IconBox.Background" Value="#D97706" />
                                                <Setter Target="IconPresenter.(TextElement.Foreground)" Value="White" />
                                                <Setter Target="TextPresenter.Foreground" Value="#1F2937" />
                                                <Setter Target="TextPresenter.FontWeight" Value="Bold" />
                                            </VisualState.Setters>
                                        </VisualState>

                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
