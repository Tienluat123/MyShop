<ResourceDictionary
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

        <Style x:Key="SidebarItemStyle"
               TargetType="NavigationViewItem">
                <Setter Property="Margin"
                        Value="{StaticResource SpaceSidebarItem}"/>
                <Setter Property="CornerRadius"
                        Value="{StaticResource RadiusSmall}"/>
                <Setter Property="Background"
                        Value="Transparent"/>
                <Setter Property="Template">
                        <Setter.Value>
                                <ControlTemplate TargetType="NavigationViewItem">
                                        <Grid x:Name="RootGrid"
                                              Background="Transparent"
                                              CornerRadius="{StaticResource RadiusSmall}"
                                              Height="{StaticResource Size3XLarge}">
                                                <VisualStateManager.VisualStateGroups>
                                                        <VisualStateGroup x:Name="CommonStates">
                                                                <VisualStateGroup.Transitions>
                                                                        <VisualTransition/>
                                                                </VisualStateGroup.Transitions>

                                                                <VisualState x:Name="Normal">
                                                                        <VisualState.Setters>
                                                                                <Setter Target="RootGrid.Background"
                                                                                        Value="Transparent"/>
                                                                                <Setter Target="IconBox.Background"
                                                                                        Value="Transparent"/>
                                                                                <Setter Target="IconPresenter.(TextElement.Foreground)"
                                                                                        Value="{StaticResource TextSecondary}"/>
                                                                                <Setter Target="TextPresenter.Foreground"
                                                                                        Value="{StaticResource TextSecondary}"/>
                                                                                <Setter Target="TextPresenter.FontWeight"
                                                                                        Value="{StaticResource FontWeightRegular}"/>
                                                                        </VisualState.Setters>
                                                                </VisualState>

                                                                <VisualState x:Name="PointerOver">
                                                                        <VisualState.Setters>
                                                                                <Setter Target="RootGrid.Background"
                                                                                        Value="{StaticResource SurfaceHover}"/>
                                                                                <Setter Target="IconBox.Background"
                                                                                        Value="Transparent"/>
                                                                                <Setter Target="IconPresenter.(TextElement.Foreground)"
                                                                                        Value="{StaticResource TextSecondary}"/>
                                                                                <Setter Target="TextPresenter.Foreground"
                                                                                        Value="{StaticResource TextSecondary}"/>
                                                                                <Setter Target="TextPresenter.FontWeight"
                                                                                        Value="{StaticResource FontWeightRegular}"/>
                                                                        </VisualState.Setters>
                                                                </VisualState>

                                                                <VisualState x:Name="Selected">
                                                                        <VisualState.Setters>
                                                                                <Setter Target="RootGrid.Background"
                                                                                        Value="Transparent"/>
                                                                                <Setter Target="IconBox.Background"
                                                                                        Value="{StaticResource BrandPrimary}"/>
                                                                                <Setter Target="IconPresenter.(TextElement.Foreground)"
                                                                                        Value="{StaticResource BrandPrimaryForeground}"/>
                                                                                <Setter Target="TextPresenter.Foreground"
                                                                                        Value="{StaticResource TextPrimary}"/>
                                                                                <Setter Target="TextPresenter.FontWeight"
                                                                                        Value="{StaticResource FontWeightBold}"/>
                                                                        </VisualState.Setters>
                                                                </VisualState>

                                                                <VisualState x:Name="PointerOverSelected">
                                                                        <VisualState.Setters>
                                                                                <Setter Target="RootGrid.Background"
                                                                                        Value="{StaticResource SurfaceHover}"/>
                                                                                <Setter Target="IconBox.Background"
                                                                                        Value="{StaticResource BrandPrimary}"/>
                                                                                <Setter Target="IconPresenter.(TextElement.Foreground)"
                                                                                        Value="{StaticResource BrandPrimaryForeground}"/>
                                                                                <Setter Target="TextPresenter.Foreground"
                                                                                        Value="{StaticResource TextPrimary}"/>
                                                                                <Setter Target="TextPresenter.FontWeight"
                                                                                        Value="{StaticResource FontWeightBold}"/>
                                                                        </VisualState.Setters>
                                                                </VisualState>
                                                        </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>

                                                <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{StaticResource Size3XLarge}"/>
                                                        <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border x:Name="IconBox"
                                                        Grid.Column="0"
                                                        Width="{StaticResource Size3XLarge}"
                                                        Height="{StaticResource Size3XLarge}"
                                                        CornerRadius="{StaticResource RadiusMedium}"
                                                        Background="Transparent"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                        <ContentPresenter x:Name="IconPresenter"
                                                                          Content="{TemplateBinding Icon}"
                                                                          HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"
                                                                          Foreground="{StaticResource TextSecondary}"/>
                                                </Border>

                                                <TextBlock x:Name="TextPresenter"
                                                           Text="{TemplateBinding Content}"
                                                           Grid.Column="1"
                                                           VerticalAlignment="Center"
                                                           Margin="{StaticResource SpaceTextIndent}"
                                                           Foreground="{StaticResource TextSecondary}"/>
                                        </Grid>
                                </ControlTemplate>
                        </Setter.Value>
                </Setter>
        </Style>

</ResourceDictionary>
