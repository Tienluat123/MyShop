<ResourceDictionary
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

        <Style x:Key="RoleTagStyle"
               TargetType="Border">
                <Setter Property="Background"
                        Value="{StaticResource SurfaceHover}"/>
                <Setter Property="CornerRadius"
                        Value="{StaticResource RadiusMedium}"/>
                <Setter Property="Padding"
                        Value="{StaticResource SpaceSmall_XSmall}"/>
                <Setter Property="Margin"
                        Value="{StaticResource SpaceRoleTag}"/>
                <Setter Property="HorizontalAlignment"
                        Value="Left"/>
        </Style>

        <Style x:Key="IconCaptionStyle"
               TargetType="FontIcon">
                <Setter Property="FontSize"
                        Value="{StaticResource FontCaption}"/>
        </Style>

        <Style x:Key="IconBodyStyle"
               TargetType="FontIcon">
                <Setter Property="FontSize"
                        Value="{StaticResource FontBody}"/>
        </Style>

        <Style x:Key="IconSubtitleStyle"
               TargetType="FontIcon">
                <Setter Property="FontSize"
                        Value="{StaticResource FontSubtitle}"/>
        </Style>

        <Style x:Key="IconHeaderStyle"
               TargetType="FontIcon">
                <Setter Property="FontSize"
                        Value="{StaticResource FontHeader}"/>
        </Style>

        <Style x:Key="IconTitleStyle"
               TargetType="FontIcon">
                <Setter Property="FontSize"
                        Value="{StaticResource FontTitle}"/>
        </Style>

        <Style x:Key="Icon2XLargeStyle"
               TargetType="FontIcon">
                <Setter Property="FontSize"
                        Value="{StaticResource Size2XLarge}"/>
        </Style>

        <Style x:Key="Icon3XLargeStyle"
               TargetType="FontIcon">
                <Setter Property="FontSize"
                        Value="{StaticResource Size3XLarge}"/>
        </Style>

        <Style x:Key="AppButtonBaseStyle"
               TargetType="Button">
                <Setter Property="FontSize"
                        Value="{StaticResource FontBody}"/>
                <Setter Property="FontWeight"
                        Value="{StaticResource FontWeightSemiBold}"/>
                <Setter Property="CornerRadius"
                        Value="{StaticResource RadiusSmall}"/>
                <Setter Property="Padding"
                        Value="{StaticResource SpaceMedium_Small}"/>
                <Setter Property="HorizontalContentAlignment"
                        Value="Center"/>
                <Setter Property="VerticalContentAlignment"
                        Value="Center"/>
        </Style>

        <Style x:Key="AppPrimaryButtonStyle"
               BasedOn="{StaticResource AppButtonBaseStyle}"
               TargetType="Button">
                <Setter Property="Background"
                        Value="{StaticResource BrandPrimary}"/>
                <Setter Property="Foreground"
                        Value="{StaticResource BrandPrimaryForeground}"/>
                <Setter Property="BorderThickness"
                        Value="0"/>
        </Style>

        <Style x:Key="AppSecondaryButtonStyle"
               BasedOn="{StaticResource AppButtonBaseStyle}"
               TargetType="Button">
                <Setter Property="Background"
                        Value="{StaticResource Gray100}"/>
                <Setter Property="Foreground"
                        Value="{StaticResource Gray500}"/>
                <Setter Property="BorderThickness"
                        Value="0"/>
        </Style>

        <Style x:Key="AppOutlineButtonStyle"
               BasedOn="{StaticResource AppButtonBaseStyle}"
               TargetType="Button">
                <Setter Property="Background"
                        Value="{StaticResource SurfaceBackground}"/>
                <Setter Property="Foreground"
                        Value="{StaticResource TextPrimary}"/>
                <Setter Property="BorderBrush"
                        Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness"
                        Value="1"/>
        </Style>

        <Style x:Key="AppGhostButtonStyle"
               BasedOn="{StaticResource AppButtonBaseStyle}"
               TargetType="Button">
                <Setter Property="Background"
                        Value="Transparent"/>
                <Setter Property="Foreground"
                        Value="{StaticResource TextPrimary}"/>
                <Setter Property="BorderThickness"
                        Value="0"/>
        </Style>

        <Style x:Key="AppIconButtonStyle"
               BasedOn="{StaticResource AppButtonBaseStyle}"
               TargetType="Button">
                <Setter Property="Background"
                        Value="Transparent"/>
                <Setter Property="BorderThickness"
                        Value="0"/>
                <Setter Property="Padding"
                        Value="0"/>
        </Style>

        <Style x:Key="StaffHeaderLabelTextStyle"
               TargetType="TextBlock">
                <Setter Property="FontSize"
                        Value="{StaticResource FontBody}"/>
                <Setter Property="FontWeight"
                        Value="{StaticResource FontWeightSemiBold}"/>
                <Setter Property="Foreground"
                        Value="{StaticResource TextSecondary}"/>
                <Setter Property="VerticalAlignment"
                        Value="Center"/>
        </Style>

        <Style x:Key="StaffTagBaseStyle"
               TargetType="Border">
                <Setter Property="CornerRadius"
                        Value="{StaticResource RadiusMedium}"/>
                <Setter Property="Padding"
                        Value="{StaticResource SpaceMedium_Small}"/>
                <Setter Property="HorizontalAlignment"
                        Value="Left"/>
                <Setter Property="VerticalAlignment"
                        Value="Center"/>
        </Style>

        <Style x:Key="StaffRoleAdminTagStyle"
               BasedOn="{StaticResource StaffTagBaseStyle}"
               TargetType="Border">
                <Setter Property="Background"
                        Value="{StaticResource ErrorSurface}"/>
        </Style>

        <Style x:Key="StaffRoleSalesTagStyle"
               BasedOn="{StaticResource StaffTagBaseStyle}"
               TargetType="Border">
                <Setter Property="Background"
                        Value="{StaticResource InfoSurface}"/>
        </Style>

        <Style x:Key="StaffStatusActiveTagStyle"
               BasedOn="{StaticResource StaffTagBaseStyle}"
               TargetType="Border">
                <Setter Property="Background"
                        Value="{StaticResource SuccessSurface}"/>
        </Style>

        <Style x:Key="StaffTagTextStyle"
               TargetType="TextBlock">
                <Setter Property="FontSize"
                        Value="{StaticResource FontCaption}"/>
                <Setter Property="FontWeight"
                        Value="{StaticResource FontWeightBold}"/>
                <Setter Property="VerticalAlignment"
                        Value="Center"/>
        </Style>



</ResourceDictionary>
