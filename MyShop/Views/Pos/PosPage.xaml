<Page
    x:Class="MyShop.Views.Pos.PosPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MyShop.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MyShop.Models"
    xmlns:viewmodels="using:MyShop.ViewModels"
    x:Name="PageRoot"
    Background="#F3F4F6"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:ColumnWidthConverter x:Key="ColumnWidthConverter" />
        <converters:CurrencyConverter x:Key="CurrencyConverter" />
        <converters:StringFormatConverter x:Key="StringFormatConverter" />
        <converters:IconKeyToPathConverter x:Key="IconKeyToPathConverter" />
        <converters:StringToDoubleConverter x:Key="StringToDoubleConverter" />
        <converters:CategoryBrushConverter
            x:Key="CategoryBackgroundConverter"
            ActiveBrush="#D97706"
            InactiveBrush="#F59E0B" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />

        <SolidColorBrush x:Key="Amber600" Color="#D97706" />
        <SolidColorBrush x:Key="Pink500" Color="#EC4899" />
        <SolidColorBrush x:Key="Blue500" Color="#3B82F6" />
        <SolidColorBrush x:Key="Purple500" Color="#A855F7" />
        <SolidColorBrush x:Key="Amber50" Color="#FFFBEB" />
        <SolidColorBrush x:Key="Pink50" Color="#FDF2F8" />
        <SolidColorBrush x:Key="Blue50" Color="#EFF6FF" />
        <SolidColorBrush x:Key="Purple50" Color="#FAF5FF" />

        <converters:EqualityToBrushConverter
            x:Key="OrderTypeBackgroundConverter"
            FalseBrush="#F9FAFB"
            TrueBrush="{StaticResource Amber600}" />
        <converters:EqualityToBrushConverter
            x:Key="OrderTypeForegroundConverter"
            FalseBrush="#374151"
            TrueBrush="White" />
        <converters:EqualityToBrushConverter
            x:Key="TableBackgroundConverter"
            FalseBrush="#F9FAFB"
            TrueBrush="{StaticResource Amber600}" />
        <converters:EqualityToBrushConverter
            x:Key="TableForegroundConverter"
            FalseBrush="#374151"
            TrueBrush="White" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />

        <Style x:Key="CategoryButtonStyle" TargetType="Button">
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="Gray" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid
                            x:Name="RootGrid"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <ContentPresenter
                                x:Name="ContentPresenter"
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}" />

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />

                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="#20808080" />
                                            <Setter Target="ContentPresenter.Foreground" Value="Black" />
                                        </VisualState.Setters>
                                    </VisualState>

                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="{StaticResource IconSelectedBgBrush}" />
                                            <Setter Target="ContentPresenter.Foreground" Value="White" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OrderTypeButtonStyle" TargetType="Button">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Height" Value="40" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#F3F4FB" />
            <Setter Property="Background" Value="#F9FAFB" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>

    <Page.DataContext>
        <viewmodels:PosViewModel x:Name="ViewModel" />
    </Page.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <!--  LEFT PANEL (Main Content)  -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!--  Top Bar  -->
                <RowDefinition Height="Auto" />
                <!--  Categories  -->
                <RowDefinition Height="Auto" />
                <!--  Search  -->
                <RowDefinition Height="*" />
                <!--  Products Grid  -->
            </Grid.RowDefinitions>

            <!--  Top Bar  -->
            <Grid
                Grid.Row="0"
                Padding="24,16"
                Background="White"
                BorderBrush="#F3F4F6"
                BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border
                        Width="36"
                        Height="36"
                        Background="{StaticResource IconSelectedBgBrush}"
                        CornerRadius="11">
                        <Path
                            Width="18"
                            Height="18"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="{StaticResource IconCoffee}"
                            Stretch="Uniform"
                            Stroke="White"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="2" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            FontWeight="Bold"
                            Foreground="#1F2937"
                            LineHeight="14"
                            Text="MyShop" />
                        <TextBlock
                            FontSize="11"
                            Foreground="#9CA3AF"
                            Text="Point of Sale" />
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="16">
                    <Button
                        Padding="16,8"
                        Background="#F9FAFB"
                        BorderBrush="#F3F4F6"
                        Click="ActiveOrders_Click"
                        CornerRadius="11">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontSize="16"
                                Foreground="#9CA3AF"
                                Glyph="&#xE8A5;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="#6B7280"
                                Text="Active Orders" />
                        </StackPanel>
                    </Button>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="#9CA3AF"
                        Text="Monday, Nov 11" />
                </StackPanel>
            </Grid>

            <!--  Categories  -->
            <Grid
                Grid.Row="1"
                Padding="24,16,24,8"
                Background="White"
                BorderBrush="#F9FAFB"
                BorderThickness="0,0,0,1">
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Command="{Binding DataContext.SetCategoryCommand, ElementName=PageRoot}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource CategoryButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Path
                                        Width="18"
                                        Height="18"
                                        VerticalAlignment="Center"
                                        Data="{Binding IconKey, Converter={StaticResource IconKeyToPathConverter}}"
                                        Fill="Transparent"
                                        Stretch="Uniform"
                                        Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                        StrokeEndLineCap="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeThickness="1" />

                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                        Text="{Binding Name}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!--  Search Area  -->
            <Grid
                Grid.Row="2"
                Padding="24,12"
                Background="White">
                <Grid x:Name="SearchBoxRoot">
                    <TextBox
                        Padding="40,10,12,10"
                        Background="#F9FAFB"
                        BorderBrush="#E5E7EB"
                        CornerRadius="12"
                        PlaceholderText="Search menu..."
                        Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <FontIcon
                        Margin="14,0,0,0"
                        HorizontalAlignment="Left"
                        FontSize="16"
                        Foreground="#9CA3AF"
                        Glyph="&#xE721;" />
                </Grid>
            </Grid>

            <!--  Products Grid  -->
            <ScrollViewer Grid.Row="3" Padding="24,8">
                <ItemsRepeater ItemsSource="{Binding FilteredProducts}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsStretch="Fill"
                            MaximumRowsOrColumns="5"
                            MinColumnSpacing="12"
                            MinItemWidth="150"
                            MinRowSpacing="12"
                            Orientation="Horizontal" />
                    </ItemsRepeater.Layout>

                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="ProductCard_Click">
                                <Border
                                    MinHeight="220"
                                    Background="White"
                                    BorderBrush="#F3F4F6"
                                    BorderThickness="1"
                                    CornerRadius="16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="130" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Border Background="#F9FAFB" CornerRadius="16,16,0,0">
                                            <FontIcon
                                                FontSize="40"
                                                Foreground="#E5E7EB"
                                                Glyph="&#xEB9F;" />
                                        </Border>

                                        <StackPanel Grid.Row="1" Padding="12,10">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                MaxLines="1"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                FontWeight="Bold"
                                                Foreground="#D97706"
                                                Text="{Binding DisplayPrice}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>

        <!--  RIGHT PANEL (Order Sidebar)  -->
        <Grid
            Grid.Column="1"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!--  Header  -->
                <RowDefinition Height="*" />
                <!--  Order Items  -->
                <RowDefinition Height="Auto" />
                <!--  Summary & Payment  -->
            </Grid.RowDefinitions>

            <!--  Sidebar Header  -->
            <Grid
                Grid.Row="0"
                Padding="20,16"
                BorderBrush="#F9FAFB"
                BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon
                        FontSize="18"
                        Foreground="{StaticResource IconSelectedBgBrush}"
                        Glyph="&#xE7BF;" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Foreground="#111827"
                        Text="Current Order" />
                </StackPanel>
                <Button
                    Padding="12,6"
                    HorizontalAlignment="Right"
                    Background="#FEF2F2"
                    BorderThickness="0"
                    Command="{Binding ClearCartCommand}"
                    CornerRadius="8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon
                            FontSize="12"
                            Foreground="#DC2626"
                            Glyph="&#xE74D;" />
                        <TextBlock
                            FontSize="10"
                            FontWeight="Black"
                            Foreground="#DC2626"
                            Text="CLEAR" />
                    </StackPanel>
                </Button>
            </Grid>

            <!--  Order List  -->
            <ListView
                Grid.Row="1"
                Padding="0,10"
                ItemsSource="{Binding Order}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid
                            Padding="16,12"
                            BorderBrush="#F9FAFB"
                            BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Width="48"
                                Height="48"
                                VerticalAlignment="Top"
                                Background="#F9FAFB"
                                CornerRadius="12">
                                <FontIcon
                                    FontSize="24"
                                    Foreground="#E5E7EB"
                                    Glyph="&#xEB9F;" />
                            </Border>

                            <StackPanel
                                Grid.Column="1"
                                Margin="12,0,12,0"
                                VerticalAlignment="Top">
                                <TextBlock
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="#1F2937"
                                    MaxLines="2"
                                    Text="{Binding Product.Name}"
                                    TextWrapping="Wrap" />

                                <!--  Customization Tags  -->
                                <StackPanel Margin="0,4,0,0" Visibility="{Binding DrinkOptions, Converter={StaticResource NullToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border
                                            Margin="0,0,4,4"
                                            Padding="6,2"
                                            Background="{StaticResource Amber50}"
                                            CornerRadius="6">
                                            <TextBlock
                                                FontSize="10"
                                                FontWeight="Medium"
                                                Foreground="{StaticResource Amber600}"
                                                Text="{Binding DrinkOptions.Size}" />
                                        </Border>
                                        <Border
                                            Margin="0,0,4,4"
                                            Padding="6,2"
                                            Background="{StaticResource Pink50}"
                                            CornerRadius="6">
                                            <TextBlock
                                                FontSize="10"
                                                FontWeight="Medium"
                                                Foreground="{StaticResource Pink500}"
                                                Text="{Binding DrinkOptions.Sugar}" />
                                        </Border>
                                        <Border
                                            Margin="0,0,4,4"
                                            Padding="6,2"
                                            Background="{StaticResource Blue50}"
                                            CornerRadius="6">
                                            <TextBlock
                                                FontSize="10"
                                                FontWeight="Medium"
                                                Foreground="{StaticResource Blue500}"
                                                Text="{Binding DrinkOptions.Ice}" />
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding DrinkOptions.AddOns}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border
                                                        Margin="0,0,4,4"
                                                        Padding="6,2"
                                                        Background="{StaticResource Purple50}"
                                                        CornerRadius="6">
                                                        <TextBlock
                                                            FontSize="10"
                                                            FontWeight="Medium"
                                                            Foreground="{StaticResource Purple500}"
                                                            Text="{Binding}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <TextBlock
                                        FontSize="11"
                                        FontStyle="Italic"
                                        Foreground="#9CA3AF"
                                        Text="{Binding DrinkOptions.Notes}"
                                        Visibility="{Binding DrinkOptions.Notes, Converter={StaticResource NullToVisibilityConverter}}" />
                                </StackPanel>

                                <!--  Controls  -->
                                <StackPanel
                                    Margin="0,8,0,0"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Grid
                                        Padding="2"
                                        Background="#F9FAFB"
                                        CornerRadius="8">
                                        <StackPanel Orientation="Horizontal">
                                            <Button
                                                Width="28"
                                                Height="28"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.UpdateQuantityCommand, ElementName=PageRoot}">
                                                <Button.CommandParameter>
                                                    <models:UpdateQtyParams Delta="-1" Item="{Binding}" />
                                                </Button.CommandParameter>
                                                <FontIcon FontSize="12" Glyph="&#xE738;" />
                                            </Button>
                                            <TextBlock
                                                Width="24"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="#1F2937"
                                                Text="{Binding Quantity}"
                                                TextAlignment="Center" />
                                            <Button
                                                Width="28"
                                                Height="28"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.UpdateQuantityCommand, ElementName=PageRoot}">
                                                <Button.CommandParameter>
                                                    <models:UpdateQtyParams Delta="1" Item="{Binding}" />
                                                </Button.CommandParameter>
                                                <FontIcon FontSize="12" Glyph="&#xE710;" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <Button
                                        Width="28"
                                        Height="28"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="#9CA3AF"
                                        ToolTipService.ToolTip="Edit">
                                        <FontIcon FontSize="14" Glyph="&#xE70F;" />
                                    </Button>
                                    <Button
                                        Width="28"
                                        Height="28"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding DataContext.RemoveItemCommand, ElementName=PageRoot}"
                                        CommandParameter="{Binding}"
                                        Foreground="#9CA3AF"
                                        ToolTipService.ToolTip="Remove">
                                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Top"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="#1F2937"
                                Text="{Binding TotalPrice, Converter={StaticResource CurrencyConverter}}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!--  Bottom Section  -->
            <StackPanel
                Grid.Row="2"
                Padding="20"
                Background="#F9FAFB"
                BorderBrush="#F3F4F6"
                BorderThickness="0,1,0,0"
                Spacing="16">
                <StackPanel Spacing="8">
                    <Grid>
                        <TextBlock
                            FontSize="14"
                            Foreground="#6B7280"
                            Text="Subtotal" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            FontSize="14"
                            FontWeight="Medium"
                            Foreground="#374151"
                            Text="{Binding Subtotal, Converter={StaticResource CurrencyConverter}}" />
                    </Grid>
                    <Grid>
                        <TextBlock
                            FontSize="14"
                            Foreground="#9CA3AF"
                            Text="Tax (8.75%)" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            FontSize="14"
                            Foreground="#9CA3AF"
                            Text="{Binding Tax, Converter={StaticResource CurrencyConverter}}" />
                    </Grid>
                    <Grid Margin="0,4,0,0">
                        <TextBlock
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="#111827"
                            Text="Total" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="{StaticResource IconSelectedBgBrush}"
                            Text="{Binding Total, Converter={StaticResource CurrencyConverter}}" />
                    </Grid>
                </StackPanel>

                <!--  Order Type Selector  -->
                <Grid
                    Padding="0,12,0,0"
                    BorderBrush="#F3F4F6"
                    BorderThickness="0,1,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnDefinitions="*,*,*">
                        <Button
                            Margin="0,0,4,0"
                            Background="{Binding OrderType, Converter={StaticResource OrderTypeBackgroundConverter}, ConverterParameter='Dine-in'}"
                            Command="{Binding SetOrderTypeCommand}"
                            CommandParameter="Dine-in"
                            Content="Dine-in"
                            Foreground="{Binding OrderType, Converter={StaticResource OrderTypeForegroundConverter}, ConverterParameter='Dine-in'}"
                            Style="{StaticResource OrderTypeButtonStyle}" />
                        <Button
                            Grid.Column="1"
                            Margin="4,0,4,0"
                            Background="{Binding OrderType, Converter={StaticResource OrderTypeBackgroundConverter}, ConverterParameter='Takeaway'}"
                            Command="{Binding SetOrderTypeCommand}"
                            CommandParameter="Takeaway"
                            Content="Takeaway"
                            Foreground="{Binding OrderType, Converter={StaticResource OrderTypeForegroundConverter}, ConverterParameter='Takeaway'}"
                            Style="{StaticResource OrderTypeButtonStyle}" />
                        <Button
                            Grid.Column="2"
                            Margin="4,0,0,0"
                            Background="{Binding OrderType, Converter={StaticResource OrderTypeBackgroundConverter}, ConverterParameter='Delivery'}"
                            Command="{Binding SetOrderTypeCommand}"
                            CommandParameter="Delivery"
                            Content="Delivery"
                            Foreground="{Binding OrderType, Converter={StaticResource OrderTypeForegroundConverter}, ConverterParameter='Delivery'}"
                            Style="{StaticResource OrderTypeButtonStyle}" />
                    </Grid>

                    <!--  Table Selection (Mocked visual)  -->
                    <StackPanel
                        Grid.Row="1"
                        Margin="0,16,0,0"
                        Visibility="{Binding OrderType, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='Dine-in'}">
                        <StackPanel
                            Margin="0,0,0,8"
                            Orientation="Horizontal"
                            Spacing="6">
                            <Border
                                Width="4"
                                Height="12"
                                Background="{StaticResource Amber600}"
                                CornerRadius="2" />
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#374151"
                                Text="Select Table" />
                        </StackPanel>
                        <VariableSizedWrapGrid
                            ItemHeight="40"
                            ItemWidth="40"
                            Orientation="Horizontal">
                            <Button
                                Width="36"
                                Margin="0,0,4,4"
                                Background="{Binding TableNumber, Converter={StaticResource TableBackgroundConverter}, ConverterParameter='T1'}"
                                Command="{Binding SetTableNumberCommand}"
                                CommandParameter="T1"
                                Content="T1"
                                Foreground="{Binding TableNumber, Converter={StaticResource TableForegroundConverter}, ConverterParameter='T1'}"
                                Style="{StaticResource OrderTypeButtonStyle}" />
                            <Button
                                Width="36"
                                Margin="0,0,4,4"
                                Background="{Binding TableNumber, Converter={StaticResource TableBackgroundConverter}, ConverterParameter='T2'}"
                                Command="{Binding SetTableNumberCommand}"
                                CommandParameter="T2"
                                Content="T2"
                                Foreground="{Binding TableNumber, Converter={StaticResource TableForegroundConverter}, ConverterParameter='T2'}"
                                Style="{StaticResource OrderTypeButtonStyle}" />
                            <Button
                                Width="36"
                                Margin="0,0,4,4"
                                Background="{Binding TableNumber, Converter={StaticResource TableBackgroundConverter}, ConverterParameter='T3'}"
                                Command="{Binding SetTableNumberCommand}"
                                CommandParameter="T3"
                                Content="T3"
                                Foreground="{Binding TableNumber, Converter={StaticResource TableForegroundConverter}, ConverterParameter='T3'}"
                                Style="{StaticResource OrderTypeButtonStyle}" />
                            <Button
                                Width="36"
                                Margin="0,0,4,4"
                                Background="{Binding TableNumber, Converter={StaticResource TableBackgroundConverter}, ConverterParameter='T4'}"
                                Command="{Binding SetTableNumberCommand}"
                                CommandParameter="T4"
                                Content="T4"
                                Foreground="{Binding TableNumber, Converter={StaticResource TableForegroundConverter}, ConverterParameter='T4'}"
                                Style="{StaticResource OrderTypeButtonStyle}" />
                        </VariableSizedWrapGrid>
                    </StackPanel>
                </Grid>

                <Button
                    Padding="0,16"
                    HorizontalAlignment="Stretch"
                    Background="{StaticResource IconSelectedBgBrush}"
                    Command="{Binding PlaceOrderCommand}"
                    CornerRadius="12"
                    FontWeight="Bold"
                    Foreground="White">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Place Order ·" />
                        <TextBlock Text="{Binding Total, Converter={StaticResource CurrencyConverter}}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
