<Page
    x:Class="MyShop.Views.Pos.PosPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MyShop.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MyShop.Models"
    xmlns:viewmodels="using:MyShop.ViewModels"
    x:Name="PageRoot"
    Background="{StaticResource BgPage}"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:ColumnWidthConverter x:Key="ColumnWidthConverter"/>
        <converters:CurrencyConverter x:Key="CurrencyConverter"/>
        <converters:StringFormatConverter x:Key="StringFormatConverter"/>
        <converters:IconKeyToPathConverter x:Key="IconKeyToPathConverter"/>
        <converters:StringToDoubleConverter x:Key="StringToDoubleConverter"/>
        <converters:CategoryBrushConverter
            x:Key="CategoryBackgroundConverter"
            ActiveBrush="{StaticResource Warning}"
            InactiveBrush="{StaticResource TransparentBrush}"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <converters:EqualityToBrushConverter
            x:Key="OrderTypeBackgroundConverter"
            FalseBrush="{StaticResource SurfaceAlt}"
            TrueBrush="{StaticResource BrandPrimary}"/>
        <converters:EqualityToBrushConverter
            x:Key="OrderTypeForegroundConverter"
            FalseBrush="{StaticResource Gray700}"
            TrueBrush="White"/>
        <converters:EqualityToBrushConverter
            x:Key="TableBackgroundConverter"
            FalseBrush="{StaticResource SurfaceAlt}"
            TrueBrush="{StaticResource BrandPrimary}"/>
        <converters:EqualityToBrushConverter
            x:Key="TableForegroundConverter"
            FalseBrush="{StaticResource Gray700}"
            TrueBrush="White"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>

        <Style x:Key="CategoryButtonStyle"
                TargetType="Button">
            <Setter Property="CornerRadius"
                    Value="{StaticResource RadiusXLarge}"/>
            <Setter Property="Padding"
                    Value="{StaticResource SpaceLarge_Small}"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="{StaticResource TextSecondary}"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid
                            x:Name="RootGrid"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <ContentPresenter
                                x:Name="ContentPresenter"
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}"/>

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>

                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background"
                                                    Value="{StaticResource OverlayBlack20}"/>
                                            <Setter Target="ContentPresenter.Foreground"
                                                    Value="{StaticResource TextPrimary}"/>
                                        </VisualState.Setters>
                                    </VisualState>

                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background"
                                                    Value="{StaticResource IconSelectedBgBrush}"/>
                                            <Setter Target="ContentPresenter.Foreground"
                                                    Value="White"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OrderTypeButtonStyle"
                TargetType="Button">
            <Setter Property="CornerRadius"
                    Value="{StaticResource RadiusSmall}"/>
            <Setter Property="Height"
                    Value="{StaticResource Size40}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource SurfaceBorderAlt}"/>
            <Setter Property="Background"
                    Value="{StaticResource SurfaceAlt}"/>
            <Setter Property="FontSize"
                    Value="{StaticResource FontCaption}"/>
            <Setter Property="FontWeight"
                    Value="{StaticResource FontWeightSemiBold}"/>
            <Setter Property="HorizontalAlignment"
                    Value="Stretch"/>
        </Style>
    </Page.Resources>


    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="PosResponsiveStates">
                <VisualState x:Name="PosMobileState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="MainShellGrid.(Grid.Row)" Value="0"/>
                        <Setter Target="MainShellGrid.(Grid.Column)" Value="0"/>
                        <Setter Target="MainShellGrid.(Grid.ColumnSpan)" Value="2"/>
                        <Setter Target="SidebarGrid.(Grid.Row)" Value="2"/>
                        <Setter Target="SidebarGrid.(Grid.Column)" Value="0"/>
                        <Setter Target="SidebarGrid.(Grid.ColumnSpan)" Value="2"/>
                        <Setter Target="SidebarColumn.Width" Value="0"/>
                        <Setter Target="ProductsLayout.MaximumRowsOrColumns" Value="2"/>
                        <Setter Target="HeaderActionsPanel.Orientation" Value="Vertical"/>
                        <Setter Target="HeaderActionsPanel.Spacing" Value="8"/>
                        <Setter Target="HeaderActionsPanel.HorizontalAlignment" Value="Stretch"/>
                        <Setter Target="HeaderBar.Padding" Value="16,12"/>
                        <Setter Target="CategorySection.Padding" Value="16,12,16,8"/>
                        <Setter Target="SearchSection.Padding" Value="16,12"/>
                        <Setter Target="ProductsSection.Padding" Value="16,8"/>
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="PosTabletState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource BreakpointTablet}"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="MainShellGrid.(Grid.Row)" Value="0"/>
                        <Setter Target="MainShellGrid.(Grid.Column)" Value="0"/>
                        <Setter Target="MainShellGrid.(Grid.ColumnSpan)" Value="2"/>
                        <Setter Target="SidebarGrid.(Grid.Row)" Value="2"/>
                        <Setter Target="SidebarGrid.(Grid.Column)" Value="0"/>
                        <Setter Target="SidebarGrid.(Grid.ColumnSpan)" Value="2"/>
                        <Setter Target="SidebarColumn.Width" Value="0"/>
                        <Setter Target="ProductsLayout.MaximumRowsOrColumns" Value="3"/>
                        <Setter Target="HeaderActionsPanel.Orientation" Value="Horizontal"/>
                        <Setter Target="HeaderActionsPanel.Spacing" Value="12"/>
                        <Setter Target="HeaderActionsPanel.HorizontalAlignment" Value="Right"/>
                        <Setter Target="HeaderBar.Padding" Value="20,14"/>
                        <Setter Target="CategorySection.Padding" Value="20,14,20,8"/>
                        <Setter Target="SearchSection.Padding" Value="20,12"/>
                        <Setter Target="ProductsSection.Padding" Value="20,8"/>
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="PosDesktopState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource BreakpointDesktop}"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="MainShellGrid.(Grid.Row)" Value="0"/>
                        <Setter Target="MainShellGrid.(Grid.Column)" Value="0"/>
                        <Setter Target="MainShellGrid.(Grid.ColumnSpan)" Value="1"/>
                        <Setter Target="SidebarGrid.(Grid.Row)" Value="0"/>
                        <Setter Target="SidebarGrid.(Grid.Column)" Value="1"/>
                        <Setter Target="SidebarGrid.(Grid.ColumnSpan)" Value="1"/>
                        <Setter Target="SidebarColumn.Width" Value="380"/>
                        <Setter Target="ProductsLayout.MaximumRowsOrColumns" Value="3"/>
                        <Setter Target="HeaderActionsPanel.Orientation" Value="Horizontal"/>
                        <Setter Target="HeaderActionsPanel.Spacing" Value="16"/>
                        <Setter Target="HeaderActionsPanel.HorizontalAlignment" Value="Right"/>
                        <Setter Target="HeaderBar.Padding" Value="24,16"/>
                        <Setter Target="CategorySection.Padding" Value="24,16,24,8"/>
                        <Setter Target="SearchSection.Padding" Value="24,12"/>
                        <Setter Target="ProductsSection.Padding" Value="24,8"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="SidebarColumn" Width="380"/>
        </Grid.ColumnDefinitions>

        <!--  LEFT PANEL (Main Content)  -->
        <Grid x:Name="MainShellGrid"
              Grid.Row="0"
              Grid.Column="0"
              Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!--  Top Bar  -->
                <RowDefinition Height="Auto"/>
                <!--  Categories  -->
                <RowDefinition Height="Auto"/>
                <!--  Search  -->
                <RowDefinition Height="*"/>
                <!--  Products Grid  -->
            </Grid.RowDefinitions>

            <!--  Top Bar  -->
            <Grid
                x:Name="HeaderBar"
                Grid.Row="0"
                Padding="24,16"
                Background="{StaticResource SurfaceBackground}"
                BorderBrush="{StaticResource Gray100}"
                BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                        Spacing="12">
                    <Border
                        Width="36"
                        Height="36"
                        Background="{StaticResource IconSelectedBgBrush}"
                        CornerRadius="11">
                        <Path
                            Width="18"
                            Height="18"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="{StaticResource IconCoffee}"
                            Stretch="Uniform"
                            Stroke="White"
                            StrokeThickness="2"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            FontWeight="Bold"
                            LineHeight="14"
                            Style="{StaticResource BodyTextStyle}"
                            Text="MyShop"/>
                        <TextBlock Style="{StaticResource CaptionMutedTextStyle}"
                                Text="Point of Sale"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    x:Name="HeaderActionsPanel"
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="16">
                    <Button
                        Padding="16,8"
                        Background="{StaticResource SurfaceAlt}"
                        BorderBrush="{StaticResource Gray100}"
                        Click="ActiveOrders_Click"
                        CornerRadius="11"
                        Style="{StaticResource AppOutlineButtonStyle}">
                        <StackPanel Orientation="Horizontal"
                                Spacing="8">
                            <FontIcon
                                Foreground="{StaticResource TextMuted}"
                                Glyph="&#xE8A5;"
                                Style="{StaticResource IconSubtitleStyle}"/>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="{StaticResource FontWeightBold}"
                                Style="{StaticResource CaptionTextStyle}"
                                Text="Active Orders"/>
                        </StackPanel>
                    </Button>

                    <!-- Nút Đăng xuất cho POS -->
                    <Button
                        Padding="12,8"
                        Background="#FEF2F2"
                        BorderBrush="#FCA5A5"
                        Click="LogoutButton_Click"
                        CornerRadius="11"
                        Style="{StaticResource AppOutlineButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7E8;" 
                                      Foreground="#EF4444" 
                                      FontSize="16"/>
                            <TextBlock Text="Đăng xuất" 
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="#EF4444"
                                       Style="{StaticResource CaptionTextStyle}"/>
                        </StackPanel>
                    </Button>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyMutedTextStyle}"
                        Text="Monday, Nov 11"/>
                </StackPanel>
            </Grid>

            <!--  Categories  -->
            <Grid
                x:Name="CategorySection"
                Grid.Row="1"
                Padding="24,16,24,8"
                Background="{StaticResource SurfaceBackground}"
                BorderBrush="{StaticResource SurfaceAlt}"
                BorderThickness="0,0,0,1">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Enabled"
                              VerticalScrollMode="Disabled">
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Background="{Binding IsActive, Converter={StaticResource CategoryBackgroundConverter}}"
                                    Command="{Binding DataContext.SetCategoryCommand, ElementName=PageRoot}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource CategoryButtonStyle}">

                                    <StackPanel Orientation="Horizontal"
                                            Spacing="8">

                                        <Path
                                            Width="18"
                                            Height="18"
                                            VerticalAlignment="Center"
                                            Data="{Binding IconKey, Converter={StaticResource IconKeyToPathConverter}}"
                                            Fill="Transparent"
                                            Stretch="Uniform"
                                            Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                            StrokeThickness="1"/>

                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                            Text="{Binding Name}"/>

                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!--  Search Area  -->
            <Grid
                x:Name="SearchSection"
                Grid.Row="2"
                Padding="24,12"
                Background="{StaticResource SurfaceBackground}">
                <Grid x:Name="SearchBoxRoot">
                    <TextBox
                        Padding="40,10,12,10"
                        Background="{StaticResource SurfaceAlt}"
                        BorderBrush="{StaticResource BorderBrush}"
                        CornerRadius="12"
                        PlaceholderText="Search menu..."
                        Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <FontIcon
                        Margin="14,0,0,0"
                        HorizontalAlignment="Left"
                        Foreground="{StaticResource TextMuted}"
                        Glyph="&#xE721;"
                        Style="{StaticResource IconSubtitleStyle}"/>
                </Grid>
            </Grid>

            <!--  Products Grid  -->
            <ScrollViewer Grid.Row="3"
                    x:Name="ProductsSection"
                    Padding="24,8">
                <ItemsRepeater ItemsSource="{Binding FilteredProducts}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            x:Name="ProductsLayout"
                            ItemsStretch="Fill"
                            MaximumRowsOrColumns="3"
                            MinColumnSpacing="12"
                            MinItemWidth="150"
                            MinRowSpacing="12"
                            Orientation="Horizontal"/>
                    </ItemsRepeater.Layout>

                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="ProductCard_Click"
                                Style="{StaticResource AppGhostButtonStyle}">
                                <Border
                                    MinHeight="220"
                                    Background="{StaticResource SurfaceBackground}"
                                    BorderBrush="{StaticResource Gray100}"
                                    BorderThickness="1"
                                    CornerRadius="16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="130"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Border Background="{StaticResource SurfaceAlt}"
                                                CornerRadius="16,16,0,0">
                                            <Grid>
                                                <FontIcon
                                                    FontSize="{StaticResource Size40}"
                                                    Foreground="{StaticResource Gray200}"
                                                    Glyph="&#xEB9F;"/>
                                                <Image Source="{Binding PrimaryImageUrl, Converter={StaticResource ImageSourceConverter}}"
                                                       Stretch="UniformToFill"
                                                       Visibility="{Binding HasPrimaryImage, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                                <ItemsControl VerticalAlignment="Bottom"
                                                              HorizontalAlignment="Right"
                                                              Margin="0,0,8,8"
                                                              ItemsSource="{Binding SecondaryImageUrls}"
                                                              Visibility="{Binding HasSecondaryImages, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" Spacing="4"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Width="18"
                                                                    Height="18"
                                                                    CornerRadius="4"
                                                                    BorderBrush="White"
                                                                    BorderThickness="1">
                                                                <Image Source="{Binding Converter={StaticResource ImageSourceConverter}}"
                                                                       Stretch="UniformToFill"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Border>

                                        <StackPanel
                                            Grid.Row="1"
                                            Padding="12,10"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                MaxLines="1"
                                                Style="{StaticResource SubtitleTextStyle}"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis"/>
                                            <TextBlock
                                                FontWeight="Bold"
                                                Foreground="{StaticResource BrandPrimary}"
                                                Text="{Binding Price, Converter={StaticResource CurrencyConverter}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>

        <!--  RIGHT PANEL (Order Sidebar)  -->
        <Grid x:Name="SidebarGrid"
            Grid.Row="0"
            Grid.Column="1"
            Grid.RowSpan="2"
            Background="{StaticResource SurfaceBackground}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!--  Header  -->
                <RowDefinition Height="*"/>
                <!--  Order Items  -->
                <RowDefinition Height="Auto"/>
                <!--  Summary & Payment  -->
            </Grid.RowDefinitions>

            <!--  Sidebar Header  -->
            <Grid
                Grid.Row="0"
                Padding="20,16"
                BorderBrush="{StaticResource SurfaceAlt}"
                BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal"
                        Spacing="8">
                    <FontIcon
                        Foreground="{StaticResource IconSelectedBgBrush}"
                        Glyph="&#xE7BF;"
                        Style="{StaticResource IconSubtitleStyle}"/>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Foreground="{StaticResource Gray900}"
                        Text="Current Order"/>
                </StackPanel>
                <Button
                    Padding="12,6"
                    HorizontalAlignment="Right"
                    Background="{StaticResource ErrorSurfaceSoft}"
                    BorderThickness="0"
                    Command="{Binding ClearCartCommand}"
                    CornerRadius="8"
                    Style="{StaticResource AppSecondaryButtonStyle}">
                    <StackPanel Orientation="Horizontal"
                            Spacing="6">
                        <FontIcon
                            Foreground="{StaticResource ErrorStrong}"
                            Glyph="&#xE74D;"
                            Style="{StaticResource IconCaptionStyle}"/>
                        <TextBlock
                            FontSize="{StaticResource FontCaption}"
                            FontWeight="Black"
                            Foreground="{StaticResource ErrorStrong}"
                            Text="CLEAR"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!--  Order List  -->
            <ListView
                Grid.Row="1"
                Padding="0,10"
                ItemsSource="{Binding Order}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid
                            Padding="16,12"
                            BorderBrush="{StaticResource SurfaceAlt}"
                            BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border
                                Width="48"
                                Height="48"
                                VerticalAlignment="Top"
                                Background="{StaticResource SurfaceAlt}"
                                CornerRadius="12">
                                <FontIcon
                                    Foreground="{StaticResource Gray200}"
                                    Glyph="&#xEB9F;"
                                    Style="{StaticResource IconTitleStyle}"/>
                            </Border>

                            <StackPanel
                                Grid.Column="1"
                                Margin="12,0,12,0"
                                VerticalAlignment="Top">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    MaxLines="2"
                                    Style="{StaticResource BodyTextStyle}"
                                    Text="{Binding Product.Name}"
                                    TextWrapping="Wrap"/>

                                <!--  Customization Tags  -->
                                <StackPanel Margin="0,4,0,0"
                                        Visibility="{Binding DrinkOptions, Converter={StaticResource NullToVisibilityConverter}}">
                                    <WrapPanel>
                                        <Border
                                            Margin="0,0,4,4"
                                            Padding="6,2"
                                            Background="{StaticResource WarningSurfaceSoft}"
                                            CornerRadius="6">
                                            <TextBlock
                                                FontSize="{StaticResource FontCaption}"
                                                FontWeight="Medium"
                                                Foreground="{StaticResource BrandPrimary}"
                                                Text="{Binding DrinkOptions.Size}"/>
                                        </Border>
                                        <Border
                                            Margin="0,0,4,4"
                                            Padding="6,2"
                                            Background="{StaticResource AccentPinkSurface}"
                                            CornerRadius="6">
                                            <TextBlock
                                                FontSize="{StaticResource FontCaption}"
                                                FontWeight="Medium"
                                                Foreground="{StaticResource AccentPink}"
                                                Text="{Binding DrinkOptions.Sugar}"/>
                                        </Border>
                                        <Border
                                            Margin="0,0,4,4"
                                            Padding="6,2"
                                            Background="{StaticResource AccentBlueSurface}"
                                            CornerRadius="6">
                                            <TextBlock
                                                FontSize="{StaticResource FontCaption}"
                                                FontWeight="Medium"
                                                Foreground="{StaticResource AccentBlue}"
                                                Text="{Binding DrinkOptions.Ice}"/>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding DrinkOptions.AddOns}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border
                                                        Margin="0,0,4,4"
                                                        Padding="6,2"
                                                        Background="{StaticResource AccentPurpleSurface}"
                                                        CornerRadius="6">
                                                        <TextBlock
                                                            FontSize="{StaticResource FontCaption}"
                                                            FontWeight="Medium"
                                                            Foreground="{StaticResource AccentPurple}"
                                                            Text="{Binding}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </WrapPanel>
                                    <TextBlock
                                        FontStyle="Italic"
                                        Style="{StaticResource CaptionMutedTextStyle}"
                                        Text="{Binding DrinkOptions.Notes}"
                                        Visibility="{Binding DrinkOptions.Notes, Converter={StaticResource NullToVisibilityConverter}}"/>
                                </StackPanel>

                                <!--  Controls  -->
                                <StackPanel
                                    Margin="0,8,0,0"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Grid
                                        Padding="2"
                                        Background="{StaticResource SurfaceAlt}"
                                        CornerRadius="8">
                                        <StackPanel Orientation="Horizontal">
                                            <Button
                                                Width="28"
                                                Height="28"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.DecreaseQuantityCommand, ElementName=PageRoot}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource AppIconButtonStyle}">
                                                <FontIcon Glyph="&#xE738;"
                                                        Style="{StaticResource IconCaptionStyle}"/>
                                            </Button>
                                            <TextBlock
                                                Width="24"
                                                VerticalAlignment="Center"
                                                FontWeight="Bold"
                                                Style="{StaticResource BodyTextStyle}"
                                                Text="{Binding Quantity}"
                                                TextAlignment="Center"/>
                                            <Button
                                                Width="28"
                                                Height="28"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.IncreaseQuantityCommand, ElementName=PageRoot}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource AppIconButtonStyle}">
                                                <FontIcon Glyph="&#xE710;"
                                                        Style="{StaticResource IconCaptionStyle}"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <Button
                                        Width="28"
                                        Height="28"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding DataContext.EditItemCommand, ElementName=PageRoot}"
                                        CommandParameter="{Binding}"
                                        Foreground="{StaticResource TextMuted}"
                                        Style="{StaticResource AppIconButtonStyle}"
                                        ToolTipService.ToolTip="Edit">
                                        <FontIcon Glyph="&#xE70F;"
                                                Style="{StaticResource IconBodyStyle}"/>
                                    </Button>
                                    <Button
                                        Width="28"
                                        Height="28"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding DataContext.RemoveItemCommand, ElementName=PageRoot}"
                                        CommandParameter="{Binding}"
                                        Foreground="{StaticResource TextMuted}"
                                        Style="{StaticResource AppIconButtonStyle}"
                                        ToolTipService.ToolTip="Remove">
                                        <FontIcon Glyph="&#xE74D;"
                                                Style="{StaticResource IconBodyStyle}"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Top"
                                FontWeight="Bold"
                                Style="{StaticResource BodyTextStyle}"
                                Text="{Binding TotalPrice, Converter={StaticResource CurrencyConverter}}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!--  Bottom Section  -->
            <StackPanel
                Grid.Row="2"
                Padding="20"
                Background="{StaticResource SurfaceAlt}"
                BorderBrush="{StaticResource Gray100}"
                BorderThickness="0,1,0,0"
                Spacing="16">
                <StackPanel Spacing="8">
                    <Grid>
                        <TextBlock Style="{StaticResource BodySecondaryTextStyle}"
                                Text="Subtotal"/>
                        <TextBlock
                            HorizontalAlignment="Right"
                            FontSize="{StaticResource FontBody}"
                            FontWeight="Medium"
                            Foreground="{StaticResource Gray700}"
                            Text="{Binding Subtotal, Converter={StaticResource CurrencyConverter}}"/>
                    </Grid>
                    <Grid>
                        <TextBlock Style="{StaticResource BodyMutedTextStyle}"
                                Text="Tax (8.75%)"/>
                        <TextBlock
                            HorizontalAlignment="Right"
                            Style="{StaticResource BodyMutedTextStyle}"
                            Text="{Binding Tax, Converter={StaticResource CurrencyConverter}}"/>
                    </Grid>
                </StackPanel>

                <!--  Order Type Selector  -->
                <Grid
                    Padding="0,12,0,0"
                    BorderBrush="{StaticResource Gray100}"
                    BorderThickness="0,1,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid x:Name="OrderTypeButtonsGrid"
                          ColumnDefinitions="*,*,*">
                        <Button
                            Margin="0,0,4,0"
                            Background="{Binding OrderType, Converter={StaticResource OrderTypeBackgroundConverter}, ConverterParameter='Dine-in'}"
                            Command="{Binding SetOrderTypeCommand}"
                            CommandParameter="Dine-in"
                            Content="Dine-in"
                            Foreground="{Binding OrderType, Converter={StaticResource OrderTypeForegroundConverter}, ConverterParameter='Dine-in'}"
                            Style="{StaticResource OrderTypeButtonStyle}"/>
                        <Button
                            Grid.Column="1"
                            Margin="4,0,4,0"
                            Background="{Binding OrderType, Converter={StaticResource OrderTypeBackgroundConverter}, ConverterParameter='Takeaway'}"
                            Command="{Binding SetOrderTypeCommand}"
                            CommandParameter="Takeaway"
                            Content="Takeaway"
                            Foreground="{Binding OrderType, Converter={StaticResource OrderTypeForegroundConverter}, ConverterParameter='Takeaway'}"
                            Style="{StaticResource OrderTypeButtonStyle}"/>
                        <Button
                            Grid.Column="2"
                            Margin="4,0,0,0"
                            Background="{Binding OrderType, Converter={StaticResource OrderTypeBackgroundConverter}, ConverterParameter='Delivery'}"
                            Command="{Binding SetOrderTypeCommand}"
                            CommandParameter="Delivery"
                            Content="Delivery"
                            Foreground="{Binding OrderType, Converter={StaticResource OrderTypeForegroundConverter}, ConverterParameter='Delivery'}"
                            Style="{StaticResource OrderTypeButtonStyle}"/>
                    </Grid>

                    <!--  Table Selection (Mocked visual)  -->
                    <StackPanel
                        Grid.Row="1"
                        Margin="0,16,0,0"
                        Visibility="{Binding OrderType, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='Dine-in'}">
                        <StackPanel
                            Margin="0,0,0,8"
                            Orientation="Horizontal"
                            Spacing="6">
                            <Border
                                Width="4"
                                Height="12"
                                Background="{StaticResource BrandPrimary}"
                                CornerRadius="2"/>
                            <TextBlock
                                FontSize="{StaticResource FontCaption}"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource Gray700}"
                                Text="Select Table"/>
                        </StackPanel>
                        <VariableSizedWrapGrid
                            x:Name="TableChoicesGrid"
                            ItemHeight="40"
                            ItemWidth="100"
                            Orientation="Horizontal">
                            <Button
                                Width="96"
                                Margin="0,0,4,4"
                                Background="{Binding TableNumber, Converter={StaticResource TableBackgroundConverter}, ConverterParameter='Table 1'}"
                                Command="{Binding SetTableNumberCommand}"
                                CommandParameter="Table 1"
                                Content="Table 1"
                                Foreground="{Binding TableNumber, Converter={StaticResource TableForegroundConverter}, ConverterParameter='Table 1'}"
                                Style="{StaticResource OrderTypeButtonStyle}"/>
                            <Button
                                Width="96"
                                Margin="0,0,4,4"
                                Background="{Binding TableNumber, Converter={StaticResource TableBackgroundConverter}, ConverterParameter='Table 2'}"
                                Command="{Binding SetTableNumberCommand}"
                                CommandParameter="Table 2"
                                Content="Table 2"
                                Foreground="{Binding TableNumber, Converter={StaticResource TableForegroundConverter}, ConverterParameter='Table 2'}"
                                Style="{StaticResource OrderTypeButtonStyle}"/>
                            <Button
                                Width="96"
                                Margin="0,0,4,4"
                                Background="{Binding TableNumber, Converter={StaticResource TableBackgroundConverter}, ConverterParameter='Table 3'}"
                                Command="{Binding SetTableNumberCommand}"
                                CommandParameter="Table 3"
                                Content="Table 3"
                                Foreground="{Binding TableNumber, Converter={StaticResource TableForegroundConverter}, ConverterParameter='Table 3'}"
                                Style="{StaticResource OrderTypeButtonStyle}"/>
                            <Button
                                Width="96"
                                Margin="0,0,4,4"
                                Background="{Binding TableNumber, Converter={StaticResource TableBackgroundConverter}, ConverterParameter='Table 4'}"
                                Command="{Binding SetTableNumberCommand}"
                                CommandParameter="Table 4"
                                Content="Table 4"
                                Foreground="{Binding TableNumber, Converter={StaticResource TableForegroundConverter}, ConverterParameter='Table 4'}"
                                Style="{StaticResource OrderTypeButtonStyle}"/>
                        </VariableSizedWrapGrid>
                    </StackPanel>
                </Grid>

                <Button
                    Padding="0,16"
                    HorizontalAlignment="Stretch"
                    Background="{StaticResource IconSelectedBgBrush}"
                    Command="{Binding PlaceOrderCommand}"
                    CornerRadius="12"
                    FontWeight="Bold"
                    Foreground="White"
                    Style="{StaticResource AppPrimaryButtonStyle}">
                    <StackPanel Orientation="Horizontal"
                            Spacing="8">
                        <TextBlock Text="Place Order ·"/>
                        <TextBlock Text="{Binding Total, Converter={StaticResource CurrencyConverter}}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
