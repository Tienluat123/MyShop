<UserControl
    x:Class="MyShop.Views.Pos.Components.OrderDetailModal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MyShop.Converters">

    <UserControl.Resources>
        <converters:StatusToBrushConverter x:Key="StatusBgConverter" IsBackground="True" />
        <converters:StatusToBrushConverter x:Key="StatusFgConverter" IsBackground="False" />
    </UserControl.Resources>

    <!-- Overlay Background -->
    <Grid Background="{StaticResource OverlayBlack40}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        
        <!-- Modal Container -->
        <Border Width="600" MinHeight="500" MaxHeight="700" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource SurfaceAlt}" CornerRadius="{StaticResource RadiusXLarge}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Shadow="{ThemeResource SharedShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Padding="24" Background="{StaticResource SurfaceBackground}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="24,24,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="8">
                            <TextBlock Text="Order Details" Style="{StaticResource HeadingStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Padding="8,2" Background="{StaticResource WarningSurfaceSoft}" CornerRadius="6">
                                    <TextBlock Text="{Binding SelectedOrderDetails.OrderId}" Foreground="{StaticResource BrandPrimary}" FontWeight="Bold" FontSize="14" />
                                </Border>
                                <Border Padding="8,2" Background="{Binding SelectedOrderDetails.Status, Converter={StaticResource StatusBgConverter}}" CornerRadius="6">
                                    <TextBlock Text="{Binding SelectedOrderDetails.Status}" Foreground="{Binding SelectedOrderDetails.Status, Converter={StaticResource StatusFgConverter}}" FontWeight="Bold" FontSize="14" />
                                </Border>
                                <TextBlock Text="{Binding SelectedOrderDetails.CreatedAt}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding CloseOrderDetailCommand}" Style="{StaticResource AppIconButtonStyle}" VerticalAlignment="Top">
                            <FontIcon Glyph="&#xE711;" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Body -->
                <ScrollViewer Grid.Row="1" Padding="24">
                    <ItemsControl ItemsSource="{Binding SelectedOrderDetails.Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Product.Name}" Style="{StaticResource SubheadingStyle}" />
                                        <TextBlock Foreground="{StaticResource TextSecondary}">
                                            <Run Text="x" />
                                            <Run Text="{Binding Quantity}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" 
                                               Style="{StaticResource SubheadingStyle}" 
                                               VerticalAlignment="Center">
                                        <Run Text="$" />
                                        <Run Text="{Binding BasePrice}" />
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Footer -->
                <Border Grid.Row="2" Padding="24" Background="{StaticResource SurfaceBackground}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,24,24">
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock Text="Subtotal" Style="{StaticResource BodyStyle}" HorizontalAlignment="Left" />
                            <TextBlock Style="{StaticResource BodyStyle}" FontWeight="Bold" HorizontalAlignment="Right">
                                <Run Text="$" />
                                <Run Text="{Binding SelectedOrderDetails.Subtotal}" />
                            </TextBlock>
                        </Grid>
                        <Grid>
                            <TextBlock Text="Total" Style="{StaticResource SubheadingStyle}" HorizontalAlignment="Left" />
                            <TextBlock Style="{StaticResource SubheadingStyle}" Foreground="{StaticResource BrandPrimary}" HorizontalAlignment="Right">
                                <Run Text="$" />
                                <Run Text="{Binding SelectedOrderDetails.Total}" />
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
