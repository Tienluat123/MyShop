<UserControl
    x:Class="MyShop.Views.Pos.Components.OrderDetailModal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MyShop.Converters">

    <UserControl.Resources>
        <converters:StatusToBrushConverter x:Key="StatusBgConverter" IsBackground="True" />
        <converters:StatusToBrushConverter x:Key="StatusFgConverter" IsBackground="False" />
        <converters:CurrencyConverter x:Key="CurrencyConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Inverse="True" />
    </UserControl.Resources>

    <!--  Overlay Background  -->
    <Grid
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="{StaticResource OverlayBlack40}">

        <!--  Modal Container  -->
        <Border
            Width="600"
            MinHeight="500"
            MaxHeight="700"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{StaticResource SurfaceAlt}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusXLarge}"
            Shadow="{ThemeResource SharedShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Header  -->
                <Border
                    Grid.Row="0"
                    Padding="24"
                    Background="{StaticResource SurfaceBackground}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="24,24,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="8">
                            <TextBlock Style="{StaticResource HeadingStyle}" Text="Order Details" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border
                                    Padding="8,2"
                                    Background="{StaticResource WarningSurfaceSoft}"
                                    CornerRadius="6">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource BrandPrimary}"
                                        Text="{Binding SelectedOrderDetails.OrderId}" />
                                </Border>
                                <Border
                                    Padding="8,2"
                                    Background="{Binding SelectedOrderDetails.PaymentStatus, Converter={StaticResource StatusBgConverter}}"
                                    CornerRadius="6">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Foreground="{Binding SelectedOrderDetails.PaymentStatus, Converter={StaticResource StatusFgConverter}}"
                                        Text="{Binding SelectedOrderDetails.PaymentStatus}" />
                                </Border>
                                <Border
                                    Padding="8,2"
                                    Background="{Binding SelectedOrderDetails.FulfillmentStatus, Converter={StaticResource StatusBgConverter}}"
                                    CornerRadius="6">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Foreground="{Binding SelectedOrderDetails.FulfillmentStatus, Converter={StaticResource StatusFgConverter}}"
                                        Text="{Binding SelectedOrderDetails.FulfillmentStatus}" />
                                </Border>
                                <TextBlock
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource TextSecondary}"
                                    Text="{Binding SelectedOrderDetails.CreatedAt}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                Command="{Binding EditOrderDetailCommand}"
                                Style="{StaticResource AppIconButtonStyle}"
                                Visibility="{Binding IsEditingDetail, Converter={StaticResource InverseBoolToVis}}">
                                <FontIcon Glyph="&#xE70F;" />
                            </Button>
                            <Button Command="{Binding CloseOrderDetailCommand}" Style="{StaticResource AppIconButtonStyle}">
                                <FontIcon Glyph="&#xE711;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  Body  -->
                <ScrollViewer Grid.Row="1" Padding="24">
                    <StackPanel Spacing="24">
                        <!--  Items View  -->
                        <ItemsControl ItemsSource="{Binding SelectedOrderDetails.Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource SubheadingStyle}" Text="{Binding Product.Name}" />
                                            <TextBlock Foreground="{StaticResource TextSecondary}">
                                                <Run Text="x" />
                                                <Run Text="{Binding Quantity}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SubheadingStyle}">
                                            <Run Text="{Binding BasePrice, Converter={StaticResource CurrencyConverter}}" />
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <MenuFlyoutSeparator />

                        <!--  Additional Details (View Mode)  -->
                        <StackPanel Spacing="12" Visibility="{Binding IsEditingDetail, Converter={StaticResource InverseBoolToVis}}">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8"
                                Visibility="{Binding SelectedOrderDetails.Type, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='Dine-in'}">
                                <TextBlock FontWeight="SemiBold" Text="Table Number:" />
                                <TextBlock Text="{Binding SelectedOrderDetails.Table}" />
                            </StackPanel>
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8"
                                Visibility="{Binding SelectedOrderDetails.Notes, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='NotNull'}">
                                <TextBlock FontWeight="SemiBold" Text="Notes:" />
                                <TextBlock Text="{Binding SelectedOrderDetails.Notes}" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>

                        <!--  Edit Form (Edit Mode)  -->
                        <StackPanel Spacing="16" Visibility="{Binding IsEditingDetail, Converter={StaticResource BoolToVis}}">
                            <TextBox Header="Table Number" Text="{Binding EditTableNumber, Mode=TwoWay}" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    Grid.Column="0"
                                    HorizontalAlignment="Stretch"
                                    Header="Payment Status"
                                    ItemsSource="{Binding PaymentStatusOptions}"
                                    SelectedItem="{Binding EditPaymentStatus, Mode=TwoWay}" />
                                <ComboBox
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    Header="Fulfillment Status"
                                    ItemsSource="{Binding FulfillmentStatusOptions}"
                                    SelectedItem="{Binding EditFulfillmentStatus, Mode=TwoWay}" />
                            </Grid>
                            <TextBox
                                AcceptsReturn="True"
                                Header="Notes (Admin Override)"
                                PlaceholderText="Add internal notes..."
                                Text="{Binding EditNotes, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!--  Footer  -->
                <Border
                    Grid.Row="2"
                    Padding="24"
                    Background="{StaticResource SurfaceBackground}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,24,24">
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock
                                HorizontalAlignment="Left"
                                Style="{StaticResource BodyStyle}"
                                Text="Subtotal" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontWeight="Bold"
                                Style="{StaticResource BodyStyle}">
                                <Run Text="{Binding SelectedOrderDetails.Subtotal, Converter={StaticResource CurrencyConverter}}" />
                            </TextBlock>
                        </Grid>
                        <Grid Visibility="{Binding SelectedOrderDetails.Discount, Converter={StaticResource NumberToVisibilityConverter}}">
                            <TextBlock
                                HorizontalAlignment="Left"
                                Style="{StaticResource BodyStyle}"
                                Text="Discount" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                Foreground="{StaticResource ErrorSurface}"
                                Style="{StaticResource BodyStyle}">
                                <Run Text="-" />
                                <Run Text="{Binding SelectedOrderDetails.Discount, Converter={StaticResource CurrencyConverter}}" />
                            </TextBlock>
                        </Grid>
                        <Grid Visibility="{Binding SelectedOrderDetails.Tax, Converter={StaticResource NumberToVisibilityConverter}}">
                            <TextBlock
                                HorizontalAlignment="Left"
                                Style="{StaticResource BodyStyle}"
                                Text="Tax" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                Style="{StaticResource BodyStyle}">
                                <Run Text="{Binding SelectedOrderDetails.Tax, Converter={StaticResource CurrencyConverter}}" />
                            </TextBlock>
                        </Grid>
                        <Grid>
                            <TextBlock
                                HorizontalAlignment="Left"
                                Style="{StaticResource SubheadingStyle}"
                                Text="Total" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                Foreground="{StaticResource BrandPrimary}"
                                Style="{StaticResource SubheadingStyle}">
                                <Run Text="{Binding SelectedOrderDetails.Total, Converter={StaticResource CurrencyConverter}}" />
                            </TextBlock>
                        </Grid>

                        <!--  Action Buttons (Edit Mode)  -->
                        <Grid
                            Margin="0,12,0,0"
                            ColumnSpacing="12"
                            Visibility="{Binding IsEditingDetail, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                Command="{Binding CancelEditOrderDetailCommand}"
                                Content="Cancel"
                                Style="{StaticResource AppSecondaryButtonStyle}" />
                            <Button
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Command="{Binding SaveOrderDetailCommand}"
                                Content="Save Changes"
                                Style="{StaticResource AppPrimaryButtonStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
