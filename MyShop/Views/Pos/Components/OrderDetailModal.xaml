<UserControl
    x:Class="MyShop.Views.Pos.Components.OrderDetailModal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MyShop.Converters">

    <UserControl.Resources>
        <converters:StatusToBrushConverter x:Key="StatusBgConverter" IsBackground="True" />
        <converters:StatusToBrushConverter x:Key="StatusFgConverter" IsBackground="False" />
        <converters:CurrencyConverter x:Key="CurrencyConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:StringFormatConverter x:Key="StringFormatConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVis" />
    </UserControl.Resources>

    <Grid Background="{StaticResource OverlayBlack40}">
        <Border
            Width="430"
            MaxHeight="760"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{StaticResource SurfaceBackground}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="24"
            Shadow="{ThemeResource SharedShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid
                    Grid.Row="0"
                    Padding="20,16"
                    BorderBrush="{StaticResource SurfaceAlt}"
                    BorderThickness="0,0,0,1">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                Foreground="{StaticResource IconSelectedBgBrush}"
                                Glyph="&#xE7BF;"
                                Style="{StaticResource IconSubtitleStyle}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="Bold"
                                Foreground="{StaticResource Gray900}"
                                Text="Order Detail" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border
                                Padding="8,2"
                                Background="{StaticResource WarningSurfaceSoft}"
                                CornerRadius="6">
                                <TextBlock
                                    FontSize="{StaticResource FontCaption}"
                                    FontWeight="Black"
                                    Foreground="{StaticResource BrandPrimary}"
                                    Text="{Binding SelectedOrderDetails.OrderId}" />
                            </Border>
                            <Border
                                Padding="8,2"
                                Background="{Binding SelectedOrderDetails.PaymentStatus, Converter={StaticResource StatusBgConverter}}"
                                CornerRadius="6">
                                <TextBlock
                                    FontSize="{StaticResource FontCaption}"
                                    FontWeight="Bold"
                                    Foreground="{Binding SelectedOrderDetails.PaymentStatus, Converter={StaticResource StatusFgConverter}}"
                                    Text="{Binding SelectedOrderDetails.PaymentStatus}" />
                            </Border>
                            <Border
                                Padding="8,2"
                                Background="{Binding SelectedOrderDetails.FulfillmentStatus, Converter={StaticResource StatusBgConverter}}"
                                CornerRadius="6">
                                <TextBlock
                                    FontSize="{StaticResource FontCaption}"
                                    FontWeight="Bold"
                                    Foreground="{Binding SelectedOrderDetails.FulfillmentStatus, Converter={StaticResource StatusFgConverter}}"
                                    Text="{Binding SelectedOrderDetails.FulfillmentStatus}" />
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock
                                FontWeight="SemiBold"
                                Style="{StaticResource CaptionMutedTextStyle}"
                                Text="{Binding SelectedOrderDetails.Type}" />
                            <TextBlock
                                FontWeight="SemiBold"
                                Style="{StaticResource CaptionMutedTextStyle}"
                                Text="{Binding SelectedOrderDetails.Table, Converter={StaticResource StringFormatConverter}, ConverterParameter='· Table {0}'}"
                                Visibility="{Binding SelectedOrderDetails.Table, Converter={StaticResource StringToVis}, ConverterParameter='NotNull'}" />
                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrandPrimary}"
                                Style="{StaticResource CaptionTextStyle}"
                                Text="{Binding SelectedOrderDetails.CustomerName, Converter={StaticResource StringFormatConverter}, ConverterParameter='· {0}'}" />
                        </StackPanel>
                    </StackPanel>

                    <Button
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        Command="{Binding CloseOrderDetailCommand}"
                        CornerRadius="12"
                        Style="{StaticResource AppIconButtonStyle}">
                        <FontIcon Glyph="&#xE711;" Style="{StaticResource IconBodyStyle}" />
                    </Button>
                </Grid>

                <ListView
                    Grid.Row="1"
                    Padding="0,10"
                    ItemsSource="{Binding SelectedOrderDetails.Items}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid
                                Padding="16,12"
                                BorderBrush="{StaticResource SurfaceAlt}"
                                BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>



                                <StackPanel
                                    Grid.Column="1"
                                    Margin="12,0,12,0"
                                    VerticalAlignment="Top">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        MaxLines="2"
                                        Style="{StaticResource BodyTextStyle}"
                                        Text="{Binding Product.Name}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        Style="{StaticResource CaptionMutedTextStyle}"
                                        Text="{Binding BasePrice, Converter={StaticResource CurrencyConverter}}" />

                                    <StackPanel Margin="0,4,0,0" Visibility="{Binding DrinkOptions, Converter={StaticResource NullToVis}}">
                                        <WrapPanel>
                                            <Border
                                                Margin="0,0,4,4"
                                                Padding="6,2"
                                                Background="{StaticResource WarningSurfaceSoft}"
                                                CornerRadius="6">
                                                <TextBlock
                                                    FontSize="{StaticResource FontCaption}"
                                                    FontWeight="Medium"
                                                    Foreground="{StaticResource BrandPrimary}"
                                                    Text="{Binding DrinkOptions.Size}" />
                                            </Border>
                                            <Border
                                                Margin="0,0,4,4"
                                                Padding="6,2"
                                                Background="{StaticResource AccentPinkSurface}"
                                                CornerRadius="6">
                                                <TextBlock
                                                    FontSize="{StaticResource FontCaption}"
                                                    FontWeight="Medium"
                                                    Foreground="{StaticResource AccentPink}"
                                                    Text="{Binding DrinkOptions.Sugar}" />
                                            </Border>
                                            <Border
                                                Margin="0,0,4,4"
                                                Padding="6,2"
                                                Background="{StaticResource AccentBlueSurface}"
                                                CornerRadius="6">
                                                <TextBlock
                                                    FontSize="{StaticResource FontCaption}"
                                                    FontWeight="Medium"
                                                    Foreground="{StaticResource AccentBlue}"
                                                    Text="{Binding DrinkOptions.Ice}" />
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding DrinkOptions.AddOns}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border
                                                            Margin="0,0,4,4"
                                                            Padding="6,2"
                                                            Background="{StaticResource AccentPurpleSurface}"
                                                            CornerRadius="6">
                                                            <TextBlock
                                                                FontSize="{StaticResource FontCaption}"
                                                                FontWeight="Medium"
                                                                Foreground="{StaticResource AccentPurple}"
                                                                Text="{Binding}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </WrapPanel>
                                        <TextBlock
                                            FontStyle="Italic"
                                            Style="{StaticResource CaptionMutedTextStyle}"
                                            Text="{Binding DrinkOptions.Notes}"
                                            Visibility="{Binding DrinkOptions.Notes, Converter={StaticResource NullToVis}}" />
                                    </StackPanel>

                                    <Border
                                        Margin="0,8,0,0"
                                        Padding="10,4"
                                        HorizontalAlignment="Left"
                                        Background="{StaticResource SurfaceAlt}"
                                        CornerRadius="8">
                                        <TextBlock
                                            FontWeight="Bold"
                                            Style="{StaticResource CaptionTextStyle}"
                                            Text="{Binding Quantity, Converter={StaticResource StringFormatConverter}, ConverterParameter='Qty {0}'}" />
                                    </Border>
                                </StackPanel>

                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Top"
                                    FontWeight="Bold"
                                    Style="{StaticResource BodyTextStyle}"
                                    Text="{Binding TotalPrice, Converter={StaticResource CurrencyConverter}}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel
                    Grid.Row="2"
                    Padding="20"
                    Background="{StaticResource SurfaceAlt}"
                    BorderBrush="{StaticResource Gray100}"
                    BorderThickness="0,1,0,0"
                    Spacing="16">
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock Style="{StaticResource BodySecondaryTextStyle}" Text="Subtotal" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontWeight="Medium"
                                Foreground="{StaticResource Gray700}"
                                Text="{Binding SelectedOrderDetails.Subtotal, Converter={StaticResource CurrencyConverter}}" />
                        </Grid>
                        <Grid Visibility="{Binding SelectedOrderDetails.Discount, Converter={StaticResource NumberToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource BodyMutedTextStyle}" Text="Discount" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                Foreground="{StaticResource ErrorStrong}"
                                Style="{StaticResource BodyMutedTextStyle}"
                                Text="{Binding SelectedOrderDetails.Discount, Converter={StaticResource CurrencyConverter}}" />
                        </Grid>
                        <Grid Visibility="{Binding SelectedOrderDetails.ManualAdjustment, Converter={StaticResource NumberToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource BodyMutedTextStyle}" Text="Adjustment" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                Foreground="{StaticResource ErrorStrong}"
                                Style="{StaticResource BodyMutedTextStyle}"
                                Text="{Binding SelectedOrderDetails.ManualAdjustment, Converter={StaticResource CurrencyConverter}}" />
                        </Grid>
                        <Grid>
                            <TextBlock Style="{StaticResource BodyMutedTextStyle}" Text="Tax (8.75%)" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                Style="{StaticResource BodyMutedTextStyle}"
                                Text="{Binding SelectedOrderDetails.Tax, Converter={StaticResource CurrencyConverter}}" />
                        </Grid>
                        <Grid>
                            <TextBlock
                                FontWeight="Bold"
                                Foreground="{StaticResource Gray900}"
                                Text="Total" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontWeight="Bold"
                                Foreground="{StaticResource BrandPrimary}"
                                Text="{Binding SelectedOrderDetails.Total, Converter={StaticResource CurrencyConverter}}" />
                        </Grid>
                    </StackPanel>

                    <Button
                        Padding="0,16"
                        HorizontalAlignment="Stretch"
                        Background="{StaticResource IconSelectedBgBrush}"
                        Command="{Binding EditOrderDetailCommand}"
                        CornerRadius="12"
                        FontWeight="Bold"
                        Foreground="White"
                        IsEnabled="{Binding CanEditItems}"
                        Style="{StaticResource AppPrimaryButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE70F;" Style="{StaticResource IconCaptionStyle}" />
                            <TextBlock Text="Edit Order" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
