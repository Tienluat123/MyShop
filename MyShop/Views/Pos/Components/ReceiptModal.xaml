<ContentDialog
    x:Class="MyShop.Views.Pos.Components.ReceiptModal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MyShop.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MyShop.Models"
    x:Name="Root"
    Title="Payment Successful"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <!--  User added overrides  -->
        <x:Double x:Key="ContentDialogMaxWidth">600</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">1200</x:Double>
        <Thickness x:Key="ContentDialogPadding">0</Thickness>
        <Thickness x:Key="ContentDialogBorderThickness">0</Thickness>

        <converters:CurrencyConverter x:Key="CurrencyConverter"/>

        <Style
            x:Key="ReceiptActionButtonStyle"
            BasedOn="{StaticResource DefaultButtonStyle}"
            TargetType="Button">
            <Setter Property="Padding"
                    Value="{StaticResource SpaceXLarge_Medium}"/>
            <Setter Property="CornerRadius"
                    Value="{StaticResource RadiusXLarge}"/>
            <Setter Property="FontWeight"
                    Value="{StaticResource FontWeightSemiBold}"/>
        </Style>

        <Style
            x:Key="ReceiptPrimaryButtonStyle"
            BasedOn="{StaticResource ReceiptActionButtonStyle}"
            TargetType="Button">
            <Setter Property="Background"
                    Value="{StaticResource BrandPrimary}"/>
            <Setter Property="Foreground"
                    Value="White"/>
        </Style>

        <Style
            x:Key="ReceiptSecondaryButtonStyle"
            BasedOn="{StaticResource ReceiptActionButtonStyle}"
            TargetType="Button">
            <Setter Property="Background"
                    Value="{StaticResource Gray100}"/>
            <Setter Property="Foreground"
                    Value="{StaticResource Gray500}"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
        </Style>
    </ContentDialog.Resources>

    <Grid Width="450"
          Padding="0">
        <!--  Paper Background Effect  -->
        <Border
            Background="{StaticResource SurfaceBackground}"
            BorderBrush="{StaticResource Gray100}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusMedium}">
            <Border.Shadow>
                <ThemeShadow/>
            </Border.Shadow>
        </Border>

        <ScrollViewer MaxHeight="800"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="0,0,0,32">
                <!--  Header Section  -->
                <StackPanel Padding="32,40,32,24"
                            Spacing="0">
                    <Border
                        Width="64"
                        Height="64"
                        Margin="0,0,0,24"
                        HorizontalAlignment="Center"
                        Background="{StaticResource WarningSurfaceSoft}"
                        CornerRadius="{StaticResource Radius2XLarge}">
                        <FontIcon
                            Style="{StaticResource Icon2XLargeStyle}"
                            Foreground="{StaticResource BrandPrimary}"
                            Glyph="&#xE73E;"/>
                    </Border>

                    <TextBlock
                        Margin="0,0,0,32"
                        HorizontalAlignment="Center"
                        CharacterSpacing="100"
                        FontSize="{StaticResource FontTitle}"
                        FontWeight="Black"
                        Text="CAFE SHOP"/>

                    <Grid
                        Padding="0,20"
                        BorderBrush="{StaticResource Gray100}"
                        BorderThickness="0,1,0,1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Row="0"
                            Grid.Column="0"
                            Spacing="4">
                            <TextBlock
                                FontWeight="Bold"
                                Style="{StaticResource CaptionMutedTextStyle}"
                                Text="CUSTOMER"/>
                            <TextBlock
                                x:Name="CustomerNameText"
                                FontSize="{StaticResource FontBody}"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource Gray900}"/>
                        </StackPanel>

                        <StackPanel
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Spacing="4">
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontWeight="Bold"
                                Style="{StaticResource CaptionMutedTextStyle}"
                                Text="ORDER TYPE"/>
                            <TextBlock
                                x:Name="OrderTypeText"
                                HorizontalAlignment="Right"
                                FontSize="{StaticResource FontBody}"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource Gray900}"/>
                        </StackPanel>

                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,16,0,0"
                            Spacing="4">
                            <TextBlock
                                FontWeight="Bold"
                                Style="{StaticResource CaptionMutedTextStyle}"
                                Text="RECEIPT"/>
                            <TextBlock
                                x:Name="OrderIdText"
                                FontSize="{StaticResource FontBody}"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource Gray900}"/>
                        </StackPanel>

                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,16,0,0"
                            HorizontalAlignment="Right"
                            Spacing="4">
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontWeight="Bold"
                                Style="{StaticResource CaptionMutedTextStyle}"
                                Text="DATE"/>
                            <TextBlock
                                x:Name="DateText"
                                HorizontalAlignment="Right"
                                FontSize="{StaticResource FontBody}"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource Gray900}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!--  Items Content  -->
                <ItemsControl
                    x:Name="ItemsList"
                    Padding="32,0"
                    ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="2">
                                    <TextBlock
                                        FontSize="{StaticResource FontSubtitle}"
                                        FontWeight="Medium"
                                        Foreground="{StaticResource Gray900}"
                                        Text="{Binding Product.Name}"/>
                                    <TextBlock Style="{StaticResource BodyMutedTextStyle}">
                                        <Run Text="{Binding Quantity}"/>
                                        <Run Text="x"/>
                                        <Run Text="{Binding BasePrice, Converter={StaticResource CurrencyConverter}}"/>
                                    </TextBlock>
                                </StackPanel>

                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource FontSubtitle}"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource Gray900}"
                                    Text="{Binding TotalPrice, Converter={StaticResource CurrencyConverter}}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--  Separator between items and totals  -->
                <Rectangle
                    Height="1"
                    Margin="32,12"
                    VerticalAlignment="Center"
                    Stretch="Fill"
                    Stroke="{StaticResource Gray100}"
                    StrokeDashArray="2,2"
                    StrokeThickness="1"/>

                <!--  Footer Section  -->
                <StackPanel Padding="32,24,32,40"
                            Spacing="16">
                    <!--  Totals  -->
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock
                                Style="{StaticResource BodyMutedTextStyle}"
                                Text="Subtotal"/>
                            <TextBlock
                                x:Name="SubtotalText"
                                HorizontalAlignment="Right"
                                FontSize="{StaticResource FontBody}"
                                Foreground="{StaticResource Gray900}"/>
                        </Grid>
                        <Grid>
                            <TextBlock
                                Style="{StaticResource BodyMutedTextStyle}"
                                Text="Tax (8.75%)"/>
                            <TextBlock
                                x:Name="TaxText"
                                HorizontalAlignment="Right"
                                FontSize="{StaticResource FontBody}"
                                Foreground="{StaticResource Gray900}"/>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <TextBlock
                                Style="{StaticResource BodyMutedTextStyle}"
                                Text="Method"/>
                            <TextBlock
                                x:Name="PaymentMethodText"
                                HorizontalAlignment="Right"
                                FontSize="{StaticResource FontBody}"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource Gray900}"/>
                        </Grid>
                        <Rectangle
                            Height="1"
                            Margin="0,12"
                            VerticalAlignment="Center"
                            Stretch="Fill"
                            Stroke="{StaticResource Gray100}"
                            StrokeDashArray="2,2"
                            StrokeThickness="1"/>
                        <Grid>
                            <TextBlock
                                FontSize="{StaticResource FontHeader}"
                                FontWeight="Black"
                                Foreground="{StaticResource Gray900}"
                                Text="TOTAL PAID"/>
                            <TextBlock
                                x:Name="TotalText"
                                HorizontalAlignment="Right"
                                FontSize="{StaticResource FontHeader}"
                                FontWeight="Black"
                                Foreground="{StaticResource BrandPrimary}"/>
                        </Grid>
                    </StackPanel>

                    <!--  Digital QR Copy  -->
                    <StackPanel
                        Margin="0,24,0,24"
                        HorizontalAlignment="Center"
                        Spacing="12">
                        <Border
                            Width="100"
                            Height="100"
                            Padding="8"
                            Background="{StaticResource SurfaceAlt}"
                            BorderBrush="{StaticResource Gray100}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMedium}">
                            <FontIcon
                                FontSize="80"
                                Foreground="{StaticResource Gray900}"
                                Glyph="&#xED14;"/>
                        </Border>
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource CaptionMutedTextStyle}"
                            Text="Scan for digital receipt"/>
                    </StackPanel>

                    <TextBlock
                        Margin="0,0,0,32"
                        HorizontalAlignment="Center"
                        FontWeight="SemiBold"
                        Style="{StaticResource BodyTextStyle}"
                        Text="Thank you for your visit!"/>

                    <!--  Unified Action Buttons  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button
                            Margin="0,0,8,0"
                            HorizontalAlignment="Stretch"
                            Content="Print"
                            Style="{StaticResource ReceiptSecondaryButtonStyle}">
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="8">
                                        <FontIcon Style="{StaticResource IconBodyStyle}"
                                                  Glyph="&#xE749;"/>
                                        <TextBlock Text="Print"/>
                                    </StackPanel>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>
                        <Button
                            x:Name="CloseButton"
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            HorizontalAlignment="Stretch"
                            Click="{x:Bind Hide}"
                            Content="Done"
                            Style="{StaticResource ReceiptPrimaryButtonStyle}"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentDialog>
