<ContentDialog
    x:Class="MyShop.Views.Pos.Components.ProductCustomizationModal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MyShop.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <converters:StringToDoubleConverter x:Key="StringToDoubleConverter"/>
        <converters:CurrencyConverter x:Key="CurrencyConverter"/>
        <converters:CollectionContainsToBoolConverter x:Key="CollectionContainsToBoolConverter"/>
        <converters:EqualityToBrushConverter
            x:Key="SizeSelectedBackgroundConverter"
            FalseBrush="{StaticResource SurfaceAlt}"
            TrueBrush="{StaticResource WarningSurfaceSoft}"/>
        <converters:EqualityToBrushConverter
            x:Key="SizeSelectedBorderConverter"
            FalseBrush="{StaticResource Gray100}"
            TrueBrush="{StaticResource BrandPrimary}"/>
        <converters:EqualityToBrushConverter
            x:Key="IceSelectedBackgroundConverter"
            FalseBrush="{StaticResource SurfaceAlt}"
            TrueBrush="{StaticResource AccentTealSurface}"/>
        <converters:EqualityToBrushConverter
            x:Key="IceSelectedBorderConverter"
            FalseBrush="{StaticResource Gray100}"
            TrueBrush="{StaticResource AccentTeal}"/>

        <Style x:Key="SectionHeaderStyle"
               TargetType="StackPanel">
            <Setter Property="Orientation"
                    Value="Horizontal"/>
            <Setter Property="Spacing"
                    Value="8"/>
            <Setter Property="Margin"
                    Value="0,0,0,12"/>
        </Style>

        <Style x:Key="SectionTitleStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="{StaticResource FontCaption}"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Foreground"
                    Value="{StaticResource TextPrimary}"/>
            <Setter Property="CharacterSpacing"
                    Value="50"/>
        </Style>

        <Style x:Key="SelectionButtonStyle"
               TargetType="Button">
            <Setter Property="CornerRadius"
                    Value="16"/>
            <Setter Property="Padding"
                    Value="12"/>
            <Setter Property="BorderThickness"
                    Value="2"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        </Style>

        <Style x:Key="AddOnToggleStyle"
               TargetType="ToggleButton">
            <Setter Property="CornerRadius"
                    Value="12"/>
            <Setter Property="Padding"
                    Value="12,6"/>
            <Setter Property="Margin"
                    Value="4"/>
            <Setter Property="FontSize"
                    Value="{StaticResource FontCaption}"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Background"
                    Value="{StaticResource SurfaceBackground}"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource Gray100}"/>
            <Setter Property="BorderThickness"
                    Value="2"/>
        </Style>
    </ContentDialog.Resources>

    <Grid Width="450"
          Background="{StaticResource SurfaceBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="180"/>
            <!--  Header  -->
            <RowDefinition Height="*"/>
            <!--  Content  -->
            <RowDefinition Height="Auto"/>
            <!--  Footer  -->
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid Grid.Row="0">
            <Image Source="{Binding Product.ImageUrl}"
                   Stretch="UniformToFill"/>
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="0,1">
                        <GradientStop Offset="0"
                                      Color="{StaticResource TransparentBrush}"/>
                        <GradientStop Offset="1"
                                      Color="{StaticResource OverlayBlack80}"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <StackPanel Margin="24,0,24,16"
                        VerticalAlignment="Bottom">
                <TextBlock
                    FontSize="{StaticResource FontTitle}"
                    FontWeight="Black"
                    Foreground="White"
                    Text="{Binding Product.Name}"/>
                <TextBlock
                    FontSize="{StaticResource FontCaption}"
                    FontWeight="Medium"
                    Foreground="White"
                    Opacity="0.6"
                    Text="Customize your selection"/>
            </StackPanel>

            <Button
                Margin="24"
                Padding="8"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="{StaticResource OverlayBlack40}"
                BorderThickness="0"
                Click="CloseBtn_Click"
                Content="&#xE711;"
                CornerRadius="20"
                FontFamily="Segoe MDL2 Assets"
                FontSize="{StaticResource FontSubtitle}"
                Foreground="White"
                Style="{StaticResource AppIconButtonStyle}"/>

            <Border
                Margin="0,0,24,16"
                Padding="16,8"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="{StaticResource OverlayWhite12}"
                BorderBrush="{StaticResource OverlayWhite25}"
                BorderThickness="1"
                CornerRadius="16">
                <StackPanel>
                    <TextBlock
                        CharacterSpacing="100"
                        FontSize="{StaticResource FontCaption}"
                        FontWeight="Bold"
                        Foreground="White"
                        Opacity="0.5"
                        Text="PRICE"/>
                    <TextBlock
                        FontSize="{StaticResource FontHeader}"
                        FontWeight="Black"
                        Foreground="{StaticResource AccentGold}"
                        Text="{Binding UnitTotalPrice, Converter={StaticResource CurrencyConverter}}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!--  Content  -->
        <ScrollViewer
            Grid.Row="1"
            MaxHeight="450"
            Padding="24">
            <StackPanel Spacing="32">
                <StackPanel x:Name="BeverageOptions"
                            Spacing="32">
                    <!--  Size  -->
                    <StackPanel>
                        <StackPanel Style="{StaticResource SectionHeaderStyle}">
                            <Border
                                Padding="6"
                                Background="{StaticResource WarningSurfaceSoft}"
                                CornerRadius="8">
                                <FontIcon
                                    Style="{StaticResource IconBodyStyle}"
                                    Foreground="{StaticResource BrandPrimary}"
                                    Glyph="&#xE93E;"/>
                            </Border>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource SectionTitleStyle}"
                                Text="SELECT SIZE"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,*,*">
                            <Button
                                Margin="0,0,4,0"
                                HorizontalAlignment="Stretch"
                                Background="{Binding Size, Converter={StaticResource SizeSelectedBackgroundConverter}, ConverterParameter=S}"
                                BorderBrush="{Binding Size, Converter={StaticResource SizeSelectedBorderConverter}, ConverterParameter=S}"
                                Command="{Binding SetSizeCommand}"
                                CommandParameter="S"
                                Style="{StaticResource SelectionButtonStyle}">
                                <StackPanel>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="{StaticResource FontHeader}"
                                        FontWeight="Black"
                                        Text="S"/>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="{StaticResource FontCaption}"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource TextSecondary}"
                                        Text="8 oz"/>
                                </StackPanel>
                            </Button>
                            <Button
                                Grid.Column="1"
                                Margin="4,0,4,0"
                                HorizontalAlignment="Stretch"
                                Background="{Binding Size, Converter={StaticResource SizeSelectedBackgroundConverter}, ConverterParameter=M}"
                                BorderBrush="{Binding Size, Converter={StaticResource SizeSelectedBorderConverter}, ConverterParameter=M}"
                                Command="{Binding SetSizeCommand}"
                                CommandParameter="M"
                                Style="{StaticResource SelectionButtonStyle}">
                                <StackPanel>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="{StaticResource FontHeader}"
                                        FontWeight="Black"
                                        Text="M"/>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="{StaticResource FontCaption}"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource TextSecondary}"
                                        Text="12 oz"/>
                                </StackPanel>
                            </Button>
                            <Button
                                Grid.Column="2"
                                Margin="4,0,0,0"
                                HorizontalAlignment="Stretch"
                                Background="{Binding Size, Converter={StaticResource SizeSelectedBackgroundConverter}, ConverterParameter=L}"
                                BorderBrush="{Binding Size, Converter={StaticResource SizeSelectedBorderConverter}, ConverterParameter=L}"
                                Command="{Binding SetSizeCommand}"
                                CommandParameter="L"
                                Style="{StaticResource SelectionButtonStyle}">
                                <StackPanel>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="{StaticResource FontHeader}"
                                        FontWeight="Black"
                                        Text="L"/>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="{StaticResource FontCaption}"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource TextSecondary}"
                                        Text="16 oz"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!--  Sugar  -->
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel Style="{StaticResource SectionHeaderStyle}">
                                <Border
                                    Padding="6"
                                    Background="{StaticResource AccentBlueSurface}"
                                    CornerRadius="8">
                                    <FontIcon
                                        Style="{StaticResource IconBodyStyle}"
                                        Foreground="{StaticResource InfoDeep}"
                                        Glyph="&#xE93C;"/>
                                </Border>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SectionTitleStyle}"
                                    Text="SUGAR"/>
                            </StackPanel>
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="{StaticResource FontBody}"
                                FontWeight="Black"
                                Foreground="{StaticResource BrandPrimary}"
                                Text="{Binding Sugar}"/>
                        </Grid>
                        <Slider
                            Maximum="100"
                            Background="{StaticResource AccentBlueSurface}"
                            StepFrequency="50"
                            TickPlacement="None"
                            Value="{Binding Sugar, Mode=TwoWay, Converter={StaticResource StringToDoubleConverter}}"/>

                        <!--  Ice  -->
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <StackPanel Style="{StaticResource SectionHeaderStyle}">
                                    <Border
                                        Padding="6"
                                        Background="{StaticResource AccentTealSurface}"
                                        CornerRadius="8">
                                        <FontIcon
                                            Style="{StaticResource IconBodyStyle}"
                                            Foreground="{StaticResource AccentTeal}"
                                            Glyph="&#xE9F3;"/>
                                    </Border>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SectionTitleStyle}"
                                        Text="ICE"/>
                                </StackPanel>
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource FontBody}"
                                    FontWeight="Black"
                                    Foreground="{StaticResource BrandPrimary}"
                                    Text="{Binding Ice}"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,*,*,*">
                                <Button
                                    Margin="0,0,4,0"
                                    HorizontalAlignment="Stretch"
                                    Background="{Binding Ice, Converter={StaticResource IceSelectedBackgroundConverter}, ConverterParameter='No Ice'}"
                                    BorderBrush="{Binding Ice, Converter={StaticResource IceSelectedBorderConverter}, ConverterParameter='No Ice'}"
                                    Command="{Binding SetIceCommand}"
                                    CommandParameter="No Ice"
                                    Content="None"
                                    Style="{StaticResource SelectionButtonStyle}"/>
                                <Button
                                    Grid.Column="1"
                                    Margin="4,0,4,0"
                                    HorizontalAlignment="Stretch"
                                    Background="{Binding Ice, Converter={StaticResource IceSelectedBackgroundConverter}, ConverterParameter='Less Ice'}"
                                    BorderBrush="{Binding Ice, Converter={StaticResource IceSelectedBorderConverter}, ConverterParameter='Less Ice'}"
                                    Command="{Binding SetIceCommand}"
                                    CommandParameter="Less Ice"
                                    Content="Less"
                                    Style="{StaticResource SelectionButtonStyle}"/>
                                <Button
                                    Grid.Column="2"
                                    Margin="4,0,4,0"
                                    HorizontalAlignment="Stretch"
                                    Background="{Binding Ice, Converter={StaticResource IceSelectedBackgroundConverter}, ConverterParameter='Regular'}"
                                    BorderBrush="{Binding Ice, Converter={StaticResource IceSelectedBorderConverter}, ConverterParameter='Regular'}"
                                    Command="{Binding SetIceCommand}"
                                    CommandParameter="Regular"
                                    Content="Regular"
                                    Style="{StaticResource SelectionButtonStyle}"/>
                                <Button
                                    Grid.Column="3"
                                    Margin="4,0,0,0"
                                    HorizontalAlignment="Stretch"
                                    Background="{Binding Ice, Converter={StaticResource IceSelectedBackgroundConverter}, ConverterParameter='Extra Ice'}"
                                    BorderBrush="{Binding Ice, Converter={StaticResource IceSelectedBorderConverter}, ConverterParameter='Extra Ice'}"
                                    Command="{Binding SetIceCommand}"
                                    CommandParameter="Extra Ice"
                                    Content="Extra"
                                    Style="{StaticResource SelectionButtonStyle}"/>
                            </Grid>
                        </StackPanel>

                        <!--  Add-ons  -->
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,12"
                                Style="{StaticResource SectionTitleStyle}"
                                Text="ADD-ONS (+$0.75 EACH)"/>
                            <ItemsRepeater ItemsSource="{Binding AvailableAddOns}">
                                <ItemsRepeater.Layout>
                                    <FlowLayout
                                        MinColumnSpacing="8"
                                        MinRowSpacing="8"
                                        Orientation="Horizontal"/>
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton
                                            MinWidth="60"
                                            Padding="16,8"
                                            HorizontalAlignment="Left"
                                            Command="{Binding DataContext.ToggleAddOnCommand, ElementName=BeverageOptions}"
                                            CommandParameter="{Binding}"
                                            Content="{Binding}"
                                            Style="{StaticResource AddOnToggleStyle}"/>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>

                        <!--  Notes  -->
                        <StackPanel>
                            <StackPanel Style="{StaticResource SectionHeaderStyle}">
                                <FontIcon
                                    Style="{StaticResource IconSubtitleStyle}"
                                    Foreground="{StaticResource TextMuted}"
                                    Glyph="&#xE70F;"/>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SectionTitleStyle}"
                                    Text="SPECIAL NOTES"/>
                            </StackPanel>
                            <TextBox
                                Padding="16,12"
                                Background="{StaticResource SurfaceAlt}"
                                BorderBrush="{StaticResource Gray100}"
                                BorderThickness="1"
                                CornerRadius="16"
                                PlaceholderText="E.g. Extra hot, no lid..."
                                Text="{Binding Notes, Mode=TwoWay}"/>
                        </StackPanel>
                    </StackPanel>

                    <!--  Quantity  -->
                    <Border
                        Margin="-24,0"
                        Padding="24"
                        Background="{StaticResource SurfaceAlt}"
                        BorderBrush="{StaticResource Gray100}"
                        BorderThickness="0,1">
                        <Grid>
                            <StackPanel>
                                <TextBlock
                                    FontSize="{StaticResource FontBody}"
                                    FontWeight="Black"
                                    Foreground="{StaticResource Gray900}"
                                    Text="QUANTITY"/>
                                <TextBlock
                                    FontWeight="Bold"
                                    Style="{StaticResource CaptionMutedTextStyle}"
                                    Text="ADJUST NUMBER OF ITEMS"/>
                            </StackPanel>
                            <StackPanel
                                Padding="8"
                                HorizontalAlignment="Right"
                                Background="{StaticResource SurfaceBackground}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Orientation="Horizontal"
                                Spacing="24">
                                <Button
                                    Width="40"
                                    Height="40"
                                    Padding="0"
                                    Background="{StaticResource SurfaceAlt}"
                                    BorderThickness="0"
                                    Command="{Binding UpdateQuantityCommand}"
                                    CommandParameter="-1"
                                    CornerRadius="12"
                                    Style="{StaticResource AppIconButtonStyle}">
                                    <FontIcon Style="{StaticResource IconSubtitleStyle}"
                                              Glyph="&#xE738;"/>
                                </Button>
                                <TextBlock
                                    MinWidth="24"
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource FontTitle}"
                                    FontWeight="Black"
                                    Text="{Binding Quantity}"
                                    TextAlignment="Center"/>
                                <Button
                                    Width="40"
                                    Height="40"
                                    Padding="0"
                                    Background="{StaticResource SurfaceAlt}"
                                    BorderThickness="0"
                                    Command="{Binding UpdateQuantityCommand}"
                                    CommandParameter="1"
                                    CornerRadius="12"
                                    Style="{StaticResource AppIconButtonStyle}">
                                    <FontIcon Style="{StaticResource IconSubtitleStyle}"
                                              Glyph="&#xE710;"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!--  Footer  -->
        <Border
            Grid.Row="2"
            Padding="24"
            Background="{StaticResource SurfaceBackground}"
            BorderBrush="{StaticResource Gray100}"
            BorderThickness="0,1,0,0">
            <Button
                Padding="0,18"
                HorizontalAlignment="Stretch"
                Background="{StaticResource IconSelectedBgBrush}"
                Command="{Binding ConfirmCommand}"
                CornerRadius="16"
                FontSize="{StaticResource FontSubtitle}"
                FontWeight="Black"
                Foreground="White"
                Style="{StaticResource AppPrimaryButtonStyle}">
                <StackPanel Orientation="Horizontal"
                            Spacing="12">
                    <FontIcon Style="{StaticResource IconBodyStyle}"
                              Glyph="&#xE7BF;"/>
                    <TextBlock Text="ADD TO ORDER · "/>
                    <TextBlock Text="{Binding TotalPrice, Converter={StaticResource CurrencyConverter}}"/>
                </StackPanel>
            </Button>
        </Border>
    </Grid>
</ContentDialog>
