<ContentDialog
    x:Class="MyShop.Views.Pos.Components.MembershipSelectionModal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MyShop.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MyShop.Models"
    x:Name="Root"
    MinWidth="600"
    MinHeight="500"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">600</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">800</x:Double>
        <Thickness x:Key="ContentDialogPadding">0</Thickness>
        <Thickness x:Key="ContentDialogBorderThickness">0</Thickness>

        <converters:StringFormatConverter x:Key="StringFormatConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <SolidColorBrush x:Key="Amber600" Color="#D97706" />
        <SolidColorBrush x:Key="Amber50" Color="#FFFBEB" />

        <Style
            x:Key="MembershipButtonStyle"
            BasedOn="{StaticResource DefaultButtonStyle}"
            TargetType="Button">
            <Setter Property="Padding" Value="24,12" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style
            x:Key="PrimaryMembershipButtonStyle"
            BasedOn="{StaticResource MembershipButtonStyle}"
            TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Amber600}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style
            x:Key="SecondaryMembershipButtonStyle"
            BasedOn="{StaticResource MembershipButtonStyle}"
            TargetType="Button">
            <Setter Property="Background" Value="#F3F4F6" />
            <Setter Property="Foreground" Value="#4B5563" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </ContentDialog.Resources>

    <ContentDialog.Title>
        <Grid HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon
                    FontSize="20"
                    Foreground="{StaticResource Amber600}"
                    Glyph="&#xE734;" />
                <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="Membership &amp; Loyalty" />
            </StackPanel>
        </Grid>
    </ContentDialog.Title>

    <Grid Width="500" Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Search Bar (Only visible when NOT registering)  -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,24"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="12"
            Visibility="{Binding ShowRegister, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='False'}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="16"
                    Foreground="#9CA3AF"
                    Glyph="&#xE721;" />
                <TextBox
                    x:Name="SearchBox"
                    Grid.Column="1"
                    Margin="0,2"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    PlaceholderText="Search by Name or Phone Number..." />
            </Grid>
        </Border>

        <!--  Results / Registration Form  -->
        <Grid Grid.Row="1" MinHeight="350">
            <!--  Search Results View  -->
            <Grid Visibility="{Binding ShowRegister, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='False'}">
                <!--  Members List  -->
                <ListView
                    x:Name="ResultsList"
                    Padding="0,0,0,12"
                    ItemsSource="{Binding FilteredCustomers}"
                    SelectionMode="None"
                    Visibility="{Binding FilteredCustomers, Converter={StaticResource NullToVisibilityConverter}}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:TempCustomer">
                            <Button
                                Margin="0,0,0,8"
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding ElementName=Root, Path=DataContext.SelectMemberCommand}"
                                CommandParameter="{Binding}">
                                <Border
                                    Padding="16"
                                    Background="White"
                                    BorderBrush="#F3F4F6"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Grid.Column="0"
                                            Width="40"
                                            Height="40"
                                            Margin="0,0,12,0"
                                            Background="#F3F4FB"
                                            CornerRadius="20">
                                            <FontIcon
                                                FontSize="18"
                                                Foreground="#6366F1"
                                                Glyph="&#xE77B;" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="15"
                                                FontWeight="Bold"
                                                Foreground="#111827"
                                                Text="{Binding Name}" />
                                            <TextBlock
                                                FontSize="13"
                                                Foreground="#6B7280"
                                                Text="{Binding Phone}" />
                                        </StackPanel>

                                        <Border
                                            Grid.Column="2"
                                            Padding="8,4"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource Amber50}"
                                            CornerRadius="8">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon
                                                    FontSize="12"
                                                    Foreground="{StaticResource Amber600}"
                                                    Glyph="&#xE734;" />
                                                <TextBlock
                                                    FontSize="12"
                                                    FontWeight="Bold"
                                                    Foreground="{StaticResource Amber600}"
                                                    Text="{Binding Points}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!--  Empty State  -->
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="24"
                    Visibility="{Binding FilteredCustomers, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter='Inverse'}">
                    <Border
                        Width="80"
                        Height="80"
                        Background="#F9FAFB"
                        CornerRadius="40">
                        <FontIcon
                            FontSize="32"
                            Foreground="#9CA3AF"
                            Glyph="&#xE77B;" />
                    </Border>
                    <StackPanel Spacing="8">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="#111827"
                            Text="Customer Not Found" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="14"
                            Foreground="#6B7280"
                            Text="Search by phone number to find existing members" />
                    </StackPanel>
                    <Button
                        Padding="24,12"
                        HorizontalAlignment="Center"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        Command="{Binding ToggleRegisterCommand}"
                        Content="Register New Member"
                        CornerRadius="12" />
                </StackPanel>
            </Grid>

            <!--  Registration Form View  -->
            <Grid Visibility="{Binding ShowRegister, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='True'}">
                <Border
                    Padding="32"
                    Background="White"
                    BorderBrush="#F3F4F6"
                    BorderThickness="1"
                    CornerRadius="16">
                    <StackPanel Spacing="24">
                        <StackPanel Spacing="8">
                            <TextBlock
                                FontSize="18"
                                FontWeight="Bold"
                                Foreground="#111827"
                                Text="New Member Registration" />
                            <TextBlock
                                FontSize="14"
                                Foreground="#6B7280"
                                Text="Fill in the details to create a new membership account" />
                        </StackPanel>

                        <StackPanel Spacing="16">
                            <!--  Full Name  -->
                            <StackPanel Spacing="8">
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="#374151"
                                    Text="Full Name" />
                                <TextBox
                                    Padding="12"
                                    Background="#F9FAFB"
                                    BorderBrush="#E5E7EB"
                                    CornerRadius="8"
                                    PlaceholderText="e.g. John Doe"
                                    Text="{Binding NewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <!--  Phone Number  -->
                            <StackPanel Spacing="8">
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="#374151"
                                    Text="Phone Number" />
                                <TextBox
                                    Padding="12"
                                    Background="#F9FAFB"
                                    BorderBrush="#E5E7EB"
                                    CornerRadius="8"
                                    PlaceholderText="e.g. 0901234567"
                                    Text="{Binding NewPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                HorizontalAlignment="Stretch"
                                Command="{Binding ToggleRegisterCommand}"
                                Content="Cancel"
                                Style="{StaticResource SecondaryMembershipButtonStyle}" />
                            <Button
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                HorizontalAlignment="Stretch"
                                Command="{Binding RegisterCommand}"
                                Content="Create &amp; Select"
                                Style="{StaticResource PrimaryMembershipButtonStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!--  Footer Actions  -->
        <Grid
            Grid.Row="2"
            Margin="0,24,0,0"
            Visibility="{Binding ShowRegister, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='False'}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                VerticalAlignment="Center"
                FontSize="13"
                Foreground="#6B7280"
                Text="Points will be added to selected member" />

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="12">
                <Button
                    x:Name="SkipButton"
                    Content="Skip &amp; Pay"
                    Style="{StaticResource SecondaryMembershipButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</ContentDialog>
