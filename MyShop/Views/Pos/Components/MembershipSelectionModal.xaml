<ContentDialog
    x:Class="MyShop.Views.Pos.Components.MembershipSelectionModal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MyShop.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MyShop.Models"
    x:Name="Root"
    MinWidth="600"
    MinHeight="500"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">600</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">800</x:Double>
        <Thickness x:Key="ContentDialogPadding">0</Thickness>
        <Thickness x:Key="ContentDialogBorderThickness">0</Thickness>

        <converters:StringFormatConverter x:Key="StringFormatConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <Style
            x:Key="MembershipButtonStyle"
            BasedOn="{StaticResource DefaultButtonStyle}"
            TargetType="Button">
            <Setter Property="Padding" Value="{StaticResource SpaceXLarge_Medium}" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusXLarge}" />
            <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}" />
        </Style>

        <Style
            x:Key="PrimaryMembershipButtonStyle"
            BasedOn="{StaticResource MembershipButtonStyle}"
            TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrandPrimary}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style
            x:Key="SecondaryMembershipButtonStyle"
            BasedOn="{StaticResource MembershipButtonStyle}"
            TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Gray100}" />
            <Setter Property="Foreground" Value="{StaticResource Gray500}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </ContentDialog.Resources>

    <ContentDialog.Title>
        <Grid HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon
                    Foreground="{StaticResource BrandPrimary}"
                    Glyph="&#xE734;"
                    Style="{StaticResource IconHeaderStyle}" />
                <TextBlock
                    FontSize="{StaticResource FontHeader}"
                    FontWeight="{StaticResource FontWeightSemiBold}"
                    Text="Membership &amp; Loyalty" />
            </StackPanel>
        </Grid>
    </ContentDialog.Title>

    <Grid Width="500" Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Search Bar (Only visible when NOT registering)  -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,24"
            Background="{StaticResource SurfaceBackground}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Visibility="{Binding ShowRegister, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='False'}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    HorizontalAlignment="Center"
                    Foreground="{StaticResource TextMuted}"
                    Glyph="&#xE721;"
                    Style="{StaticResource IconSubtitleStyle}" />
                <TextBox
                    x:Name="SearchBox"
                    Grid.Column="1"
                    Margin="0,2"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    PlaceholderText="Search by Name or Phone Number..."
                    Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </Border>

        <!--  Results / Registration Form  -->
        <Grid Grid.Row="1" MinHeight="350">
            <!--  Search Results View  -->
            <Grid Visibility="{Binding ShowRegister, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='False'}">
                <!--  Loading indicator  -->
                <ProgressRing
                    Width="40"
                    Height="40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsActive="{Binding IsLoading}"
                    Visibility="{Binding IsLoading, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='True'}" />

                <!--  Members List  -->
                <ListView
                    x:Name="ResultsList"
                    Padding="0,0,0,12"
                    ItemsSource="{Binding FilteredCustomers}"
                    SelectionMode="None"
                    Visibility="{Binding IsLoading, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='False'}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Customer">
                            <Button
                                Margin="0,0,0,8"
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding ElementName=Root, Path=DataContext.SelectMemberCommand}"
                                CommandParameter="{Binding}">
                                <Border
                                    Padding="16"
                                    Background="{StaticResource SurfaceBackground}"
                                    BorderBrush="{StaticResource Gray100}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMedium}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Grid.Column="0"
                                            Width="40"
                                            Height="40"
                                            Margin="0,0,12,0"
                                            Background="{StaticResource SurfaceBorderAlt}"
                                            CornerRadius="{StaticResource RadiusXLarge}">
                                            <FontIcon
                                                Foreground="{StaticResource AccentIndigo}"
                                                Glyph="&#xE77B;"
                                                Style="{StaticResource IconSubtitleStyle}" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="{StaticResource FontSubtitle}"
                                                FontWeight="Bold"
                                                Foreground="{StaticResource Gray900}"
                                                Text="{Binding Name}" />
                                            <TextBlock Style="{StaticResource BodySecondaryTextStyle}" Text="{Binding Phone}" />
                                        </StackPanel>

                                        <Border
                                            Grid.Column="2"
                                            Padding="8,4"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource WarningSurfaceSoft}"
                                            CornerRadius="{StaticResource RadiusSmall}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon
                                                    Foreground="{StaticResource BrandPrimary}"
                                                    Glyph="&#xE734;"
                                                    Style="{StaticResource IconCaptionStyle}" />
                                                <TextBlock
                                                    FontSize="{StaticResource FontCaption}"
                                                    FontWeight="Bold"
                                                    Foreground="{StaticResource BrandPrimary}"
                                                    Text="{Binding TotalAccumulatedPoints}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!--  Empty State  -->
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="24"
                    Visibility="{Binding FilteredCustomers, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter='Inverse'}">
                    <Border
                        Width="80"
                        Height="80"
                        Background="{StaticResource SurfaceAlt}"
                        CornerRadius="{StaticResource Radius2XLarge}">
                        <FontIcon
                            Foreground="{StaticResource TextMuted}"
                            Glyph="&#xE77B;"
                            Style="{StaticResource Icon2XLargeStyle}" />
                    </Border>
                    <StackPanel Spacing="8">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="{StaticResource FontHeader}"
                            FontWeight="Bold"
                            Foreground="{StaticResource Gray900}"
                            Text="Customer Not Found" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource BodySecondaryTextStyle}"
                            Text="Search by phone number to find existing members" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!--  Registration Form View  -->
            <Grid Visibility="{Binding ShowRegister, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='True'}">
                <Border
                    Padding="32"
                    Background="{StaticResource SurfaceBackground}"
                    BorderBrush="{StaticResource Gray100}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLarge}">
                    <StackPanel Spacing="24">
                        <StackPanel Spacing="8">
                            <TextBlock
                                FontSize="{StaticResource FontHeader}"
                                FontWeight="Bold"
                                Foreground="{StaticResource Gray900}"
                                Text="New Member Registration" />
                            <TextBlock Style="{StaticResource BodySecondaryTextStyle}" Text="Fill in the details to create a new membership account" />
                        </StackPanel>

                        <StackPanel Spacing="16">
                            <!--  Full Name  -->
                            <StackPanel Spacing="8">
                                <TextBlock
                                    FontSize="{StaticResource FontBody}"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource Gray700}"
                                    Text="Full Name" />
                                <TextBox
                                    Padding="12"
                                    Background="{StaticResource SurfaceAlt}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    CornerRadius="{StaticResource RadiusSmall}"
                                    PlaceholderText="e.g. John Doe"
                                    Text="{Binding NewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <!--  Phone Number  -->
                            <StackPanel Spacing="8">
                                <TextBlock
                                    FontSize="{StaticResource FontBody}"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource Gray700}"
                                    Text="Phone Number" />
                                <TextBox
                                    Padding="12"
                                    Background="{StaticResource SurfaceAlt}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    CornerRadius="{StaticResource RadiusSmall}"
                                    PlaceholderText="e.g. 0901234567"
                                    Text="{Binding NewPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                HorizontalAlignment="Stretch"
                                Command="{Binding ToggleRegisterCommand}"
                                Content="Cancel"
                                Style="{StaticResource SecondaryMembershipButtonStyle}" />
                            <Button
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                HorizontalAlignment="Stretch"
                                Command="{Binding RegisterCommand}"
                                Content="Create &amp; Select"
                                Style="{StaticResource PrimaryMembershipButtonStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!--  Footer Actions  -->
        <Grid
            Grid.Row="2"
            Margin="0,24,0,0"
            Visibility="{Binding ShowRegister, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='False'}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="12">
                <Button
                    Command="{Binding ToggleRegisterCommand}"
                    Content="Register New Member"
                    Style="{StaticResource PrimaryMembershipButtonStyle}" />
                <Button
                    x:Name="SkipButton"
                    Content="Skip &amp; Pay"
                    Style="{StaticResource SecondaryMembershipButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</ContentDialog>
