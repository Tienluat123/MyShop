<ContentDialog
    x:Class="MyShop.Views.Pos.Components.PromoSelectionModal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MyShop.Models"
    mc:Ignorable="d"
    Title="Apply Promotion"
    SecondaryButtonText="Skip"
    SecondaryButtonStyle="{StaticResource AppSecondaryButtonStyle}"
    xmlns:converters="using:MyShop.Converters"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>
        <converters:CurrencyConverter x:Key="CurrencyConverter"/>
        <converters:DateFormatter x:Key="DateFormatter"/>
        <converters:PromoTypeConverter x:Key="PromoTypeConverter"/>
        <converters:PromotionDiscountConverter x:Key="PromotionDiscountConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </ContentDialog.Resources>

    <StackPanel Spacing="20" Width="400">
        <!-- Manual Code Entry -->
        <StackPanel Spacing="8">
            <TextBlock Text="Enter Promo Code" Style="{StaticResource SubheadingStyle}"/>
            <Grid ColumnDefinitions="*, Auto">
                <TextBox x:Name="PromoCodeBox" 
                         PlaceholderText="e.g. GIAM30"
                         Text="{x:Bind ViewModel.PromoCodeEntry, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource TextBoxStyle}"/>
                <Button Grid.Column="1" 
                        Content="Validate"
                        Command="{x:Bind ViewModel.ApplyCodeCommand}"
                        Margin="8,0,0,0"
                        Style="{StaticResource AppPrimaryButtonStyle}"/>
            </Grid>
            <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                       Foreground="{StaticResource Error}"
                       FontSize="12"
                       Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"/>
        </StackPanel>

        <!-- Active Promotions List -->
        <StackPanel Spacing="12">
            <TextBlock Text="Available Promotions" Style="{StaticResource SubheadingStyle}"/>
            <ListView ItemsSource="{x:Bind ViewModel.ActivePromotions}"
                      SelectionMode="None"
                      MaxHeight="300"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Promotion">
                        <Button Click="Promo_Click" 
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,8"
                                Style="{StaticResource AppOutlineButtonStyle}"
                                Padding="16">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Bind PromoCode}" FontWeight="Bold" FontSize="16"/>
                                    <TextBlock Text="{Binding Converter={StaticResource PromotionDiscountConverter}}"
                                               Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock Text="{x:Bind MinOrderAmount, Converter={StaticResource CurrencyConverter}, ConverterParameter='Min order: {0}'}"
                                               FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock FontSize="12" Foreground="{StaticResource TextMuted}">
                                        <Run Text="For: "/>
                                        <Run Text="{x:Bind TargetAudience}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="12" Foreground="{StaticResource TextMuted}">
                                        <Run Text="Valid: "/>
                                        <Run Text="{x:Bind StartDate, Mode=OneWay, Converter={StaticResource DateFormatter}}"/>
                                        <Run Text=" - "/>
                                        <Run Text="{x:Bind EndDate, Mode=OneWay, Converter={StaticResource DateFormatter}}"/>
                                    </TextBlock>
                                </StackPanel>
                                <FontIcon Grid.Column="1" Glyph="&#xE73E;" FontSize="20" Foreground="{StaticResource BrandPrimary}"/>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </StackPanel>
</ContentDialog>
