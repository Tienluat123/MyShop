<ContentDialog
    x:Class="MyShop.Views.Pos.Components.PaymentModal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MyShop.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    MinWidth="1000"
    MinHeight="800"
    DefaultButton="Primary"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1200</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">900</x:Double>
        <Thickness x:Key="ContentDialogPadding">0</Thickness>
        <Thickness x:Key="ContentDialogBorderThickness">0</Thickness>

        <converters:CurrencyConverter x:Key="CurrencyConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <converters:EqualityToBrushConverter x:Key="EqualityToBrushConverter" />
        <converters:EqualityToBrushConverter
            x:Key="ActiveTabBackgroundConverter"
            FalseBrush="Transparent"
            TrueBrush="{StaticResource BrandPrimary}" />
        <converters:EqualityToBrushConverter
            x:Key="ActiveTabForegroundConverter"
            FalseBrush="{StaticResource Gray500}"
            TrueBrush="White" />
        <converters:EqualityToBrushConverter
            x:Key="ActiveTabBorderConverter"
            FalseBrush="{StaticResource BorderBrush}"
            TrueBrush="{StaticResource BrandPrimary}" />

        <Style x:Key="KeypadButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="{StaticResource SpaceXSmall}" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
            <Setter Property="FontSize" Value="{StaticResource FontHeader}" />
            <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="QuickAmountButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="{StaticResource SpaceLarge_Small}" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
            <Setter Property="FontSize" Value="{StaticResource FontCaption}" />
            <Setter Property="FontWeight" Value="{StaticResource FontWeightMedium}" />
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        </Style>

        <Style
            x:Key="PaymentPrimaryButtonStyle"
            BasedOn="{StaticResource AppPrimaryButtonStyle}"
            TargetType="Button">
            <Setter Property="Padding" Value="{StaticResource Space3XLarge_Large}" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
        </Style>
        <Style
            x:Key="PaymentSecondaryButtonStyle"
            BasedOn="{StaticResource AppSecondaryButtonStyle}"
            TargetType="Button">
            <Setter Property="Padding" Value="{StaticResource Space3XLarge_Large}" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
        </Style>
    </ContentDialog.Resources>

    <ContentDialog.Title>
        <Grid HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon
                    Foreground="{StaticResource BrandPrimary}"
                    Glyph="&#xE8FB;"
                    Style="{StaticResource IconHeaderStyle}" />
                <TextBlock
                    FontSize="{StaticResource FontHeader}"
                    FontWeight="{StaticResource FontWeightSemiBold}"
                    Text="Payment Checkout" />
            </StackPanel>
            <TextBlock
                Grid.Column="1"
                Margin="24,0,0,0"
                VerticalAlignment="Center"
                FontWeight="{StaticResource FontWeightMedium}"
                Style="{StaticResource SubtitleMutedTextStyle}"
                Text="{Binding OrderIdentifier}" />
        </Grid>
    </ContentDialog.Title>

    <Grid
        Width="800"
        Height="680"
        Margin="0,24,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  TOP: PAYMENT METHODS  -->
        <Grid
            Grid.Row="0"
            Margin="0,0,0,32"
            ColumnDefinitions="*,*,*">
            <Button
                Grid.Column="0"
                Height="100"
                Margin="0,0,8,0"
                Padding="16"
                HorizontalAlignment="Stretch"
                Background="{Binding PaymentMethods[0].IsSelected, Converter={StaticResource ActiveTabBackgroundConverter}, ConverterParameter=True}"
                BorderBrush="{Binding PaymentMethods[0].IsSelected, Converter={StaticResource ActiveTabBorderConverter}, ConverterParameter=True}"
                BorderThickness="2"
                Command="{Binding SelectMethodCommand}"
                CommandParameter="Cash"
                CornerRadius="16">
                <StackPanel Spacing="8">
                    <FontIcon
                        Foreground="{Binding PaymentMethods[0].IsSelected, Converter={StaticResource ActiveTabForegroundConverter}, ConverterParameter=True}"
                        Glyph="{Binding PaymentMethods[0].Glyph}"
                        Style="{StaticResource IconTitleStyle}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="{StaticResource FontSubtitle}"
                        FontWeight="Bold"
                        Foreground="{Binding PaymentMethods[0].IsSelected, Converter={StaticResource ActiveTabForegroundConverter}, ConverterParameter=True}"
                        Text="{Binding PaymentMethods[0].Label}" />
                </StackPanel>
            </Button>

            <Button
                Grid.Column="1"
                Height="100"
                Margin="4,0,4,0"
                Padding="16"
                HorizontalAlignment="Stretch"
                Background="{Binding PaymentMethods[1].IsSelected, Converter={StaticResource ActiveTabBackgroundConverter}, ConverterParameter=True}"
                BorderBrush="{Binding PaymentMethods[1].IsSelected, Converter={StaticResource ActiveTabBorderConverter}, ConverterParameter=True}"
                BorderThickness="2"
                Command="{Binding SelectMethodCommand}"
                CommandParameter="Card"
                CornerRadius="16">
                <StackPanel Spacing="8">
                    <FontIcon
                        Foreground="{Binding PaymentMethods[1].IsSelected, Converter={StaticResource ActiveTabForegroundConverter}, ConverterParameter=True}"
                        Glyph="{Binding PaymentMethods[1].Glyph}"
                        Style="{StaticResource IconTitleStyle}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="{StaticResource FontSubtitle}"
                        FontWeight="Bold"
                        Foreground="{Binding PaymentMethods[1].IsSelected, Converter={StaticResource ActiveTabForegroundConverter}, ConverterParameter=True}"
                        Text="{Binding PaymentMethods[1].Label}" />
                </StackPanel>
            </Button>

            <Button
                Grid.Column="2"
                Height="100"
                Margin="8,0,0,0"
                Padding="16"
                HorizontalAlignment="Stretch"
                Background="{Binding PaymentMethods[2].IsSelected, Converter={StaticResource ActiveTabBackgroundConverter}, ConverterParameter=True}"
                BorderBrush="{Binding PaymentMethods[2].IsSelected, Converter={StaticResource ActiveTabBorderConverter}, ConverterParameter=True}"
                BorderThickness="2"
                Command="{Binding SelectMethodCommand}"
                CommandParameter="Digital"
                CornerRadius="16">
                <StackPanel Spacing="8">
                    <FontIcon
                        Foreground="{Binding PaymentMethods[2].IsSelected, Converter={StaticResource ActiveTabForegroundConverter}, ConverterParameter=True}"
                        Glyph="{Binding PaymentMethods[2].Glyph}"
                        Style="{StaticResource IconTitleStyle}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="{StaticResource FontSubtitle}"
                        FontWeight="Bold"
                        Foreground="{Binding PaymentMethods[2].IsSelected, Converter={StaticResource ActiveTabForegroundConverter}, ConverterParameter=True}"
                        Text="{Binding PaymentMethods[2].Label}" />
                </StackPanel>
            </Button>
        </Grid>

        <!--  MIDDLE: CONTENT  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Padding="0,0,32,0"
                BorderBrush="{StaticResource Gray100}"
                BorderThickness="0,0,1,0">
                <StackPanel Spacing="24">
                    <Border
                        Padding="24"
                        Background="{StaticResource WarningSurfaceSoft}"
                        CornerRadius="{StaticResource RadiusLarge}">
                        <StackPanel Spacing="8">
                            <TextBlock
                                CharacterSpacing="100"
                                FontSize="{StaticResource FontCaption}"
                                FontWeight="Bold"
                                Foreground="{StaticResource WarningTextDark}"
                                Text="TOTAL TO PAY" />
                            <TextBlock
                                FontSize="{StaticResource FontTitle}"
                                FontWeight="Black"
                                Foreground="{StaticResource BrandPrimary}"
                                Text="{Binding Total, Converter={StaticResource CurrencyConverter}}" />
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="20"
                        Background="{StaticResource Gray100}"
                        CornerRadius="{StaticResource RadiusLarge}"
                        Visibility="{Binding Method, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='Cash'}">
                        <StackPanel Spacing="8">
                            <TextBlock
                                CharacterSpacing="50"
                                FontWeight="Bold"
                                Style="{StaticResource CaptionTextStyle}"
                                Text="CHANGE DUE" />
                            <TextBlock
                                FontSize="{StaticResource FontTitle}"
                                FontWeight="Bold"
                                Foreground="{StaticResource BrandPrimary}"
                                Text="{Binding Change, Converter={StaticResource CurrencyConverter}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Padding="32,0,0,0">
                <!--  CASH  -->
                <Grid Visibility="{Binding Method, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='Cash'}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="16">
                        <TextBlock
                            FontSize="{StaticResource FontSubtitle}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource Gray700}"
                            Text="Enter Cash Amount" />
                        <Border
                            Padding="20"
                            Background="{StaticResource SurfaceBackground}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="2"
                            CornerRadius="{StaticResource RadiusLarge}">
                            <StackPanel
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="12">
                                <TextBlock
                                    FontSize="{StaticResource FontTitle}"
                                    FontWeight="Black"
                                    Foreground="{StaticResource TextPrimary}"
                                    Text="{Binding CashInput}" />
                                <TextBlock
                                    FontSize="{StaticResource FontTitle}"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource TextMuted}"
                                    Text="₫" />
                            </StackPanel>
                        </Border>

                        <WrapPanel HorizontalAlignment="Center">
                            <Button
                                Margin="6"
                                Command="{Binding AddQuickAmountCommand}"
                                CommandParameter="1000.0"
                                Content="+1.000₫"
                                Style="{StaticResource QuickAmountButtonStyle}" />
                            <Button
                                Margin="6"
                                Command="{Binding AddQuickAmountCommand}"
                                CommandParameter="2000.0"
                                Content="+2.000₫"
                                Style="{StaticResource QuickAmountButtonStyle}" />
                            <Button
                                Margin="6"
                                Command="{Binding AddQuickAmountCommand}"
                                CommandParameter="5000.0"
                                Content="+5.000₫"
                                Style="{StaticResource QuickAmountButtonStyle}" />
                            <Button
                                Margin="6"
                                Command="{Binding AddQuickAmountCommand}"
                                CommandParameter="10000.0"
                                Content="+10.000₫"
                                Style="{StaticResource QuickAmountButtonStyle}" />
                            <Button
                                Margin="6"
                                Command="{Binding AddQuickAmountCommand}"
                                CommandParameter="20000.0"
                                Content="+20.000₫"
                                Style="{StaticResource QuickAmountButtonStyle}" />
                            <Button
                                Margin="6"
                                Command="{Binding AddQuickAmountCommand}"
                                CommandParameter="50000.0"
                                Content="+50.000₫"
                                Style="{StaticResource QuickAmountButtonStyle}" />
                            <Button
                                Margin="6"
                                Command="{Binding AddQuickAmountCommand}"
                                CommandParameter="100000.0"
                                Content="+100.000₫"
                                Style="{StaticResource QuickAmountButtonStyle}" />
                            <Button
                                Margin="6"
                                Command="{Binding AddQuickAmountCommand}"
                                CommandParameter="200000.0"
                                Content="+200.000₫"
                                Style="{StaticResource QuickAmountButtonStyle}" />
                            <Button
                                Margin="6"
                                Command="{Binding AddQuickAmountCommand}"
                                CommandParameter="500000.0"
                                Content="+500.000₫"
                                Style="{StaticResource QuickAmountButtonStyle}" />
                        </WrapPanel>
                    </StackPanel>

                    <Grid
                        Grid.Row="1"
                        Margin="0,32,0,0"
                        ColumnDefinitions="*,*,*"
                        RowDefinitions="*,*,*,*">
                        <Button
                            Grid.Row="0"
                            Grid.Column="0"
                            Command="{Binding HandleKeypadCommand}"
                            CommandParameter="1"
                            Content="1"
                            Style="{StaticResource KeypadButtonStyle}" />
                        <Button
                            Grid.Row="0"
                            Grid.Column="1"
                            Command="{Binding HandleKeypadCommand}"
                            CommandParameter="2"
                            Content="2"
                            Style="{StaticResource KeypadButtonStyle}" />
                        <Button
                            Grid.Row="0"
                            Grid.Column="2"
                            Command="{Binding HandleKeypadCommand}"
                            CommandParameter="3"
                            Content="3"
                            Style="{StaticResource KeypadButtonStyle}" />

                        <Button
                            Grid.Row="1"
                            Grid.Column="0"
                            Command="{Binding HandleKeypadCommand}"
                            CommandParameter="4"
                            Content="4"
                            Style="{StaticResource KeypadButtonStyle}" />
                        <Button
                            Grid.Row="1"
                            Grid.Column="1"
                            Command="{Binding HandleKeypadCommand}"
                            CommandParameter="5"
                            Content="5"
                            Style="{StaticResource KeypadButtonStyle}" />
                        <Button
                            Grid.Row="1"
                            Grid.Column="2"
                            Command="{Binding HandleKeypadCommand}"
                            CommandParameter="6"
                            Content="6"
                            Style="{StaticResource KeypadButtonStyle}" />

                        <Button
                            Grid.Row="2"
                            Grid.Column="0"
                            Command="{Binding HandleKeypadCommand}"
                            CommandParameter="7"
                            Content="7"
                            Style="{StaticResource KeypadButtonStyle}" />
                        <Button
                            Grid.Row="2"
                            Grid.Column="1"
                            Command="{Binding HandleKeypadCommand}"
                            CommandParameter="8"
                            Content="8"
                            Style="{StaticResource KeypadButtonStyle}" />
                        <Button
                            Grid.Row="2"
                            Grid.Column="2"
                            Command="{Binding HandleKeypadCommand}"
                            CommandParameter="9"
                            Content="9"
                            Style="{StaticResource KeypadButtonStyle}" />

                        <Button
                            Grid.Row="3"
                            Grid.Column="1"
                            Command="{Binding HandleKeypadCommand}"
                            CommandParameter="0"
                            Content="0"
                            Style="{StaticResource KeypadButtonStyle}" />
                        <Button
                            Grid.Row="3"
                            Grid.Column="2"
                            Background="{StaticResource ErrorSurfaceSoft}"
                            Command="{Binding HandleKeypadCommand}"
                            CommandParameter="C"
                            Content="C"
                            Foreground="{StaticResource Error}"
                            Style="{StaticResource KeypadButtonStyle}" />
                    </Grid>
                </Grid>

                <!--  CARD  -->
                <Grid Visibility="{Binding Method, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='Card'}">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="24">
                        <Border
                            Width="120"
                            Height="120"
                            Background="{StaticResource SurfaceAlt}"
                            CornerRadius="{StaticResource Radius2XLarge}">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource TextMuted}"
                                Glyph="{Binding PaymentMethods[1].Glyph}"
                                Style="{StaticResource Icon3XLargeStyle}" />
                        </Border>
                        <StackPanel Spacing="8">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontWeight="Bold"
                                Style="{StaticResource SubtitleTextStyle}"
                                Text="Ready for Card Payment" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource SubtitleSecondaryTextStyle}"
                                Text="Insert, swipe, or tap your card on the terminal" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!--  DIGITAL  -->
                <Grid Visibility="{Binding Method, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='Digital'}">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="24">
                        <Border
                            Padding="20"
                            Background="{StaticResource SurfaceBackground}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="20">
                            <FontIcon
                                FontSize="120"
                                Foreground="{StaticResource Gray900}"
                                Glyph="{Binding PaymentMethods[2].Glyph}" />
                        </Border>
                        <StackPanel Spacing="8">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontWeight="Bold"
                                Style="{StaticResource SubtitleTextStyle}"
                                Text="Scan QR to Pay" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource SubtitleSecondaryTextStyle}"
                                Text="Present this QR code to the customer terminal" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!--  BOTTOM: ACTIONS  -->
        <StackPanel
            Grid.Row="2"
            Margin="0,32,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="12">
            <Button
                Click="CloseButton_Click"
                Content="Back to Order"
                Style="{StaticResource PaymentSecondaryButtonStyle}" />
            <Button
                Command="{Binding ConfirmCommand}"
                Content="Complete Payment"
                Style="{StaticResource PaymentPrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</ContentDialog>
