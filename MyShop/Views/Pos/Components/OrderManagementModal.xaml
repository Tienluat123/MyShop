<ContentDialog
    x:Class="MyShop.Views.Pos.Components.OrderManagementModal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MyShop.Converters"
    xmlns:local="using:MyShop.Views.Pos.Components"
    xmlns:models="using:MyShop.Models"
    x:Name="ModalRoot"
    MinWidth="1000"
    MinHeight="800"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    BorderThickness="0"
    CornerRadius="{StaticResource RadiusXLarge}"
    Loaded="ContentDialog_Loaded">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1200</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">900</x:Double>
        <Thickness x:Key="ContentDialogPadding">0</Thickness>
        <Thickness x:Key="ContentDialogBorderThickness">0</Thickness>

        <converters:StatusToBrushConverter x:Key="StatusBgConverter" IsBackground="True" />
        <converters:StatusToBrushConverter x:Key="StatusFgConverter" IsBackground="False" />
        <converters:EqualityToBrushConverter
            x:Key="ActiveBgConverter"
            FalseBrush="Transparent"
            TrueBrush="White" />
        <converters:EqualityToBrushConverter
            x:Key="ActiveFgConverter"
            FalseBrush="{StaticResource TextMuted}"
            TrueBrush="{StaticResource BrandPrimary}" />
        <converters:StringFormatConverter x:Key="StringFormatConverter" />
        <converters:StatusToVisibilityConverter x:Key="StatusToVisibilityConverter" />
        <converters:TimeAgoConverter x:Key="TimeAgoConverter" />
        <converters:StatusToNextStatusTextConverter x:Key="StatusToNextStatusTextConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:EqualityToBrushConverter
            x:Key="PageButtonBackgroundConverter"
            FalseBrush="{StaticResource SurfaceAlt}"
            TrueBrush="{StaticResource BrandPrimary}" />
        <converters:EqualityToBrushConverter
            x:Key="PageButtonForegroundConverter"
            FalseBrush="{StaticResource TextBrand}"
            TrueBrush="White" />

        <Style x:Key="FilterButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="{StaticResource SpaceLarge_Small}" />
            <Setter Property="FontSize" Value="{StaticResource FontBody}" />
            <Setter Property="FontWeight" Value="{StaticResource FontWeightBold}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
        </Style>

        <Style x:Key="OrderCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource Gray100}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}" />
            <Setter Property="Padding" Value="{StaticResource SpaceXLarge}" />
            <Setter Property="Margin" Value="{StaticResource SpaceSmall}" />
        </Style>
    </ContentDialog.Resources>

    <Grid
        Width="1000"
        Height="800"
        Background="{StaticResource SurfaceAlt}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <Border
                Padding="{StaticResource SpaceXLarge_Large}"
                Background="{StaticResource SurfaceBackground}"
                BorderBrush="{StaticResource Gray100}"
                BorderThickness="0,0,0,1"
                CornerRadius="24,24,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock
                            FontSize="{StaticResource FontHeader}"
                            FontWeight="{StaticResource FontWeightBold}"
                            Text="Order Management" />
                        <TextBlock Style="{StaticResource BodyMutedTextStyle}" Text="Track and update orders" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="12">
                        <Border
                            Padding="4"
                            Background="{StaticResource Gray100}"
                            CornerRadius="{StaticResource RadiusMedium}">
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    Background="{Binding Filter, Converter={StaticResource ActiveBgConverter}, ConverterParameter='Active'}"
                                    Command="{Binding SetFilterCommand}"
                                    CommandParameter="Active"
                                    Content="{Binding ActiveCount, Converter={StaticResource StringFormatConverter}, ConverterParameter='Active ({0})'}"
                                    Foreground="{Binding Filter, Converter={StaticResource ActiveFgConverter}, ConverterParameter='Active'}"
                                    Style="{StaticResource FilterButtonStyle}" />
                                <Button
                                    Background="{Binding Filter, Converter={StaticResource ActiveBgConverter}, ConverterParameter='History'}"
                                    Command="{Binding SetFilterCommand}"
                                    CommandParameter="History"
                                    Content="{Binding HistoryCount, Converter={StaticResource StringFormatConverter}, ConverterParameter='History ({0})'}"
                                    Foreground="{Binding Filter, Converter={StaticResource ActiveFgConverter}, ConverterParameter='History'}"
                                    Style="{StaticResource FilterButtonStyle}" />
                            </StackPanel>
                        </Border>
                        <Button
                            Background="Transparent"
                            Click="CloseBtn_Click"
                            CornerRadius="{StaticResource RadiusLarge}"
                            Style="{StaticResource AppIconButtonStyle}">
                            <FontIcon Glyph="&#xE711;" Style="{StaticResource IconBodyStyle}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                Padding="24,12"
                Background="{StaticResource SurfaceBackground}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="12">
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{StaticResource TextSecondary}"
                            Style="{StaticResource SubheadingStyle}"
                            Text="Status:" />
                        <ComboBox
                            MinWidth="150"
                            MinHeight="40"
                            Background="{StaticResource SecondaryBackground}"
                            BorderThickness="1"
                            CornerRadius="6"
                            ItemsSource="{Binding StatusFilterOptions}"
                            SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="16"
                        Visibility="{Binding Filter, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='History'}">
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{StaticResource TextSecondary}"
                            Style="{StaticResource SubheadingStyle}"
                            Text="Filter by Date:" />

                        <CalendarDatePicker
                            MinHeight="40"
                            Background="{StaticResource SecondaryBackground}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Date="{Binding SearchStartDate, Mode=TwoWay}"
                            FontSize="14"
                            PlaceholderText="Start Date" />

                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{StaticResource TextTertiary}"
                            Style="{StaticResource BodyStyle}"
                            Text="-" />

                        <CalendarDatePicker
                            MinHeight="40"
                            Background="{StaticResource SecondaryBackground}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Date="{Binding SearchEndDate, Mode=TwoWay}"
                            FontSize="14"
                            PlaceholderText="End Date" />

                        <Button
                            Command="{Binding SearchByDateRangeCommand}"
                            Content="Search"
                            Style="{StaticResource PrimaryButtonStyle}" />

                        <Button
                            Command="{Binding ClearDateFilterCommand}"
                            Content="Clear"
                            Style="{StaticResource AppSecondaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <GridView
            x:Name="OrderGridView"
            Grid.Row="1"
            Padding="20"
            HorizontalAlignment="Center"
            HorizontalContentAlignment="Center"
            IsItemClickEnabled="True"
            ItemClickCommand="{Binding ViewOrderDetailCommand}"
            ItemsSource="{Binding DisplayOrders}"
            SelectionMode="None">
            <GridView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Width="400"
                        Height="300"
                        Style="{StaticResource OrderCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  Header Area  -->
                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border
                                            Padding="8,2"
                                            Background="{StaticResource WarningSurfaceSoft}"
                                            CornerRadius="6">
                                            <TextBlock
                                                FontSize="{StaticResource FontCaption}"
                                                FontWeight="Black"
                                                Foreground="{StaticResource BrandPrimary}"
                                                Text="{Binding OrderId}" />
                                        </Border>
                                        <Border
                                            Padding="8,2"
                                            Background="{Binding PaymentStatus, Converter={StaticResource StatusBgConverter}}"
                                            CornerRadius="6">
                                            <TextBlock
                                                FontSize="{StaticResource FontCaption}"
                                                FontWeight="Bold"
                                                Foreground="{Binding PaymentStatus, Converter={StaticResource StatusFgConverter}}"
                                                Text="{Binding PaymentStatus}" />
                                        </Border>
                                        <Border
                                            Padding="8,2"
                                            Background="{Binding FulfillmentStatus, Converter={StaticResource StatusBgConverter}}"
                                            CornerRadius="6">
                                            <TextBlock
                                                FontSize="{StaticResource FontCaption}"
                                                FontWeight="Bold"
                                                Foreground="{Binding FulfillmentStatus, Converter={StaticResource StatusFgConverter}}"
                                                Text="{Binding FulfillmentStatus}" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock
                                            FontWeight="Bold"
                                            Style="{StaticResource CaptionMutedTextStyle}"
                                            Text="{Binding Type}" />
                                        <TextBlock
                                            FontWeight="Bold"
                                            Style="{StaticResource CaptionMutedTextStyle}"
                                            Text="{Binding Table, Converter={StaticResource StringFormatConverter}, ConverterParameter='· Table {0}'}"
                                            Visibility="{Binding Table, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='NotNull'}" />
                                        <TextBlock
                                            Margin="8,0,0,0"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource BrandPrimary}"
                                            Style="{StaticResource CaptionTextStyle}"
                                            Text="{Binding CustomerName, Converter={StaticResource StringFormatConverter}, ConverterParameter='· {0}'}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    Visibility="{Binding DataContext.Filter, ElementName=ModalRoot, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='Active'}">
                                    <FontIcon
                                        Foreground="{StaticResource TextMuted}"
                                        Glyph="&#xE916;"
                                        Style="{StaticResource IconBodyStyle}" />
                                    <TextBlock
                                        FontWeight="Bold"
                                        Style="{StaticResource CaptionMutedTextStyle}"
                                        Text="{Binding CreatedAt, Converter={StaticResource TimeAgoConverter}}" />
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    Visibility="{Binding DataContext.Filter, ElementName=ModalRoot, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='History'}">
                                    <FontIcon
                                        Foreground="{StaticResource TextMuted}"
                                        Glyph="&#xE916;"
                                        Style="{StaticResource IconBodyStyle}" />
                                    <TextBlock
                                        FontWeight="Bold"
                                        Style="{StaticResource CaptionMutedTextStyle}"
                                        Text="{Binding CreatedAt, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0:dd/MM/yyyy HH:mm}'}" />
                                </StackPanel>
                            </Grid>

                            <!--  Items List  -->
                            <ScrollViewer
                                Grid.Row="1"
                                IsHitTestVisible="False"
                                VerticalScrollBarVisibility="Hidden">
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <TextBlock
                                                    FontSize="{StaticResource FontBody}"
                                                    FontWeight="Medium"
                                                    Foreground="{StaticResource Gray500}"
                                                    MaxLines="1"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap">
                                                    <Run Text="{Binding Product.Name}" />
                                                    <Run Foreground="{StaticResource Gray300}" Text=" x" />
                                                    <Run Foreground="{StaticResource Gray300}" Text="{Binding Quantity}" />
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!--  Footer / Actions  -->
                            <Grid Grid.Row="2" Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Left Actions (Icons) -->
                                <StackPanel
                                    Grid.Column="0"
                                    Margin="0,0,12,0"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        Width="40"
                                        Height="40"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderBrush="{StaticResource ErrorSurface}"
                                        BorderThickness="1"
                                        Command="{Binding DataContext.CancelOrderCommand, ElementName=ModalRoot}"
                                        CommandParameter="{Binding}"
                                        CornerRadius="10"
                                        Style="{StaticResource AppIconButtonStyle}"
                                        Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <FontIcon
                                            Foreground="{StaticResource Error}"
                                            Glyph="&#xE74D;"
                                            Style="{StaticResource IconCaptionStyle}" />
                                    </Button>
                                    <Button
                                        Width="40"
                                        Height="40"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderBrush="{StaticResource ErrorSurface}"
                                        BorderThickness="1"
                                        Command="{Binding DataContext.DeleteOrderCommand, ElementName=ModalRoot}"
                                        CommandParameter="{Binding}"
                                        CornerRadius="10"
                                        Style="{StaticResource AppIconButtonStyle}"
                                        Visibility="{Binding CanDeleteFromHistory, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <FontIcon
                                            Foreground="{StaticResource Error}"
                                            Glyph="&#xE74D;"
                                            Style="{StaticResource IconCaptionStyle}" />
                                    </Button>
                                </StackPanel>

                                <!-- Right Actions (Primary Buttons) -->
                                <StackPanel 
                                    Grid.Column="1"
                                    Orientation="Horizontal" 
                                    Spacing="6"
                                    HorizontalAlignment="Right">
                                    
                                    <!-- Refund Action -->
                                    <Button
                                        Padding="12,8"
                                        MinWidth="100"
                                        Background="{StaticResource AccentPurpleSurface}"
                                        BorderBrush="{StaticResource AccentPurpleBorder}"
                                        BorderThickness="1"
                                        Command="{Binding DataContext.RefundOrderCommand, ElementName=ModalRoot}"
                                        CommandParameter="{Binding}"
                                        CornerRadius="10"
                                        Style="{StaticResource AppOutlineButtonStyle}"
                                        Visibility="{Binding PaymentStatus, Converter={StaticResource StatusToVisibilityConverter}, ConverterParameter='Refund'}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE777;" FontSize="14" Foreground="{StaticResource AccentPurple}" />
                                            <TextBlock
                                                FontSize="{StaticResource FontCaption}"
                                                FontWeight="Bold"
                                                Foreground="{StaticResource AccentPurple}"
                                                Text="REFUND" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Next Fulfillment Stage Action -->
                                    <Button
                                        Padding="12,8"
                                        MinWidth="140"
                                        Background="{StaticResource SurfaceAlt}"
                                        BorderBrush="{StaticResource Gray100}"
                                        BorderThickness="1"
                                        Command="{Binding DataContext.UpdateOrderStatusCommand, ElementName=ModalRoot}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding IsFulfillmentActionEnabled}"
                                        CornerRadius="10"
                                        Style="{StaticResource AppOutlineButtonStyle}"
                                        Visibility="{Binding CanUpdateFulfillment, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock
                                                FontSize="{StaticResource FontCaption}"
                                                FontWeight="Bold"
                                                Text="{Binding FulfillmentStatus, Converter={StaticResource StatusToNextStatusTextConverter}}" />
                                            <FontIcon Glyph="&#xE76C;" FontSize="14" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <Border
            Grid.Row="2"
            Padding="24,16"
            Background="{StaticResource SurfaceBackground}"
            BorderBrush="{StaticResource Gray100}"
            BorderThickness="0,1,0,0"
            CornerRadius="0,0,24,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="#64748B"
                    Text="{Binding PagingSummary}" />

                <StackPanel
                    Grid.Column="1"
                    Margin="0,0,16,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        Width="36"
                        Height="36"
                        Background="{StaticResource SurfaceAlt}"
                        BorderBrush="{StaticResource Gray100}"
                        Command="{Binding PreviousPageCommand}"
                        CornerRadius="8">
                        <FontIcon
                            FontSize="12"
                            Foreground="{StaticResource TextMuted}"
                            Glyph="&#xE76B;" />
                    </Button>
                    <ItemsControl ItemsSource="{Binding PageNumbers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:PageNumberItem">
                                <Button
                                    Width="36"
                                    Height="36"
                                    Background="{Binding IsActive, Converter={StaticResource PageButtonBackgroundConverter}, ConverterParameter=True}"
                                    BorderBrush="{StaticResource Gray100}"
                                    Command="{Binding DataContext.GoToPageCommand, ElementName=ModalRoot}"
                                    CommandParameter="{Binding PageNumber}"
                                    Content="{Binding PageNumber}"
                                    CornerRadius="8"
                                    Foreground="{Binding IsActive, Converter={StaticResource PageButtonForegroundConverter}, ConverterParameter=True}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button
                        Width="36"
                        Height="36"
                        Background="{StaticResource SurfaceAlt}"
                        BorderBrush="{StaticResource Gray100}"
                        Command="{Binding NextPageCommand}"
                        CornerRadius="8">
                        <FontIcon
                            FontSize="12"
                            Foreground="{StaticResource TextMuted}"
                            Glyph="&#xE76C;" />
                    </Button>
                </StackPanel>

            </Grid>
        </Border>

        <!--  Nested Inner Modal for Order Details  -->
        <local:OrderDetailModal
            Grid.Row="1"
            Grid.RowSpan="2"
            Canvas.ZIndex="100"
            Visibility="{Binding IsOrderDetailOpen, Mode=OneWay}" />
    </Grid>
</ContentDialog>
