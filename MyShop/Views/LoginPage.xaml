<Page
    x:Class="MyShop.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:MyShop.Converters"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:BoolToPasswordRevealModeConverter x:Key="BoolToPasswordRevealModeConverter"/>
        <converters:BoolToSymbolConverter x:Key="BoolToSymbolConverter"/>
    </Page.Resources>

    <Grid x:Name="RootGrid">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ResponsiveStates">
                <VisualState x:Name="MobileState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LeftPanel.Visibility" Value="Collapsed"/>
                        <Setter Target="LoginColumns.(Grid.ColumnDefinitions)[0].Width" Value="0*"/>
                        <Setter Target="LoginColumns.(Grid.ColumnDefinitions)[1].Width" Value="*"/>
                        <Setter Target="RightPanel.(Grid.Column)" Value="1"/>
                        <Setter Target="RightPanel.(Grid.ColumnSpan)" Value="1"/>
                        <Setter Target="FormStackPanel.Width" Value="NaN"/>
                        <Setter Target="PageTitle.FontSize" Value="24"/>
                        <Setter Target="SubtitleText.FontSize" Value="13"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="TabletState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="768"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LeftPanel.Visibility" Value="Collapsed"/>
                        <Setter Target="LoginColumns.(Grid.ColumnDefinitions)[0].Width" Value="0*"/>
                        <Setter Target="LoginColumns.(Grid.ColumnDefinitions)[1].Width" Value="*"/>
                        <Setter Target="RightPanel.(Grid.Column)" Value="1"/>
                        <Setter Target="RightPanel.(Grid.ColumnSpan)" Value="1"/>
                        <Setter Target="FormStackPanel.Width" Value="NaN"/>
                        <Setter Target="PageTitle.FontSize" Value="26"/>
                        <Setter Target="SubtitleText.FontSize" Value="13"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="DesktopState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1200"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LeftPanel.Visibility" Value="Visible"/>
                        <Setter Target="LoginColumns.(Grid.ColumnDefinitions)[0].Width" Value="2*"/>
                        <Setter Target="LoginColumns.(Grid.ColumnDefinitions)[1].Width" Value="3*"/>
                        <Setter Target="RightPanel.(Grid.Column)" Value="1"/>
                        <Setter Target="RightPanel.(Grid.ColumnSpan)" Value="1"/>
                        <Setter Target="FormStackPanel.Width" Value="360"/>
                        <Setter Target="PageTitle.FontSize" Value="30"/>
                        <Setter Target="SubtitleText.FontSize" Value="13"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ColumnDefinitions x:Name="LoginColumns">
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" x:Name="LeftPanel">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FDBA74" Offset="0.0"/>
                    <GradientStop Color="#F97316" Offset="0.5"/>
                    <GradientStop Color="#EA580C" Offset="1.0"/>
                </LinearGradientBrush>
            </Grid.Background>

            <Ellipse
                Width="320" Height="320"
                Margin="-100,80,0,0"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Opacity="0.45">
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FDBA74" Offset="0"/>
                        <GradientStop Color="#EA580C" Offset="1"/>
                    </LinearGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Ellipse
                Width="260" Height="260"
                Margin="0,0,-80,-80"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Opacity="0.35">
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FB923C" Offset="0"/>
                        <GradientStop Color="#C2410C" Offset="1"/>
                    </LinearGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8">
                <TextBlock
                    Text="Chào Mừng"
                    FontSize="42"
                    FontWeight="Bold"
                    Foreground="White"
                    TextWrapping="Wrap"/>
                <TextBlock
                    Text="Trở Lại!"
                    FontSize="42"
                    FontWeight="Bold"
                    Foreground="White"
                    TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1" x:Name="RightPanel" Background="White" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel
                    x:Name="FormStackPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="360"
                    Spacing="0">

                <TextBlock
                    x:Name="PageTitle"
                    Text="Đăng Nhập"
                    FontSize="30"
                    FontWeight="Bold"
                    Foreground="#1A1A2E"
                    Margin="0,0,0,6"/>

                <TextBlock
                    x:Name="SubtitleText"
                    Text="Vui lòng nhập thông tin tài khoản của bạn."
                    FontSize="13"
                    Foreground="#6B7280"
                    Margin="0,0,0,28"/>

                <TextBlock
                    Text="Tên đăng nhập"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="#374151"
                    Margin="0,0,0,6"/>

                <TextBox
                    x:Name="UsernameBox"
                    PlaceholderText="Nhập tên đăng nhập..."
                    Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    FontSize="14"
                    Padding="12,10"
                    CornerRadius="8"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1.5"
                    Margin="0,0,0,18"/>

                <TextBlock
                    Text="Mật khẩu"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="#374151"
                    Margin="0,0,0,6"/>

                <Grid Margin="0,0,0,8">
                    <PasswordBox
                        x:Name="PasswordBox"
                        PlaceholderText="Nhập mật khẩu..."
                        FontSize="14"
                        Padding="12,10,40,10"
                        CornerRadius="8"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1.5"
                        PasswordRevealMode="{Binding IsPasswordVisible, Mode=OneWay, Converter={StaticResource BoolToPasswordRevealModeConverter}}"
                        PasswordChanged="PasswordBox_PasswordChanged"/>

                    <Button
                        Command="{Binding TogglePasswordCommand}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        Width="40"
                        Margin="1,1,1,1"
                        Padding="0"
                        CornerRadius="0,8,8,0">
                        <SymbolIcon 
                            Symbol="{Binding IsPasswordVisible, Mode=OneWay, Converter={StaticResource BoolToSymbolConverter}}"
                            Foreground="#6B7280"/>
                    </Button>
                </Grid>

                <TextBlock
                    x:Name="ErrorLabel"
                    Text="{Binding ErrorMessage, Mode=OneWay}"
                    FontSize="13"
                    Foreground="#EF4444"
                    Margin="0,4,0,16"
                    TextWrapping="Wrap"
                    Visibility="{Binding ErrorMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='NotNull'}"/>

                <Button
                    x:Name="LoginBtn"
                    Content="Đăng nhập"
                    Command="{Binding LoginCommand}"
                    HorizontalAlignment="Stretch"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Padding="0,13"
                    CornerRadius="8"
                    Margin="0,0,0,0">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FB923C" Offset="0"/>
                            <GradientStop Color="#EA580C" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Foreground>
                        <SolidColorBrush Color="White"/>
                    </Button.Foreground>
                </Button>

                <Button
                    Click="ConfigDatabase_Click"
                    Background="Transparent"
                    Foreground="#6B7280"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1.5"
                    CornerRadius="8"
                    Padding="16,8"
                    HorizontalAlignment="Center"
                    Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Setting" Foreground="#6B7280" />
                        <TextBlock Text="Cấu hình Database" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <ProgressRing
                    IsActive="{Binding IsLoading, Mode=OneWay}"
                    Margin="0,14,0,0"
                    HorizontalAlignment="Center"
                    Width="32" Height="32"
                    Foreground="#EA580C"/>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
