<Page
    x:Class="MyShop.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:MyShop.Converters"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:BoolToPasswordRevealModeConverter x:Key="BoolToPasswordRevealModeConverter"/>
        <converters:BoolToSymbolConverter x:Key="BoolToSymbolConverter"/>
    </Page.Resources>

    <!-- Layout chính: 2 cột — trái trang trí, phải form -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== CỘT TRÁI: hình trang trí gradient tím =====-->
        <Grid Grid.Column="0" x:Name="LeftPanel">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F2A65A" Offset="0.0"/>
                    <GradientStop Color="#9B6FE8" Offset="0.5"/>
                    <GradientStop Color="#7B4FD4" Offset="1.0"/>
                </LinearGradientBrush>
            </Grid.Background>

            <!-- Blob trang trí (giả lập bằng Ellipse bo góc) -->
            <Ellipse
                Width="320" Height="320"
                Margin="-100,80,0,0"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Opacity="0.45">
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#C084FC" Offset="0"/>
                        <GradientStop Color="#7C3AED" Offset="1"/>
                    </LinearGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Ellipse
                Width="260" Height="260"
                Margin="0,0,-80,-80"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Opacity="0.35">
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#F97316" Offset="0"/>
                        <GradientStop Color="#EC4899" Offset="1"/>
                    </LinearGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Chữ chào mừng -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8">
                <TextBlock
                    Text="Chào Mừng"
                    FontSize="42"
                    FontWeight="Bold"
                    Foreground="White"
                    TextWrapping="Wrap"/>
                <TextBlock
                    Text="Trở Lại!"
                    FontSize="42"
                    FontWeight="Bold"
                    Foreground="White"
                    TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <!-- ===== CỘT PHẢI: Form đăng nhập ===== -->
        <Grid Grid.Column="1" Background="White">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="360"
                Spacing="0">

                <!-- Tiêu đề -->
                <TextBlock
                    Text="Đăng Nhập"
                    FontSize="30"
                    FontWeight="Bold"
                    Foreground="#1A1A2E"
                    Margin="0,0,0,6"/>

                <TextBlock
                    Text="Vui lòng nhập thông tin tài khoản của bạn."
                    FontSize="13"
                    Foreground="#6B7280"
                    Margin="0,0,0,28"/>

                <!-- Label: Tên đăng nhập -->
                <TextBlock
                    Text="Tên đăng nhập"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="#374151"
                    Margin="0,0,0,6"/>

                <!-- Input: Tên đăng nhập -->
                <TextBox
                    x:Name="UsernameBox"
                    PlaceholderText="Nhập tên đăng nhập..."
                    Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    FontSize="14"
                    Padding="12,10"
                    CornerRadius="8"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1.5"
                    Margin="0,0,0,18"/>

                <!-- Label: Mật khẩu -->
                <TextBlock
                    Text="Mật khẩu"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="#374151"
                    Margin="0,0,0,6"/>

                <!-- Input: Mật khẩu (Wrap in Grid to add Custom Reveal Button) -->
                <Grid Margin="0,0,0,8">
                    <PasswordBox
                        x:Name="PasswordBox"
                        PlaceholderText="Nhập mật khẩu..."
                        FontSize="14"
                        Padding="12,10,40,10"
                        CornerRadius="8"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1.5"
                        PasswordRevealMode="{Binding IsPasswordVisible, Mode=OneWay, Converter={StaticResource BoolToPasswordRevealModeConverter}}"
                        PasswordChanged="PasswordBox_PasswordChanged"/>

                    <!-- Nút con mắt tùy chỉnh -->
                    <Button
                        Command="{Binding TogglePasswordCommand}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        Width="40"
                        Margin="1,1,1,1"
                        Padding="0"
                        CornerRadius="0,8,8,0">
                        <SymbolIcon 
                            Symbol="{Binding IsPasswordVisible, Mode=OneWay, Converter={StaticResource BoolToSymbolConverter}}"
                            Foreground="#6B7280"/>
                    </Button>
                </Grid>

                <!-- Thông báo lỗi -->
                <TextBlock
                    x:Name="ErrorLabel"
                    Text="{Binding ErrorMessage, Mode=OneWay}"
                    FontSize="13"
                    Foreground="#EF4444"
                    Margin="0,4,0,16"
                    TextWrapping="Wrap"
                    Visibility="{Binding ErrorMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='NotNull'}"/>

                <!-- Nút Đăng nhập -->
                <Button
                    x:Name="LoginBtn"
                    Content="Đăng nhập"
                    Command="{Binding LoginCommand}"
                    HorizontalAlignment="Stretch"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Padding="0,13"
                    CornerRadius="8"
                    Margin="0,0,0,0">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#9B6FE8" Offset="0"/>
                            <GradientStop Color="#7B4FD4" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Foreground>
                        <SolidColorBrush Color="White"/>
                    </Button.Foreground>
                </Button>

                <!-- Loading indicator -->
                <ProgressRing
                    IsActive="{Binding IsLoading, Mode=OneWay}"
                    Margin="0,14,0,0"
                    HorizontalAlignment="Center"
                    Width="32" Height="32"
                    Foreground="#7B4FD4"/>

            </StackPanel>
        </Grid>
    </Grid>
</Page>
