<UserControl
    x:Class="MyShop.Views.Controls.LabeledInputControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="RootControl">

    <StackPanel Spacing="8">
        <TextBlock Text="{Binding Label, ElementName=RootControl}"
                   Foreground="#94A3B8"
                   FontSize="12"
                   FontWeight="Bold" />
        <ContentPresenter Content="{Binding InputContent, ElementName=RootControl}" />
    </StackPanel>
</UserControl>
