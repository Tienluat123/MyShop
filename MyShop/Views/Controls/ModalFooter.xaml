<UserControl x:Class="MyShop.Views.Controls.ModalFooter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Border Padding="32,32,32,24"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Background="{StaticResource SurfaceBackground}"
            CornerRadius="0,0,28,28">

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="{x:Bind CancelText}"
                    HorizontalAlignment="Stretch"
                    Padding="0,16"
                    CornerRadius="12"
                    Background="{StaticResource SurfaceHover}"
                    Foreground="{StaticResource TextPrimary}"
                    FontWeight="SemiBold"
                    Click="CancelButton_Click"/>

            <Button Grid.Column="1"
                    Content="{x:Bind SubmitText}"
                    IsEnabled="{x:Bind IsSubmitEnabled, Mode=OneWay}"
                    HorizontalAlignment="Stretch"
                    Padding="0,16"
                    CornerRadius="12"
                    Background="{StaticResource BrandPrimary}"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="SubmitButton_Click"/>
        </Grid>
    </Border>
</UserControl>