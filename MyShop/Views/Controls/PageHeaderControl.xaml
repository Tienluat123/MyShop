<UserControl
    x:Class="MyShop.Views.Controls.PageHeaderControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid ColumnSpacing="12"
          Padding="0,0,0,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Icon (optional) -->
        <Border x:Name="IconBorder"
                Grid.Column="0"
                Width="42"
                Height="42"
                Background="{StaticResource BrandPrimary}"
                CornerRadius="8"
                VerticalAlignment="Center"
                Visibility="{x:Bind Icon, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}">
            <FontIcon x:Name="IconControl"
                      Glyph="{x:Bind Icon, Mode=OneWay}"
                      Style="{StaticResource IconTitleStyle}"/>
        </Border>
        <!-- Title and Subtitle -->
        <StackPanel Grid.Column="1">
            <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                       Style="{StaticResource TitleTextStyle}"/>
            <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}"
                       Style="{StaticResource BodySecondaryTextStyle}"/>
        </StackPanel>

        <!-- Actions (optional) -->
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
            <ContentPresenter Content="{x:Bind Actions, Mode=OneWay}"/>
        </StackPanel>
    </Grid>
</UserControl>
