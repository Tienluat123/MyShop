<UserControl
    x:Class="MyShop.Views.Controls.ChatBotControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    HorizontalAlignment="Right"
    VerticalAlignment="Bottom"
    Margin="20">

    <Grid>
        <!-- Floating Action Button -->
        <Button x:Name="ChatButton" 
                Click="ChatButton_Click"
                Width="60" Height="60"
                Padding="0"
                Background="{StaticResource BrandPrimary}"
                Style="{StaticResource AccentButtonStyle}"
                CornerRadius="30">
            <FontIcon Glyph="&#xE8BD;" Foreground="White" FontSize="24"/>
        </Button>

        <!-- Chat Popup -->
        <Popup x:Name="ChatPopup" 
               IsLightDismissEnabled="False"
               HorizontalOffset="-320"
               VerticalOffset="-450">
            <Border Width="350" Height="480"
                    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="24"
                    Shadow="{StaticResource SharedShadow4}">
                <Grid RowDefinitions="Auto, *, Auto">
                    <!-- Header -->
                    <Grid Background="{ThemeResource BrandPrimary}" 
                          Padding="16,12" CornerRadius="24,24,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xEA80;" Foreground="White" FontSize="18"/>
                            <TextBlock Text="AI Business Assistant" 
                                       Foreground="White" 
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" 
                                VerticalAlignment="Center"
                                Background="Transparent" 
                                BorderThickness="0"
                                Click="CloseButton_Click">
                            <FontIcon Glyph="&#xE711;" Foreground="White" FontSize="14"/>
                        </Button>
                    </Grid>

                    <!-- Message List -->
                    <ListView Grid.Row="1" x:Name="MessageList"
                              Padding="12"
                              SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,4" 
                                        Padding="14,10"
                                        CornerRadius="16"
                                        HorizontalAlignment="{Binding HorizontalAlignment}"
                                        Background="{Binding Background}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding Content}" 
                                                   TextWrapping="Wrap"
                                                   FontSize="14"/>
                                        
                                        <!-- Confirmation Buttons (Visible only for proposals) -->
                                        <StackPanel Orientation="Horizontal" 
                                                    Spacing="8" 
                                                    Visibility="{Binding IsProposal, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Margin="0,8,0,0">
                                            <Button Content="Accept" 
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    Click="Confirm_Click"
                                                    Tag="{Binding ActionId}"/>
                                            <Button Content="Cancel" 
                                                    Click="Cancel_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Input Area -->
                    <Grid Grid.Row="2" Padding="12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                        <Grid RowDefinitions="Auto, Auto">
                            <!-- Mode Selector -->
                            <ComboBox x:Name="ModeSelector" 
                                      SelectedIndex="0"
                                      HorizontalAlignment="Stretch"
                                      Margin="0,0,0,8"
                                      CornerRadius="8"
                                      BorderThickness="1">
                                <ComboBoxItem Content="🔍 Q&amp;A &amp; Data Analysis"
                                              Tag="qa"/>
                                <ComboBoxItem Content="🎟️ Request Promotion Code"
                                              Tag="promotion"/>
                            </ComboBox>

                            <Grid Grid.Row="1" ColumnDefinitions="*, Auto">
                                <TextBox x:Name="InputBox" 
                                         PlaceholderText="Enter a message..."
                                         KeyDown="InputBox_KeyDown"
                                         AcceptsReturn="False"
                                         CornerRadius="12">
                                    <TextBox.Resources>
                                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#D97706"/>
                                    </TextBox.Resources>
                                </TextBox>
                                <Button Grid.Column="1" 
                                        Margin="8,0,0,0"
                                        Click="SendButton_Click"
                                        Background="{StaticResource BrandPrimary}"
                                        Foreground="White"
                                        Style="{StaticResource AccentButtonStyle}"
                                        CornerRadius="12">
                                    <FontIcon Glyph="&#xE724;"/>
                                </Button>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
