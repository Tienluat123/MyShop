<Page
    x:Class="MyShop.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MyShop.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:MyShop.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            HorizontalAlignment="Stretch"
            Padding="16"
            Orientation="Vertical"
            Spacing="16">
            <!--  Header  -->
            <TextBlock
                Margin="0,0,0,8"
                FontSize="24"
                FontWeight="Bold"
                Text="DASHBOARD" />

            <!--  Metric Cards  -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Sản phẩm  -->
                <Border
                    Grid.Column="0"
                    Padding="14"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="10">
                    <StackPanel Spacing="4">
                        <TextBlock
                            FontSize="14"
                            Foreground="Gray"
                            Text="Sản phẩm" />
                        <TextBlock
                            FontSize="28"
                            FontWeight="Bold"
                            Foreground="HotPink"
                            Text="{x:Bind ViewModel.ProductsCount, Mode=OneWay}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="Gray"
                            Text="Tổng số sản phẩm" />
                    </StackPanel>
                </Border>

                <!--  Doanh thu  -->
                <Border
                    Grid.Column="1"
                    Padding="14"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="10">
                    <StackPanel Spacing="4">
                        <TextBlock
                            FontSize="14"
                            Foreground="Gray"
                            Text="Doanh thu" />
                        <TextBlock
                            FontSize="28"
                            FontWeight="Bold"
                            Foreground="DodgerBlue"
                            Text="{x:Bind ViewModel.Revenue, Mode=OneWay}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="Gray"
                            Text="Tổng doanh thu (triệu)" />
                    </StackPanel>
                </Border>

                <!--  Đơn hàng  -->
                <Border
                    Grid.Column="2"
                    Padding="14"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="10">
                    <StackPanel Spacing="4">
                        <TextBlock
                            FontSize="14"
                            Foreground="Gray"
                            Text="Đơn hàng" />
                        <TextBlock
                            FontSize="28"
                            FontWeight="Bold"
                            Foreground="LimeGreen"
                            Text="{x:Bind ViewModel.OrdersCount, Mode=OneWay}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="Gray"
                            Text="Số đơn hàng" />
                    </StackPanel>
                </Border>

                <!--  Khách  -->
                <Border
                    Grid.Column="3"
                    Padding="14"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="10">
                    <StackPanel Spacing="4">
                        <TextBlock
                            FontSize="14"
                            Foreground="Gray"
                            Text="Khách" />
                        <TextBlock
                            FontSize="28"
                            FontWeight="Bold"
                            Foreground="Goldenrod"
                            Text="{x:Bind ViewModel.CustomersCount, Mode=OneWay}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="Gray"
                            Text="Khách hàng mới" />
                    </StackPanel>
                </Border>
            </Grid>

            <!--  Trends Panel  -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Sản phẩm Trend  -->
                <Border
                    Grid.Column="0"
                    Padding="12"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="10">
                    <StackPanel Spacing="8">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="Sản phẩm" />
                        <TextBlock
                            FontSize="12"
                            Foreground="Gray"
                            Text="Số lượng sản phẩm" />
                        <Border
                            Padding="8"
                            Background="#1AFF1493"
                            CornerRadius="8">
                            <!--  Background color with opacity 0x0F in original code was dynamic based on color.R,G,B  -->
                            <!--  I'll use a slightly transparent background matching the theme in code-behind or just static here  -->
                            <Canvas
                                x:Name="ProductTrendCanvas"
                                Width="300"
                                Height="200" />
                        </Border>
                    </StackPanel>
                </Border>

                <!--  Doanh thu Trend  -->
                <Border
                    Grid.Column="1"
                    Padding="12"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="10">
                    <StackPanel Spacing="8">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="Doanh thu" />
                        <TextBlock
                            FontSize="12"
                            Foreground="Gray"
                            Text="Triệu VND" />
                        <Border
                            Padding="8"
                            Background="#0F1E90FF"
                            CornerRadius="8">
                            <StackPanel
                                x:Name="RevenueTrendPanel"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Bottom"
                                Orientation="Horizontal"
                                Spacing="6" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!--  Top Products Section  -->
            <Border
                Padding="12"
                HorizontalAlignment="Left"
                MinWidth="400"
                MaxWidth="600"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel Spacing="8">
                    <TextBlock
                        FontSize="18"
                        FontWeight="Bold"
                        Text="TOP 5 sản phẩm" />
                    <ListView
                        Margin="0,8,0,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.TopProducts, Mode=OneWay}"
                        SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="MinWidth" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:DashboardViewModel+TopProduct">
                                <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1">
                                    <Grid
                                        Padding="12,10"
                                        HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            FontWeight="Medium"
                                            Text="{x:Bind Name}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right"
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Text="{x:Bind Amount}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
