<Page
    x:Class="MyShop.Views.StaffManagement.StaffSchedulePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:comps="using:MyShop.Views.StaffManagement.Components"
    Background="{StaticResource BgPage}">

    <Page.Resources>
        <Style x:Key="SegmentedTabStyle"
               TargetType="RadioButton">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="{StaticResource TextSecondary}"/>
            <Setter Property="CornerRadius"
                    Value="8"/>
            <Setter Property="Padding"
                    Value="24,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="BgBorder.Background"
                                                    Value="{StaticResource SurfaceBackground}"/>
                                            <Setter Target="BgBorder.BorderBrush"
                                                    Value="#E5E7EB"/>
                                            <Setter Target="BgBorder.BorderThickness"
                                                    Value="1"/>
                                            <Setter Target="TextPresenter.Foreground"
                                                    Value="{StaticResource TextPrimary}"/>
                                            <Setter Target="TextPresenter.FontWeight"
                                                    Value="SemiBold"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <Border x:Name="BgBorder"
                                    Background="Transparent"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Margin="2"/>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="TextPresenter"
                                                  Content="{TemplateBinding Content}"
                                                  Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal"
                    Spacing="20"
                    Margin="0,0,0,24">
            <Border Background="{StaticResource BrandPrimary}"
                    CornerRadius="8"
                    Padding="8">
                <FontIcon Glyph="&#xE716;"
                          Foreground="{StaticResource BrandPrimaryForeground}"
                          FontSize="20"/>
            </Border>
            <TextBlock Text="Quản lý nhân viên"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="{StaticResource SurfaceHover}"
                CornerRadius="10"
                Padding="4"
                HorizontalAlignment="Left"
                Margin="0,0,0,24">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TabWeekly"
                             Content="Lịch phân ca (Tuần)"
                             Style="{StaticResource SegmentedTabStyle}"
                             IsChecked="True"
                             Checked="Tab_Checked"/>

                <RadioButton x:Name="TabList"
                             Content="Danh sách nhân sự"
                             Style="{StaticResource SegmentedTabStyle}"
                             Checked="Tab_Checked"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <comps:WeeklyRosterTab x:Name="WeeklyContent"
                                   Visibility="Visible"/>
            <comps:EmployeeListTab x:Name="ListContent"
                                   Visibility="Collapsed"/>
        </Grid>

    </Grid>
</Page>