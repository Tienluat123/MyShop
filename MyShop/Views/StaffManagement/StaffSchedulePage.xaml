<Page
    x:Class="MyShop.Views.StaffManagement.StaffSchedulePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:comps="using:MyShop.Views.StaffManagement.Components"
    xmlns:controls="using:MyShop.Views.Controls"
    Background="{StaticResource BgPage}">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderControl.Subtitle"
                                Value=""/>
                        <Setter Target="BtnWeekly.Padding"
                                Value="8,6"/>
                        <Setter Target="BtnList.Padding"
                                Value="8,6"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource BreakpointTablet}"/>
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="18,14"
                Background="{StaticResource SurfaceBackground}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <controls:PageHeaderControl x:Name="HeaderControl"
                                            Title="Staff Management"
                                            Subtitle="Manage your staff schedules and information"
                                            Icon="&#xE8A4;"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Button x:Name="BtnWeekly"
                            Click="NavButton_Click"
                            Tag="weekly"
                            Background="#D97706"
                            Foreground="White"
                            BorderBrush="#D97706"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,8"
                            FontSize="14"
                            FontWeight="SemiBold">
                        Weekly Roster
                    </Button>

                    <Button x:Name="BtnList"
                            Click="NavButton_Click"
                            Tag="list"
                            Background="Transparent"
                            Foreground="#374151"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,8"
                            FontSize="14">
                        Employee List
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <comps:WeeklyRosterTab x:Name="WeeklyContent"
                                   Visibility="Visible"/>

            <comps:EmployeeListTab x:Name="ListContent"
                                   Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Page>