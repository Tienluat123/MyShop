<Page
    x:Class="MyShop.Views.StaffManagement.StaffSchedulePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:comps="using:MyShop.Views.StaffManagement.Components"
    xmlns:controls="using:MyShop.Views.Controls"
    Background="{StaticResource BgPage}">

    <Page.Resources>
        <Style x:Key="SegmentedTabStyle"
               TargetType="RadioButton">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="{StaticResource TextSecondary}"/>

            <Setter Property="CornerRadius"
                    Value="{StaticResource RadiusSmall}"/>
            <Setter Property="Padding"
                    Value="{StaticResource SpaceXLarge_Small}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="BgBorder.Background"
                                                    Value="{StaticResource SurfaceBackground}"/>
                                            <Setter Target="BgBorder.BorderBrush"
                                                    Value="{StaticResource BorderBrush}"/>
                                            <Setter Target="BgBorder.BorderThickness"
                                                    Value="1"/>
                                            <Setter Target="TextPresenter.Foreground"
                                                    Value="{StaticResource TextPrimary}"/>
                                            <Setter Target="TextPresenter.FontWeight"
                                                    Value="{StaticResource FontWeightSemiBold}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <Border x:Name="BgBorder"
                                    Background="Transparent"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Margin="2"/>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="TextPresenter"
                                                  Content="{TemplateBinding Content}"
                                                  Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:PageHeaderControl Title="Staff Management"
                                    Subtitle="Manage your staff and their work schedules"
                                    Icon="&#xE8A4;"/>

        <Border Grid.Row="1"
                Background="{StaticResource SurfaceHover}"
                CornerRadius="{StaticResource RadiusMedium}"
                Padding="{StaticResource SpaceXSmall}"
                HorizontalAlignment="Left"
                Margin="0,0,0,24">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TabWeekly"
                             Content="Weekly Schedule"
                             Style="{StaticResource SegmentedTabStyle}"
                             IsChecked="True"
                             Checked="Tab_Checked"/>

                <RadioButton x:Name="TabList"
                             Content="Staff List"
                             Style="{StaticResource SegmentedTabStyle}"
                             Checked="Tab_Checked"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <comps:WeeklyRosterTab x:Name="WeeklyContent"
                                   Visibility="Visible"/>
            <comps:EmployeeListTab x:Name="ListContent"
                                   Visibility="Collapsed"/>
        </Grid>

    </Grid>
</Page>