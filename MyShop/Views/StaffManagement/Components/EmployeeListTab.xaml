<UserControl
    x:Class="MyShop.Views.StaffManagement.Components.EmployeeListTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:comps="using:MyShop.Views.StaffManagement.Components"
    xmlns:viewModels="using:MyShop.ViewModels">

    <UserControl.Resources>
        <DataTemplate x:Key="EmployeeCardTemplate"
                      x:DataType="viewModels:EmployeeListItem">
            <Border Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusSmall}"
                    Padding="16"
                    Margin="0,0,0,12">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Avatar -->
                    <PersonPicture Grid.Column="0"
                                   Initials="{Binding Initials}"
                                   Width="{StaticResource Size3XLarge}"
                                   Height="{StaticResource Size3XLarge}"
                                   VerticalAlignment="Center"/>

                    <!-- Employee Info -->
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="8">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="12">
                            <TextBlock Text="{Binding Name}"
                                       Style="{StaticResource BodyTextStyle}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"/>
                            <Border Background="{StaticResource ErrorStrong}"
                                    CornerRadius="6"
                                    Padding="8,4"
                                    Visibility="{Binding Position, Converter={StaticResource StringToVisibilityConverter}}">
                                <TextBlock Text="{Binding Position}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="White"/>
                            </Border>
                            <Border Background="{StaticResource SuccessStrong}"
                                    CornerRadius="6"
                                    Padding="8,4"
                                    Visibility="{Binding Status, Converter={StaticResource StringToVisibilityConverter}}">
                                <TextBlock Text="{Binding Status}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="White"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="16">
                            <TextBlock Style="{StaticResource CaptionTextStyle}"
                                       Foreground="{StaticResource TextSecondary}">
                                <Run Text="ID: "/><Run Text="{Binding Code}"/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource CaptionTextStyle}"
                                       Foreground="{StaticResource TextSecondary}">
                                <Run Text="Phone: "/><Run Text="{Binding Phone}"/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource CaptionTextStyle}"
                                       Foreground="{StaticResource TextSecondary}"
                                       Visibility="{Binding ShiftCount, Converter={StaticResource StringToVisibilityConverter}}">
                                <Run Text="Shifts: "/><Run Text="{Binding ShiftCount}"/><Run Text=" shift"/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource CaptionTextStyle}"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontStyle="Italic"
                                       Visibility="{Binding ShiftCount, Converter={StaticResource StringToVisibilityConverter}}">
                                <Run Text="Not assigned"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <!-- Schedule Button -->
                    <Button Grid.Column="2"
                            Content="{Binding ScheduleButtonText}"
                            Background="{StaticResource SurfaceHover}"
                            Foreground="{StaticResource TextPrimary}"
                            CornerRadius="{StaticResource RadiusMedium}"
                            Padding="{StaticResource SpaceMedium_Small}"
                            FontWeight="{StaticResource FontWeightSemiBold}"
                            BorderThickness="0"
                            Style="{StaticResource AppGhostButtonStyle}"
                            VerticalAlignment="Center">
                        <Button.Flyout>
                            <Flyout>
                                <comps:EmployeeScheduleFlyout/>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!-- Actions -->
                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <Button Background="Transparent"
                                BorderThickness="0"
                                Padding="8"
                                CornerRadius="{StaticResource RadiusSmall}"
                                ToolTipService.ToolTip="Edit"
                                Tag="{Binding}"
                                Click="EditEmployee_Click"
                                Style="{StaticResource AppIconButtonStyle}">
                            <FontIcon Glyph="&#xE70F;"
                                      Foreground="{StaticResource InfoStrong}"
                                      Style="{StaticResource IconBodyStyle}"/>
                        </Button>
                        <Button Background="Transparent"
                                BorderThickness="0"
                                Padding="8"
                                CornerRadius="{StaticResource RadiusSmall}"
                                ToolTipService.ToolTip="Lock Account"
                                Style="{StaticResource AppIconButtonStyle}">
                            <FontIcon Glyph="&#xE72E;"
                                      Foreground="{StaticResource ErrorStrong}"
                                      Style="{StaticResource IconBodyStyle}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="0,16,0,0"
          Background="{StaticResource SurfaceBackground}"
          CornerRadius="{StaticResource RadiusMedium}"
          BorderBrush="{StaticResource BorderBrush}"
          BorderThickness="1"
          Padding="{StaticResource SpaceXLarge}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Button Content="+ Add Employee"
                    Height="{StaticResource Size40}"
                    Background="{StaticResource BrandPrimary}"
                    Foreground="{StaticResource BrandPrimaryForeground}"
                    Padding="{StaticResource SpaceMedium}"
                    FontSize="{StaticResource FontBody}"
                    BorderThickness="0"
                    CornerRadius="{StaticResource RadiusSmall}"
                    FontWeight="{StaticResource FontWeightSemiBold}"
                    VerticalAlignment="Center"
                    Style="{StaticResource AppPrimaryButtonStyle}"
                    Click="AddEmployee_Click"/>

            <ComboBox Grid.Column="1"
                      Margin="16,0,0,0"
                      Width="180"
                      Height="{StaticResource Size40}"
                      Padding="{StaticResource SpaceMedium}"
                      PlaceholderText="Filter by position"
                      CornerRadius="{StaticResource RadiusSmall}"
                      VerticalAlignment="Center"/>

            <Grid Grid.Column="3"
                  Margin="12,0,0,0"
                  Height="{StaticResource Size40}">

                <TextBox x:Name="SearchTextBox"
                         PlaceholderText="Search employees..."
                         CornerRadius="{StaticResource RadiusSmall}"
                         Padding="12,8,36,8"
                         VerticalAlignment="Stretch"
                         VerticalContentAlignment="Center"
                         FontWeight="{StaticResource FontWeightSemiBold}"/>

                <FontIcon Glyph="&#xE721;"
                          Foreground="{StaticResource TextMuted}"
                          Style="{StaticResource IconBodyStyle}"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Margin="0,0,12,0"
                          IsHitTestVisible="False"/>
            </Grid>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <ItemsRepeater ItemsSource="{Binding Employees}"
                           ItemTemplate="{StaticResource EmployeeCardTemplate}"
                           Margin="0,16,0,0"/>
        </ScrollViewer>
    </Grid>

</UserControl>