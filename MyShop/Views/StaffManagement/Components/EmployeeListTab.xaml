<UserControl
    x:Class="MyShop.Views.StaffManagement.Components.EmployeeListTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:comps="using:MyShop.Views.StaffManagement.Components">

    <Grid Margin="0,16,0,0"
          Background="{StaticResource SurfaceBackground}"
          CornerRadius="{StaticResource RadiusMedium}"
          BorderBrush="{StaticResource BorderBrush}"
          BorderThickness="1"
          Padding="{StaticResource SpaceXLarge}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Button Content="+ Thêm nhân viên"
                    Height="{StaticResource Size40}"
                    Background="{StaticResource BrandPrimary}"
                    Foreground="{StaticResource BrandPrimaryForeground}"
                    Padding="{StaticResource SpaceMedium}"
                    FontSize="{StaticResource FontBody}"
                    BorderThickness="0"
                    CornerRadius="{StaticResource RadiusSmall}"
                    FontWeight="{StaticResource FontWeightSemiBold}"
                    VerticalAlignment="Center"
                    Style="{StaticResource AppPrimaryButtonStyle}"
                    Click="AddEmployee_Click"/>

            <ComboBox Grid.Column="1"
                      Margin="16,0,0,0"
                      Width="180"
                      Height="{StaticResource Size40}"
                      Padding="{StaticResource SpaceMedium}"
                      PlaceholderText="Lọc theo chức vụ"
                      CornerRadius="{StaticResource RadiusSmall}"
                      VerticalAlignment="Center"/>

            <Grid Grid.Column="3"
                  Margin="12,0,0,0"
                  Height="{StaticResource Size40}">

                <TextBox PlaceholderText="Tìm kiếm nhân viên..."
                         CornerRadius="{StaticResource RadiusSmall}"
                         Padding="12,8,36,8"
                         VerticalAlignment="Stretch"
                         VerticalContentAlignment="Center"
                         FontWeight="{StaticResource FontWeightSemiBold}"/>

                <FontIcon Glyph="&#xE721;"
                          Foreground="{StaticResource TextMuted}"
                          Style="{StaticResource IconBodyStyle}"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Margin="0,0,12,0"
                          IsHitTestVisible="False"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="1"
              Background="{StaticResource SurfaceHover}"
              Padding="{StaticResource SpaceLarge_Medium}"
              CornerRadius="{StaticResource RadiusSmall}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="2.5*"/>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Mã NV"
                       Style="{StaticResource StaffHeaderLabelTextStyle}"/>
            <TextBlock Grid.Column="1"
                       Text="Họ tên"
                       Style="{StaticResource StaffHeaderLabelTextStyle}"/>
            <TextBlock Grid.Column="2"
                       Text="Liên hệ"
                       Style="{StaticResource StaffHeaderLabelTextStyle}"/>
            <TextBlock Grid.Column="3"
                       Text="Chức vụ"
                       Style="{StaticResource StaffHeaderLabelTextStyle}"/>
            <TextBlock Grid.Column="4"
                       Text="Lịch làm việc"
                       Style="{StaticResource StaffHeaderLabelTextStyle}"/>
            <TextBlock Grid.Column="5"
                       Text="Trạng thái"
                       Style="{StaticResource StaffHeaderLabelTextStyle}"/>
            <TextBlock Grid.Column="6"
                       Text="Thao tác"
                       Style="{StaticResource StaffHeaderLabelTextStyle}"
                       HorizontalAlignment="Center"/>
        </Grid>

        <StackPanel Grid.Row="2"
                    Spacing="0">

            <Grid Padding="16,16"
                  BorderBrush="{StaticResource Gray100}"
                  BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="2.5*"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="NV001"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondary}"
                           FontWeight="{StaticResource FontWeightMedium}"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="12">
                    <PersonPicture Initials="VN"
                                   Width="{StaticResource Size2XLarge}"
                                   Height="{StaticResource Size2XLarge}"/>
                    <TextBlock Text="Nguyễn Văn Nam"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimary}"
                               FontWeight="{StaticResource FontWeightSemiBold}"/>
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="0912.345.678"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondary}"/>

                <Border Grid.Column="3"
                        Style="{StaticResource StaffRoleAdminTagStyle}">
                    <TextBlock Text="Admin"
                               Foreground="{StaticResource ErrorStrong}"
                               Style="{StaticResource StaffTagTextStyle}"/>
                </Border>

                <StackPanel Grid.Column="4"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left">
                    <Button Content="Xem lịch (3 ca)"
                            Background="{StaticResource SurfaceHover}"
                            Foreground="{StaticResource TextPrimary}"
                            CornerRadius="{StaticResource RadiusLarge}"
                            Padding="{StaticResource SpaceMedium_Small}"
                            FontWeight="{StaticResource FontWeightSemiBold}"
                            BorderThickness="0"
                            Style="{StaticResource AppGhostButtonStyle}">
                        <Button.Flyout>
                            <Flyout>
                                <comps:EmployeeScheduleFlyout/>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <Border Grid.Column="5"
                        Style="{StaticResource StaffStatusActiveTagStyle}">
                    <TextBlock Text="Đang làm"
                               Foreground="{StaticResource SuccessStrong}"
                               Style="{StaticResource StaffTagTextStyle}"/>
                </Border>

                <StackPanel Grid.Column="6"
                            Orientation="Horizontal"
                            Spacing="16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Button Background="Transparent"
                            BorderThickness="0"
                            Padding="8"
                            CornerRadius="{StaticResource RadiusSmall}"
                            ToolTipService.ToolTip="Chỉnh sửa"
                            Click="EditEmployee_Click"
                            Style="{StaticResource AppIconButtonStyle}">
                        <FontIcon Glyph="&#xE70F;"
                                  Foreground="{StaticResource InfoStrong}"
                                  Style="{StaticResource IconBodyStyle}"/>
                    </Button>

                    <Button Background="Transparent"
                            BorderThickness="0"
                            Padding="8"
                            CornerRadius="{StaticResource RadiusSmall}"
                            ToolTipService.ToolTip="Khóa tài khoản"
                            Style="{StaticResource AppIconButtonStyle}">
                        <FontIcon Glyph="&#xE72E;"
                                  Foreground="{StaticResource ErrorStrong}"
                                  Style="{StaticResource IconBodyStyle}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Padding="16,16"
                  BorderBrush="{StaticResource Gray100}"
                  BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="2.5*"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="NV002"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondary}"
                           FontWeight="{StaticResource FontWeightMedium}"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="12">
                    <PersonPicture Initials="TL"
                                   Width="{StaticResource Size2XLarge}"
                                   Height="{StaticResource Size2XLarge}"/>
                    <TextBlock Text="Trần Thị Lan"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimary}"
                               FontWeight="{StaticResource FontWeightSemiBold}"/>
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="0987.654.321"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondary}"/>

                <Border Grid.Column="3"
                        Style="{StaticResource StaffRoleSalesTagStyle}">
                    <TextBlock Text="Bán hàng"
                               Foreground="{StaticResource InfoStrong}"
                               Style="{StaticResource StaffTagTextStyle}"/>
                </Border>

                <TextBlock Grid.Column="4"
                           Text="Chưa phân ca"
                           FontStyle="Italic"
                           Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center"/>

                <Border Grid.Column="5"
                        Style="{StaticResource StaffStatusActiveTagStyle}">
                    <TextBlock Text="Đang làm"
                               Foreground="{StaticResource SuccessStrong}"
                               Style="{StaticResource StaffTagTextStyle}"/>
                </Border>

                <StackPanel Grid.Column="6"
                            Orientation="Horizontal"
                            Spacing="16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Button Background="Transparent"
                            BorderThickness="0"
                            Padding="8"
                            CornerRadius="{StaticResource RadiusSmall}"
                            ToolTipService.ToolTip="Chỉnh sửa"
                            Style="{StaticResource AppIconButtonStyle}">
                        <FontIcon Glyph="&#xE70F;"
                                  Foreground="{StaticResource TextSecondary}"
                                  Style="{StaticResource IconBodyStyle}"/>
                    </Button>
                    <Button Background="Transparent"
                            BorderThickness="0"
                            Padding="8"
                            CornerRadius="{StaticResource RadiusSmall}"
                            ToolTipService.ToolTip="Khóa tài khoản"
                            Style="{StaticResource AppIconButtonStyle}">
                        <FontIcon Glyph="&#xE72E;"
                                  Foreground="{StaticResource ErrorStrong}"
                                  Style="{StaticResource IconBodyStyle}"/>
                    </Button>
                </StackPanel>
            </Grid>

        </StackPanel>
    </Grid>

</UserControl>