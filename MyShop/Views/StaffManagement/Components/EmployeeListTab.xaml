<UserControl
    x:Class="MyShop.Views.StaffManagement.Components.EmployeeListTab"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:MyShop.ViewModels.StaffManagement"
    xmlns:baseviewmodels="using:MyShop.ViewModels"
    xmlns:services="using:MyShop.Services"
    xmlns:converters="using:MyShop.Converters"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:RoleToDisplayConverter x:Key="RoleToDisplayConverter"/>
        <converters:CurrencyConverter x:Key="CurrencyConverter"/>
        <converters:SortIndicatorConverter x:Key="SortIndicatorConverter"/>

        <!-- Style for sort header buttons - keeps color consistent on press/hover -->
        <Style x:Key="SortHeaderButtonStyle"
                TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="Gray"/>
            <Setter Property="Padding"
                    Value="0"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="HorizontalAlignment"
                    Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
          <Grid x:Name="RootGrid"
              Padding="0"
              Background="#F5F5F5">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="EmployeeListResponsiveStates">
                <VisualState x:Name="EmployeeListMobileState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SummaryGrid.ColumnSpacing" Value="12"/>
                        <Setter Target="SummaryGrid.RowSpacing" Value="12"/>
                        <Setter Target="SummaryGrid.(Grid.ColumnDefinitions)[0].Width" Value="*"/>
                        <Setter Target="SummaryGrid.(Grid.ColumnDefinitions)[1].Width" Value="0"/>
                        <Setter Target="SummaryGrid.(Grid.ColumnDefinitions)[2].Width" Value="0"/>
                        <Setter Target="PayrollCard.(Grid.Row)" Value="0"/>
                        <Setter Target="PayrollCard.(Grid.Column)" Value="0"/>
                        <Setter Target="ActiveCard.(Grid.Row)" Value="1"/>
                        <Setter Target="ActiveCard.(Grid.Column)" Value="0"/>
                        <Setter Target="TopPerformerCard.(Grid.Row)" Value="2"/>
                        <Setter Target="TopPerformerCard.(Grid.Column)" Value="0"/>
                        <Setter Target="ActionBarGrid.ColumnSpacing" Value="12"/>
                        <Setter Target="ActionBarGrid.RowSpacing" Value="12"/>
                        <Setter Target="SearchBorder.(Grid.Row)" Value="0"/>
                        <Setter Target="SearchBorder.(Grid.Column)" Value="0"/>
                        <Setter Target="SearchBorder.(Grid.ColumnSpan)" Value="4"/>
                        <Setter Target="SearchBorder.Width" Value="Auto"/>
                        <Setter Target="SearchBorder.HorizontalAlignment" Value="Stretch"/>
                        <Setter Target="FilterStack.Orientation" Value="Vertical"/>
                        <Setter Target="FilterStack.Spacing" Value="12"/>
                        <Setter Target="FilterStack.(Grid.Row)" Value="1"/>
                        <Setter Target="FilterStack.(Grid.Column)" Value="0"/>
                        <Setter Target="FilterStack.(Grid.ColumnSpan)" Value="4"/>
                        <Setter Target="AddEmployeeButton.(Grid.Row)" Value="2"/>
                        <Setter Target="AddEmployeeButton.(Grid.Column)" Value="0"/>
                        <Setter Target="AddEmployeeButton.(Grid.ColumnSpan)" Value="4"/>
                        <Setter Target="AddEmployeeButton.HorizontalAlignment" Value="Stretch"/>
                        <Setter Target="TableScroll.Padding" Value="8,0"/>
                        <Setter Target="TableStackPanel.MinWidth" Value="980"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="EmployeeListTabletState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource BreakpointTablet}"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SummaryGrid.ColumnSpacing" Value="16"/>
                        <Setter Target="SummaryGrid.RowSpacing" Value="12"/>
                        <Setter Target="SummaryGrid.(Grid.ColumnDefinitions)[0].Width" Value="*"/>
                        <Setter Target="SummaryGrid.(Grid.ColumnDefinitions)[1].Width" Value="*"/>
                        <Setter Target="SummaryGrid.(Grid.ColumnDefinitions)[2].Width" Value="0"/>
                        <Setter Target="PayrollCard.(Grid.Row)" Value="0"/>
                        <Setter Target="PayrollCard.(Grid.Column)" Value="0"/>
                        <Setter Target="ActiveCard.(Grid.Row)" Value="0"/>
                        <Setter Target="ActiveCard.(Grid.Column)" Value="1"/>
                        <Setter Target="TopPerformerCard.(Grid.Row)" Value="1"/>
                        <Setter Target="TopPerformerCard.(Grid.Column)" Value="0"/>
                        <Setter Target="TopPerformerCard.(Grid.ColumnSpan)" Value="2"/>
                        <Setter Target="ActionBarGrid.ColumnSpacing" Value="16"/>
                        <Setter Target="ActionBarGrid.RowSpacing" Value="0"/>
                        <Setter Target="SearchBorder.(Grid.Row)" Value="0"/>
                        <Setter Target="SearchBorder.(Grid.Column)" Value="0"/>
                        <Setter Target="SearchBorder.(Grid.ColumnSpan)" Value="1"/>
                        <Setter Target="SearchBorder.Width" Value="260"/>
                        <Setter Target="SearchBorder.HorizontalAlignment" Value="Left"/>
                        <Setter Target="FilterStack.Orientation" Value="Horizontal"/>
                        <Setter Target="FilterStack.Spacing" Value="8"/>
                        <Setter Target="FilterStack.(Grid.Row)" Value="0"/>
                        <Setter Target="FilterStack.(Grid.Column)" Value="1"/>
                        <Setter Target="FilterStack.(Grid.ColumnSpan)" Value="2"/>
                        <Setter Target="AddEmployeeButton.(Grid.Row)" Value="0"/>
                        <Setter Target="AddEmployeeButton.(Grid.Column)" Value="3"/>
                        <Setter Target="AddEmployeeButton.(Grid.ColumnSpan)" Value="1"/>
                        <Setter Target="AddEmployeeButton.HorizontalAlignment" Value="Right"/>
                        <Setter Target="TableScroll.Padding" Value="0"/>
                        <Setter Target="TableStackPanel.MinWidth" Value="0"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="EmployeeListDesktopState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource BreakpointDesktop}"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SummaryGrid.ColumnSpacing" Value="16"/>
                        <Setter Target="SummaryGrid.RowSpacing" Value="0"/>
                        <Setter Target="SummaryGrid.(Grid.ColumnDefinitions)[0].Width" Value="*"/>
                        <Setter Target="SummaryGrid.(Grid.ColumnDefinitions)[1].Width" Value="*"/>
                        <Setter Target="SummaryGrid.(Grid.ColumnDefinitions)[2].Width" Value="*"/>
                        <Setter Target="PayrollCard.(Grid.Row)" Value="0"/>
                        <Setter Target="PayrollCard.(Grid.Column)" Value="0"/>
                        <Setter Target="ActiveCard.(Grid.Row)" Value="0"/>
                        <Setter Target="ActiveCard.(Grid.Column)" Value="1"/>
                        <Setter Target="TopPerformerCard.(Grid.Row)" Value="0"/>
                        <Setter Target="TopPerformerCard.(Grid.Column)" Value="2"/>
                        <Setter Target="TopPerformerCard.(Grid.ColumnSpan)" Value="1"/>
                        <Setter Target="ActionBarGrid.ColumnSpacing" Value="16"/>
                        <Setter Target="ActionBarGrid.RowSpacing" Value="0"/>
                        <Setter Target="SearchBorder.(Grid.Row)" Value="0"/>
                        <Setter Target="SearchBorder.(Grid.Column)" Value="0"/>
                        <Setter Target="SearchBorder.(Grid.ColumnSpan)" Value="1"/>
                        <Setter Target="SearchBorder.Width" Value="320"/>
                        <Setter Target="SearchBorder.HorizontalAlignment" Value="Left"/>
                        <Setter Target="FilterStack.Orientation" Value="Horizontal"/>
                        <Setter Target="FilterStack.Spacing" Value="8"/>
                        <Setter Target="FilterStack.(Grid.Row)" Value="0"/>
                        <Setter Target="FilterStack.(Grid.Column)" Value="1"/>
                        <Setter Target="FilterStack.(Grid.ColumnSpan)" Value="2"/>
                        <Setter Target="AddEmployeeButton.(Grid.Row)" Value="0"/>
                        <Setter Target="AddEmployeeButton.(Grid.Column)" Value="3"/>
                        <Setter Target="AddEmployeeButton.(Grid.ColumnSpan)" Value="1"/>
                        <Setter Target="AddEmployeeButton.HorizontalAlignment" Value="Right"/>
                        <Setter Target="TableScroll.Padding" Value="0"/>
                        <Setter Target="TableStackPanel.MinWidth" Value="0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="SummaryGrid"
              Grid.Row="0"
              Margin="16,12,16,8"
              ColumnSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="PayrollCard"
                    Grid.Column="0"
                    Background="White"
                    Padding="20"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="#EEEEEE">
                <StackPanel>
                    <TextBlock Text="Total Monthly Payroll"
                               FontSize="12"
                               Foreground="Gray"/>
                    <TextBlock Text="{x:Bind ViewModel.TotalPayrollDisplay, Mode=OneWay}"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="0,5,0,0"
                               Foreground="#2E7D32"/>
                </StackPanel>
            </Border>

                <Border x:Name="ActiveCard"
                    Grid.Column="1"
                    Background="White"
                    Padding="20"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="#EEEEEE">
                <StackPanel>
                    <TextBlock Text="Active Employees"
                               FontSize="12"
                               Foreground="Gray"/>
                    <TextBlock Text="{x:Bind ViewModel.ActiveStaffCount, Mode=OneWay}"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

                <Border x:Name="TopPerformerCard"
                    Grid.Column="2"
                    Background="White"
                    Padding="20"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="#EEEEEE">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Monthly Top Performer"
                                   FontSize="12"
                                   Foreground="Gray"/>
                        <TextBlock Text="{x:Bind ViewModel.TopPerformerName, Mode=OneWay}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,5,0,0"
                                   Foreground="#E67E22"/>
                        <TextBlock Text="Best effort this month"
                                   FontSize="11"
                                   Foreground="Gray"/>
                    </StackPanel>
                    <FontIcon Grid.Column="1"
                              Glyph="&#xE734;"
                              Foreground="#FFD700"
                              FontSize="24"
                              VerticalAlignment="Top"/>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Margin="16,12,16,16"
                Background="White"
                CornerRadius="12"
                BorderThickness="1"
                BorderBrush="#EEEEEE">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search and Filter Row -->
                                <Grid Grid.Row="0"
                                            x:Name="ActionBarGrid"
                                            Padding="16,16,16,12"
                                            ColumnSpacing="16"
                                            RowSpacing="0">
                                        <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                                        <Button x:Name="AddEmployeeButton"
                                                        Grid.Column="3"
                                                        Grid.Row="0"
                            Command="{x:Bind ViewModel.AddEmployeeCommand}"
                            Background="#D97706"
                            Foreground="White"
                            Height="35"
                            Padding="20,0"
                            CornerRadius="20"
                            VerticalAlignment="Center"
                            BorderThickness="0">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8">
                            <FontIcon Glyph="&#xE710;"
                                      FontSize="14"
                                      VerticalAlignment="Center"/>
                            <TextBlock Text="Add New Employee"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                        <Border x:Name="SearchBorder"
                            Grid.Column="0"
                            Grid.Row="0"
                            Width="320"
                            Height="35"
                            Background="#F0F0F0"
                            CornerRadius="20"
                            BorderThickness="1"
                            BorderBrush="Gray"
                            Padding="12,0,12,0"
                            VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <FontIcon Glyph="&#xE71E;"
                                      FontSize="14"
                                      Foreground="Gray"
                                      VerticalAlignment="Center"/>

                            <TextBox Grid.Column="1"
                                     PlaceholderText="Search everything..."
                                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     VerticalAlignment="Center"
                                     Margin="0,3,0,0">
                                <TextBox.Resources>
                                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                    <SolidColorBrush x:Key="TextControlBackground"
                                                     Color="Transparent"/>
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused"
                                                     Color="Transparent"/>
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver"
                                                     Color="Transparent"/>
                                </TextBox.Resources>
                            </TextBox>
                        </Grid>
                    </Border>
                    <StackPanel x:Name="FilterStack"
                                Grid.Column="1"
                                Grid.Row="0"
                                Orientation="Horizontal"
                                Margin="12,0,0,0"
                                Spacing="8">

                        <Border x:Name="RoleFilterBorder"
                            Background="White"
                                Height="35"
                                CornerRadius="20"
                                BorderThickness="1"
                                BorderBrush="#E0E0E0"
                                Padding="12,0,4,0">
                            <ComboBox PlaceholderText="All Roles"
                                      SelectedValue="{x:Bind ViewModel.SelectedRole, Mode=TwoWay}"
                                      SelectedValuePath="Content"
                                      Width="120"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      VerticalAlignment="Center">
                                <ComboBox.Resources>
                                    <Thickness x:Key="ComboBoxBorderThemeThickness">0</Thickness>
                                    <Thickness x:Key="ComboBoxBorderThemeThicknessFocused">0</Thickness>
                                    <SolidColorBrush x:Key="ComboBoxBackground"
                                                     Color="Transparent"/>
                                    <SolidColorBrush x:Key="ComboBoxBackgroundFocused"
                                                     Color="Transparent"/>
                                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver"
                                                     Color="Transparent"/>
                                </ComboBox.Resources>
                                <ComboBoxItem Content="All Roles"/>
                                <ComboBoxItem Content="Admin"/>
                                <ComboBoxItem Content="Sale"/>
                            </ComboBox>
                        </Border>

                        <Border x:Name="StatusFilterBorder"
                            Background="White"
                                Height="35"
                                CornerRadius="20"
                                BorderThickness="1"
                                BorderBrush="#E0E0E0"
                                Padding="12,0,4,0">
                            <ComboBox PlaceholderText="All Status"
                                      SelectedValue="{x:Bind ViewModel.SelectedStatus, Mode=TwoWay}"
                                      SelectedValuePath="Content"
                                      Width="120"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      VerticalAlignment="Center">
                                <ComboBox.Resources>
                                    <Thickness x:Key="ComboBoxBorderThemeThickness">0</Thickness>
                                    <Thickness x:Key="ComboBoxBorderThemeThicknessFocused">0</Thickness>
                                    <SolidColorBrush x:Key="ComboBoxBackground"
                                                     Color="Transparent"/>
                                    <SolidColorBrush x:Key="ComboBoxBackgroundFocused"
                                                     Color="Transparent"/>
                                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver"
                                                     Color="Transparent"/>
                                </ComboBox.Resources>
                                <ComboBoxItem Content="All Status"/>
                                <ComboBoxItem Content="Active"/>
                                <ComboBoxItem Content="Inactive"/>
                            </ComboBox>
                        </Border>

                        <!-- Advanced Sort Button -->
                        <Button x:Name="AdvancedSortButton"
                            Background="White"
                                Height="35"
                                CornerRadius="20"
                                BorderThickness="1"
                                BorderBrush="#E0E0E0"
                                Padding="16,0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8CB;" FontSize="14" Foreground="#4A4A4A"/>
                                <TextBlock Text="Advanced Sort" Foreground="#4A4A4A" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout>
                                    <StackPanel Width="360" Spacing="12" Padding="4">
                                        <TextBlock Text="Multi-Criteria Sorting" FontWeight="Bold" FontSize="16"/>
                                        <TextBlock Text="Add multiple levels of sorting logic." FontSize="12" Foreground="Gray" TextWrapping="Wrap"/>

                                        <ItemsControl ItemsSource="{x:Bind ViewModel.SortCriteriaList, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="baseviewmodels:SortCriteriaItem">
                                                    <Grid Margin="0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="100"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        
                                                        <ComboBox Grid.Column="0" 
                                                                  ItemsSource="{x:Bind AvailableColumns, Mode=OneWay}" 
                                                                  SelectedValue="{x:Bind ColumnName, Mode=TwoWay}" 
                                                                  HorizontalAlignment="Stretch" Margin="0,0,8,0"/>
                                                        
                                                        <ComboBox Grid.Column="1" 
                                                                  SelectedValue="{x:Bind Direction, Mode=TwoWay}"
                                                                  SelectedValuePath="Content"
                                                                  HorizontalAlignment="Stretch" Margin="0,0,8,0">
                                                            <ComboBoxItem Content="ASC"/>
                                                            <ComboBoxItem Content="DESC"/>
                                                        </ComboBox>

                                                        <Button Grid.Column="2" 
                                                                Background="Transparent" 
                                                                BorderThickness="0" 
                                                                Padding="4" 
                                                                Command="{Binding DataContext.RemoveSortCriteriaCommand, ElementName=Root}"
                                                                CommandParameter="{x:Bind}">
                                                            <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="Red"/>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Button Content="+ Add Level"
                                                Command="{x:Bind ViewModel.AddSortCriteriaCommand}"
                                                Background="Transparent"
                                                Foreground="#0078D7"
                                                BorderThickness="0"
                                                HorizontalAlignment="Left"/>

                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="Clear All"
                                                    Command="{x:Bind ViewModel.ClearMultiSortCommand}"
                                                    HorizontalAlignment="Stretch" Margin="0,0,4,0"/>
                                            <Button Grid.Column="1" Content="Apply"
                                                    Command="{x:Bind ViewModel.ApplyMultiSortCommand}"
                                                    Style="{StaticResource AppPrimaryButtonStyle}"
                                                    HorizontalAlignment="Stretch" Margin="4,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- List Grid with Header and Paging -->
                    <Grid Grid.Row="1"
                        RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0"
                                  x:Name="TableScroll"
                                  Margin="0,0,0,4"
                                  MinHeight="220"
                                  HorizontalScrollBarVisibility="Auto"
                                  HorizontalScrollMode="Enabled"
                                  IsHorizontalRailEnabled="True"
                                  VerticalScrollBarVisibility="Disabled"
                                  VerticalScrollMode="Disabled">
                        <StackPanel x:Name="TableStackPanel">
                            <!-- Header Row -->
                            <Border Background="#FAFAFA"
                                    Padding="16,12"
                                    BorderBrush="#EEEEEE"
                                    BorderThickness="0,1,0,1">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="0.8*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="0.7*"/>
                                        <ColumnDefinition Width="0.5*"/>
                                        <ColumnDefinition Width="1.1*"/>
                                        <ColumnDefinition Width="1.3*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>

                            <!-- Column 0: EMPLOYEE -->
                            <Button Style="{StaticResource SortHeaderButtonStyle}"
                                    Command="{x:Bind ViewModel.SortByColumnCommand}"
                                    CommandParameter="FullName">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="4">
                                    <TextBlock Text="EMPLOYEE"
                                               FontSize="11"
                                               FontWeight="Bold"/>
                                    <FontIcon Glyph="{x:Bind ViewModel.SortInfo, Mode=OneWay, Converter={StaticResource SortIndicatorConverter}, ConverterParameter=FullName}"
                                              FontSize="12"
                                              FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                            <!-- Column 1: CONTACT -->
                            <Button Grid.Column="1"
                                    Style="{StaticResource SortHeaderButtonStyle}"
                                    Command="{x:Bind ViewModel.SortByColumnCommand}"
                                    CommandParameter="Phone">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="4">
                                    <TextBlock Text="CONTACT"
                                               FontSize="11"
                                               FontWeight="Bold"/>
                                    <FontIcon Glyph="{x:Bind ViewModel.SortInfo, Mode=OneWay, Converter={StaticResource SortIndicatorConverter}, ConverterParameter=Phone}"
                                              FontSize="12"
                                              FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                            <!-- Column 2: ROLE -->
                            <Button Grid.Column="2"
                                    Style="{StaticResource SortHeaderButtonStyle}"
                                    Command="{x:Bind ViewModel.SortByColumnCommand}"
                                    CommandParameter="Role">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="4">
                                    <TextBlock Text="ROLE"
                                               FontSize="11"
                                               FontWeight="Bold"/>
                                    <FontIcon Glyph="{x:Bind ViewModel.SortInfo, Mode=OneWay, Converter={StaticResource SortIndicatorConverter}, ConverterParameter=Role}"
                                              FontSize="12"
                                              FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                            <!-- Column 3: STATUS -->
                            <Button Grid.Column="3"
                                    Style="{StaticResource SortHeaderButtonStyle}"
                                    HorizontalAlignment="Center"
                                    Command="{x:Bind ViewModel.SortByColumnCommand}"
                                    CommandParameter="Status">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="4">
                                    <TextBlock Text="STATUS"
                                               FontSize="11"
                                               FontWeight="Bold"/>
                                    <FontIcon Glyph="{x:Bind ViewModel.SortInfo, Mode=OneWay, Converter={StaticResource SortIndicatorConverter}, ConverterParameter=Status}"
                                              FontSize="12"
                                              FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                            <!-- Column 4: RATE -->
                            <Button Grid.Column="4"
                                    Style="{StaticResource SortHeaderButtonStyle}"
                                    HorizontalAlignment="Right"
                                    Command="{x:Bind ViewModel.SortByColumnCommand}"
                                    CommandParameter="HourlyRate">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="4">
                                    <TextBlock Text="RATE"
                                               FontSize="11"
                                               FontWeight="Bold"/>
                                    <FontIcon Glyph="{x:Bind ViewModel.SortInfo, Mode=OneWay, Converter={StaticResource SortIndicatorConverter}, ConverterParameter=HourlyRate}"
                                              FontSize="12"
                                              FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                            <!-- Column 5: HRS -->
                            <Button Grid.Column="5"
                                    Style="{StaticResource SortHeaderButtonStyle}"
                                    HorizontalAlignment="Center"
                                    Command="{x:Bind ViewModel.SortByColumnCommand}"
                                    CommandParameter="TotalHours">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="4">
                                    <TextBlock Text="HRS"
                                               FontSize="11"
                                               FontWeight="Bold"/>
                                    <FontIcon Glyph="{x:Bind ViewModel.SortInfo, Mode=OneWay, Converter={StaticResource SortIndicatorConverter}, ConverterParameter=TotalHours}"
                                              FontSize="12"
                                              FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                            <!-- Column 6: PREV. -->
                            <Button Grid.Column="6"
                                    Style="{StaticResource SortHeaderButtonStyle}"
                                    HorizontalAlignment="Right"
                                    Command="{x:Bind ViewModel.SortByColumnCommand}"
                                    CommandParameter="LastMonthSalary">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="4">
                                    <TextBlock Text="PREV."
                                               FontSize="11"
                                               FontWeight="Bold"/>
                                    <FontIcon Glyph="{x:Bind ViewModel.SortInfo, Mode=OneWay, Converter={StaticResource SortIndicatorConverter}, ConverterParameter=LastMonthSalary}"
                                              FontSize="12"
                                              FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                            <!-- Column 7: NET SALARY -->
                            <Button Grid.Column="7"
                                    Style="{StaticResource SortHeaderButtonStyle}"
                                    HorizontalAlignment="Right"
                                    Command="{x:Bind ViewModel.SortByColumnCommand}"
                                    CommandParameter="FinalSalary">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="4">
                                    <TextBlock Text="NET SALARY"
                                               FontSize="11"
                                               FontWeight="Bold"/>
                                    <FontIcon Glyph="{x:Bind ViewModel.SortInfo, Mode=OneWay, Converter={StaticResource SortIndicatorConverter}, ConverterParameter=FinalSalary}"
                                              FontSize="12"
                                              FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                            <!-- Column 8: ACTIONS -->
                            <TextBlock Grid.Column="8"
                                       Text="ACTIONS"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="Gray"
                                       HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- List -->
                            <ItemsControl ItemsSource="{x:Bind ViewModel.DisplayEmployees, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:UserSalaryInfo">
                                        <Border BorderBrush="#F9F9F9"
                                                BorderThickness="0,0,0,1"
                                                Padding="16,10">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="0.8*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="0.7*"/>
                                                    <ColumnDefinition Width="0.5*"/>
                                                    <ColumnDefinition Width="1.1*"/>
                                                    <ColumnDefinition Width="1.3*"/>
                                                    <ColumnDefinition Width="100"/>
                                                </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="8">
                                                <PersonPicture DisplayName="{x:Bind User.FullName, Mode=OneWay}"
                                                               Height="28"
                                                               VerticalAlignment="Center"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind User.FullName, Mode=OneWay}"
                                                               FontWeight="Bold"
                                                               FontSize="13"/>
                                                    <TextBlock Text="{x:Bind User.Username, Mode=OneWay}"
                                                               FontSize="10"
                                                               Foreground="Gray"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind User.Phone, Mode=OneWay}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Foreground="#555555"/>

                                            <TextBlock Grid.Column="2"
                                                       Text="{x:Bind User.Role, Mode=OneWay, Converter={StaticResource RoleToDisplayConverter}}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Foreground="#444444"/>

                                            <ToggleSwitch Grid.Column="3"
                                                          IsOn="{x:Bind User.IsActive, Mode=TwoWay}"
                                                          OnContent="Active"
                                                          OffContent="Inactive"
                                                          FontSize="10"
                                                          MinWidth="0"
                                                          HorizontalAlignment="Center"
                                                          Toggled="Status_Toggled"/>

                                            <TextBlock Grid.Column="4"
                                                       Text="{x:Bind User.HourlyRate, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"
                                                       Foreground="#666666"/>

                                            <TextBlock Grid.Column="5"
                                                       Text="{x:Bind TotalHours, Mode=OneWay}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="6"
                                                       Text="{x:Bind LastMonthSalary, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                                                       Foreground="Gray"
                                                       FontSize="12"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>

                                            <StackPanel Grid.Column="7"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind FinalSalary, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                                                           FontWeight="Black"
                                                           Foreground="#1B5E20"
                                                           FontSize="14"
                                                           HorizontalAlignment="Right"/>
                                                <Border Background="{x:Bind TagColor, Mode=OneWay}"
                                                        CornerRadius="4"
                                                        Padding="4,0"
                                                        Margin="0,1,0,0"
                                                        HorizontalAlignment="Right">
                                                    <TextBlock Text="{x:Bind BonusTag, Mode=OneWay}"
                                                               FontSize="8"
                                                               Foreground="White"
                                                               FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Grid.Column="8"
                                                        Orientation="Horizontal"
                                                        Spacing="10"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Background="Transparent">
                                                <Button Style="{StaticResource AppIconButtonStyle}"
                                                        Click="EditButton_Click"
                                                        ToolTipService.ToolTip="Edit Employee"
                                                        Foreground="#0078D4">
                                                    <FontIcon Glyph="&#xEB7E;"
                                                              FontSize="16"/>
                                                </Button>

                                                <Button Style="{StaticResource AppIconButtonStyle}"
                                                        Click="DeleteButton_Click"
                                                        ToolTipService.ToolTip="Delete Employee"
                                                        Foreground="#E81123">
                                                    <FontIcon Glyph="&#xED62;"
                                                              FontSize="16"/>
                                                </Button>
                                            </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Paging Controls -->
                        <Border Grid.Row="1"
                            Background="White"
                            Padding="10"
                            BorderBrush="#EEEEEE"
                            BorderThickness="0,1,0,0">
                        <Grid ColumnSpacing="12"
                              HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Previous Button -->
                            <Button Grid.Column="0"
                                    Content="←"
                                    Click="PreviousButton_Click"
                                    Height="30"
                                    Padding="16,0"
                                    CornerRadius="8"
                                    Background="#F0F0F0"
                                    Foreground="#333333"/>

                            <!-- Page Info -->
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.PageInfoDisplay, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#555555"/>

                            <!-- Next Button -->
                            <Button Grid.Column="2"
                                    Content="→"
                                    Click="NextButton_Click"
                                    Height="30"
                                    Padding="16,0"
                                    CornerRadius="8"
                                    Background="#0078D4"
                                    Foreground="White"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
        </Grid>
    </ScrollViewer>
</UserControl>