<UserControl
    x:Class="MyShop.Views.StaffManagement.Components.EmployeeListTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:comps="using:MyShop.Views.StaffManagement.Components"
    xmlns:viewModels="using:MyShop.ViewModels"
    x:Name="Root">

    <Grid>
        <Border Background="#FFFFFF"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="14"
                Padding="16">
            <StackPanel Spacing="16">
                
                <!-- Actions Section -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Command="{Binding AddEmployeeCommand}"
                            Background="#BB4D00"
                            BorderBrush="#BB4D00"
                            Foreground="White"
                            CornerRadius="12"
                            Padding="14,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;"/>
                            <TextBlock Text="Add Employee" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <ComboBox Grid.Column="2"
                              Width="180"
                              ItemsSource="{Binding Positions}"
                              SelectedItem="{Binding SelectedPosition, Mode=TwoWay}"
                              PlaceholderText="Position"
                              CornerRadius="12"
                              VerticalAlignment="Center">
                        <ComboBox.Items>
                            <x:String>All</x:String>
                            <x:String>Admin</x:String>
                            <x:String>Bán hàng</x:String>
                        </ComboBox.Items>
                    </ComboBox>

                    <Grid Grid.Column="4">
                        <TextBox Padding="40,10,10,10"
                                 Background="#F8FAFC"
                                 BorderBrush="#E5E7EB"
                                 CornerRadius="12"
                                 PlaceholderText="Search by name, ID or phone..."
                                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <FontIcon Glyph="&#xE721;"
                                  Foreground="#94A3B8"
                                  Margin="14,0,0,0"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"/>
                    </Grid>
                </Grid>

                <MenuFlyoutSeparator Background="#E5E7EB" Margin="-16,0"/>

                <!-- Staff List -->
                <ItemsRepeater ItemsSource="{Binding PageItems}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" Spacing="12"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:EmployeeListItem">
                            <Border Background="White"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="16">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Avatar -->
                                    <PersonPicture Grid.Column="0"
                                                   Initials="{x:Bind Initials}"
                                                   Width="48" Height="48"
                                                   VerticalAlignment="Center"/>

                                    <!-- Details -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="{x:Bind Name}"
                                                       FontWeight="SemiBold"
                                                       Foreground="#1E293B"/>
                                            <Border Background="#FEF3C7"
                                                    CornerRadius="6"
                                                    Padding="8,4">
                                                <TextBlock Text="{x:Bind Position}"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="#92400E"/>
                                            </Border>
                                            <Border Background="#D1FAE5"
                                                    CornerRadius="6"
                                                    Padding="8,4">
                                                <TextBlock Text="{x:Bind Status}"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="#065F46"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="16">
                                            <TextBlock FontSize="12" Foreground="#6B7280">
                                                <Run Text="ID: "/><Run Text="{x:Bind Code}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="12" Foreground="#6B7280">
                                                <Run Text="Phone: "/><Run Text="{x:Bind Phone}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="12" Foreground="#6B7280">
                                                <Run Text="Shifts: "/><Run Text="{x:Bind ShiftCount}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Schedule Action -->
                                    <Button Grid.Column="2"
                                            Content="{x:Bind ScheduleButtonText}"
                                            Background="#F1F5F9"
                                            Foreground="#475569"
                                            BorderBrush="#E2E8F0"
                                            CornerRadius="8"
                                            Padding="12,6"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            VerticalAlignment="Center">
                                        <Button.Flyout>
                                            <Flyout>
                                                <comps:EmployeeScheduleFlyout/>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>

                                    <!-- Actions -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Background="Transparent" BorderThickness="0" Padding="8"
                                                Command="{Binding DataContext.EditEmployeeCommand, ElementName=Root}"
                                                CommandParameter="{Binding}">
                                            <FontIcon Glyph="&#xE70F;" FontSize="16" Foreground="#6B7280"/>
                                        </Button>
                                        <Button Background="Transparent" BorderThickness="0" Padding="8">
                                            <FontIcon Glyph="&#xE72E;" FontSize="16" Foreground="#EF4444"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <MenuFlyoutSeparator Background="#E5E7EB" Margin="-16,0"/>

                <!-- Paging Section -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding PagingSummary}"
                               Foreground="#64748B"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Command="{Binding PreviousPageCommand}"
                                Background="#FFFFFF" BorderBrush="#E5E7EB"
                                CornerRadius="8" Width="32" Height="32">
                            <FontIcon Glyph="&#xE76B;" Foreground="#94A3B8" FontSize="12"/>
                        </Button>
                        <ItemsControl ItemsSource="{Binding PageNumbers}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:Int32">
                                    <Button Command="{Binding DataContext.GoToPageCommand, ElementName=Root}"
                                            CommandParameter="{Binding}"
                                            Width="32" Height="32" CornerRadius="8"
                                            Background="#FFFFFF" BorderBrush="#E5E7EB"
                                            Foreground="#4B5563" Content="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Command="{Binding NextPageCommand}"
                                Background="#FFFFFF" BorderBrush="#E5E7EB"
                                CornerRadius="8" Width="32" Height="32">
                            <FontIcon Glyph="&#xE76C;" Foreground="#94A3B8" FontSize="12"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>