<UserControl
    x:Class="MyShop.Views.StaffManagement.Components.ShiftNoteFlyoutContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="16"
                Width="{StaticResource Size260}">
        <StackPanel Orientation="Horizontal"
                    Spacing="12">
            <PersonPicture Initials="VN"
                           Width="{StaticResource Size42}"
                           Height="{StaticResource Size42}"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Nguyễn Văn Nam"
                           FontWeight="{StaticResource FontWeightBold}"
                           FontSize="{StaticResource FontSubtitle}"
                           Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="Mã NV: NV001"
                           Style="{StaticResource CaptionTextStyle}"/>
            </StackPanel>
        </StackPanel>

        <Border BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"/>

        <StackPanel Spacing="8">
            <TextBlock Text="Shift Note:"
                       FontWeight="{StaticResource FontWeightSemiBold}"
                       FontSize="{StaticResource FontBody}"
                       Foreground="{StaticResource BrandPrimary}"/>
            <TextBox PlaceholderText="e.g. Clean counter, check inventory..."
                     Height="{StaticResource Size70}"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     CornerRadius="{StaticResource RadiusSmall}"
                     Foreground="{StaticResource TextPrimary}"/>
        </StackPanel>

        <Button Content="Save"
                Background="{StaticResource BrandPrimary}"
                Foreground="{StaticResource BrandPrimaryForeground}"
                HorizontalAlignment="Right"
                CornerRadius="{StaticResource RadiusSmall}"
                Padding="{StaticResource SpaceLarge_Small}"
                FontWeight="{StaticResource FontWeightSemiBold}"
                BorderThickness="0"
                Style="{StaticResource AppPrimaryButtonStyle}"/>
    </StackPanel>
</UserControl>