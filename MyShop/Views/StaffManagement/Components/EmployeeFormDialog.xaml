<ContentDialog
    x:Class="MyShop.Views.StaffManagement.Components.EmployeeFormDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Thêm nhân viên mới"
    PrimaryButtonText="Lưu thông tin"
    CloseButtonText="Hủy bỏ"
    DefaultButton="Primary"
    CornerRadius="{StaticResource RadiusMedium}"
    Background="{StaticResource SurfaceBackground}">

    <StackPanel Spacing="16"
                Width="{StaticResource Size400}"
                Margin="0,16,0,0">
        <TextBox x:Name="TxtHoTen"
                 Header="Họ và Tên (*)"
                 PlaceholderText="Nhập tên nhân viên"
                 CornerRadius="{StaticResource RadiusSmall}"
                 Foreground="{StaticResource TextPrimary}"/>
        <TextBox x:Name="TxtSDT"
                 Header="Số điện thoại (*)"
                 PlaceholderText="09xx.xxx.xxx"
                 CornerRadius="{StaticResource RadiusSmall}"
                 Foreground="{StaticResource TextPrimary}"/>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="CmbChucVu"
                      Header="Chức vụ"
                      PlaceholderText="Chọn chức vụ"
                      HorizontalAlignment="Stretch"
                      CornerRadius="{StaticResource RadiusSmall}">
                <ComboBoxItem Content="Quản lý (Admin)"/>
                <ComboBoxItem Content="Nhân viên Bán hàng"/>
                <ComboBoxItem Content="Nhân viên Pha chế"/>
            </ComboBox>
            <ComboBox x:Name="CmbTrangThai"
                      Grid.Column="1"
                      Header="Trạng thái"
                      PlaceholderText="Chọn trạng thái"
                      HorizontalAlignment="Stretch"
                      CornerRadius="{StaticResource RadiusSmall}"
                      SelectedIndex="0">
                <ComboBoxItem Content="Đang làm việc"/>
                <ComboBoxItem Content="Nghỉ phép"/>
            </ComboBox>
        </Grid>

        <TextBox Header="Ghi chú thêm"
                 PlaceholderText="Thông tin khác..."
                 Height="{StaticResource Size60}"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 CornerRadius="{StaticResource RadiusSmall}"
                 Foreground="{StaticResource TextPrimary}"/>
    </StackPanel>
</ContentDialog>