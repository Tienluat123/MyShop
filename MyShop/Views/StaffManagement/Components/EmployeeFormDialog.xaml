<ContentDialog
    x:Class="MyShop.Views.StaffManagement.Dialogs.EmployeeFormDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MyShop.Models"
    CornerRadius="20">

    <Grid Width="450"
          Height="650"
          Margin="0"
          Padding="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="0,0,0,10">
            <TextBlock x:Name="DialogTitleText"
                       Text="Employee Information"
                       FontSize="18"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>

            <PersonPicture x:Name="ProfilePic"
                           HorizontalAlignment="Right"
                           Height="40"
                           VerticalAlignment="Center"/>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="0,0,10,0">
            <StackPanel Spacing="20">

                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <FontIcon Glyph="&#xE77B;"
                                  FontSize="16"
                                  Foreground="#2980B9"/>
                        <TextBlock Text="Personal Details"
                                   FontWeight="Bold"
                                   Foreground="#2980B9"/>
                    </StackPanel>

                    <Border BorderBrush="#EEEEEE"
                            BorderThickness="1"
                            CornerRadius="12"
                            Background="#F9F9F9"
                            Padding="15">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtFirstName"
                                         Text="{x:Bind ViewModel.FirstName, Mode=TwoWay}"
                                         FontFamily="Segoe UI"
                                         Header="First Name"
                                         CornerRadius="8"/>
                                <TextBox Grid.Column="1"
                                         x:Name="TxtLastName"
                                         FontFamily="Segoe UI"
                                         Text="{x:Bind ViewModel.LastName, Mode=TwoWay}"
                                         Header="Last Name"
                                         CornerRadius="8"/>
                            </Grid>
                            <TextBox x:Name="TxtPhone"
                                     Text="{x:Bind ViewModel.Phone, Mode=TwoWay}"
                                     Header="Phone Number"
                                     InputScope="Number"
                                     PlaceholderText="0912..."
                                     CornerRadius="8"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <FontIcon Glyph="&#xE713;"
                                  FontSize="16"
                                  Foreground="#27AE60"/>
                        <TextBlock Text="Account &amp; Compensation"
                                   FontWeight="Bold"
                                   Foreground="#27AE60"/>
                    </StackPanel>

                    <Border BorderBrush="#EEEEEE"
                            BorderThickness="1"
                            CornerRadius="12"
                            Background="#F9F9F9"
                            Padding="15">
                        <StackPanel Spacing="12">
                            <TextBox x:Name="TxtUsername"
                                     Text="{x:Bind ViewModel.Username, Mode=TwoWay}"
                                     Header="Username"
                                     PlaceholderText="admin_luat"
                                     CornerRadius="8"/>

                            <PasswordBox x:Name="TxtPassword"
                                         Header="Password"
                                         PlaceholderText="••••••••"
                                         PasswordRevealMode="Peek"
                                         CornerRadius="8"/>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <NumberBox x:Name="NbHourlyRate"
                                           Value="{x:Bind ViewModel.HourlyRate, Mode=TwoWay}"
                                           Header="Hourly Rate (VNĐ)"
                                           SpinButtonPlacementMode="Compact"
                                           CornerRadius="8"/>
                                <ComboBox x:Name="CboRole"
                                          SelectedIndex="{x:Bind ViewModel.SelectedRoleIndex, Mode=TwoWay}"
                                          Header="Role"
                                          Grid.Column="1"
                                          HorizontalAlignment="Stretch"
                                          CornerRadius="8">
                                    <ComboBoxItem Content="Admin"
                                                  Tag="1"/>
                                    <ComboBoxItem Content="Sale"
                                                  Tag="2"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <ToggleSwitch x:Name="TglStatus"
                              IsOn="{x:Bind ViewModel.IsActive, Mode=TwoWay}"
                              Header="Account Status"
                              OnContent="Active"
                              OffContent="Inactive"
                              Margin="5,0,0,0"/>

                <TextBlock Text="{x:Bind ViewModel.ErrorMessage}"
                           Foreground="#C00000"
                           FontSize="12"
                           Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2"
              ColumnSpacing="12"
              Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="CustomSaveButton"
                    Content="Save Changes"
                    Click="CustomSaveButton_Click"
                    Background="#E67E22"
                    Foreground="White"
                    HorizontalAlignment="Stretch"
                    Height="40"
                    CornerRadius="10"
                    FontWeight="Bold"/>

            <Button Grid.Column="1"
                    x:Name="CustomCancelButton"
                    Content="Cancel"
                    Click="CustomCancelButton_Click"
                    Background="#F0F0F0"
                    Foreground="#333333"
                    HorizontalAlignment="Stretch"
                    Height="40"
                    CornerRadius="10"/>
        </Grid>
    </Grid>
</ContentDialog>