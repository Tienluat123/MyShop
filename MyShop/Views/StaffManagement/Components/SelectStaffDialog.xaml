<ContentDialog
    x:Class="MyShop.Views.StaffManagement.Dialogs.SelectStaffDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MyShop.Models"
    CornerRadius="20">

    <Grid x:Name="DialogRoot"
          Width="420"
          Padding="0">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SelectStaffDialogStates">
                <VisualState x:Name="SelectStaffDialogNarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DialogRoot.Width" Value="Auto"/>
                        <Setter Target="DialogRoot.MaxWidth" Value="360"/>
                        <Setter Target="DialogRoot.Padding" Value="8"/>
                        <Setter Target="StaffListView.Height" Value="160"/>
                        <Setter Target="StatusNoteGrid.(Grid.ColumnDefinitions)[0].Width" Value="*"/>
                        <Setter Target="StatusNoteGrid.(Grid.ColumnDefinitions)[1].Width" Value="0"/>
                        <Setter Target="NoteStack.(Grid.Column)" Value="0"/>
                        <Setter Target="NoteStack.(Grid.Row)" Value="1"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="SelectStaffDialogWideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="600"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DialogRoot.Width" Value="420"/>
                        <Setter Target="DialogRoot.MaxWidth" Value="420"/>
                        <Setter Target="DialogRoot.Padding" Value="0"/>
                        <Setter Target="StaffListView.Height" Value="180"/>
                        <Setter Target="StatusNoteGrid.(Grid.ColumnDefinitions)[0].Width" Value="180"/>
                        <Setter Target="StatusNoteGrid.(Grid.ColumnDefinitions)[1].Width" Value="*"/>
                        <Setter Target="NoteStack.(Grid.Column)" Value="1"/>
                        <Setter Target="NoteStack.(Grid.Row)" Value="0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <StackPanel Spacing="20">

            <Grid Margin="0,5,0,0">
                <TextBlock x:Name="DialogTitleText"
                           Text="Schedule Assignment"
                           FontSize="18"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <Button x:Name="DeleteButton"
                        Click="DeleteButton_Click"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="4"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal"
                                Spacing="4">
                        <FontIcon Glyph="&#xE74D;"
                                  FontSize="14"
                                  Foreground="#C0392B"/>
                        <TextBlock Text="Remove"
                                   FontSize="12"
                                   Foreground="#C0392B"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                    <FontIcon Glyph="&#xE716;"
                              FontSize="16"
                              Foreground="#E67E22"/>
                    <TextBlock Text="Select Staff Member"
                               FontWeight="Bold"
                               Foreground="#E67E22"/>
                </StackPanel>

                <Border BorderBrush="#EEEEEE"
                        BorderThickness="1"
                        CornerRadius="12"
                        Background="#F9F9F9"
                        Padding="2">
                    <ListView x:Name="StaffListView"
                              ItemsSource="{x:Bind StaffList, Mode=OneWay}"
                              SelectionMode="Single"
                              Height="180">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:User">
                                <Grid Padding="8"
                                      ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <PersonPicture DisplayName="{x:Bind Username}"
                                                   Height="32"
                                                   VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Username}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"/>
                                        <TextBlock Text="Active Staff"
                                                   FontSize="11"
                                                   Foreground="Gray"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </StackPanel>

            <Grid x:Name="StatusNoteGrid" ColumnSpacing="12" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="5">
                    <TextBlock Text="Status"
                               FontWeight="SemiBold"
                               Foreground="Gray"
                               FontSize="12"/>
                    <ComboBox x:Name="StatusCombo"
                              HorizontalAlignment="Stretch"
                              SelectedIndex="0"
                              CornerRadius="8">
                        <ComboBoxItem Content="Scheduled"/>
                        <ComboBoxItem Content="Completed"/>
                        <ComboBoxItem Content="Cancelled"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel x:Name="NoteStack"
                            Grid.Column="1"
                            Grid.Row="0"
                            Spacing="5">
                    <TextBlock Text="Quick Note"
                               FontWeight="SemiBold"
                               Foreground="Gray"
                               FontSize="12"/>
                    <TextBox x:Name="NoteBox"
                             PlaceholderText="Details..."
                             CornerRadius="8"/>
                </StackPanel>
            </Grid>

            <Grid ColumnSpacing="12"
                  Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="CustomAssignButton"
                        Content="Assign"
                        Click="CustomAssignButton_Click"
                        Background="#E67E22"
                        Foreground="White"
                        HorizontalAlignment="Stretch"
                        Height="40"
                        CornerRadius="10"
                        FontWeight="Bold"/>

                <Button Grid.Column="1"
                        Content="Cancel"
                        Click="CustomCancelButton_Click"
                        Background="#F0F0F0"
                        Foreground="#333333"
                        HorizontalAlignment="Stretch"
                        Height="40"
                        CornerRadius="10"/>
            </Grid>
        </StackPanel>
    </Grid>
</ContentDialog>