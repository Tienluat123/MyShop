<ContentDialog
    x:Class="MyShop.Views.StaffManagement.Components.EmployeeFormView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:MyShop.Views.Controls"
    DefaultButton="Primary"
    CornerRadius="{StaticResource RadiusMedium}"
    Background="{StaticResource SurfaceBackground}">

    <Grid Width="500"
          Margin="-24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:ModalHeader Grid.Row="0"
                        Title="{Binding FormTitle}"
                        Subtitle="{Binding Subtitle}"
                        CancelClicked="CancelButton_Click"/>

        <ScrollViewer Grid.Row="1"
                      Padding="32,8,32,24"
                      MaxHeight="500">
            <StackPanel Spacing="16"
                        Width="{StaticResource Size400}">
                <TextBox Text="{Binding EmployeeData.Name, Mode=TwoWay}"
                         Header="FULL NAME (*)"
                         PlaceholderText="Enter employee's full name"
                         CornerRadius="{StaticResource RadiusSmall}"
                         Foreground="{StaticResource TextPrimary}"/>
                <TextBox Text="{Binding EmployeeData.Phone, Mode=TwoWay}"
                         Header="PHONE NUMBER (*)"
                         PlaceholderText="09xx.xxx.xxx"
                         CornerRadius="{StaticResource RadiusSmall}"
                         Foreground="{StaticResource TextPrimary}"/>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox SelectedIndex="{Binding EmployeeData.Position, Mode=TwoWay}"
                              Header="POSITION"
                              PlaceholderText="Select position"
                              HorizontalAlignment="Stretch"
                              CornerRadius="{StaticResource RadiusSmall}">
                        <ComboBoxItem Content="Manager (Admin)"/>
                        <ComboBoxItem Content="Sales Associate"/>
                    </ComboBox>
                    <ComboBox SelectedIndex="{Binding EmployeeData.Status, Mode=TwoWay}"
                              Grid.Column="1"
                              Header="STATUS"
                              PlaceholderText="Select status"
                              HorizontalAlignment="Stretch"
                              CornerRadius="{StaticResource RadiusSmall}">
                        <ComboBoxItem Content="Active"/>
                        <ComboBoxItem Content="On Leave"/>
                    </ComboBox>
                </Grid>

                <TextBox Text="{Binding EmployeeData.Notes, Mode=TwoWay}"
                         Header="ADDITIONAL NOTES"
                         PlaceholderText="Additional information..."
                         Height="{StaticResource Size60}"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         CornerRadius="{StaticResource RadiusSmall}"
                         Foreground="{StaticResource TextPrimary}"/>
            </StackPanel>
        </ScrollViewer>
        <ui:ModalFooter Grid.Row="2"
                        CancelText="Discard"
                        SubmitText="{Binding SubmitButtonText}"
                        CancelClicked="CancelButton_Click"
                        SubmitClicked="SaveButton_Click"/>
    </Grid>
</ContentDialog>