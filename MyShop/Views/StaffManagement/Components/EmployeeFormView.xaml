<ContentDialog
    x:Class="MyShop.Views.StaffManagement.Components.EmployeeFormDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:MyShop.Views.Controls"
    CornerRadius="24"
    BorderThickness="0">

    <Grid Width="500"
          Margin="-24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:ModalHeader Grid.Row="0"
                        Title="{Binding FormTitle}"
                        Subtitle="{Binding Subtitle}"
                        CancelClicked="CancelButton_Click"/>

        <ScrollViewer Grid.Row="1"
                      Padding="32,8,32,24"
                      MaxHeight="550">
            <StackPanel Spacing="20">

                <ui:LabeledInputControl Label="FULL NAME *">
                    <ui:LabeledInputControl.InputContent>
                        <TextBox Text="{Binding EmployeeData.Name, Mode=TwoWay}"
                                 PlaceholderText="Enter employee's full name"
                                 CornerRadius="12"
                                 Padding="14,10"/>
                    </ui:LabeledInputControl.InputContent>
                </ui:LabeledInputControl>

                <ui:LabeledInputControl Label="PHONE NUMBER *">
                    <ui:LabeledInputControl.InputContent>
                        <TextBox Text="{Binding EmployeeData.Phone, Mode=TwoWay}"
                                 PlaceholderText="09xx.xxx.xxx"
                                 CornerRadius="12"
                                 Padding="14,10"/>
                    </ui:LabeledInputControl.InputContent>
                </ui:LabeledInputControl>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ui:LabeledInputControl Label="POSITION">
                        <ui:LabeledInputControl.InputContent>
                            <ComboBox SelectedIndex="{Binding EmployeeData.Position, Mode=TwoWay}"
                                      PlaceholderText="Select position"
                                      HorizontalAlignment="Stretch"
                                      CornerRadius="12">
                                <ComboBoxItem Content="Manager (Admin)"/>
                                <ComboBoxItem Content="Sales Associate"/>
                            </ComboBox>
                        </ui:LabeledInputControl.InputContent>
                    </ui:LabeledInputControl>

                    <ui:LabeledInputControl Grid.Column="1" Label="STATUS">
                        <ui:LabeledInputControl.InputContent>
                            <ComboBox SelectedIndex="{Binding EmployeeData.Status, Mode=TwoWay}"
                                      PlaceholderText="Select status"
                                      HorizontalAlignment="Stretch"
                                      CornerRadius="12">
                                <ComboBoxItem Content="Active"/>
                                <ComboBoxItem Content="On Leave"/>
                            </ComboBox>
                        </ui:LabeledInputControl.InputContent>
                    </ui:LabeledInputControl>
                </Grid>

                <ui:LabeledInputControl Label="ADDITIONAL NOTES">
                    <ui:LabeledInputControl.InputContent>
                        <TextBox Text="{Binding EmployeeData.Notes, Mode=TwoWay}"
                                 PlaceholderText="Additional information..."
                                 Height="100"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 CornerRadius="12"
                                 Padding="14,10"/>
                    </ui:LabeledInputControl.InputContent>
                </ui:LabeledInputControl>
            </StackPanel>
        </ScrollViewer>

        <ui:ModalFooter Grid.Row="2"
                        CancelText="Discard"
                        SubmitText="{Binding SubmitButtonText}"
                        CancelClicked="CancelButton_Click"
                        SubmitClicked="SaveButton_Click"/>
    </Grid>
</ContentDialog>