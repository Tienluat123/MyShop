<UserControl
    x:Class="MyShop.Views.StaffManagement.Components.EmployeeScheduleFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="12"
                Width="220"
                Padding="8"
                Margin="0,0,0,8">

        <TextBlock Text="Lịch tuần này của Nam"
                   FontWeight="Bold"
                   FontSize="14"
                   Foreground="{StaticResource TextPrimary}"/>
        <Border BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1"
                Margin="0,0,0,4"/>

        <Grid RowSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Thứ 2"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondary}"
                       VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="6">
                <Border Background="#FEF3C7"
                        CornerRadius="6"
                        Padding="8,4">
                    <TextBlock Text="Sáng"
                               FontSize="11"
                               Foreground="#D97706"
                               FontWeight="Bold"/>
                </Border>
                <Border Background="#F3E8FF"
                        CornerRadius="6"
                        Padding="8,4">
                    <TextBlock Text="Tối"
                               FontSize="11"
                               Foreground="#7E22CE"
                               FontWeight="Bold"/>
                </Border>
            </StackPanel>

            <TextBlock Grid.Row="1"
                       Text="Thứ 3"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondary}"
                       VerticalAlignment="Center"/>
            <StackPanel Grid.Row="1"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="6">
                <Border Background="#FEF3C7"
                        CornerRadius="6"
                        Padding="8,4">
                    <TextBlock Text="Sáng"
                               FontSize="11"
                               Foreground="#D97706"
                               FontWeight="Bold"/>
                </Border>
            </StackPanel>

            <TextBlock Grid.Row="2"
                       Text="Thứ 4"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondary}"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Row="2"
                       Grid.Column="1"
                       Text="Nghỉ phép"
                       Foreground="#9CA3AF"
                       FontStyle="Italic"
                       FontSize="12"
                       VerticalAlignment="Center"/>

            <TextBlock Grid.Row="3"
                       Text="Thứ 5"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondary}"
                       VerticalAlignment="Center"/>
            <StackPanel Grid.Row="3"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="6">
                <Border Background="#DBEAFE"
                        CornerRadius="6"
                        Padding="8,4">
                    <TextBlock Text="Chiều"
                               FontSize="11"
                               Foreground="#2563EB"
                               FontWeight="Bold"/>
                </Border>
            </StackPanel>

            <TextBlock Grid.Row="4"
                       Text="Thứ 6"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondary}"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Row="5"
                       Text="Thứ 7"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondary}"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Row="6"
                       Text="CN"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondary}"
                       VerticalAlignment="Center"/>
        </Grid>

    </StackPanel>
</UserControl>