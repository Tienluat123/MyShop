<UserControl
    x:Class="MyShop.Views.StaffManagement.Components.WeeklyRosterTab"
    x:Name="RosterRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MyShop.Models"
    xmlns:converters="using:MyShop.Converters">

    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVis"/>
        <converters:StatusToColorConverter x:Key="StatusToColor"/>

        <DataTemplate x:Key="DayCellTemplate">
            <Grid Padding="4"
                  MinHeight="50">
                <!-- Show staff name button when User exists -->
                <Button Visibility="{Binding User, Converter={StaticResource NullToVis}}"
                        Style="{StaticResource AppGhostButtonStyle}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Command="{Binding DataContext.EditStaffCommand, ElementName=RosterRoot}"
                        CommandParameter="{Binding}"
                        Background="{Binding Status, Converter={StaticResource StatusToColor}}">
                    <StackPanel Spacing="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding User.Username, FallbackValue=''}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Show + button when User is null (empty slot) -->
                <Button Visibility="{Binding User, Converter={StaticResource NullToVis}, ConverterParameter='Inverse'}"
                        Content="+"
                        Command="{Binding DataContext.AddStaffCommand, ElementName=RosterRoot}"
                        CommandParameter="{Binding}"
                        Foreground="{StaticResource TextSecondary}"
                        FontSize="20"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Style="{StaticResource AppGhostButtonStyle}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16,12,16,20"
          Background="{StaticResource SurfaceBackground}"
          CornerRadius="{StaticResource RadiusMedium}"
          BorderBrush="{StaticResource BorderBrush}"
          BorderThickness="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="24"
                    Margin="0,16">
            <Button Command="{x:Bind ViewModel.PreviousWeekCommand}"
                    Style="{StaticResource AppGhostButtonStyle}">
                <FontIcon Glyph="&#xE72B;"
                          FontSize="14"/>
            </Button>
            <StackPanel VerticalAlignment="Center"
                        MinWidth="220">
                <TextBlock Text="{x:Bind ViewModel.CurrentWeekStart, Mode=OneWay}"
                           HorizontalAlignment="Center"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{StaticResource BrandPrimary}"/>
                <TextBlock Text="Staff Weekly Schedule"
                           HorizontalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondary}"/>
            </StackPanel>
            <Button Command="{x:Bind ViewModel.NextWeekCommand}"
                    Style="{StaticResource AppGhostButtonStyle}">
                <FontIcon Glyph="&#xE72A;"
                          FontSize="14"/>
            </Button>
        </StackPanel>

        <Grid Grid.Row="1"
              Background="{StaticResource SurfaceHover}"
              Padding="0,12"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="SHIFT"
                       Margin="16,0,0,0"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextSecondary}"/>
            <TextBlock Grid.Column="1"
                       Text="Mon"
                       HorizontalAlignment="Center"
                       FontWeight="SemiBold"/>
            <TextBlock Grid.Column="2"
                       Text="Tue"
                       HorizontalAlignment="Center"
                       FontWeight="SemiBold"/>
            <TextBlock Grid.Column="3"
                       Text="Wed"
                       HorizontalAlignment="Center"
                       FontWeight="SemiBold"/>
            <TextBlock Grid.Column="4"
                       Text="Thu"
                       HorizontalAlignment="Center"
                       FontWeight="SemiBold"/>
            <TextBlock Grid.Column="5"
                       Text="Fri"
                       HorizontalAlignment="Center"
                       FontWeight="SemiBold"/>
            <TextBlock Grid.Column="6"
                       Text="Sat"
                       HorizontalAlignment="Center"
                       FontWeight="SemiBold"/>
            <TextBlock Grid.Column="7"
                       Text="Sun"
                       HorizontalAlignment="Center"
                       FontWeight="Bold"
                       Foreground="{StaticResource ErrorStrong}"/>
        </Grid>

        <ScrollViewer Grid.Row="2">
            <StackPanel>
                <Grid MinHeight="120"
                      BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Padding="12"
                                Background="{StaticResource SurfaceHover}">
                        <TextBlock Text="MORNING"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource BrandPrimary}"/>
                        <TextBlock Text="08:00-14:00"
                                   FontSize="10"
                                   Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1,0,0,0">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.MorningShifts[0], Mode=OneWay}"
                                      ItemTemplate="{StaticResource DayCellTemplate}"/>
                    </Border>
                    <Border Grid.Column="2"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1,0,0,0">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.MorningShifts[1], Mode=OneWay}"
                                      ItemTemplate="{StaticResource DayCellTemplate}"/>
                    </Border>
                    <Border Grid.Column="3"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1,0,0,0">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.MorningShifts[2], Mode=OneWay}"
                                      ItemTemplate="{StaticResource DayCellTemplate}"/>
                    </Border>
                    <Border Grid.Column="4"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1,0,0,0">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.MorningShifts[3], Mode=OneWay}"
                                      ItemTemplate="{StaticResource DayCellTemplate}"/>
                    </Border>
                    <Border Grid.Column="5"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1,0,0,0">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.MorningShifts[4], Mode=OneWay}"
                                      ItemTemplate="{StaticResource DayCellTemplate}"/>
                    </Border>
                    <Border Grid.Column="6"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1,0,0,0">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.MorningShifts[5], Mode=OneWay}"
                                      ItemTemplate="{StaticResource DayCellTemplate}"/>
                    </Border>
                    <Border Grid.Column="7"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1,0,0,0">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.MorningShifts[6], Mode=OneWay}"
                                      ItemTemplate="{StaticResource DayCellTemplate}"/>
                    </Border>
                </Grid>

                <Grid MinHeight="120"
                      BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Padding="12"
                                Background="{StaticResource SurfaceHover}">
                        <TextBlock Text="AFTERNOON"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#E67E22"/>
                        <TextBlock Text="14:00-18:00"
                                   FontSize="10"
                                   Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1,0,0,0">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.AfternoonShifts[0], Mode=OneWay}"
                                      ItemTemplate="{StaticResource DayCellTemplate}"/>
                    </Border>
                    <Border Grid.Column="2"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1,0,0,0">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.AfternoonShifts[1], Mode=OneWay}"
                                      ItemTemplate="{StaticResource DayCellTemplate}"/>
                    </Border>
                    <Border Grid.Column="3"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1,0,0,0">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.AfternoonShifts[2], Mode=OneWay}"
                                      ItemTemplate="{StaticResource DayCellTemplate}"/>
                    </Border>
                    <Border Grid.Column="4"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1,0,0,0">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.AfternoonShifts[3], Mode=OneWay}"
                                      ItemTemplate="{StaticResource DayCellTemplate}"/>
                    </Border>
                    <Border Grid.Column="5"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1,0,0,0">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.AfternoonShifts[4], Mode=OneWay}"
                                      ItemTemplate="{StaticResource DayCellTemplate}"/>
                    </Border>
                    <Border Grid.Column="6"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1,0,0,0">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.AfternoonShifts[5], Mode=OneWay}"
                                      ItemTemplate="{StaticResource DayCellTemplate}"/>
                    </Border>
                    <Border Grid.Column="7"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1,0,0,0">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.AfternoonShifts[6], Mode=OneWay}"
                                      ItemTemplate="{StaticResource DayCellTemplate}"/>
                    </Border>
                </Grid>

                <Grid MinHeight="120"
                      BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Padding="12"
                                Background="{StaticResource SurfaceHover}">
                        <TextBlock Text="EVENING"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#8E44AD"/>
                        <TextBlock Text="18:00-22:00"
                                   FontSize="10"
                                   Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1,0,0,0">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.EveningShifts[0], Mode=OneWay}"
                                      ItemTemplate="{StaticResource DayCellTemplate}"/>
                    </Border>
                    <Border Grid.Column="2"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1,0,0,0">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.EveningShifts[1], Mode=OneWay}"
                                      ItemTemplate="{StaticResource DayCellTemplate}"/>
                    </Border>
                    <Border Grid.Column="3"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1,0,0,0">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.EveningShifts[2], Mode=OneWay}"
                                      ItemTemplate="{StaticResource DayCellTemplate}"/>
                    </Border>
                    <Border Grid.Column="4"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1,0,0,0">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.EveningShifts[3], Mode=OneWay}"
                                      ItemTemplate="{StaticResource DayCellTemplate}"/>
                    </Border>
                    <Border Grid.Column="5"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1,0,0,0">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.EveningShifts[4], Mode=OneWay}"
                                      ItemTemplate="{StaticResource DayCellTemplate}"/>
                    </Border>
                    <Border Grid.Column="6"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1,0,0,0">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.EveningShifts[5], Mode=OneWay}"
                                      ItemTemplate="{StaticResource DayCellTemplate}"/>
                    </Border>
                    <Border Grid.Column="7"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1,0,0,0">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.EveningShifts[6], Mode=OneWay}"
                                      ItemTemplate="{StaticResource DayCellTemplate}"/>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>