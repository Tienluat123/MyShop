<UserControl
    x:Class="MyShop.Views.StaffManagement.Components.WeeklyRosterTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="0,16,0,0"
          Background="{StaticResource SurfaceBackground}"
          CornerRadius="{StaticResource RadiusMedium}"
          BorderBrush="{StaticResource BorderBrush}"
          BorderThickness="1"
          Padding="{StaticResource SpaceXLarge}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Background="{StaticResource SurfaceHover}"
              Padding="{StaticResource SpaceLarge_Medium}"
              CornerRadius="{StaticResource RadiusSmall}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Ca làm việc"
                       Style="{StaticResource StaffHeaderLabelTextStyle}"
                       FontWeight="{StaticResource FontWeightBold}"/>
            <TextBlock Grid.Column="1"
                       Text="Thứ 2"
                       Style="{StaticResource StaffHeaderLabelTextStyle}"
                       HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="2"
                       Text="Thứ 3"
                       Style="{StaticResource StaffHeaderLabelTextStyle}"
                       HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="3"
                       Text="Thứ 4"
                       Style="{StaticResource StaffHeaderLabelTextStyle}"
                       HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="4"
                       Text="Thứ 5"
                       Style="{StaticResource StaffHeaderLabelTextStyle}"
                       HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="5"
                       Text="Thứ 6"
                       Style="{StaticResource StaffHeaderLabelTextStyle}"
                       HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="6"
                       Text="Thứ 7"
                       Style="{StaticResource StaffHeaderLabelTextStyle}"
                       HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="7"
                       Text="Chủ Nhật"
                       Style="{StaticResource StaffHeaderLabelTextStyle}"
                       FontWeight="{StaticResource FontWeightBold}"
                       Foreground="{StaticResource ErrorStrong}"
                       HorizontalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1"
              Padding="16,16"
              BorderBrush="{StaticResource Gray100}"
              BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Top">
                <TextBlock Text="CA SÁNG"
                           Style="{StaticResource BodyTextStyle}"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrandPrimary}"/>
                <TextBlock Text="08:00 - 16:00"
                           Style="{StaticResource CaptionTextStyle}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Spacing="8"
                        Margin="4,0">
                <Button Background="{StaticResource SurfaceHover}"
                        BorderThickness="0"
                        CornerRadius="{StaticResource RadiusSmall}"
                        Padding="0,10"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Style="{StaticResource AppGhostButtonStyle}">
                    <TextBlock Text="NV001"
                               FontSize="{StaticResource FontCaption}"
                               Foreground="{StaticResource TextPrimary}"
                               FontWeight="{StaticResource FontWeightBold}"/>
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel Spacing="16"
                                        Width="260">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="12">
                                    <PersonPicture Initials="VN"
                                                   Width="42"
                                                   Height="42"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Nguyễn Văn Nam"
                                                   FontWeight="{StaticResource FontWeightBold}"
                                                   FontSize="{StaticResource FontSubtitle}"
                                                   Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="Mã NV: NV001"
                                                   FontSize="{StaticResource FontCaption}"
                                                   Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,0,1"/>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Ghi chú Ca Sáng - Thứ 2:"
                                               FontWeight="{StaticResource FontWeightSemiBold}"
                                               FontSize="{StaticResource FontBody}"
                                               Foreground="{StaticResource BrandPrimary}"/>
                                    <TextBox PlaceholderText="VD: Lau dọn quầy..."
                                             Height="{StaticResource Size70}"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             CornerRadius="{StaticResource RadiusSmall}"
                                             Foreground="{StaticResource TextPrimary}"/>
                                </StackPanel>
                                <Button Content="Lưu thông tin"
                                        Background="{StaticResource BrandPrimary}"
                                        Foreground="{StaticResource BrandPrimaryForeground}"
                                        HorizontalAlignment="Right"
                                        CornerRadius="{StaticResource RadiusSmall}"
                                        Padding="{StaticResource SpaceLarge_Small}"
                                        FontWeight="{StaticResource FontWeightSemiBold}"
                                        BorderThickness="0"
                                        Style="{StaticResource AppPrimaryButtonStyle}"/>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button Background="{StaticResource SurfaceHover}"
                        BorderThickness="0"
                        CornerRadius="{StaticResource RadiusSmall}"
                        Padding="0,10"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Style="{StaticResource AppGhostButtonStyle}">
                    <TextBlock Text="NV003"
                               FontSize="{StaticResource FontCaption}"
                               Foreground="{StaticResource TextPrimary}"
                               FontWeight="{StaticResource FontWeightBold}"/>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Spacing="8"
                        Margin="4,0"
                        VerticalAlignment="Center">
                <TextBlock Text="-"
                           Foreground="{StaticResource Gray300}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2"
              Padding="16,16"
              BorderBrush="{StaticResource Gray100}"
              BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Top">
                <TextBlock Text="CA CHIỀU"
                           Style="{StaticResource BodyTextStyle}"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource InfoStrong}"/>
                <TextBlock Text="14:00 - 22:00"
                           Style="{StaticResource CaptionTextStyle}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Spacing="8"
                        Margin="4,0">
                <Button Background="{StaticResource SurfaceHover}"
                        BorderThickness="0"
                        CornerRadius="{StaticResource RadiusSmall}"
                        Padding="0,10"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Style="{StaticResource AppGhostButtonStyle}">
                    <TextBlock Text="NV002"
                               FontSize="{StaticResource FontCaption}"
                               Foreground="{StaticResource TextPrimary}"
                               FontWeight="{StaticResource FontWeightBold}"/>
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel Spacing="16"
                                        Width="260">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="12">
                                    <PersonPicture Initials="TL"
                                                   Width="{StaticResource Size42}"
                                                   Height="{StaticResource Size42}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Trần Thị Lan"
                                                   FontWeight="{StaticResource FontWeightBold}"
                                                   FontSize="{StaticResource FontSubtitle}"
                                                   Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="Mã NV: NV002"
                                                   FontSize="{StaticResource FontCaption}"
                                                   Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,0,1"/>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Ghi chú Ca Chiều - Thứ 2:"
                                               FontWeight="{StaticResource FontWeightSemiBold}"
                                               FontSize="{StaticResource FontBody}"
                                               Foreground="{StaticResource BrandPrimary}"/>
                                    <TextBox PlaceholderText="Nhập ghi chú..."
                                             Height="{StaticResource Size70}"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             CornerRadius="{StaticResource RadiusSmall}"
                                             Foreground="{StaticResource TextPrimary}"/>
                                </StackPanel>
                                <Button Content="Lưu thông tin"
                                        Background="{StaticResource BrandPrimary}"
                                        Foreground="{StaticResource BrandPrimaryForeground}"
                                        HorizontalAlignment="Right"
                                        CornerRadius="{StaticResource RadiusSmall}"
                                        Padding="{StaticResource SpaceLarge_Small}"
                                        FontWeight="{StaticResource FontWeightSemiBold}"
                                        BorderThickness="0"
                                        Style="{StaticResource AppPrimaryButtonStyle}"/>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3"
              Padding="16,16"
              BorderBrush="{StaticResource Gray100}"
              BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Top">
                <TextBlock Text="CA TỐI"
                           Style="{StaticResource BodyTextStyle}"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource AccentPurple}"/>
                <TextBlock Text="18:00 - 02:00"
                           Style="{StaticResource CaptionTextStyle}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <TextBlock Grid.Column="1"
                       Text="-"
                       Foreground="{StaticResource Gray300}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2"
                       Text="-"
                       Foreground="{StaticResource Gray300}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Grid>

    </Grid>
</UserControl>