<UserControl
    x:Class="MyShop.Views.StaffManagement.Components.WeeklyRosterTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="0,16,0,0"
          Background="{StaticResource SurfaceBackground}"
          CornerRadius="12"
          BorderBrush="#E5E7EB"
          BorderThickness="1"
          Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Background="{StaticResource SurfaceHover}"
              Padding="16,12"
              CornerRadius="8"
              BorderBrush="#E5E7EB"
              BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Ca làm việc"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextSecondary}"
                       FontSize="13"/>
            <TextBlock Grid.Column="1"
                       Text="Thứ 2"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondary}"
                       FontSize="13"
                       HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="2"
                       Text="Thứ 3"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondary}"
                       FontSize="13"
                       HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="3"
                       Text="Thứ 4"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondary}"
                       FontSize="13"
                       HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="4"
                       Text="Thứ 5"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondary}"
                       FontSize="13"
                       HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="5"
                       Text="Thứ 6"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondary}"
                       FontSize="13"
                       HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="6"
                       Text="Thứ 7"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondary}"
                       FontSize="13"
                       HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="7"
                       Text="Chủ Nhật"
                       FontWeight="Bold"
                       Foreground="#DC2626"
                       FontSize="13"
                       HorizontalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1"
              Padding="16,16"
              BorderBrush="#F3F4F6"
              BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Top">
                <TextBlock Text="CA SÁNG"
                           FontWeight="Bold"
                           Foreground="#D97706"/>
                <TextBlock Text="08:00 - 16:00"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="11"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Spacing="8"
                        Margin="4,0">
                <Button Background="{StaticResource SurfaceHover}"
                        BorderThickness="0"
                        CornerRadius="8"
                        Padding="0,10"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center">
                    <TextBlock Text="NV001"
                               FontSize="12"
                               Foreground="{StaticResource TextPrimary}"
                               FontWeight="Bold"/>
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel Spacing="16"
                                        Width="260">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="12">
                                    <PersonPicture Initials="VN"
                                                   Width="42"
                                                   Height="42"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Nguyễn Văn Nam"
                                                   FontWeight="Bold"
                                                   FontSize="15"
                                                   Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="Mã NV: NV001"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border BorderBrush="#E5E7EB"
                                        BorderThickness="0,0,0,1"/>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Ghi chú Ca Sáng - Thứ 2:"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="{StaticResource BrandPrimary}"/>
                                    <TextBox PlaceholderText="VD: Lau dọn quầy..."
                                             Height="70"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             CornerRadius="6"
                                             Foreground="{StaticResource TextPrimary}"/>
                                </StackPanel>
                                <Button Content="Lưu thông tin"
                                        Background="{StaticResource BrandPrimary}"
                                        Foreground="{StaticResource BrandPrimaryForeground}"
                                        HorizontalAlignment="Right"
                                        CornerRadius="6"
                                        Padding="16,6"
                                        FontWeight="SemiBold"
                                        BorderThickness="0"/>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button Background="{StaticResource SurfaceHover}"
                        BorderThickness="0"
                        CornerRadius="8"
                        Padding="0,10"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center">
                    <TextBlock Text="NV003"
                               FontSize="12"
                               Foreground="{StaticResource TextPrimary}"
                               FontWeight="Bold"/>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Spacing="8"
                        Margin="4,0"
                        VerticalAlignment="Center">
                <TextBlock Text="-"
                           Foreground="#D1D5DB"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2"
              Padding="16,16"
              BorderBrush="#F3F4F6"
              BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Top">
                <TextBlock Text="CA CHIỀU"
                           FontWeight="Bold"
                           Foreground="#2563EB"/>
                <TextBlock Text="14:00 - 22:00"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="11"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Spacing="8"
                        Margin="4,0">
                <Button Background="{StaticResource SurfaceHover}"
                        BorderThickness="0"
                        CornerRadius="8"
                        Padding="0,10"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center">
                    <TextBlock Text="NV002"
                               FontSize="12"
                               Foreground="{StaticResource TextPrimary}"
                               FontWeight="Bold"/>
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel Spacing="16"
                                        Width="260">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="12">
                                    <PersonPicture Initials="TL"
                                                   Width="42"
                                                   Height="42"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Trần Thị Lan"
                                                   FontWeight="Bold"
                                                   FontSize="15"
                                                   Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="Mã NV: NV002"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border BorderBrush="#E5E7EB"
                                        BorderThickness="0,0,0,1"/>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Ghi chú Ca Chiều - Thứ 2:"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="{StaticResource BrandPrimary}"/>
                                    <TextBox PlaceholderText="Nhập ghi chú..."
                                             Height="70"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             CornerRadius="6"
                                             Foreground="{StaticResource TextPrimary}"/>
                                </StackPanel>
                                <Button Content="Lưu thông tin"
                                        Background="{StaticResource BrandPrimary}"
                                        Foreground="{StaticResource BrandPrimaryForeground}"
                                        HorizontalAlignment="Right"
                                        CornerRadius="6"
                                        Padding="16,6"
                                        FontWeight="SemiBold"
                                        BorderThickness="0"/>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3"
              Padding="16,16"
              BorderBrush="#F3F4F6"
              BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Top">
                <TextBlock Text="CA TỐI"
                           FontWeight="Bold"
                           Foreground="#7C3AED"/>
                <TextBlock Text="18:00 - 02:00"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="11"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <TextBlock Grid.Column="1"
                       Text="-"
                       Foreground="#D1D5DB"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2"
                       Text="-"
                       Foreground="#D1D5DB"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Grid>

    </Grid>
</UserControl>