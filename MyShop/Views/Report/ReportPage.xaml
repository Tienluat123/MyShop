<Page
    x:Class="MyShop.Views.Report.ReportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MyShop.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MyShop.Views.Report"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MyShop.Models"
    xmlns:viewmodels="using:MyShop.ViewModels"
    Name="RootPage"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:DateTimeToDateTimeOffsetConverter x:Key="DateConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:EqualityToBoolConverter x:Key="EqualityToBoolConverter" />
        <converters:CurrencyConverter x:Key="CurrencyConverter" />
        <converters:StringToBoolConverter x:Key="StringToBoolConverter" />

        <Style x:Key="RankingTabRadioStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            x:Name="Root"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SurfaceBackground}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Label" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TextPrimary}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <TextBlock
                                x:Name="Label"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="{TemplateBinding FontSize}"
                                FontWeight="{TemplateBinding FontWeight}"
                                Foreground="{TemplateBinding Foreground}"
                                Text="{TemplateBinding Content}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource BgPage}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ReportResponsiveStates">
                <VisualState x:Name="ReportMobileState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderGrid.Padding" Value="16,12" />
                        <Setter Target="HeaderContentStack.Orientation" Value="Vertical" />
                        <Setter Target="HeaderContentStack.Spacing" Value="8" />
                        <Setter Target="HeaderDateText.HorizontalAlignment" Value="Left" />
                        <Setter Target="HeaderDateText.Margin" Value="0,4,0,0" />
                        <Setter Target="FilterBarStack.Orientation" Value="Vertical" />
                        <Setter Target="FilterBarStack.Spacing" Value="12" />
                        <Setter Target="FilterUpdateButton.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="FilterUpdateButton.Margin" Value="0,8,0,0" />
                        <Setter Target="ReportScrollViewer.Padding" Value="16" />
                        <Setter Target="MetricsGrid.RowSpacing" Value="12" />
                        <Setter Target="MetricsGrid.ColumnSpacing" Value="12" />
                        <Setter Target="RevenueMetricCard.(Grid.Row)" Value="0" />
                        <Setter Target="RevenueMetricCard.(Grid.Column)" Value="0" />
                        <Setter Target="RevenueMetricCard.(Grid.ColumnSpan)" Value="4" />
                        <Setter Target="ProfitMetricCard.(Grid.Row)" Value="1" />
                        <Setter Target="ProfitMetricCard.(Grid.Column)" Value="0" />
                        <Setter Target="ProfitMetricCard.(Grid.ColumnSpan)" Value="4" />
                        <Setter Target="OrdersMetricCard.(Grid.Row)" Value="2" />
                        <Setter Target="OrdersMetricCard.(Grid.Column)" Value="0" />
                        <Setter Target="OrdersMetricCard.(Grid.ColumnSpan)" Value="4" />
                        <Setter Target="ProductsMetricCard.(Grid.Row)" Value="3" />
                        <Setter Target="ProductsMetricCard.(Grid.Column)" Value="0" />
                        <Setter Target="ProductsMetricCard.(Grid.ColumnSpan)" Value="4" />
                        <Setter Target="TrendsActionsPanel.Orientation" Value="Vertical" />
                        <Setter Target="TrendsActionsPanel.HorizontalAlignment" Value="Left" />
                        <Setter Target="RankingTabsPanel.Orientation" Value="Horizontal" />
                        <Setter Target="ProductRankingGrid.(Grid.Row)" Value="0" />
                        <Setter Target="ProductRankingGrid.(Grid.Column)" Value="0" />
                        <Setter Target="ProductRankingGrid.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="ProductRankingList.(Grid.Row)" Value="1" />
                        <Setter Target="ProductRankingList.(Grid.Column)" Value="0" />
                        <Setter Target="ProductRankingList.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="ProductRankingPager.(Grid.Row)" Value="2" />
                        <Setter Target="ProductRankingPager.(Grid.Column)" Value="0" />
                        <Setter Target="ProductRankingPager.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="CategoryRankingGrid.(Grid.Row)" Value="0" />
                        <Setter Target="CategoryRankingGrid.(Grid.Column)" Value="0" />
                        <Setter Target="CategoryRankingGrid.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="CategoryRankingList.(Grid.Row)" Value="1" />
                        <Setter Target="CategoryRankingList.(Grid.Column)" Value="0" />
                        <Setter Target="CategoryRankingList.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="ExpenseFormBorder.(Grid.Row)" Value="0" />
                        <Setter Target="ExpenseFormBorder.(Grid.Column)" Value="0" />
                        <Setter Target="ExpenseFormBorder.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="ExpenseListBorder.(Grid.Row)" Value="1" />
                        <Setter Target="ExpenseListBorder.(Grid.Column)" Value="0" />
                        <Setter Target="ExpenseListBorder.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="ExpenseFieldsGrid.ColumnSpacing" Value="8" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="ReportTabletState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource BreakpointTablet}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderGrid.Padding" Value="20,14" />
                        <Setter Target="HeaderContentStack.Orientation" Value="Horizontal" />
                        <Setter Target="HeaderContentStack.Spacing" Value="12" />
                        <Setter Target="HeaderDateText.HorizontalAlignment" Value="Right" />
                        <Setter Target="HeaderDateText.Margin" Value="0" />
                        <Setter Target="FilterBarStack.Orientation" Value="Vertical" />
                        <Setter Target="FilterBarStack.Spacing" Value="12" />
                        <Setter Target="FilterUpdateButton.HorizontalAlignment" Value="Left" />
                        <Setter Target="FilterUpdateButton.Margin" Value="0,8,0,0" />
                        <Setter Target="ReportScrollViewer.Padding" Value="20" />
                        <Setter Target="MetricsGrid.RowSpacing" Value="16" />
                        <Setter Target="MetricsGrid.ColumnSpacing" Value="16" />
                        <Setter Target="RevenueMetricCard.(Grid.Row)" Value="0" />
                        <Setter Target="RevenueMetricCard.(Grid.Column)" Value="0" />
                        <Setter Target="RevenueMetricCard.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="ProfitMetricCard.(Grid.Row)" Value="0" />
                        <Setter Target="ProfitMetricCard.(Grid.Column)" Value="2" />
                        <Setter Target="ProfitMetricCard.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="OrdersMetricCard.(Grid.Row)" Value="1" />
                        <Setter Target="OrdersMetricCard.(Grid.Column)" Value="0" />
                        <Setter Target="OrdersMetricCard.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="ProductsMetricCard.(Grid.Row)" Value="1" />
                        <Setter Target="ProductsMetricCard.(Grid.Column)" Value="2" />
                        <Setter Target="ProductsMetricCard.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="TrendsActionsPanel.Orientation" Value="Horizontal" />
                        <Setter Target="TrendsActionsPanel.HorizontalAlignment" Value="Right" />
                        <Setter Target="ProductRankingGrid.(Grid.Row)" Value="0" />
                        <Setter Target="ProductRankingGrid.(Grid.Column)" Value="0" />
                        <Setter Target="ProductRankingGrid.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="ProductRankingList.(Grid.Row)" Value="1" />
                        <Setter Target="ProductRankingList.(Grid.Column)" Value="0" />
                        <Setter Target="ProductRankingList.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="ProductRankingPager.(Grid.Row)" Value="2" />
                        <Setter Target="ProductRankingPager.(Grid.Column)" Value="0" />
                        <Setter Target="ProductRankingPager.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="CategoryRankingGrid.(Grid.Row)" Value="0" />
                        <Setter Target="CategoryRankingGrid.(Grid.Column)" Value="0" />
                        <Setter Target="CategoryRankingGrid.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="CategoryRankingList.(Grid.Row)" Value="1" />
                        <Setter Target="CategoryRankingList.(Grid.Column)" Value="0" />
                        <Setter Target="CategoryRankingList.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="ExpenseFormBorder.(Grid.Row)" Value="0" />
                        <Setter Target="ExpenseFormBorder.(Grid.Column)" Value="0" />
                        <Setter Target="ExpenseFormBorder.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="ExpenseListBorder.(Grid.Row)" Value="1" />
                        <Setter Target="ExpenseListBorder.(Grid.Column)" Value="0" />
                        <Setter Target="ExpenseListBorder.(Grid.ColumnSpan)" Value="2" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="ReportDesktopState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource BreakpointDesktop}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderGrid.Padding" Value="24,16" />
                        <Setter Target="HeaderContentStack.Orientation" Value="Horizontal" />
                        <Setter Target="HeaderContentStack.Spacing" Value="12" />
                        <Setter Target="HeaderDateText.HorizontalAlignment" Value="Right" />
                        <Setter Target="HeaderDateText.Margin" Value="0" />
                        <Setter Target="FilterBarStack.Orientation" Value="Horizontal" />
                        <Setter Target="FilterBarStack.Spacing" Value="24" />
                        <Setter Target="FilterUpdateButton.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="FilterUpdateButton.Margin" Value="0" />
                        <Setter Target="ReportScrollViewer.Padding" Value="24" />
                        <Setter Target="MetricsGrid.RowSpacing" Value="0" />
                        <Setter Target="MetricsGrid.ColumnSpacing" Value="16" />
                        <Setter Target="RevenueMetricCard.(Grid.Row)" Value="0" />
                        <Setter Target="RevenueMetricCard.(Grid.Column)" Value="0" />
                        <Setter Target="RevenueMetricCard.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="ProfitMetricCard.(Grid.Row)" Value="0" />
                        <Setter Target="ProfitMetricCard.(Grid.Column)" Value="1" />
                        <Setter Target="ProfitMetricCard.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="OrdersMetricCard.(Grid.Row)" Value="0" />
                        <Setter Target="OrdersMetricCard.(Grid.Column)" Value="2" />
                        <Setter Target="OrdersMetricCard.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="ProductsMetricCard.(Grid.Row)" Value="0" />
                        <Setter Target="ProductsMetricCard.(Grid.Column)" Value="3" />
                        <Setter Target="ProductsMetricCard.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="TrendsActionsPanel.Orientation" Value="Horizontal" />
                        <Setter Target="TrendsActionsPanel.HorizontalAlignment" Value="Right" />
                        <Setter Target="ProductRankingGrid.(Grid.Row)" Value="0" />
                        <Setter Target="ProductRankingGrid.(Grid.Column)" Value="0" />
                        <Setter Target="ProductRankingGrid.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="ProductRankingList.(Grid.Row)" Value="0" />
                        <Setter Target="ProductRankingList.(Grid.Column)" Value="1" />
                        <Setter Target="ProductRankingList.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="ProductRankingPager.(Grid.Row)" Value="1" />
                        <Setter Target="ProductRankingPager.(Grid.Column)" Value="1" />
                        <Setter Target="ProductRankingPager.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="CategoryRankingGrid.(Grid.Row)" Value="0" />
                        <Setter Target="CategoryRankingGrid.(Grid.Column)" Value="0" />
                        <Setter Target="CategoryRankingGrid.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="CategoryRankingList.(Grid.Row)" Value="0" />
                        <Setter Target="CategoryRankingList.(Grid.Column)" Value="1" />
                        <Setter Target="CategoryRankingList.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="ExpenseFormBorder.(Grid.Row)" Value="0" />
                        <Setter Target="ExpenseFormBorder.(Grid.Column)" Value="0" />
                        <Setter Target="ExpenseFormBorder.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="ExpenseListBorder.(Grid.Row)" Value="0" />
                        <Setter Target="ExpenseListBorder.(Grid.Column)" Value="1" />
                        <Setter Target="ExpenseListBorder.(Grid.ColumnSpan)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!--  Header  -->
            <RowDefinition Height="Auto" />
            <!--  Filter Bar  -->
            <RowDefinition Height="*" />
            <!--  Content  -->
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid
            x:Name="HeaderGrid"
            Grid.Row="0"
            Padding="24,16"
            Background="{StaticResource SurfaceBackground}"
            BorderBrush="{StaticResource Gray100}"
            BorderThickness="0,0,0,1">
            <StackPanel x:Name="HeaderContentStack" Orientation="Horizontal" Spacing="12">
                <Border
                    Width="36"
                    Height="36"
                    Background="{StaticResource IconSelectedBgBrush}"
                    CornerRadius="11">
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="18"
                        Foreground="White"
                        Glyph="&#xE9D2;" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        FontWeight="Bold"
                        LineHeight="14"
                        Style="{StaticResource BodyTextStyle}"
                        Text="Reports" />
                    <TextBlock Style="{StaticResource CaptionMutedTextStyle}" Text="Statistics &amp; Advanced Analysis" />
                </StackPanel>
            </StackPanel>
            <TextBlock
                x:Name="HeaderDateText"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Style="{StaticResource BodyMutedTextStyle}"
                Text="{x:Bind ViewModel.EndDate, Mode=OneWay, Converter={StaticResource DateConverter}}" />
        </Grid>

        <!--  Filter Bar  -->
        <Grid
            Grid.Row="1"
            Padding="24,12"
            Background="{StaticResource SurfaceBackground}"
            BorderBrush="{StaticResource SurfaceAlt}"
            BorderThickness="0,0,0,1">
            <StackPanel
                x:Name="FilterBarStack"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="24">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextStyle}"
                        Text="Range" />
                    <ComboBox
                        Width="160"
                        CornerRadius="8"
                        ItemsSource="{x:Bind ViewModel.DatePresets}"
                        SelectedItem="{x:Bind ViewModel.SelectedDatePreset, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextStyle}"
                        Text="Granularity" />
                    <ComboBox
                        Width="120"
                        CornerRadius="8"
                        ItemsSource="{x:Bind ViewModel.AvailablePeriods}"
                        SelectedItem="{x:Bind ViewModel.SelectedPeriod, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextStyle}"
                        Text="Scope" />
                    <ComboBox
                        Width="140"
                        CornerRadius="8"
                        ItemsSource="{x:Bind ViewModel.CategoryScopes}"
                        SelectedItem="{x:Bind ViewModel.SelectedCategoryScope, Mode=TwoWay}" />
                </StackPanel>

                <!--  Custom Range Inputs  -->
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="16"
                    Visibility="{x:Bind ViewModel.IsCustomRangeVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    
                    <!--  Day/Week: Date Pickers  -->
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="16"
                        Visibility="{x:Bind ViewModel.IsDayWeekVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock VerticalAlignment="Center" Text="From" Style="{StaticResource CaptionTextStyle}" />
                            <CalendarDatePicker Date="{x:Bind ViewModel.StartDate, Mode=TwoWay, Converter={StaticResource DateConverter}}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock VerticalAlignment="Center" Text="To" Style="{StaticResource CaptionTextStyle}" />
                            <CalendarDatePicker Date="{x:Bind ViewModel.EndDate, Mode=TwoWay, Converter={StaticResource DateConverter}}" />
                        </StackPanel>
                    </StackPanel>

                    <!--  Month Picker  -->
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="16"
                        Visibility="{x:Bind ViewModel.IsMonthVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock VerticalAlignment="Center" Text="From" Style="{StaticResource CaptionTextStyle}" />
                            <ComboBox ItemsSource="{x:Bind ViewModel.Months}" SelectedItem="{x:Bind ViewModel.StartMonth, Mode=TwoWay}" MinWidth="80" />
                            <ComboBox ItemsSource="{x:Bind ViewModel.Years}" SelectedItem="{x:Bind ViewModel.StartYear, Mode=TwoWay}" MinWidth="100" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock VerticalAlignment="Center" Text="To" Style="{StaticResource CaptionTextStyle}" />
                            <ComboBox ItemsSource="{x:Bind ViewModel.Months}" SelectedItem="{x:Bind ViewModel.EndMonth, Mode=TwoWay}" MinWidth="80" />
                            <ComboBox ItemsSource="{x:Bind ViewModel.Years}" SelectedItem="{x:Bind ViewModel.EndYear, Mode=TwoWay}" MinWidth="100" />
                        </StackPanel>
                    </StackPanel>

                    <!--  Year Picker  -->
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="16"
                        Visibility="{x:Bind ViewModel.IsYearVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock VerticalAlignment="Center" Text="From" Style="{StaticResource CaptionTextStyle}" />
                            <ComboBox ItemsSource="{x:Bind ViewModel.Years}" SelectedItem="{x:Bind ViewModel.StartYear, Mode=TwoWay}" MinWidth="100" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock VerticalAlignment="Center" Text="To" Style="{StaticResource CaptionTextStyle}" />
                            <ComboBox ItemsSource="{x:Bind ViewModel.Years}" SelectedItem="{x:Bind ViewModel.EndYear, Mode=TwoWay}" MinWidth="100" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Button
                    x:Name="FilterUpdateButton"
                    Height="36"
                    Padding="20,0"
                    Click="FilterButton_Click"
                    Content="Update"
                    CornerRadius="8"
                    Style="{StaticResource AppPrimaryButtonStyle}" />
            </StackPanel>
        </Grid>

        <!--  Main Content  -->
        <ScrollViewer
            x:Name="ReportScrollViewer"
            Grid.Row="2"
            Padding="24"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="32">

                <!--  Tier 1: Financial Overview  -->
                <Grid x:Name="MetricsGrid"
                      ColumnSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <local:MetricCard
                        x:Name="OrdersMetricCard"
                        Grid.Column="2"
                        Color="{StaticResource WarningColor}"
                        Icon="&#xE7BF;"
                        Label="Orders"
                        Value="{x:Bind ViewModel.OrdersCount, Mode=OneWay}" />
                    <local:MetricCard
                        x:Name="ProductsMetricCard"
                        Grid.Column="3"
                        Color="{StaticResource SecondaryColor}"
                        Icon="&#xE8B9;"
                        Label="Products"
                        Value="{x:Bind ViewModel.ProductsCount, Mode=OneWay}" />
                    <local:MetricCard
                        x:Name="RevenueMetricCard"
                        Grid.Column="0"
                        Color="{StaticResource SuccessColor}"
                        Icon="&#xE8A1;"
                        Label="Revenue"
                        Value="{x:Bind ViewModel.TotalRevenue, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" />
                    <local:MetricCard
                        x:Name="ProfitMetricCard"
                        Grid.Column="1"
                        Color="{StaticResource PrimaryColor}"
                        Icon="&#xE9D2;"
                        Label="Profit"
                        Value="{x:Bind ViewModel.TotalProfit, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" />
                </Grid>

                <!--  Tier 2: Performance Trends  -->
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Padding="24"
                        Background="{StaticResource SurfaceBackground}"
                        BorderBrush="{StaticResource SurfaceAlt}"
                        BorderThickness="1"
                        CornerRadius="16">
                        <StackPanel Spacing="16">
                            <Grid>
                                <TextBlock Style="{StaticResource SubtitleTextStyle}" Text="Performance Trends" />
                                <StackPanel
                                    x:Name="TrendsActionsPanel"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <RadioButton
                                        Content="Sales"
                                        GroupName="TrendType"
                                        IsChecked="{Binding SelectedTrendType, Mode=TwoWay, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter='Sales'}"
                                        Style="{StaticResource ToggleButtonStyle}" />
                                    <RadioButton
                                        Content="Revenue"
                                        GroupName="TrendType"
                                        IsChecked="{Binding SelectedTrendType, Mode=TwoWay, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter='Revenue'}"
                                        Style="{StaticResource ToggleButtonStyle}" />
                                    <RadioButton
                                        Content="Profit"
                                        GroupName="TrendType"
                                        IsChecked="{Binding SelectedTrendType, Mode=TwoWay, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter='Profit'}"
                                        Style="{StaticResource ToggleButtonStyle}" />
                                </StackPanel>
                            </Grid>
                            <Border
                                Height="350"
                                Padding="12"
                                Background="#F8FAFC"
                                CornerRadius="12">
                                <ScrollViewer
                                    HorizontalScrollBarVisibility="Auto"
                                    HorizontalScrollMode="Enabled"
                                    VerticalScrollMode="Disabled">
                                    <Canvas x:Name="TrendsCanvas" Height="300" VerticalAlignment="Top" />
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!--  Tier 3: Advanced Rankings  -->
                <Border
                    Padding="24"
                    Background="{StaticResource SurfaceBackground}"
                    BorderBrush="{StaticResource SurfaceAlt}"
                    BorderThickness="1"
                    CornerRadius="16">
                    <Grid RowSpacing="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource SubtitleTextStyle}" Text="Performance Rankings" />
                                <TextBlock Style="{StaticResource CaptionMutedTextStyle}" Text="Growth &amp; volume analysis" />
                            </StackPanel>

                            <!--  Tabs  -->
                            <Border
                                Grid.Column="1"
                                Padding="4"
                                Background="{StaticResource SurfaceAlt}"
                                CornerRadius="10">
                                <StackPanel x:Name="RankingTabsPanel" Orientation="Horizontal" Spacing="4">
                                    <RadioButton
                                        Height="34"
                                        Content="Products"
                                        GroupName="RankingTabs"
                                        IsChecked="{Binding SelectedAnalyticsMode, Mode=TwoWay, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter='Top Products'}"
                                        Style="{StaticResource RankingTabRadioStyle}" />
                                    <RadioButton
                                        Height="34"
                                        Content="Categories"
                                        GroupName="RankingTabs"
                                        IsChecked="{Binding SelectedAnalyticsMode, Mode=TwoWay, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter='Top Categories'}"
                                        Style="{StaticResource RankingTabRadioStyle}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!--  Ranking Content Area  -->
                        <Grid Grid.Row="1">
                            <!--  Products Tab  -->
                            <Grid x:Name="ProductRankingGrid" Visibility="{x:Bind ViewModel.IsTopProductsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="300" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Canvas
                                    x:Name="RankingChartCanvas"
                                    Width="250"
                                    Height="250"
                                    Margin="0,20,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top" />

                                <ItemsControl x:Name="ProductRankingList" Grid.Column="1" ItemsSource="{x:Bind ViewModel.PagedTopProducts, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:RankingPoint">
                                            <Grid
                                                Padding="0,12"
                                                BorderBrush="{StaticResource SurfaceAlt}"
                                                BorderThickness="0,0,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontWeight="Medium"
                                                    Text="{x:Bind Name}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Width="80"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource CaptionTextStyle}"
                                                    Text="{x:Bind Volume}"
                                                    TextAlignment="Right" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Width="120"
                                                    VerticalAlignment="Center"
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind Amount, Converter={StaticResource CurrencyConverter}}"
                                                    TextAlignment="Right" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!--  Paging Controls  -->
                                <StackPanel
                                    x:Name="ProductRankingPager"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="0,16,0,0"
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="16">
                                    <Button Command="{x:Bind ViewModel.PrevPageCommand, Mode=OneWay}" Style="{StaticResource AppSecondaryButtonStyle}">
                                        <FontIcon FontSize="14" Glyph="&#xE72B;" />
                                    </Button>
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
                                        <TextBlock Foreground="{StaticResource Gray500}" Text="Page" />
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.CurrentPage, Mode=OneWay}" />
                                        <TextBlock Foreground="{StaticResource Gray500}" Text="of" />
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.TotalPages, Mode=OneWay}" />
                                    </StackPanel>
                                    <Button Command="{x:Bind ViewModel.NextPageCommand, Mode=OneWay}" Style="{StaticResource AppSecondaryButtonStyle}">
                                        <FontIcon FontSize="14" Glyph="&#xE72A;" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!--  Categories Tab  -->
                            <Grid x:Name="CategoryRankingGrid" Visibility="{x:Bind ViewModel.IsTopCategoriesSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="300" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Canvas
                                    x:Name="CategoryChartCanvas"
                                    Width="250"
                                    Height="250"
                                    Margin="0,20,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top" />

                                <ItemsControl x:Name="CategoryRankingList" Grid.Column="1" ItemsSource="{x:Bind ViewModel.CategoryProfit, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:ProfitPoint">
                                            <Grid
                                                Padding="0,12"
                                                BorderBrush="{StaticResource SurfaceAlt}"
                                                BorderThickness="0,0,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Spacing="12">
                                                    <Ellipse
                                                        Width="10"
                                                        Height="10"
                                                        Fill="{x:Bind Color}" />
                                                    <TextBlock FontWeight="Medium" Text="{x:Bind Category}" />
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind Amount, Converter={StaticResource CurrencyConverter}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!--  Tier 4: Operating Expenses  -->
                <Grid x:Name="ExpenseGrid" ColumnSpacing="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  Add Expense Form  -->
                    <Border
                        x:Name="ExpenseFormBorder"
                        Padding="24"
                        Background="{StaticResource SurfaceBackground}"
                        BorderBrush="{StaticResource SurfaceAlt}"
                        BorderThickness="1"
                        CornerRadius="16">
                        <StackPanel Spacing="20">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border
                                    Width="32"
                                    Height="32"
                                    Background="{StaticResource WarningSurface}"
                                    CornerRadius="8">
                                    <FontIcon
                                        FontSize="16"
                                        Foreground="{StaticResource BrandPrimary}"
                                        Glyph="&#xE825;" />
                                </Border>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SubtitleTextStyle}"
                                    Text="Log Overhead" />
                            </StackPanel>

                            <StackPanel Spacing="16">
                                <TextBox
                                    Header="Description"
                                    PlaceholderText="Rent, Utilities, Supplies..."
                                    CornerRadius="8"
                                    Text="{x:Bind ViewModel.NewExpenseTitle, Mode=TwoWay}" />
                                <Grid x:Name="ExpenseFieldsGrid" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <NumberBox
                                        Header="Amount"
                                        PlaceholderText="0.00"
                                        CornerRadius="8"
                                        SpinButtonPlacementMode="Compact"
                                        Value="{x:Bind ViewModel.NewExpenseAmount, Mode=TwoWay}" />
                                    <ComboBox
                                        Grid.Column="1"
                                        Header="Category"
                                        CornerRadius="8"
                                        HorizontalAlignment="Stretch"
                                        ItemsSource="{x:Bind ViewModel.ExpenseCategories}"
                                        SelectedItem="{x:Bind ViewModel.NewExpenseCategory, Mode=TwoWay}" />
                                </Grid>
                                <Button
                                    HorizontalAlignment="Stretch"
                                    Command="{x:Bind ViewModel.AddExpenseCommand}"
                                    Content="Add to Records"
                                    CornerRadius="8"
                                    Style="{StaticResource AppPrimaryButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!--  Recent Expenses List  -->
                    <Border
                        x:Name="ExpenseListBorder"
                        Grid.Column="1"
                        Padding="24"
                        Background="{StaticResource SurfaceBackground}"
                        BorderBrush="{StaticResource SurfaceAlt}"
                        BorderThickness="1"
                        CornerRadius="16">
                        <StackPanel Spacing="16">
                            <TextBlock Style="{StaticResource SubtitleTextStyle}" Text="Recent History" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.RecentExpenses, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:Expense">
                                        <Grid Padding="0,12" BorderBrush="{StaticResource SurfaceAlt}" BorderThickness="0,0,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
                                                <TextBlock Foreground="{StaticResource TextSecondary}" Style="{StaticResource CaptionTextStyle}" Text="{x:Bind Category}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Margin="24,0" VerticalAlignment="Center" Style="{StaticResource CaptionMutedTextStyle}" Text="{x:Bind Date, Converter={StaticResource DateConverter}}" />
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource Error}" Text="{x:Bind Amount, Converter={StaticResource CurrencyConverter}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock HorizontalAlignment="Center" Margin="0,8,0,0" Opacity="0.5" Style="{StaticResource CaptionTextStyle}" Text="Showing last 5 entries for current selection" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
