<Page
    x:Class="MyShop.Views.Report.ReportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MyShop.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MyShop.Views.Report"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:MyShop.ViewModels"
    xmlns:models="using:MyShop.Models"
    Name="RootPage"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:DateTimeToDateTimeOffsetConverter x:Key="DateConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:EqualityToBoolConverter x:Key="EqualityToBoolConverter" />
        <converters:CurrencyConverter x:Key="CurrencyConverter" />
        <converters:StringToBoolConverter x:Key="StringToBoolConverter" />
    </Page.Resources>

    <Grid Background="{StaticResource BgPage}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!--  Header  -->
            <RowDefinition Height="Auto" />
            <!--  Filter Bar  -->
            <RowDefinition Height="*" />
            <!--  Content  -->
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid
            Grid.Row="0"
            Padding="24,16"
            Background="{StaticResource SurfaceBackground}"
            BorderBrush="{StaticResource Gray100}"
            BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border
                    Width="36"
                    Height="36"
                    Background="{StaticResource IconSelectedBgBrush}"
                    CornerRadius="11">
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="18"
                        Foreground="White"
                        Glyph="&#xE9D2;" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        FontWeight="Bold"
                        LineHeight="14"
                        Style="{StaticResource BodyTextStyle}"
                        Text="Reports" />
                    <TextBlock Style="{StaticResource CaptionMutedTextStyle}" Text="Statistics &amp; Advanced Analysis" />
                </StackPanel>
            </StackPanel>
            <TextBlock
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Style="{StaticResource BodyMutedTextStyle}"
                Text="{x:Bind ViewModel.EndDate, Mode=OneWay, Converter={StaticResource DateConverter}}" />
        </Grid>

        <!--  Filter Bar  -->
        <Grid
            Grid.Row="1"
            Padding="24,12"
            Background="{StaticResource SurfaceBackground}"
            BorderBrush="{StaticResource SurfaceAlt}"
            BorderThickness="0,0,0,1">
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="24">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextStyle}"
                        Text="Range" />
                    <ComboBox
                        Width="160"
                        CornerRadius="8"
                        ItemsSource="{x:Bind ViewModel.DatePresets}"
                        SelectedItem="{x:Bind ViewModel.SelectedDatePreset, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextStyle}"
                        Text="Granularity" />
                    <ComboBox
                        Width="120"
                        CornerRadius="8"
                        ItemsSource="{x:Bind ViewModel.AvailablePeriods}"
                        SelectedItem="{x:Bind ViewModel.SelectedPeriod, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextStyle}"
                        Text="Scope" />
                    <ComboBox
                        Width="140"
                        CornerRadius="8"
                        ItemsSource="{x:Bind ViewModel.CategoryScopes}"
                        SelectedItem="{x:Bind ViewModel.SelectedCategoryScope, Mode=TwoWay}" />
                </StackPanel>

                <Button
                    Height="36"
                    Padding="20,0"
                    Click="FilterButton_Click"
                    Content="Update"
                    CornerRadius="8"
                    Style="{StaticResource AppPrimaryButtonStyle}" />
            </StackPanel>
        </Grid>

        <!--  Main Content  -->
        <ScrollViewer
            Grid.Row="2"
            Padding="24"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="32">

                <!--  Tier 1: Financial Overview  -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <local:MetricCard
                        Grid.Column="2"
                        Icon="&#xE7BF;"
                        Label="Orders"
                        Color="{StaticResource WarningColor}"
                        Value="{x:Bind ViewModel.OrdersCount, Mode=OneWay}" />
                    <local:MetricCard
                        Grid.Column="3"
                        Icon="&#xE8B9;"
                        Label="Products"
                        Color="{StaticResource SecondaryColor}"
                        Value="{x:Bind ViewModel.ProductsCount, Mode=OneWay}" />
                    <local:MetricCard
                        Grid.Column="0"
                        Icon="&#xE8A1;"
                        Label="Revenue"
                        Color="{StaticResource SuccessColor}"
                        Value="{x:Bind ViewModel.TotalRevenue, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" />
                    <local:MetricCard
                        Grid.Column="1"
                        Icon="&#xE9D2;"
                        Label="Profit"
                        Color="{StaticResource PrimaryColor}"
                        Value="{x:Bind ViewModel.TotalProfit, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" />
                </Grid>

                <!--  Tier 2: Performance Trends  -->
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Padding="24"
                        Background="{StaticResource SurfaceBackground}"
                        BorderBrush="{StaticResource SurfaceAlt}"
                        BorderThickness="1"
                        CornerRadius="16">
                        <StackPanel Spacing="16">
                            <Grid>
                                <TextBlock Style="{StaticResource SubtitleTextStyle}" Text="Performance Trends" />
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                    <RadioButton Content="Sales" GroupName="TrendType" IsChecked="{Binding SelectedTrendType, Mode=TwoWay, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter='Sales'}" Style="{StaticResource ToggleButtonStyle}" />
                                    <RadioButton Content="Revenue" GroupName="TrendType" IsChecked="{Binding SelectedTrendType, Mode=TwoWay, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter='Revenue'}" Style="{StaticResource ToggleButtonStyle}" />
                                    <RadioButton Content="Profit" GroupName="TrendType" IsChecked="{Binding SelectedTrendType, Mode=TwoWay, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter='Profit'}" Style="{StaticResource ToggleButtonStyle}" />
                                </StackPanel>
                            </Grid>
                            <Border
                                Height="350"
                                Padding="12"
                                Background="#F8FAFC"
                                CornerRadius="12">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                                    <Canvas x:Name="TrendsCanvas" Height="300" VerticalAlignment="Top" />
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!--  Tier 3: Advanced Rankings  -->
                <Border
                    Padding="24"
                    Background="{StaticResource SurfaceBackground}"
                    BorderBrush="{StaticResource SurfaceAlt}"
                    BorderThickness="1"
                    CornerRadius="16">
                    <Grid RowSpacing="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource SubtitleTextStyle}" Text="Performance Rankings" />
                                <TextBlock Style="{StaticResource CaptionMutedTextStyle}" Text="Growth &amp; volume analysis" />
                            </StackPanel>

                            <!--  Tabs  -->
                            <Border
                                Grid.Column="1"
                                Padding="4"
                                Background="{StaticResource SurfaceAlt}"
                                CornerRadius="10">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <ToggleButton
                                        Height="34"
                                        Content="Products"
                                        CornerRadius="8"
                                        IsChecked="{x:Bind ViewModel.IsTopProductsSelected, Mode=TwoWay}"
                                        Style="{StaticResource AppToggleButtonStyle}" />
                                    <ToggleButton
                                        Height="34"
                                        Content="Categories"
                                        CornerRadius="8"
                                        IsChecked="{x:Bind ViewModel.IsTopCategoriesSelected, Mode=TwoWay}"
                                        Style="{StaticResource AppToggleButtonStyle}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!--  Ranking List  -->
                        <ItemsControl
                            Grid.Row="1"
                            ItemsSource="{x:Bind ViewModel.TopProducts, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsTopProductsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:RankingPoint">
                                    <Grid
                                        Padding="0,12"
                                        BorderBrush="{StaticResource SurfaceAlt}"
                                        BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontWeight="Medium"
                                            Text="{x:Bind Name}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Width="80"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource CaptionTextStyle}"
                                            Text="{x:Bind Volume}"
                                            TextAlignment="Right" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Width="120"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Amount, Converter={StaticResource CurrencyConverter}}"
                                            TextAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--  Categories List  -->
                        <ItemsControl
                            Grid.Row="1"
                            ItemsSource="{x:Bind ViewModel.CategoryProfit, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsTopCategoriesSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ProfitPoint">
                                    <Grid
                                        Padding="0,12"
                                        BorderBrush="{StaticResource SurfaceAlt}"
                                        BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <Ellipse
                                                Width="10"
                                                Height="10"
                                                Fill="{x:Bind Color}" />
                                            <TextBlock FontWeight="Medium" Text="{x:Bind Category}" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="1"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Amount, Converter={StaticResource CurrencyConverter}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
