<Page
    x:Class="MyShop.Views.Report.ReportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:MyShop.ViewModels"
    xmlns:converters="using:MyShop.Converters"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:DateTimeToDateTimeOffsetConverter x:Key="DateConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Page.Resources>

    <Grid Background="{StaticResource BgPage}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Filter Bar -->
            <RowDefinition Height="*"/>    <!-- Content -->
        </Grid.RowDefinitions>

        <!-- Header (Matching POS Style) -->
        <Grid Grid.Row="0" Padding="24,16" Background="{StaticResource SurfaceBackground}" BorderBrush="{StaticResource Gray100}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Width="36" Height="36" Background="{StaticResource IconSelectedBgBrush}" CornerRadius="11">
                    <FontIcon Glyph="&#xE9D2;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource BodyTextStyle}" FontWeight="Bold" Text="Reports" LineHeight="14"/>
                    <TextBlock Style="{StaticResource CaptionMutedTextStyle}" Text="Statistics &amp; Analysis"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource BodyMutedTextStyle}" Text="{x:Bind    ViewModel.EndDate, Mode=OneWay, Converter={StaticResource DateConverter}}"/>
            </StackPanel>
        </Grid>

        <!-- Filter Bar -->
        <Grid Grid.Row="1" Padding="24,12" Background="{StaticResource SurfaceBackground}" BorderBrush="{StaticResource SurfaceAlt}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                
                <!-- Date Presets -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Range" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{x:Bind ViewModel.DatePresets}" 
                              SelectedItem="{x:Bind ViewModel.SelectedDatePreset, Mode=TwoWay}" 
                              Width="160" CornerRadius="8" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Granularity (Always Visible) -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Granularity" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{x:Bind ViewModel.AvailablePeriods}" 
                              SelectedItem="{x:Bind ViewModel.SelectedPeriod, Mode=TwoWay}" 
                              Width="120" CornerRadius="8" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Custom Range (Conditional) -->
                <StackPanel Orientation="Horizontal" Spacing="24" Visibility="{x:Bind ViewModel.IsCustomRangeVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <!-- Day/Week Range -->
                    <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{x:Bind ViewModel.IsDayWeekVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="From" Style="{StaticResource CaptionTextStyle}"/>
                            <CalendarDatePicker Date="{x:Bind ViewModel.StartDate, Mode=TwoWay, Converter={StaticResource DateConverter}}" PlaceholderText="Select date" Width="150" CornerRadius="8"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="To" Style="{StaticResource CaptionTextStyle}"/>
                            <CalendarDatePicker Date="{x:Bind ViewModel.EndDate, Mode=TwoWay, Converter={StaticResource DateConverter}}" PlaceholderText="Select date" Width="150" CornerRadius="8"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Month Range -->
                    <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{x:Bind ViewModel.IsMonthVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="From" Style="{StaticResource CaptionTextStyle}"/>
                            <ComboBox ItemsSource="{x:Bind ViewModel.Months}" SelectedItem="{x:Bind ViewModel.StartMonth, Mode=TwoWay}" Width="70" CornerRadius="8"/>
                            <ComboBox ItemsSource="{x:Bind ViewModel.Years}" SelectedItem="{x:Bind ViewModel.StartYear, Mode=TwoWay}" Width="90" CornerRadius="8"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="To" Style="{StaticResource CaptionTextStyle}"/>
                            <ComboBox ItemsSource="{x:Bind ViewModel.Months}" SelectedItem="{x:Bind ViewModel.EndMonth, Mode=TwoWay}" Width="70" CornerRadius="8"/>
                            <ComboBox ItemsSource="{x:Bind ViewModel.Years}" SelectedItem="{x:Bind ViewModel.EndYear, Mode=TwoWay}" Width="90" CornerRadius="8"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Year Range -->
                    <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{x:Bind ViewModel.IsYearVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="From" Style="{StaticResource CaptionTextStyle}"/>
                            <ComboBox ItemsSource="{x:Bind ViewModel.Years}" SelectedItem="{x:Bind ViewModel.StartYear, Mode=TwoWay}" Width="100" CornerRadius="8"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="To" Style="{StaticResource CaptionTextStyle}"/>
                            <ComboBox ItemsSource="{x:Bind ViewModel.Years}" SelectedItem="{x:Bind ViewModel.EndYear, Mode=TwoWay}" Width="100" CornerRadius="8"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Button Content="Update Report" Click="FilterButton_Click" Style="{StaticResource AppPrimaryButtonStyle}" Padding="20,0" Height="36" CornerRadius="8"/>
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="24" Spacing="20">
                
                <!-- Metric Cards (Simplified) -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Padding="20" Background="{StaticResource SurfaceBackground}" BorderBrush="{StaticResource Gray100}" BorderThickness="1" CornerRadius="16">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource BodySecondaryTextStyle}" Text="Total Products" />
                            <TextBlock FontSize="32" FontWeight="Bold" Foreground="{StaticResource BrandPrimary}" Text="{x:Bind    ViewModel.ProductsCount, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Padding="20" Background="{StaticResource SurfaceBackground}" BorderBrush="{StaticResource Gray100}" BorderThickness="1" CornerRadius="16">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource BodySecondaryTextStyle}" Text="Total Orders" />
                            <TextBlock FontSize="32" FontWeight="Bold" Foreground="{StaticResource SuccessStrong}" Text="{x:Bind ViewModel.OrdersCount, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </Grid>

            <!-- Charts Section -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sales Trend (Line Chart) -->
                <Border Padding="16" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10">
                    <StackPanel Spacing="12">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Sales Trend (Products)" />
                        <Border Padding="10" Background="#F8FAFC" CornerRadius="8">
                            <Canvas x:Name="SalesTrendCanvas" Height="200" HorizontalAlignment="Stretch" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Revenue/Profit (Bar Chart) -->
                <Border Grid.Column="1" Padding="16" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10">
                    <StackPanel Spacing="12">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Weekly Revenue (VND)" />
                        <Border Padding="10" Background="#F8FAFC" CornerRadius="8">
                            <StackPanel x:Name="RevenueBarPanel" Height="200" Orientation="Horizontal" Spacing="20" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Bottom Stats -->
            <Border Padding="16" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10">
                <StackPanel Spacing="12">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Profit by Category" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.CategoryProfit, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="40" HorizontalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:ReportViewModel+ProfitPoint">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="12" Height="12" Fill="{x:Bind Color}" />
                                    <TextBlock Text="{x:Bind Category}" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind Amount, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
