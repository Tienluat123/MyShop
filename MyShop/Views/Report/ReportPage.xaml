<Page
    x:Class="MyShop.Views.Report.ReportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:MyShop.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            Padding="16"
            Spacing="16">
            
            <!-- Header & Filters -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Style="{StaticResource TitleTextStyle}"
                    Text="BÁO CÁO THỐNG KÊ" />
            </Grid>

            <!-- Metric Cards -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Padding="14" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10">
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="14" Foreground="Gray" Text="Tổng sản phẩm" />
                        <TextBlock FontSize="28" FontWeight="Bold" Foreground="#3B82F6" Text="{x:Bind    ViewModel.ProductsCount, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Padding="14" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10">
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="14" Foreground="Gray" Text="Tổng đơn hàng" />
                        <TextBlock FontSize="28" FontWeight="Bold" Foreground="#10B981" Text="{x:Bind ViewModel.OrdersCount, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Padding="14" Background="#FFF1F2" BorderBrush="#FECDD3" BorderThickness="1" CornerRadius="10">
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="14" Foreground="#E11D48" Text="Sắp hết hàng" />
                        <TextBlock FontSize="28" FontWeight="Bold" Foreground="#E11D48" Text="{x:Bind ViewModel.LowStockCount, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Padding="14" Background="#FEF2F2" BorderBrush="#FEE2E2" BorderThickness="1" CornerRadius="10">
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="14" Foreground="#B91C1C" Text="Đã hết hàng" />
                        <TextBlock FontSize="28" FontWeight="Bold" Foreground="#B91C1C" Text="{x:Bind ViewModel.OutOfStockCount, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Charts Section -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sales Trend (Line Chart) -->
                <Border Padding="16" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10">
                    <StackPanel Spacing="12">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Xu hướng bán hàng (Sản phẩm)" />
                        <Border Padding="10" Background="#F8FAFC" CornerRadius="8">
                            <Canvas x:Name="SalesTrendCanvas" Height="200" HorizontalAlignment="Stretch" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Revenue/Profit (Bar Chart) -->
                <Border Grid.Column="1" Padding="16" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10">
                    <StackPanel Spacing="12">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Doanh thu theo tuần (VNĐ)" />
                        <Border Padding="10" Background="#F8FAFC" CornerRadius="8">
                            <StackPanel x:Name="RevenueBarPanel" Height="200" Orientation="Horizontal" Spacing="20" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Bottom Stats -->
            <Border Padding="16" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10">
                <StackPanel Spacing="12">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Lợi nhuận theo danh mục" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.CategoryProfit, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="40" HorizontalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:ReportViewModel+ProfitPoint">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="12" Height="12" Fill="{x:Bind Color}" />
                                    <TextBlock Text="{x:Bind Category}" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind Amount}" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
