<Page
    x:Class="MyShop.Views.Products.ProductFormView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F3F4F6">

    <Grid x:Name="RootGrid">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                </VisualState>

                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderTitle.FontSize" Value="28" />
                        <Setter Target="FormHost.Margin" Value="12,10,12,16" />
                        <Setter Target="ProductNameSection.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="CategorySection.(Grid.Column)" Value="0" />
                        <Setter Target="CategorySection.(Grid.Row)" Value="1" />
                        <Setter Target="CategorySection.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="CategorySection.Margin" Value="0,0,0,0" />
                        <Setter Target="CostSection.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="SellingSection.(Grid.Column)" Value="0" />
                        <Setter Target="SellingSection.(Grid.Row)" Value="1" />
                        <Setter Target="SellingSection.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="SellingSection.Margin" Value="0,0,0,0" />
                        <Setter Target="FooterActions.Orientation" Value="Vertical" />
                        <Setter Target="FooterActions.HorizontalAlignment" Value="Stretch" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="24,14">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Command="{Binding CancelCommand}" Background="Transparent" BorderThickness="0" Padding="0">
                    <FontIcon Glyph="&#xE72B;" Foreground="#64748B" />
                </Button>
                <StackPanel>
                    <TextBlock x:Name="HeaderTitle" Text="{Binding FormTitle}" FontSize="34" FontWeight="ExtraBold" Foreground="#0F172A" />
                    <TextBlock Text="{Binding Subtitle}" Foreground="#94A3B8" />
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="FormHost" Margin="16,12,16,20" MaxWidth="900" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Border Background="#FFFFFF" CornerRadius="24" BorderBrush="#E5E7EB" BorderThickness="1" Padding="24,22,24,0" VerticalAlignment="Top">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                    <Border.Translation>0,0,14</Border.Translation>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel x:Name="ProductNameSection" Grid.Column="0" Grid.Row="0" Spacing="6" Margin="0,0,10,0">
                                    <TextBlock Text="TEN SAN PHAM" Foreground="#94A3B8" FontWeight="Bold" FontSize="11" />
                                    <TextBox Text="{Binding ProductData.Name, Mode=TwoWay}" PlaceholderText="Nhap ten san pham" Background="#F8FAFC" BorderThickness="0" CornerRadius="12" Padding="14,10" />
                                </StackPanel>

                                <StackPanel x:Name="CategorySection" Grid.Column="1" Grid.Row="0" Spacing="6" Margin="10,0,0,0">
                                    <TextBlock Text="LOAI SAN PHAM" Foreground="#94A3B8" FontWeight="Bold" FontSize="11" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <ComboBox Grid.Row="0"
                                                  Grid.Column="0"
                                                  Grid.ColumnSpan="2"
                                                  ItemsSource="{Binding Categories}"
                                                  SelectedItem="{Binding ProductData.Category, Mode=TwoWay}"
                                                  Background="#F8FAFC"
                                                  BorderThickness="0"
                                                  CornerRadius="12"
                                                  Padding="14,6" />

                                        <TextBox Grid.Row="1"
                                                 Grid.Column="0"
                                                 Margin="0,8,8,0"
                                                 Text="{Binding NewCategoryName, Mode=TwoWay}"
                                                 PlaceholderText="New category"
                                                 Background="#F8FAFC"
                                                 BorderThickness="0"
                                                 CornerRadius="12"
                                                 Padding="14,10" />

                                        <Button Grid.Row="1"
                                                Grid.Column="1"
                                                Margin="0,8,0,0"
                                                MinWidth="54"
                                                Command="{Binding AddCategoryCommand}"
                                                Background="#F8FAFC"
                                                BorderBrush="#E5E7EB"
                                                CornerRadius="12"
                                                Padding="0">
                                            <FontIcon Glyph="&#xE710;" Foreground="#6B7280" FontSize="20" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel x:Name="CostSection" Grid.Column="0" Grid.Row="0" Spacing="6" Margin="0,0,10,0">
                                    <TextBlock Text="GIA NHAP" Foreground="#94A3B8" FontWeight="Bold" FontSize="11" />
                                    <TextBox Text="{Binding ProductData.CostPrice, Mode=TwoWay}" PlaceholderText="xxx xxx d" Background="#F8FAFC" BorderThickness="0" CornerRadius="12" Padding="14,10" />
                                </StackPanel>

                                <StackPanel x:Name="SellingSection" Grid.Column="1" Grid.Row="0" Spacing="6" Margin="10,0,0,0">
                                    <TextBlock Text="GIA BAN" Foreground="#94A3B8" FontWeight="Bold" FontSize="11" />
                                    <TextBox Text="{Binding ProductData.SellingPrice, Mode=TwoWay}" PlaceholderText="xxx xxx d" Background="#F8FAFC" BorderThickness="0" CornerRadius="12" Padding="14,10" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <Border Grid.Row="1" Margin="-24,22,-24,0" Padding="24" Background="#F8FAFC" CornerRadius="0,0,24,24">
                            <StackPanel x:Name="FooterActions" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                                <Button Command="{Binding CancelCommand}" Background="#FFFFFF" BorderBrush="#E2E8F0" CornerRadius="12" Padding="28,10">
                                    <TextBlock Text="Cancel" Foreground="#64748B" FontWeight="SemiBold" />
                                </Button>
                                <Button Command="{Binding SubmitCommand}" Background="#BB4D00" BorderBrush="#BB4D00" CornerRadius="12" Padding="28,10">
                                    <TextBlock Text="{Binding SubmitButtonText}" Foreground="White" FontWeight="Bold" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
