<Page
    x:Class="MyShop.Views.Promotion.PromotionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MyShop.Views.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Shared Page Header -->
        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1"
                Padding="18,14">
            <controls:PageHeaderControl Title="Promotions Management"
                                        Subtitle="Manage your promotions and discount campaigns"
                                        Icon="&#xE8EC;"/>
        </Border>

        <!-- Dynamic Content Area -->
        <Frame x:Name="PromotionContentFrame"
               Grid.Row="1"/>
    </Grid>
</Page>