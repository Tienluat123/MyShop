<ContentDialog
    x:Class="MyShop.Views.Promotion.Components.EditPromotionModal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Style="{StaticResource DefaultContentDialogStyle}"
    CornerRadius="28"
    BorderThickness="0">

    <ContentDialog.Resources>
        <SolidColorBrush x:Key="AmberPrimary" Color="#D97706" />
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#F3F4F6"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>
        <Style TargetType="NumberBox">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#F3F4F6"/>
        </Style>
    </ContentDialog.Resources>

    <Grid Width="500" Margin="-24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="32,24,24,16">
            <StackPanel Spacing="4">
                <TextBlock Text="Edit Promotion" FontSize="22" FontWeight="Bold" Foreground="#111827"/>
                <TextBlock Text="Update discount settings for this campaign" FontSize="14" Foreground="#6B7280"/>
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" 
                    Background="Transparent" BorderThickness="0" Padding="8"
                    Click="{x:Bind Hide}">
                <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="#9CA3AF"/>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="32,8,32,24" MaxHeight="550">
            <StackPanel Spacing="18">
                <StackPanel>
                    <TextBlock Text="Promotion Code" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="CodeEntry" FontWeight="Bold" />
                </StackPanel>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Type" Style="{StaticResource LabelStyle}"/>
                        <ComboBox x:Name="TypeCombo" HorizontalAlignment="Stretch" CornerRadius="12" Background="#F9FAFB">
                            <ComboBoxItem Content="Percent (%)"/>
                            <ComboBoxItem Content="Fixed Amount (đ)"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Value" Style="{StaticResource LabelStyle}"/>
                        <NumberBox x:Name="ValueEntry" SpinButtonPlacementMode="Compact" CornerRadius="12" Background="#F9FAFB"/>
                    </StackPanel>
                </Grid>

                <StackPanel>
                    <TextBlock Text="Minimum Order Requirement" Style="{StaticResource LabelStyle}"/>
                    <NumberBox x:Name="MinOrderEntry" SpinButtonPlacementMode="Compact" CornerRadius="12" Background="#F9FAFB"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Target Group" Style="{StaticResource LabelStyle}"/>
                    <ComboBox x:Name="TargetCombo" HorizontalAlignment="Stretch" CornerRadius="12" Background="#F9FAFB">
                        <ComboBoxItem Content="All Customers"/>
                        <ComboBoxItem Content="VIP Member"/>
                        <ComboBoxItem Content="New Customer"/>
                    </ComboBox>
                </StackPanel>

                <Border Background="#F9FAFB" Padding="16,12" CornerRadius="16" BorderBrush="#F3F4F6" BorderThickness="1">
                    <Grid>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Active Status" FontWeight="Bold" FontSize="14" Foreground="#111827"/>
                            <TextBlock Text="Toggle visibility of this promotion" Foreground="#9CA3AF" FontSize="12"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="StatusSwitch" HorizontalAlignment="Right" OnContent="" OffContent=""/>
                    </Grid>
                </Border>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Start Date" Style="{StaticResource LabelStyle}"/>
                        <DatePicker x:Name="StartDatePicker" HorizontalAlignment="Stretch" CornerRadius="12"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="End Date" Style="{StaticResource LabelStyle}"/>
                        <DatePicker x:Name="EndDatePicker" HorizontalAlignment="Stretch" CornerRadius="12"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="32,24" BorderBrush="#F3F4F6" BorderThickness="0,1,0,0" Background="White" CornerRadius="0,0,28,28">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Discard" HorizontalAlignment="Stretch" 
                        Padding="0,12" CornerRadius="12" Background="Transparent" 
                        BorderBrush="#E5E7EB" BorderThickness="1" FontWeight="SemiBold"
                        Click="{x:Bind Hide}"/>
                <Button Grid.Column="1" Content="Update Changes" HorizontalAlignment="Stretch" 
                        Padding="0,12" CornerRadius="12" Background="{StaticResource AmberPrimary}" 
                        Foreground="White" FontWeight="Bold"
                        Click="ContentDialog_PrimaryButtonClick"/>
            </Grid>
        </Border>
    </Grid>
</ContentDialog>