<Page
    x:Class="MyShop.Views.Promotion.Components.PromotionManagementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MyShop.ViewModels"
    xmlns:converters="using:MyShop.Converters"
    x:Name="PageRoot"
    Background="#F3F4F6">

    <Grid x:Name="RootGrid">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="PromotionResponsiveStates">
                <VisualState x:Name="PromotionMobileState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ActionBarGrid.ColumnSpacing" Value="12"/>
                        <Setter Target="ActionBarGrid.RowSpacing" Value="12"/>
                        <Setter Target="SearchBorder.(Grid.Row)" Value="0"/>
                        <Setter Target="SearchBorder.(Grid.Column)" Value="0"/>
                        <Setter Target="SearchBorder.(Grid.ColumnSpan)" Value="5"/>
                        <Setter Target="SearchBorder.Width" Value="Auto"/>
                        <Setter Target="SearchBorder.HorizontalAlignment" Value="Stretch"/>
                        <Setter Target="StatusFilterBorder.(Grid.Row)" Value="1"/>
                        <Setter Target="StatusFilterBorder.(Grid.Column)" Value="0"/>
                        <Setter Target="StatusFilterBorder.(Grid.ColumnSpan)" Value="2"/>
                        <Setter Target="AdvancedSortButton.(Grid.Row)" Value="1"/>
                        <Setter Target="AdvancedSortButton.(Grid.Column)" Value="2"/>
                        <Setter Target="AdvancedSortButton.(Grid.ColumnSpan)" Value="2"/>
                        <Setter Target="AddPromotionButton.(Grid.Row)" Value="1"/>
                        <Setter Target="AddPromotionButton.(Grid.Column)" Value="4"/>
                        <Setter Target="AddPromotionButton.(Grid.ColumnSpan)" Value="1"/>
                        <Setter Target="TableScroll.Padding" Value="8,0"/>
                        <Setter Target="TableStackPanel.MinWidth" Value="920"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="PromotionTabletState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource BreakpointTablet}"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ActionBarGrid.ColumnSpacing" Value="16"/>
                        <Setter Target="ActionBarGrid.RowSpacing" Value="0"/>
                        <Setter Target="SearchBorder.(Grid.Row)" Value="0"/>
                        <Setter Target="SearchBorder.(Grid.Column)" Value="0"/>
                        <Setter Target="SearchBorder.(Grid.ColumnSpan)" Value="1"/>
                        <Setter Target="SearchBorder.Width" Value="220"/>
                        <Setter Target="SearchBorder.HorizontalAlignment" Value="Left"/>
                        <Setter Target="StatusFilterBorder.(Grid.Row)" Value="0"/>
                        <Setter Target="StatusFilterBorder.(Grid.Column)" Value="1"/>
                        <Setter Target="StatusFilterBorder.(Grid.ColumnSpan)" Value="1"/>
                        <Setter Target="AdvancedSortButton.(Grid.Row)" Value="0"/>
                        <Setter Target="AdvancedSortButton.(Grid.Column)" Value="2"/>
                        <Setter Target="AdvancedSortButton.(Grid.ColumnSpan)" Value="1"/>
                        <Setter Target="AddPromotionButton.(Grid.Row)" Value="0"/>
                        <Setter Target="AddPromotionButton.(Grid.Column)" Value="4"/>
                        <Setter Target="AddPromotionButton.(Grid.ColumnSpan)" Value="1"/>
                        <Setter Target="TableScroll.Padding" Value="0"/>
                        <Setter Target="TableStackPanel.MinWidth" Value="0"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="PromotionDesktopState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource BreakpointDesktop}"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ActionBarGrid.ColumnSpacing" Value="16"/>
                        <Setter Target="ActionBarGrid.RowSpacing" Value="0"/>
                        <Setter Target="SearchBorder.(Grid.Row)" Value="0"/>
                        <Setter Target="SearchBorder.(Grid.Column)" Value="0"/>
                        <Setter Target="SearchBorder.(Grid.ColumnSpan)" Value="1"/>
                        <Setter Target="SearchBorder.Width" Value="250"/>
                        <Setter Target="SearchBorder.HorizontalAlignment" Value="Left"/>
                        <Setter Target="StatusFilterBorder.(Grid.Row)" Value="0"/>
                        <Setter Target="StatusFilterBorder.(Grid.Column)" Value="1"/>
                        <Setter Target="StatusFilterBorder.(Grid.ColumnSpan)" Value="1"/>
                        <Setter Target="AdvancedSortButton.(Grid.Row)" Value="0"/>
                        <Setter Target="AdvancedSortButton.(Grid.Column)" Value="2"/>
                        <Setter Target="AdvancedSortButton.(Grid.ColumnSpan)" Value="1"/>
                        <Setter Target="AddPromotionButton.(Grid.Row)" Value="0"/>
                        <Setter Target="AddPromotionButton.(Grid.Column)" Value="4"/>
                        <Setter Target="AddPromotionButton.(Grid.ColumnSpan)" Value="1"/>
                        <Setter Target="TableScroll.Padding" Value="0"/>
                        <Setter Target="TableStackPanel.MinWidth" Value="0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.Resources>
            <converters:PromoStatusBrushConverter x:Key="PromoBgConverter" IsBackground="True"/>
            <converters:PromoStatusBrushConverter x:Key="PromoFgConverter" IsBackground="False"/>
            <converters:PromoStatusTextConverter x:Key="PromoStatusTextConverter"/>
            <converters:StringNullOrEmptyToVisibilityConverter x:Key="StringNullOrEmptyToVisibilityConverter"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:SortIndicatorConverter x:Key="SortIndicatorConverter"/>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== ERROR MESSAGE ===== -->
        <Border Grid.Row="0"
                Margin="16,12,16,0"
                Background="#FEF2F2"
                CornerRadius="10"
                Padding="12,10"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#DC2626"
                       FontSize="13"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- ===== Main Content Card ===== -->
        <Border Grid.Row="1"
                Margin="16,12,16,16"
                Background="#FFFFFF"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ===== Top Action Bar ===== -->
                <Grid Grid.Row="0"
                      x:Name="ActionBarGrid"
                      Padding="16,16,16,12"
                      ColumnSpacing="16"
                      RowSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Search -->
                        <ColumnDefinition Width="Auto"/> <!-- Status Filter -->
                        <ColumnDefinition Width="Auto"/> <!-- Advanced Sort -->
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/> <!-- Add Promotion -->
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Search Box -->
                        <Border x:Name="SearchBorder"
                            Grid.Column="0"
                            Grid.Row="0"
                            HorizontalAlignment="Left"
                            Background="#F0F0F0"
                            CornerRadius="20"
                            BorderThickness="1"
                            BorderBrush="Gray"
                            Padding="12,0,12,0"
                            Height="35"
                            Width="250">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <FontIcon Glyph="&#xE71E;"
                                      FontSize="14"
                                      Foreground="Gray"
                                      VerticalAlignment="Center"/>

                            <TextBox Grid.Column="1"
                                     PlaceholderText="Search by promotion code..."
                                     Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     VerticalAlignment="Center"
                                     Margin="0,3,0,0">
                                <TextBox.Resources>
                                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                                </TextBox.Resources>
                            </TextBox>
                        </Grid>
                    </Border>

                    <!-- Status Filter -->
                        <Border x:Name="StatusFilterBorder"
                            Grid.Column="1"
                            Grid.Row="0"
                            Background="White"
                            Height="35"
                            CornerRadius="20"
                            BorderThickness="1"
                            BorderBrush="#E0E0E0"
                            Padding="12,0,4,0">
                        <ComboBox PlaceholderText="All Status"
                                  SelectedValue="{x:Bind ViewModel.SelectedStatus, Mode=TwoWay}"
                                  SelectedValuePath="Content"
                                  Width="120"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  VerticalAlignment="Center">
                            <ComboBox.Resources>
                                <Thickness x:Key="ComboBoxBorderThemeThickness">0</Thickness>
                                <Thickness x:Key="ComboBoxBorderThemeThicknessFocused">0</Thickness>
                                <SolidColorBrush x:Key="ComboBoxBackground" Color="Transparent"/>
                                <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="Transparent"/>
                                <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="Transparent"/>
                            </ComboBox.Resources>
                            <ComboBoxItem Content="All"/>
                            <ComboBoxItem Content="Active"/>
                            <ComboBoxItem Content="Upcoming"/>
                            <ComboBoxItem Content="Expired"/>
                            <ComboBoxItem Content="Inactive"/>
                        </ComboBox>
                    </Border>

                    <!-- Advanced Sort Button -->
                        <Button x:Name="AdvancedSortButton"
                            Grid.Column="2"
                            Grid.Row="0"
                            Background="White"
                            Height="35"
                            CornerRadius="20"
                            BorderThickness="1"
                            BorderBrush="#E0E0E0"
                            Padding="16,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8CB;" FontSize="14" Foreground="#4A4A4A"/>
                            <TextBlock Text="Advanced Sort" Foreground="#4A4A4A" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout>
                                <StackPanel Width="360" Spacing="12" Padding="4">
                                    <TextBlock Text="Multi-Criteria Sorting" FontWeight="Bold" FontSize="16"/>
                                    <TextBlock Text="Add multiple levels of sorting logic." FontSize="12" Foreground="Gray" TextWrapping="Wrap"/>

                                    <ItemsControl ItemsSource="{x:Bind ViewModel.SortCriteriaList, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SortCriteriaItem">
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <ComboBox Grid.Column="0" 
                                                              ItemsSource="{x:Bind AvailableColumns, Mode=OneWay}" 
                                                              SelectedValue="{x:Bind ColumnName, Mode=TwoWay}" 
                                                              HorizontalAlignment="Stretch" Margin="0,0,8,0"/>
                                                    
                                                    <ComboBox Grid.Column="1" 
                                                              SelectedValue="{x:Bind Direction, Mode=TwoWay}"
                                                              SelectedValuePath="Content"
                                                              HorizontalAlignment="Stretch" Margin="0,0,8,0">
                                                        <ComboBoxItem Content="ASC"/>
                                                        <ComboBoxItem Content="DESC"/>
                                                    </ComboBox>

                                                    <Button Grid.Column="2" 
                                                            Background="Transparent" 
                                                            BorderThickness="0" 
                                                            Padding="4" 
                                                            Command="{Binding DataContext.RemoveSortCriteriaCommand, ElementName=PageRoot}"
                                                            CommandParameter="{x:Bind}">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="Red"/>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button Content="+ Add Level"
                                            Command="{x:Bind ViewModel.AddSortCriteriaCommand}"
                                            Background="Transparent"
                                            Foreground="#0078D7"
                                            BorderThickness="0"
                                            HorizontalAlignment="Left"/>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Clear All"
                                                Command="{x:Bind ViewModel.ClearMultiSortCommand}"
                                                HorizontalAlignment="Stretch" Margin="0,0,4,0"/>
                                        <Button Grid.Column="1" Content="Apply"
                                                Command="{x:Bind ViewModel.ApplyMultiSortCommand}"
                                                Style="{StaticResource AppPrimaryButtonStyle}"
                                                HorizontalAlignment="Stretch" Margin="4,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!-- Add Promotion Button -->
                        <Button x:Name="AddPromotionButton"
                            Grid.Column="4"
                            Grid.Row="0"
                            Command="{Binding AddPromotionCommand}"
                            Background="#D97706"
                            BorderThickness="0"
                            Foreground="White"
                            Height="35"
                            CornerRadius="18"
                            Padding="14,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14"/>
                            <TextBlock Text="Add Promotion" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- ===== Row 2: Table Header with Sortable Columns ===== -->
                <ScrollViewer Grid.Row="1"
                              x:Name="TableScroll"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="TableStackPanel">
                        <Border Background="#FAFAFA"
                                Padding="16,12"
                                BorderBrush="#EEEEEE"
                                BorderThickness="0,1,0,1">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*"/>  <!-- CODE -->
                                    <ColumnDefinition Width="1*"/>    <!-- TYPE -->
                                    <ColumnDefinition Width="0.8*"/>  <!-- VALUE -->
                                    <ColumnDefinition Width="1*"/>    <!-- STATUS -->
                                    <ColumnDefinition Width="1.2*"/>  <!-- MIN. ORDER -->
                                    <ColumnDefinition Width="2*"/>    <!-- PERIOD -->
                                    <ColumnDefinition Width="0.8*"/>  <!-- TARGET -->
                                    <ColumnDefinition Width="100"/>   <!-- ACTIONS -->
                                </Grid.ColumnDefinitions>

                                <!-- Column 0: CODE -->
                                <Button Background="Transparent"
                                        Padding="0"
                                        BorderThickness="0"
                                        Command="{x:Bind ViewModel.SortByColumnCommand}"
                                        CommandParameter="Code"
                                        Foreground="Gray">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="CODE"
                                                   FontSize="11"
                                                   FontWeight="Bold"/>
                                        <FontIcon Glyph="{x:Bind ViewModel.SortInfo, Mode=OneWay, Converter={StaticResource SortIndicatorConverter}, ConverterParameter=Code}"
                                                  FontSize="12"
                                                  FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>

                                <!-- Column 1: TYPE -->
                                <Button Grid.Column="1"
                                        Background="Transparent"
                                        Padding="0"
                                        BorderThickness="0"
                                        Command="{x:Bind ViewModel.SortByColumnCommand}"
                                        CommandParameter="Type"
                                        Foreground="Gray">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="TYPE"
                                                   FontSize="11"
                                                   FontWeight="Bold"/>
                                        <FontIcon Glyph="{x:Bind ViewModel.SortInfo, Mode=OneWay, Converter={StaticResource SortIndicatorConverter}, ConverterParameter=Type}"
                                                  FontSize="12"
                                                  FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>

                                <!-- Column 2: VALUE -->
                                <Button Grid.Column="2"
                                        Background="Transparent"
                                        Padding="0"
                                        BorderThickness="0"
                                        HorizontalAlignment="Right"
                                        Command="{x:Bind ViewModel.SortByColumnCommand}"
                                        CommandParameter="Value"
                                        Foreground="Gray">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="VALUE"
                                                   FontSize="11"
                                                   FontWeight="Bold"/>
                                        <FontIcon Glyph="{x:Bind ViewModel.SortInfo, Mode=OneWay, Converter={StaticResource SortIndicatorConverter}, ConverterParameter=Value}"
                                                  FontSize="12"
                                                  FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>

                                <!-- Column 3: STATUS -->
                                <Button Grid.Column="3"
                                        Background="Transparent"
                                        Padding="0"
                                        BorderThickness="0"
                                        HorizontalAlignment="Center"
                                        Command="{x:Bind ViewModel.SortByColumnCommand}"
                                        CommandParameter="Status"
                                        Foreground="Gray">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="STATUS"
                                                   FontSize="11"
                                                   FontWeight="Bold"/>
                                        <FontIcon Glyph="{x:Bind ViewModel.SortInfo, Mode=OneWay, Converter={StaticResource SortIndicatorConverter}, ConverterParameter=Status}"
                                                  FontSize="12"
                                                  FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>

                                <!-- Column 4: MIN. ORDER -->
                                <Button Grid.Column="4"
                                        Background="Transparent"
                                        Padding="0"
                                        BorderThickness="0"
                                        HorizontalAlignment="Right"
                                        Command="{x:Bind ViewModel.SortByColumnCommand}"
                                        CommandParameter="MinOrder"
                                        Foreground="Gray">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="MIN. ORDER"
                                                   FontSize="11"
                                                   FontWeight="Bold"/>
                                        <FontIcon Glyph="{x:Bind ViewModel.SortInfo, Mode=OneWay, Converter={StaticResource SortIndicatorConverter}, ConverterParameter=MinOrder}"
                                                  FontSize="12"
                                                  FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>

                                <!-- Column 5: PERIOD -->
                                <Button Grid.Column="5"
                                        Background="Transparent"
                                        Padding="0"
                                        BorderThickness="0"
                                        Command="{x:Bind ViewModel.SortByColumnCommand}"
                                        CommandParameter="StartDate"
                                        Foreground="Gray">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="PERIOD"
                                                   FontSize="11"
                                                   FontWeight="Bold"/>
                                        <FontIcon Glyph="{x:Bind ViewModel.SortInfo, Mode=OneWay, Converter={StaticResource SortIndicatorConverter}, ConverterParameter=StartDate}"
                                                  FontSize="12"
                                                  FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>

                                <!-- Column 6: TARGET -->
                                <Button Grid.Column="6"
                                        Background="Transparent"
                                        Padding="0"
                                        BorderThickness="0"
                                        HorizontalAlignment="Center"
                                        Command="{x:Bind ViewModel.SortByColumnCommand}"
                                        CommandParameter="Target"
                                        Foreground="Gray">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="TARGET"
                                                   FontSize="11"
                                                   FontWeight="Bold"/>
                                        <FontIcon Glyph="{x:Bind ViewModel.SortInfo, Mode=OneWay, Converter={StaticResource SortIndicatorConverter}, ConverterParameter=Target}"
                                                  FontSize="12"
                                                  FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>

                                <!-- Column 7: ACTIONS (non-sortable) -->
                                <TextBlock Grid.Column="7"
                                           Text="ACTIONS"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="Gray"
                                           HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding PageItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PromotionItem">
                                    <Border BorderBrush="#F5F5F5"
                                            BorderThickness="0,0,0,1"
                                            Padding="16,10">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.2*"/>  <!-- CODE -->
                                                <ColumnDefinition Width="1*"/>    <!-- TYPE -->
                                                <ColumnDefinition Width="0.8*"/>  <!-- VALUE -->
                                                <ColumnDefinition Width="1*"/>    <!-- STATUS -->
                                                <ColumnDefinition Width="1.2*"/>  <!-- MIN. ORDER -->
                                                <ColumnDefinition Width="2*"/>    <!-- PERIOD -->
                                                <ColumnDefinition Width="0.8*"/>  <!-- TARGET -->
                                                <ColumnDefinition Width="100"/>   <!-- ACTIONS -->
                                            </Grid.ColumnDefinitions>

                                            <!-- CODE -->
                                            <Border Background="#FEF3C7"
                                                    CornerRadius="6"
                                                    Padding="8,4"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Left">
                                                <TextBlock Text="{x:Bind Code}"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="#92400E"/>
                                            </Border>

                                            <!-- TYPE -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind TypeDisplay}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Foreground="#1E293B"/>

                                            <!-- VALUE -->
                                            <Border Grid.Column="2"
                                                    Background="#DBEAFE"
                                                    CornerRadius="6"
                                                    Padding="8,4"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Right">
                                                <TextBlock Text="{x:Bind ValueDisplay}"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="#1E40AF"/>
                                            </Border>

                                            <!-- STATUS (ToggleSwitch) -->
                                            <ToggleSwitch Grid.Column="3"
                                                          IsOn="{x:Bind IsActive, Mode=TwoWay}"
                                                          OnContent="Active"
                                                          OffContent="Off"
                                                          FontSize="10"
                                                          MinWidth="0"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>

                                            <!-- MIN. ORDER -->
                                            <TextBlock Grid.Column="4"
                                                       Text="{x:Bind MinimumOrderDisplay}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"
                                                       Foreground="#666666"/>

                                            <!-- PERIOD -->
                                            <TextBlock Grid.Column="5"
                                                       Text="{x:Bind PeriodDisplay}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Foreground="#6B7280"/>

                                            <!-- TARGET -->
                                            <TextBlock Grid.Column="6"
                                                       Text="{x:Bind TargetDisplay}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Foreground="#444444"/>

                                            <!-- ACTIONS -->
                                            <StackPanel Grid.Column="7"
                                                        Orientation="Horizontal"
                                                        Spacing="10"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <Button Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="8"
                                                        ToolTipService.ToolTip="Edit"
                                                        Command="{Binding DataContext.EditPromotionCommand, ElementName=PageRoot}"
                                                        CommandParameter="{Binding}">
                                                    <FontIcon Glyph="&#xEB7E;" FontSize="16" Foreground="#0078D4"/>
                                                </Button>
                                                <Button Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="8"
                                                        ToolTipService.ToolTip="Delete"
                                                        Command="{Binding DataContext.DeletePromotionCommand, ElementName=PageRoot}"
                                                        CommandParameter="{Binding}">
                                                    <FontIcon Glyph="&#xED62;" FontSize="16" Foreground="#E81123"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Row 4: Paging Controls (matching EmployeeListTab) ===== -->
                <Border Grid.Row="2"
                        Background="White"
                        Padding="10"
                        BorderBrush="#EEEEEE"
                        BorderThickness="0,1,0,0">
                    <Grid ColumnSpacing="12"
                          HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Previous Button -->
                        <Button Grid.Column="0"
                                Content="←"
                                Command="{Binding PreviousPageCommand}"
                                Height="30"
                                Padding="16,0"
                                CornerRadius="8"
                                Background="#F0F0F0"
                                Foreground="#333333"/>

                        <!-- Page Info -->
                        <TextBlock Grid.Column="1"
                                   Text="{Binding PageInfoDisplay}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#555555"/>

                        <!-- Next Button -->
                        <Button Grid.Column="2"
                                Content="→"
                                Command="{Binding NextPageCommand}"
                                Height="30"
                                Padding="16,0"
                                CornerRadius="8"
                                Background="#0078D4"
                                Foreground="White"/>
                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Grid>
</Page>