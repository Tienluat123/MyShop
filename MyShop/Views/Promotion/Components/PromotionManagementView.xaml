<Page
    x:Class="MyShop.Views.Promotion.Components.PromotionManagementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MyShop.ViewModels"
    x:Name="PageRoot"
    Background="#F3F4F6">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,12,16,20" Spacing="16">
                
                <Border Background="#FFFFFF"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="16">
                    <StackPanel Spacing="16">
                        
                        <!-- Actions Section -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Command="{Binding AddPromotionCommand}"
                                    Background="#BB4D00"
                                    BorderBrush="#BB4D00"
                                    Foreground="White"
                                    CornerRadius="12"
                                    Padding="14,8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;"/>
                                    <TextBlock Text="Add Promotion" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Grid Grid.Column="2">
                                <TextBox Padding="40,10,10,10"
                                         Background="#F8FAFC"
                                         BorderBrush="#E5E7EB"
                                         CornerRadius="12"
                                         PlaceholderText="Search by code or type..."
                                         Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <FontIcon Glyph="&#xE721;"
                                          Foreground="#94A3B8"
                                          Margin="14,0,0,0"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>

                        <MenuFlyoutSeparator Background="#E5E7EB" Margin="-16,0"/>

                        <!-- List Section -->
                        <ItemsRepeater ItemsSource="{Binding PageItems}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="12"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:PromotionItem">
                                    <Border Background="White"
                                            BorderBrush="#E5E7EB"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="16">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Code Badge -->
                                            <Border Grid.Column="0"
                                                    Background="#FEF3C7"
                                                    CornerRadius="8"
                                                    Padding="12,8"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Code}"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="#92400E"/>
                                            </Border>

                                            <!-- Details -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="12">
                                                    <TextBlock Text="{x:Bind TypeDisplay}"
                                                               FontWeight="SemiBold"
                                                               Foreground="#1E293B"/>
                                                    <Border Background="#DFE9F3"
                                                            CornerRadius="6"
                                                            Padding="8,4">
                                                        <TextBlock Text="{x:Bind ValueDisplay}"
                                                                   FontSize="12"
                                                                   FontWeight="Bold"
                                                                   Foreground="#1E40AF"/>
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="16">
                                                    <TextBlock FontSize="12" Foreground="#6B7280">
                                                        <Run Text="Min: "/><Run Text="{x:Bind MinimumOrderDisplay}"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="12" Foreground="#6B7280">
                                                        <Run Text="Period: "/><Run Text="{x:Bind PeriodDisplay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Status -->
                                            <ToggleSwitch Grid.Column="2"
                                                          IsOn="{x:Bind IsActive, Mode=OneWay}"
                                                          OnContent="" OffContent=""
                                                          VerticalAlignment="Center"
                                                          MinWidth="0"
                                                          Command="{Binding DataContext.ToggleStatusCommand, ElementName=PageRoot}"
                                                          CommandParameter="{Binding}"/>

                                            <!-- Actions -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Button Background="Transparent" BorderThickness="0" Padding="8"
                                                        Command="{Binding DataContext.EditPromotionCommand, ElementName=PageRoot}"
                                                        CommandParameter="{Binding}">
                                                    <FontIcon Glyph="&#xE70F;" FontSize="16" Foreground="#6B7280"/>
                                                </Button>
                                                <Button Background="Transparent" BorderThickness="0" Padding="8"
                                                        Command="{Binding DataContext.RemoveCommand, ElementName=PageRoot}"
                                                        CommandParameter="{Binding}">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="16" Foreground="#EF4444"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <MenuFlyoutSeparator Background="#E5E7EB" Margin="-16,0"/>

                        <!-- Paging -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding PagingSummary}"
                                       Foreground="#64748B"
                                       VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Command="{Binding PreviousPageCommand}"
                                        Background="#FFFFFF" BorderBrush="#E5E7EB"
                                        CornerRadius="8" Width="32" Height="32">
                                    <FontIcon Glyph="&#xE76B;" Foreground="#94A3B8" FontSize="12"/>
                                </Button>
                                <ItemsControl ItemsSource="{Binding PageNumbers}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:Int32">
                                            <Button Command="{Binding DataContext.GoToPageCommand, ElementName=PageRoot}"
                                                    CommandParameter="{Binding}"
                                                    Width="32" Height="32" CornerRadius="8"
                                                    Background="#FFFFFF" BorderBrush="#E5E7EB"
                                                    Foreground="#4B5563" Content="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Command="{Binding NextPageCommand}"
                                        Background="#FFFFFF" BorderBrush="#E5E7EB"
                                        CornerRadius="8" Width="32" Height="32">
                                    <FontIcon Glyph="&#xE76C;" Foreground="#94A3B8" FontSize="12"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
