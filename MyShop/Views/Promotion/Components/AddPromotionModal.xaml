<ContentDialog
    x:Class="MyShop.Views.Promotion.Components.AddPromotionModal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    
    Style="{StaticResource DefaultContentDialogStyle}"
    CornerRadius="28"
    BorderThickness="0">

    <ContentDialog.Resources>
        <SolidColorBrush x:Key="AmberPrimary" Color="#D97706" />
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#F3F4F6"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>
        <Style TargetType="NumberBox">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#F3F4F6"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#F3F4F6"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
    </ContentDialog.Resources>

    <Grid Width="500" Margin="-24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <RowDefinition Height="*" />    <RowDefinition Height="Auto" /> </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="32,24,24,16">
            <StackPanel Spacing="4">
                <TextBlock Text="New Promotion" FontSize="22" FontWeight="Bold" Foreground="#111827"/>
                <TextBlock Text="Setup a new discount campaign for your shop" FontSize="14" Foreground="#6B7280"/>
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" 
                    Background="Transparent" BorderThickness="0" Padding="8"
                    Click="{x:Bind Hide}">
                <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="#9CA3AF"/>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="32,8,32,24" MaxHeight="500">
            <StackPanel Spacing="18">
                <StackPanel>
                    <TextBlock Text="Promotion Code" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="CodeEntry" PlaceholderText="e.g. GIAM30K"/>
                </StackPanel>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Type" Style="{StaticResource LabelStyle}"/>
                        <ComboBox x:Name="TypeCombo" SelectedIndex="0">
                            <ComboBoxItem Content="Percent (%)"/>
                            <ComboBoxItem Content="Fixed Amount (đ)"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Value" Style="{StaticResource LabelStyle}"/>
                        <NumberBox x:Name="ValueEntry" Value="0" SpinButtonPlacementMode="Compact"/>
                    </StackPanel>
                </Grid>

                <StackPanel>
                    <TextBlock Text="Minimum Order Requirement" Style="{StaticResource LabelStyle}"/>
                    <NumberBox x:Name="MinOrderEntry" Value="0" SpinButtonPlacementMode="Compact"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Target Audience" Style="{StaticResource LabelStyle}"/>
                    <ComboBox x:Name="TargetCombo" SelectedIndex="0">
                        <ComboBoxItem Content="All Customers"/>
                        <ComboBoxItem Content="VIP Member"/>
                        <ComboBoxItem Content="New Customer"/>
                    </ComboBox>
                </StackPanel>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Start Date" Style="{StaticResource LabelStyle}"/>
                        <DatePicker x:Name="StartDatePicker" HorizontalAlignment="Stretch" CornerRadius="12"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="End Date" Style="{StaticResource LabelStyle}"/>
                        <DatePicker x:Name="EndDatePicker" HorizontalAlignment="Stretch" CornerRadius="12"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="32,24" BorderBrush="#F3F4F6" BorderThickness="0,1,0,0" Background="White" CornerRadius="0,0,28,28">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Cancel" HorizontalAlignment="Stretch" 
                        Padding="0,12" CornerRadius="12" Background="Transparent" 
                        BorderBrush="#E5E7EB" BorderThickness="1" FontWeight="SemiBold"
                        Click="{x:Bind Hide}"/>
                <Button Grid.Column="1" Content="Create Promotion" HorizontalAlignment="Stretch" 
                        Padding="0,12" CornerRadius="12" Background="{StaticResource AmberPrimary}" 
                        Foreground="White" FontWeight="Bold"
                        Click="ContentDialog_PrimaryButtonClick"/>
            </Grid>
        </Border>
    </Grid>
</ContentDialog>