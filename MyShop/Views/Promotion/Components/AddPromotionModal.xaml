<ContentDialog
        x:Class="MyShop.Views.Promotion.Components.AddPromotionModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:MyShop.Views.Controls"
        xmlns:converters="using:MyShop.Converters"
        Style="{StaticResource DefaultContentDialogStyle}"
        CornerRadius="28"
        BorderThickness="0">

        <ContentDialog.Resources>
                <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
                <converters:StringNullOrEmptyToVisibilityConverter x:Key="StringNullOrEmptyToVisibilityConverter"/>
                <converters:DateTimeToDateTimeOffsetConverter x:Key="DateConverter"/>
                <Style TargetType="TextBlock"
                       x:Key="LabelStyle">
                        <Setter Property="FontSize"
                                Value="13"/>
                        <Setter Property="FontWeight"
                                Value="SemiBold"/>
                        <Setter Property="Foreground"
                                Value="#374151"/>
                        <Setter Property="Margin"
                                Value="0,0,0,6"/>
                </Style>
                <Style TargetType="TextBox">
                        <Setter Property="CornerRadius"
                                Value="12"/>
                        <Setter Property="Background"
                                Value="#F9FAFB"/>
                        <Setter Property="BorderBrush"
                                Value="#F3F4F6"/>
                        <Setter Property="Padding"
                                Value="12,10"/>
                </Style>
                <Style TargetType="NumberBox">
                        <Setter Property="CornerRadius"
                                Value="12"/>
                        <Setter Property="Background"
                                Value="#F9FAFB"/>
                        <Setter Property="BorderBrush"
                                Value="#F3F4F6"/>
                </Style>
                <Style TargetType="ComboBox">
                        <Setter Property="CornerRadius"
                                Value="12"/>
                        <Setter Property="Background"
                                Value="#F9FAFB"/>
                        <Setter Property="BorderBrush"
                                Value="#F3F4F6"/>
                        <Setter Property="HorizontalAlignment"
                                Value="Stretch"/>
                </Style>
        </ContentDialog.Resources>

        <Grid Width="500"
              Margin="-24">
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ui:ModalHeader Grid.Row="0"
                                Title="{Binding FormTitle}"
                                Subtitle="{Binding Subtitle}"
                                CancelClicked="CancelButton_Click"/>

                <ScrollViewer Grid.Row="1"
                              Padding="32,8,32,24"
                              MaxHeight="550">
                        <StackPanel Spacing="16">

                                <!-- ===== PROMOTION CODE ===== -->
                                <StackPanel>
                                        <TextBlock Text="PROMOTION CODE"
                                                   Style="{StaticResource LabelStyle}"/>
                                        <TextBox Text="{Binding PromotionData.Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="e.g. GIAM30K"/>
                                        <!-- Validation error -->
                                        <TextBlock Text="{Binding PromotionData.Code, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"
                                                   FontSize="12"
                                                   Foreground="#EF4444"
                                                   Visibility="Collapsed"/>
                                        <TextBlock Text="Mã khuyến mãi không được để trống"
                                                   FontSize="12"
                                                   Foreground="#EF4444"
                                                   Visibility="{Binding PromotionData.Code.Length, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"/>
                                </StackPanel>

                                <!-- ===== TYPE + VALUE ===== -->
                                <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                                <TextBlock Text="TYPE"
                                                           Style="{StaticResource LabelStyle}"/>
                                                <ComboBox SelectedIndex="{Binding SelectedTypeIndex, Mode=TwoWay}">
                                                        <ComboBoxItem Content="Percent (%)"/>
                                                        <ComboBoxItem Content="Fixed Amount (đ)"/>
                                                </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                                <TextBlock Text="VALUE"
                                                           Style="{StaticResource LabelStyle}"/>
                                                <NumberBox Value="{Binding PromotionData.Value, Mode=TwoWay}"
                                                           SpinButtonPlacementMode="Compact"
                                                           Minimum="0"/>
                                        </StackPanel>
                                </Grid>

                                <!-- ===== MINIMUM ORDER ===== -->
                                <StackPanel>
                                        <TextBlock Text="MINIMUM ORDER REQUIREMENT"
                                                   Style="{StaticResource LabelStyle}"/>
                                        <NumberBox Value="{Binding PromotionData.MinimumOrderAmount, Mode=TwoWay}"
                                                   SpinButtonPlacementMode="Compact"
                                                   Minimum="0"/>
                                </StackPanel>

                                <!-- ===== TARGET AUDIENCE ===== -->
                                <StackPanel>
                                        <TextBlock Text="TARGET AUDIENCE"
                                                   Style="{StaticResource LabelStyle}"/>
                                        <ComboBox SelectedIndex="{Binding SelectedTargetIndex, Mode=TwoWay}">
                                                <ComboBoxItem Content="All Customers"/>
                                                <ComboBoxItem Content="VIP Member"/>
                                                <ComboBoxItem Content="New Customer"/>
                                                <ComboBoxItem Content="Loyalty Member"/>
                                        </ComboBox>
                                </StackPanel>

                                <!-- ===== ACTIVE STATUS (chỉ hiện khi edit) ===== -->
                                <Border Background="#F9FAFB"
                                        Padding="16,12"
                                        CornerRadius="16"
                                        BorderBrush="#F3F4F6"
                                        BorderThickness="1"
                                        Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid>
                                                <StackPanel VerticalAlignment="Center"
                                                            Spacing="2">
                                                        <TextBlock Text="ACTIVE STATUS"
                                                                   FontWeight="Bold"
                                                                   FontSize="14"
                                                                   Foreground="#111827"/>
                                                        <TextBlock Text="Toggle visibility of this promotion"
                                                                   Foreground="#9CA3AF"
                                                                   FontSize="12"/>
                                                </StackPanel>
                                                <ToggleSwitch IsOn="{Binding PromotionData.IsActive, Mode=TwoWay}"
                                                              HorizontalAlignment="Right"
                                                              OnContent=""
                                                              OffContent=""/>
                                        </Grid>
                                </Border>

                                <!-- ===== START + END DATE ===== -->
                                <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                                <TextBlock Text="START DATE"
                                                           Style="{StaticResource LabelStyle}"/>
                                                <CalendarDatePicker Date="{Binding PromotionData.StartDate, Mode=TwoWay, Converter={StaticResource DateConverter}}"
                                                                    CornerRadius="12"
                                                                    PlaceholderText="Select start date"
                                                                    Header=""
                                                                    HorizontalAlignment="Stretch"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                                <TextBlock Text="END DATE"
                                                           Style="{StaticResource LabelStyle}"/>
                                                <CalendarDatePicker Date="{Binding PromotionData.EndDate, Mode=TwoWay, Converter={StaticResource DateConverter}}"
                                                                    HorizontalAlignment="Stretch"
                                                                    CornerRadius="12"
                                                                    PlaceholderText="Select end date"
                                                                    Header=""/>
                                        </StackPanel>
                                </Grid>

                                <!-- ===== GLOBAL ERROR MESSAGE ===== -->
                                <Border Background="#FEF2F2"
                                        CornerRadius="10"
                                        Padding="12,10"
                                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                                        <TextBlock Text="{Binding ErrorMessage}"
                                                   Foreground="#DC2626"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"/>
                                </Border>

                        </StackPanel>
                </ScrollViewer>

                <ui:ModalFooter Grid.Row="2"
                                CancelText="{Binding CancelButtonText}"
                                SubmitText="{Binding SubmitButtonText}"
                                CancelClicked="CancelButton_Click"
                                SubmitClicked="SaveButton_Click"/>
        </Grid>
</ContentDialog>