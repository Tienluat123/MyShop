<ContentDialog
    x:Class="MyShop.Views.CustomerManagement.Components.CustomerFormView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MyShop.Views.Controls"
    xmlns:ui="using:MyShop.Views.Controls"
    CornerRadius="20"
    BorderThickness="0">

    <Grid Width="450"
          Margin="0"
          Padding="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Grid Grid.Row="0"
              Padding="28,20,28,16"
              Background="White">
            <TextBlock Text="{Binding FormTitle}"
                       FontSize="20"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- Content Section -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="28,0,28,20">
            <StackPanel Spacing="20">

                <!-- Personal Details Section -->
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <FontIcon Glyph="&#xE77B;"
                                  FontSize="16"
                                  Foreground="#2980B9"/>
                        <TextBlock Text="Personal Information"
                                   FontWeight="Bold"
                                   Foreground="#2980B9"/>
                    </StackPanel>

                    <Border BorderBrush="#EEEEEE"
                            BorderThickness="1"
                            CornerRadius="12"
                            Background="#F9F9F9"
                            Padding="15">
                        <StackPanel Spacing="12">
                            <!-- Full Name and Phone in 2 columns -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBox Header="Full Name *"
                                             Text="{Binding CustomerData.FullName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             LostFocus="TextBox_LostFocus_Name"
                                             CornerRadius="8"/>
                                    <TextBlock Text="{Binding NameError}"
                                               Foreground="#EF4444"
                                               FontSize="11"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBox Header="Phone Number *"
                                             Text="{Binding CustomerData.Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             LostFocus="TextBox_LostFocus_Phone"
                                             InputScope="Number"
                                             PlaceholderText="0912..."
                                             CornerRadius="8"/>
                                    <TextBlock Text="{Binding PhoneError}"
                                               Foreground="#EF4444"
                                               FontSize="11"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Email, Gender and Birthday -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBox Header="Email Address"
                                             Text="{Binding CustomerData.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             LostFocus="TextBox_LostFocus_Email"
                                             InputScope="EmailSmtpAddress"
                                             CornerRadius="8"/>
                                    <TextBlock Text="{Binding EmailError}"
                                               Foreground="#EF4444"
                                               FontSize="11"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <ComboBox Header="Gender"
                                              SelectedItem="{Binding CustomerData.Gender, Mode=TwoWay}">
                                        <x:String>Male</x:String>
                                        <x:String>Female</x:String>
                                        <x:String>Other</x:String>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <CalendarDatePicker Header="Birthday"
                                                        Date="{Binding CustomerData.Birthday, Mode=TwoWay}"
                                                        HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Additional Information Section -->
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <FontIcon Glyph="&#xE713;"
                                  FontSize="16"
                                  Foreground="#27AE60"/>
                        <TextBlock Text="Additional Information"
                                   FontWeight="Bold"
                                   Foreground="#27AE60"/>
                    </StackPanel>

                    <Border BorderBrush="#EEEEEE"
                            BorderThickness="1"
                            CornerRadius="12"
                            Background="#F9F9F9"
                            Padding="15">
                        <StackPanel Spacing="12">
                            <TextBox Header="Address"
                                     Text="{Binding CustomerData.Address, Mode=TwoWay}"
                                     CornerRadius="8"/>

                            <TextBox Header="Notes"
                                     Text="{Binding CustomerData.Notes, Mode=TwoWay}"
                                     Height="80"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     CornerRadius="8"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Section -->
        <Grid Grid.Row="2"
              Padding="28,16,28,20"
              Background="White"
              BorderThickness="0,1,0,0"
              BorderBrush="#EEEEEE">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                    Content="Discard"
                    Style="{StaticResource TextBlockButtonStyle}"
                    Click="ModalFooter_CancelClicked"
                    Margin="0,0,12,0"
                    Foreground="Gray"/>

            <Button Grid.Column="2"
                    Content="{Binding SubmitButtonText}"
                    Style="{StaticResource AppPrimaryButtonStyle}"
                    Click="ModalFooter_SubmitClicked"
                    Padding="24,8"
                    CornerRadius="8"/>
        </Grid>
    </Grid>
</ContentDialog>