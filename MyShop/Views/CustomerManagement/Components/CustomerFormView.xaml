<ContentDialog
    x:Class="MyShop.Views.CustomerManagement.Components.CustomerFormView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MyShop.Views.Controls"
    xmlns:ui="using:MyShop.Views.Controls"
    CornerRadius="24"
    BorderThickness="0">

    <Grid Width="500" Margin="-24">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="NamePhoneGrid.ColumnDefinitions[1].Width" Value="0"/>
                        <Setter Target="PhoneContainer.(Grid.Column)" Value="0"/>
                        <Setter Target="PhoneContainer.(Grid.Row)" Value="1"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="600"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PhoneContainer.(Grid.Column)" Value="1"/>
                        <Setter Target="PhoneContainer.(Grid.Row)" Value="0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:ModalHeader Grid.Row="0" Padding="32,24,32,12" Title="{Binding FormTitle}" 
                        Subtitle="Manage individual customer information"
                        CancelClicked="ModalFooter_CancelClicked"/> <ScrollViewer Grid.Row="1" Padding="32,8,32,24" MaxHeight="500">
            <StackPanel Spacing="18">

                <Grid x:Name="NamePhoneGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="NameContainer" Margin="0,0,10,0">
                        <controls:LabeledInputControl Label="FULL NAME *">
                            <controls:LabeledInputControl.InputContent>
                                <TextBox Text="{Binding CustomerData.FullName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         LostFocus="TextBox_LostFocus_Name"/>
                            </controls:LabeledInputControl.InputContent>
                        </controls:LabeledInputControl>
                        <TextBlock Text="{Binding NameError}" Foreground="#EF4444" FontSize="12" Margin="0,4,0,0"
                                   Visibility="{Binding NameError, Converter={StaticResource StringToVisibilityConverter}}"/>
                    </StackPanel>

                    <StackPanel x:Name="PhoneContainer" Grid.Column="1" Margin="10,0,0,0">
                        <controls:LabeledInputControl Label="PHONE NUMBER *">
                            <controls:LabeledInputControl.InputContent>
                                <TextBox Text="{Binding CustomerData.Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         LostFocus="TextBox_LostFocus_Phone"/>
                            </controls:LabeledInputControl.InputContent>
                        </controls:LabeledInputControl>
                        <TextBlock Text="{Binding PhoneError}" Foreground="#EF4444" FontSize="12" Margin="0,4,0,0"
                                   Visibility="{Binding PhoneError, Converter={StaticResource StringToVisibilityConverter}}"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="EmailBirthdayGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,10,0">
                        <controls:LabeledInputControl Label="EMAIL ADDRESS">
                            <controls:LabeledInputControl.InputContent>
                                <TextBox Text="{Binding CustomerData.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         LostFocus="TextBox_LostFocus_Email"/>
                            </controls:LabeledInputControl.InputContent>
                        </controls:LabeledInputControl>
                        <TextBlock Text="{Binding EmailError}" Foreground="#EF4444" FontSize="12" Margin="0,4,0,0"
                                   Visibility="{Binding EmailError, Converter={StaticResource StringToVisibilityConverter}}"/>
                    </StackPanel>

                    <controls:LabeledInputControl Grid.Column="1" Label="BIRTHDAY" Margin="10,0,0,0">
                        <controls:LabeledInputControl.InputContent>
                            <CalendarDatePicker Date="{Binding CustomerData.Birthday, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                        </controls:LabeledInputControl.InputContent>
                    </controls:LabeledInputControl>
                </Grid>

                <controls:LabeledInputControl Label="ADDRESS">
                    <TextBox Text="{Binding CustomerData.Address, Mode=TwoWay}"/>
                </controls:LabeledInputControl>

                <controls:LabeledInputControl Label="NOTES">
                    <TextBox Text="{Binding CustomerData.Notes, Mode=TwoWay}" Height="80" AcceptsReturn="True" TextWrapping="Wrap"/>
                </controls:LabeledInputControl>

            </StackPanel>
        </ScrollViewer>

        <ui:ModalFooter Grid.Row="2" CancelText="Discard" SubmitText="{Binding SubmitButtonText}"
                        CancelClicked="ModalFooter_CancelClicked" SubmitClicked="ModalFooter_SubmitClicked"/>
    </Grid>
</ContentDialog>