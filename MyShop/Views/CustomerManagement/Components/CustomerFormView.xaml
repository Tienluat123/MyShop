<ContentDialog
        x:Class="MyShop.Views.CustomerManagement.Components.CustomerFormView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:MyShop.Views.Controls"
        xmlns:ui="using:MyShop.Views.Controls"
        CornerRadius="24"
        BorderThickness="0">

        <Grid   Width="500"
                Margin="-24">
                <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup>
                                <VisualState x:Name="NarrowState">
                                        <VisualState.StateTriggers>
                                                <AdaptiveTrigger MinWindowWidth="0"/>
                                        </VisualState.StateTriggers>
                                        <VisualState.Setters>
                                                <Setter Target="NamePhoneGrid.ColumnDefinitions[0].Width"
                                                        Value="*"/>
                                                <Setter Target="NamePhoneGrid.ColumnDefinitions[1].Width"
                                                        Value="0"/>
                                                <Setter Target="PhoneField.(Grid.Column)"
                                                        Value="0"/>
                                                <Setter Target="PhoneField.(Grid.Row)"
                                                        Value="1"/>
                                                <Setter Target="NameField.Margin"
                                                        Value="0"/>
                                                <Setter Target="PhoneField.Margin"
                                                        Value="0,12,0,0"/>

                                                <Setter Target="EmailBirthdayGrid.ColumnDefinitions[0].Width"
                                                        Value="*"/>
                                                <Setter Target="EmailBirthdayGrid.ColumnDefinitions[1].Width"
                                                        Value="0"/>
                                                <Setter Target="BirthdayField.(Grid.Column)"
                                                        Value="0"/>
                                                <Setter Target="BirthdayField.(Grid.Row)"
                                                        Value="1"/>
                                                <Setter Target="EmailField.Margin"
                                                        Value="0"/>
                                                <Setter Target="BirthdayField.Margin"
                                                        Value="0,12,0,0"/>
                                        </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="WideState">
                                        <VisualState.StateTriggers>
                                                <AdaptiveTrigger MinWindowWidth="600"/>
                                        </VisualState.StateTriggers>
                                        <VisualState.Setters>
                                                <Setter Target="NamePhoneGrid.ColumnDefinitions[0].Width"
                                                        Value="*"/>
                                                <Setter Target="NamePhoneGrid.ColumnDefinitions[1].Width"
                                                        Value="*"/>
                                                <Setter Target="PhoneField.(Grid.Column)"
                                                        Value="1"/>
                                                <Setter Target="PhoneField.(Grid.Row)"
                                                        Value="0"/>
                                                <Setter Target="NameField.Margin"
                                                        Value="0,0,10,0"/>
                                                <Setter Target="PhoneField.Margin"
                                                        Value="10,0,0,0"/>

                                                <Setter Target="EmailBirthdayGrid.ColumnDefinitions[0].Width"
                                                        Value="*"/>
                                                <Setter Target="EmailBirthdayGrid.ColumnDefinitions[1].Width"
                                                        Value="*"/>
                                                <Setter Target="BirthdayField.(Grid.Column)"
                                                        Value="1"/>
                                                <Setter Target="BirthdayField.(Grid.Row)"
                                                        Value="0"/>
                                                <Setter Target="EmailField.Margin"
                                                        Value="0,0,10,0"/>
                                                <Setter Target="BirthdayField.Margin"
                                                        Value="10,0,0,0"/>
                                        </VisualState.Setters>
                                </VisualState>
                        </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ui:ModalHeader Grid.Row="0"
                                Padding="32,24,32,12"
                                Title="{Binding FormTitle}"
                                Subtitle="Manage individual customer information"/>

                <ScrollViewer Grid.Row="1"
                              Padding="32,8,32,24"
                              MaxHeight="500">
                        <StackPanel Spacing="18">

                                <Grid x:Name="NamePhoneGrid">
                                        <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <controls:LabeledInputControl x:Name="NameField"
                                                                      Label="FULL NAME *"
                                                                      Margin="0,0,10,0">
                                                <controls:LabeledInputControl.InputContent>
                                                        <TextBox Text="{Binding CustomerData.FullName, Mode=TwoWay}"
                                                                 CornerRadius="12"
                                                                 Padding="14,10"/>
                                                </controls:LabeledInputControl.InputContent>
                                        </controls:LabeledInputControl>

                                        <controls:LabeledInputControl x:Name="PhoneField"
                                                                      Grid.Column="1"
                                                                      Label="PHONE NUMBER *"
                                                                      Margin="10,0,0,0">
                                                <controls:LabeledInputControl.InputContent>
                                                        <TextBox Text="{Binding CustomerData.Phone, Mode=TwoWay}"
                                                                 CornerRadius="12"
                                                                 Padding="14,10"/>
                                                </controls:LabeledInputControl.InputContent>
                                        </controls:LabeledInputControl>
                                </Grid>

                                <Grid x:Name="EmailBirthdayGrid">
                                        <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <controls:LabeledInputControl x:Name="EmailField"
                                                                      Label="EMAIL ADDRESS"
                                                                      Margin="0,0,10,0">
                                                <controls:LabeledInputControl.InputContent>
                                                        <TextBox Text="{Binding CustomerData.Email, Mode=TwoWay}"
                                                                 CornerRadius="12"
                                                                 Padding="14,10"/>
                                                </controls:LabeledInputControl.InputContent>
                                        </controls:LabeledInputControl>


                                        <controls:LabeledInputControl Label="BIRTHDAY"
                                                                      Grid.Column="1"
                                                                      Margin="12,0,0,0">
                                                <controls:LabeledInputControl.InputContent>
                                                        <CalendarDatePicker Date="{Binding CustomerData.Birthday, Mode=TwoWay}"
                                                                            PlaceholderText="Select birthday"
                                                                            HorizontalAlignment="Stretch"
                                                                            CornerRadius="12"
                                                                            Background="Transparent"
                                                                            BorderThickness="1"
                                                                            Padding="12,8"/>
                                                </controls:LabeledInputControl.InputContent>
                                        </controls:LabeledInputControl>

                                </Grid>

                                <controls:LabeledInputControl Label="ADDRESS">
                                        <controls:LabeledInputControl.InputContent>
                                                <TextBox Text="{Binding CustomerData.Address, Mode=TwoWay}"
                                                         CornerRadius="12"
                                                         Padding="14,10"/>
                                        </controls:LabeledInputControl.InputContent>
                                </controls:LabeledInputControl>

                                <controls:LabeledInputControl Label="NOTES">
                                        <controls:LabeledInputControl.InputContent>
                                                <TextBox Text="{Binding CustomerData.Notes, Mode=TwoWay}"
                                                         PlaceholderText="Add any specific preferences..."
                                                         TextWrapping="Wrap"
                                                         AcceptsReturn="True"
                                                         Height="100"
                                                         CornerRadius="12"
                                                         Padding="14,10"/>
                                        </controls:LabeledInputControl.InputContent>
                                </controls:LabeledInputControl>
                        </StackPanel>
                </ScrollViewer>

                <ui:ModalFooter Grid.Row="2"
                                CancelText="Discard"
                                SubmitText="{Binding SubmitButtonText}"
                                CancelClicked="ModalFooter_CancelClicked"
                                SubmitClicked="ModalFooter_SubmitClicked"/>
        </Grid>
</ContentDialog>