<ContentDialog
    x:Class="MyShop.Views.CustomerManagement.Components.CustomerFormView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MyShop.Views.Controls"
    xmlns:ui="using:MyShop.Views.Controls"
    CornerRadius="20"
    BorderThickness="0">

    <Grid x:Name="DialogRoot"
          Width="450"
          Margin="0"
          Padding="0">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CustomerFormResponsiveStates">
                <VisualState x:Name="CustomerFormNarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DialogRoot.Width" Value="Auto"/>
                        <Setter Target="DialogRoot.MaxWidth" Value="360"/>
                        <Setter Target="FormScrollViewer.Padding" Value="20,0,20,20"/>
                        <Setter Target="FormHeader.Padding" Value="20,16,20,12"/>
                        <Setter Target="FormFooter.Padding" Value="20,12,20,16"/>
                        <Setter Target="NamePhoneGrid.(Grid.ColumnDefinitions)[0].Width" Value="*"/>
                        <Setter Target="NamePhoneGrid.(Grid.ColumnDefinitions)[1].Width" Value="0"/>
                        <Setter Target="PhoneStack.(Grid.Column)" Value="0"/>
                        <Setter Target="PhoneStack.(Grid.Row)" Value="1"/>
                        <Setter Target="ContactGrid.(Grid.ColumnDefinitions)[0].Width" Value="*"/>
                        <Setter Target="ContactGrid.(Grid.ColumnDefinitions)[1].Width" Value="0"/>
                        <Setter Target="ContactGrid.(Grid.ColumnDefinitions)[2].Width" Value="0"/>
                        <Setter Target="GenderStack.(Grid.Column)" Value="0"/>
                        <Setter Target="GenderStack.(Grid.Row)" Value="1"/>
                        <Setter Target="BirthdayStack.(Grid.Column)" Value="0"/>
                        <Setter Target="BirthdayStack.(Grid.Row)" Value="2"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CustomerFormWideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="600"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DialogRoot.Width" Value="450"/>
                        <Setter Target="DialogRoot.MaxWidth" Value="450"/>
                        <Setter Target="FormScrollViewer.Padding" Value="28,0,28,20"/>
                        <Setter Target="FormHeader.Padding" Value="28,20,28,16"/>
                        <Setter Target="FormFooter.Padding" Value="28,16,28,20"/>
                        <Setter Target="NamePhoneGrid.(Grid.ColumnDefinitions)[0].Width" Value="*"/>
                        <Setter Target="NamePhoneGrid.(Grid.ColumnDefinitions)[1].Width" Value="*"/>
                        <Setter Target="PhoneStack.(Grid.Column)" Value="1"/>
                        <Setter Target="PhoneStack.(Grid.Row)" Value="0"/>
                        <Setter Target="ContactGrid.(Grid.ColumnDefinitions)[0].Width" Value="*"/>
                        <Setter Target="ContactGrid.(Grid.ColumnDefinitions)[1].Width" Value="*"/>
                        <Setter Target="ContactGrid.(Grid.ColumnDefinitions)[2].Width" Value="*"/>
                        <Setter Target="GenderStack.(Grid.Column)" Value="1"/>
                        <Setter Target="GenderStack.(Grid.Row)" Value="0"/>
                        <Setter Target="BirthdayStack.(Grid.Column)" Value="2"/>
                        <Setter Target="BirthdayStack.(Grid.Row)" Value="0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
          <Grid x:Name="FormHeader"
              Grid.Row="0"
              Padding="28,20,28,16"
              Background="White">
            <TextBlock Text="{Binding FormTitle}"
                       FontSize="20"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- Content Section -->
        <ScrollViewer x:Name="FormScrollViewer"
                  Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  Padding="28,0,28,20">
            <StackPanel Spacing="20">

                <!-- Personal Details Section -->
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <FontIcon Glyph="&#xE77B;"
                                  FontSize="16"
                                  Foreground="#2980B9"/>
                        <TextBlock Text="Personal Information"
                                   FontWeight="Bold"
                                   Foreground="#2980B9"/>
                    </StackPanel>

                    <Border BorderBrush="#EEEEEE"
                            BorderThickness="1"
                            CornerRadius="12"
                            Background="#F9F9F9"
                            Padding="15">
                        <StackPanel Spacing="12">
                            <!-- Full Name and Phone in 2 columns -->
                            <Grid x:Name="NamePhoneGrid" ColumnSpacing="12" RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBox Header="Full Name *"
                                             Text="{Binding CustomerData.FullName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             LostFocus="TextBox_LostFocus_Name"
                                             CornerRadius="8"/>
                                    <TextBlock Text="{Binding NameError}"
                                               Foreground="#EF4444"
                                               FontSize="11"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel x:Name="PhoneStack" Grid.Column="1" Grid.Row="0">
                                    <TextBox Header="Phone Number *"
                                             Text="{Binding CustomerData.Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             LostFocus="TextBox_LostFocus_Phone"
                                             InputScope="Number"
                                             PlaceholderText="0912..."
                                             CornerRadius="8"/>
                                    <TextBlock Text="{Binding PhoneError}"
                                               Foreground="#EF4444"
                                               FontSize="11"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Email, Gender and Birthday -->
                            <Grid x:Name="ContactGrid" ColumnSpacing="12" RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBox Header="Email Address"
                                             Text="{Binding CustomerData.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             LostFocus="TextBox_LostFocus_Email"
                                             InputScope="EmailSmtpAddress"
                                             CornerRadius="8"/>
                                    <TextBlock Text="{Binding EmailError}"
                                               Foreground="#EF4444"
                                               FontSize="11"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel x:Name="GenderStack" Grid.Column="1" Grid.Row="0">
                                    <ComboBox Header="Gender"
                                              SelectedItem="{Binding CustomerData.Gender, Mode=TwoWay}">
                                        <x:String>Male</x:String>
                                        <x:String>Female</x:String>
                                        <x:String>Other</x:String>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel x:Name="BirthdayStack" Grid.Column="2" Grid.Row="0">
                                    <CalendarDatePicker Header="Birthday"
                                                        Date="{Binding CustomerData.Birthday, Mode=TwoWay}"
                                                        HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Additional Information Section -->
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <FontIcon Glyph="&#xE713;"
                                  FontSize="16"
                                  Foreground="#27AE60"/>
                        <TextBlock Text="Additional Information"
                                   FontWeight="Bold"
                                   Foreground="#27AE60"/>
                    </StackPanel>

                    <Border BorderBrush="#EEEEEE"
                            BorderThickness="1"
                            CornerRadius="12"
                            Background="#F9F9F9"
                            Padding="15">
                        <StackPanel Spacing="12">
                            <TextBox Header="Address"
                                     Text="{Binding CustomerData.Address, Mode=TwoWay}"
                                     CornerRadius="8"/>

                            <TextBox Header="Notes"
                                     Text="{Binding CustomerData.Notes, Mode=TwoWay}"
                                     Height="80"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     CornerRadius="8"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Section -->
          <Grid x:Name="FormFooter"
              Grid.Row="2"
              Padding="28,16,28,20"
              Background="White"
              BorderThickness="0,1,0,0"
              BorderBrush="#EEEEEE">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                    Content="Discard"
                    Style="{StaticResource TextBlockButtonStyle}"
                    Click="ModalFooter_CancelClicked"
                    Margin="0,0,12,0"
                    Foreground="Gray"/>

            <Button Grid.Column="2"
                    Content="{Binding SubmitButtonText}"
                    Style="{StaticResource AppPrimaryButtonStyle}"
                    Click="ModalFooter_SubmitClicked"
                    Padding="24,8"
                    CornerRadius="8"/>
        </Grid>
    </Grid>
</ContentDialog>