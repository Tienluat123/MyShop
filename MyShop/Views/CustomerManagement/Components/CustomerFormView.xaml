<ContentDialog
    x:Class="MyShop.Views.CustomerManagement.Components.CustomerFormView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:MyShop.Views.Controls"
    CornerRadius="24"
    BorderThickness="0">

    <Grid Width="500"
          Margin="-24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:ModalHeader Grid.Row="0"
                        Title="{Binding FormTitle}"
                        Subtitle="Manage individual customer information"
                        CancelClicked="ModalFooter_CancelClicked"/>

        <ScrollViewer Grid.Row="1"
                      Padding="32,8,32,24"
                      MaxHeight="550">
            <StackPanel Spacing="20">

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ui:LabeledInputControl Label="FULL NAME *">
                        <ui:LabeledInputControl.InputContent>
                            <TextBox Text="{Binding CustomerData.FullName, Mode=TwoWay}"
                                     PlaceholderText="Enter full name..."
                                     CornerRadius="12"
                                     Padding="14,10"/>
                        </ui:LabeledInputControl.InputContent>
                    </ui:LabeledInputControl>

                    <ui:LabeledInputControl Grid.Column="1" Label="PHONE NUMBER *">
                        <ui:LabeledInputControl.InputContent>
                            <TextBox Text="{Binding CustomerData.Phone, Mode=TwoWay}"
                                     PlaceholderText="09xx.xxx.xxx"
                                     CornerRadius="12"
                                     Padding="14,10"/>
                        </ui:LabeledInputControl.InputContent>
                    </ui:LabeledInputControl>
                </Grid>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ui:LabeledInputControl Label="EMAIL ADDRESS">
                        <ui:LabeledInputControl.InputContent>
                            <TextBox Text="{Binding CustomerData.Email, Mode=TwoWay}"
                                     PlaceholderText="example@domain.com"
                                     CornerRadius="12"
                                     Padding="14,10"/>
                        </ui:LabeledInputControl.InputContent>
                    </ui:LabeledInputControl>

                    <ui:LabeledInputControl Grid.Column="1" Label="BIRTHDAY">
                        <ui:LabeledInputControl.InputContent>
                            <CalendarDatePicker Date="{Binding CustomerData.Birthday, Mode=TwoWay}"
                                                PlaceholderText="Select birthday"
                                                HorizontalAlignment="Stretch"
                                                CornerRadius="12"
                                                Padding="12,8"/>
                        </ui:LabeledInputControl.InputContent>
                    </ui:LabeledInputControl>
                </Grid>

                <ui:LabeledInputControl Label="ADDRESS">
                    <ui:LabeledInputControl.InputContent>
                        <TextBox Text="{Binding CustomerData.Address, Mode=TwoWay}"
                                 PlaceholderText="Street, District, City..."
                                 CornerRadius="12"
                                 Padding="14,10"/>
                    </ui:LabeledInputControl.InputContent>
                </ui:LabeledInputControl>

                <ui:LabeledInputControl Label="NOTES">
                    <ui:LabeledInputControl.InputContent>
                        <TextBox Text="{Binding CustomerData.Notes, Mode=TwoWay}"
                                 PlaceholderText="Add any specific preferences..."
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Height="100"
                                 CornerRadius="12"
                                 Padding="14,10"/>
                    </ui:LabeledInputControl.InputContent>
                </ui:LabeledInputControl>
            </StackPanel>
        </ScrollViewer>

        <ui:ModalFooter Grid.Row="2"
                        CancelText="Discard"
                        SubmitText="{Binding SubmitButtonText}"
                        CancelClicked="ModalFooter_CancelClicked"
                        SubmitClicked="ModalFooter_SubmitClicked"/>
    </Grid>
</ContentDialog>