<Page
    x:Class="MyShop.Views.CustomerManagement.Components.LoyaltyRulesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F3F4F6">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="24,14">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Command="{Binding BackCommand}" Background="Transparent" BorderThickness="0" Padding="0">
                    <FontIcon Glyph="&#xE72B;" Foreground="#64748B" />
                </Button>
                <StackPanel>
                    <TextBlock Text="Loyalty Rules" FontSize="34" FontWeight="ExtraBold" Foreground="#0F172A" />
                    <TextBlock Text="Configure your loyalty program settings" Foreground="#94A3B8" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="760" MaxWidth="760">
            <Border CornerRadius="24" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" Padding="30,28,30,0">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <Border.Translation>0,0,16</Border.Translation>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Rectangle Width="3" Height="24" Fill="#BB4D00" RadiusX="1.5" RadiusY="1.5" />
                            <TextBlock Text="POINTS CALCULATION" FontSize="30" FontWeight="Black" Foreground="#0F172A" />
                        </StackPanel>

                        <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="16" Padding="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Points Earning Rate" Foreground="#BB4D00" FontSize="24" FontWeight="Bold" />
                                    <TextBlock Text="Customer earns X points for every Y amount spent" Foreground="#D97706" FontSize="12" />
                                </StackPanel>

                                <TextBox Grid.Column="1" Width="70" Height="40" Text="{Binding PointsRate, Mode=TwoWay}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" CornerRadius="12" BorderBrush="#FCD34D" />
                                <TextBlock Grid.Column="2" Text="/" Foreground="#D97706" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0" />
                                <TextBox Grid.Column="3" Width="92" Height="40" Text="{Binding MoneyUnit, Mode=TwoWay}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" CornerRadius="12" BorderBrush="#FCD34D" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,24,0,0" Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Rectangle Width="3" Height="24" Fill="#BB4D00" RadiusX="1.5" RadiusY="1.5" />
                            <TextBlock Text="TIER THRESHOLDS" FontSize="30" FontWeight="Black" Foreground="#0F172A" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding TierThresholdsCollection}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Width="40" Height="40" CornerRadius="20" Background="#FFFFFF">
                                                <FontIcon Glyph="&#xE7C1;" Foreground="#9CA3AF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding TierName}" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="Bold" Foreground="#334155" />
                                            <TextBox Grid.Column="2" Width="78" Height="40" Text="{Binding Points, Mode=TwoWay}" HorizontalContentAlignment="Center" CornerRadius="10" BorderBrush="#E2E8F0" />
                                            <TextBlock Grid.Column="3" Text="POINTS" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#CBD5E1" FontWeight="Bold" FontSize="11" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Border Grid.Row="3" Margin="-30,24,-30,0" Padding="30,24" Background="#F8FAFC" CornerRadius="0,0,24,24">
                        <Button Command="{Binding SaveRulesCommand}"
                                HorizontalAlignment="Right"
                                Background="#BB4D00"
                                Foreground="White"
                                BorderBrush="#BB4D00"
                                CornerRadius="12"
                                Padding="36,12">
                            <TextBlock Text="SAVE RULES" FontWeight="Bold" />
                        </Button>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
