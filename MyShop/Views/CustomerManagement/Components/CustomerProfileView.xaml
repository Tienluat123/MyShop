<Page
    x:Class="MyShop.Views.CustomerManagement.Components.CustomerProfileView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F3F4F6">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="24,14">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Command="{Binding BackCommand}" Background="Transparent" BorderThickness="0" Padding="0">
                    <FontIcon Glyph="&#xE72B;" Foreground="#64748B" />
                </Button>
                <StackPanel>
                    <TextBlock Text="Customer Profile" FontSize="34" FontWeight="ExtraBold" Foreground="#0F172A" />
                    <TextBlock Text="Manage individual customer information" Foreground="#94A3B8" />
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,24,28,24" Spacing="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="7*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="18" BorderBrush="#E5E7EB" BorderThickness="1" Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <Border Width="100" Height="100" CornerRadius="16" Background="#E2E8F0">
                                    <TextBlock Text="{Binding SelectedCustomer.Customer.Initials}" Foreground="#BB4D00" FontSize="28" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Background="#FEF3C7" CornerRadius="10" Padding="10,4" Margin="0,14,0,0" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding SelectedCustomer.Customer.Tier}" Foreground="#92400E" FontWeight="Bold" FontSize="12" />
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="10">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedCustomer.Customer.Name}" FontSize="42" FontWeight="Black" Foreground="#0F172A" />
                                    <TextBlock Foreground="#94A3B8">
                                        <Run Text="#" />
                                        <Run Text="{Binding SelectedCustomer.Customer.Code}" />
                                        <Run Text=" - Joined 11/25/2025" />
                                    </TextBlock>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE717;" Foreground="#94A3B8" />
                                        <StackPanel>
                                            <TextBlock Text="PHONE" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" />
                                            <TextBlock Text="{Binding SelectedCustomer.Customer.Phone}" Foreground="#334155" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE715;" Foreground="#94A3B8" />
                                        <StackPanel>
                                            <TextBlock Text="EMAIL" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" />
                                            <TextBlock Text="{Binding SelectedCustomer.Email}" Foreground="#334155" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE787;" Foreground="#94A3B8" />
                                        <StackPanel>
                                            <TextBlock Text="BIRTHDAY" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" />
                                            <TextBlock Text="{Binding SelectedCustomer.BirthdayText}" Foreground="#334155" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE707;" Foreground="#94A3B8" />
                                        <StackPanel>
                                            <TextBlock Text="ADDRESS" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" />
                                            <TextBlock Text="{Binding SelectedCustomer.Address}" Foreground="#334155" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <Button Grid.Column="2" Background="#F8FAFC" BorderThickness="0" CornerRadius="10" Width="36" Height="36">
                                <FontIcon Glyph="&#xE70F;" Foreground="#94A3B8" />
                            </Button>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Margin="16,0,0,0" Background="#BB4D00" CornerRadius="18" Padding="18">
                        <StackPanel Spacing="12">
                            <TextBlock Text="POINTS BALANCE" Foreground="#FDBA74" FontWeight="Bold" FontSize="11" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding SelectedCustomer.Customer.Points}" Foreground="White" FontSize="56" FontWeight="Black" />
                                <FontIcon Glyph="&#xE734;" Foreground="#FACC15" VerticalAlignment="Center" FontSize="28" />
                            </StackPanel>

                            <Border Background="#C35F18" CornerRadius="12" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Total Spent" Foreground="White" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedCustomer.TotalSpentText}" Foreground="White" FontWeight="Black" />
                                </Grid>
                            </Border>

                            <Border Background="#C35F18" CornerRadius="12" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Total Visits" Foreground="White" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedCustomer.Customer.Visits}" Foreground="White" FontWeight="Black" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Background="#FFFFFF" CornerRadius="18" BorderBrush="#E5E7EB" BorderThickness="1" Padding="16">
                    <TabView SelectedIndex="{Binding ActiveTab, Mode=TwoWay}">
                        <TabViewItem Header="ORDER HISTORY">
                            <StackPanel Margin="0,8,0,0">
                                <Grid Padding="12" Background="#F8FAFC" CornerRadius="10,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="4*" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ORDER ID" Foreground="#94A3B8" FontWeight="Bold" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="DATE" Foreground="#94A3B8" FontWeight="Bold" FontSize="11" />
                                    <TextBlock Grid.Column="2" Text="ITEMS" Foreground="#94A3B8" FontWeight="Bold" FontSize="11" />
                                    <TextBlock Grid.Column="3" Text="AMOUNT" Foreground="#94A3B8" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
                                </Grid>
                                <ListView ItemsSource="{Binding SelectedCustomer.Orders}" BorderThickness="0" Background="Transparent">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="12" BorderBrush="#EEF2F7" BorderThickness="0,0,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="4*" />
                                                    <ColumnDefinition Width="2*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding OrderId}" Foreground="#334155" FontWeight="Bold" />
                                                <TextBlock Grid.Column="1" Text="{Binding DateText}" Foreground="#64748B" />
                                                <TextBlock Grid.Column="2" Text="{Binding Items}" Foreground="#334155" FontStyle="Italic" />
                                                <TextBlock Grid.Column="3" Text="{Binding AmountText}" Foreground="#0F172A" FontWeight="Bold" HorizontalAlignment="Right" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </TabViewItem>

                        <TabViewItem Header="POINTS HISTORY">
                            <ListView Margin="0,8,0,0" ItemsSource="{Binding SelectedCustomer.PointLogs}" BorderThickness="0" Background="Transparent">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FAFC" CornerRadius="10" Margin="0,0,0,10" Padding="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Width="30" Height="30" CornerRadius="15" Background="#E2E8F0">
                                                    <FontIcon Glyph="{Binding DeltaGlyph}" Foreground="{Binding DeltaForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>

                                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding Title}" Foreground="#1E293B" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding DateText}" Foreground="#94A3B8" FontSize="11" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="2" Text="{Binding SignedPoints}" Foreground="{Binding DeltaForeground}" VerticalAlignment="Center" FontWeight="Bold" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </TabViewItem>

                        <TabViewItem Header="NOTES">
                            <Border Margin="0,12,0,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="24" Background="#F8FAFC">
                                <StackPanel HorizontalAlignment="Center" Spacing="10">
                                    <FontIcon Glyph="&#xE70B;" Foreground="#CBD5E1" FontSize="36" />
                                    <TextBlock Text="No internal notes for this customer" Foreground="#94A3B8" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <Button Command="{Binding AddNoteCommand}" Background="#FFFFFF" BorderBrush="#E2E8F0" CornerRadius="12" Padding="20,8">
                                        <TextBlock Text="ADD NOTE" Foreground="#94A3B8" FontWeight="Bold" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </TabViewItem>
                    </TabView>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
