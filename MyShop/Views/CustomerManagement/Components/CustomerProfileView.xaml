<Page x:Class="MyShop.Views.CustomerManagement.Components.CustomerProfileView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F3F4F6">
    <Page.Resources>
        <DataTemplate x:Key="OrderRowTemplate">
            <Grid Padding="12" BorderThickness="0,0,0,1" BorderBrush="#EEF2F7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding OrderId}" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding DateText}" Margin="20,0" Foreground="#64748B" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding AmountText}" Foreground="#BB4D00" FontWeight="Bold" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <RowDefinition Height="Auto" /> <RowDefinition Height="*" />    </Grid.RowDefinitions>

        <Border Padding="24,14" Background="White" BorderThickness="0,0,0,1" BorderBrush="#E5E7EB">
            <StackPanel Orientation="Horizontal" Spacing="15">
                <Button Command="{Binding GoBackCommand}" Background="Transparent" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets"/>
                <TextBlock Text="Customer Profile" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Margin="24,16" Padding="20" Background="White" CornerRadius="12">
            <StackPanel Orientation="Horizontal" Spacing="20">
                <Border Width="80" Height="80" CornerRadius="40" Background="#BB4D00">
                    <TextBlock Text="{Binding SelectedCustomer.Customer.Initials}" Foreground="White" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
    <TextBlock Text="{Binding SelectedCustomer.Customer.Name}" FontSize="28" FontWeight="Bold"/>
    
    <TextBlock Text="{Binding SelectedCustomer.Email}" Foreground="#64748B"/>
    
    <TextBlock Text="{Binding SelectedCustomer.Customer.Phone}" Foreground="#64748B"/>
</StackPanel>
            </StackPanel>
        </Border>

        <ContentControl x:Name="DynamicTabContainer" 
                Grid.Row="2" 
                Margin="24,0,24,24" 
                HorizontalContentAlignment="Stretch" 
                VerticalContentAlignment="Stretch" />
         </Grid>
</Page>