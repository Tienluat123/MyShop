<Page
    x:Class="MyShop.Views.CustomerManagement.Components.CustomerManagementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:MyShop.ViewModels"
    xmlns:converters="using:MyShop.Converters"
    x:Name="PageRoot"
    Background="#F3F4F6">

    <Page.Resources>
        <converters:CurrencyConverter x:Key="CurrencyConverter"/>
        <converters:StatusToBrushConverter x:Key="StatusToBrushConverter"/>
        <converters:LoyaltyTierBrushConverter x:Key="LoyaltyTierBrushConverter"/>
        <converters:StringToBoolConverter x:Key="StringToBoolConverter"/>
        <converters:SortIndicatorConverter x:Key="SortIndicatorConverter"/>

        <!-- Style for sort header buttons - keeps color consistent on press/hover -->
        <Style x:Key="SortHeaderButtonStyle"
                TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="Gray"/>
            <Setter Property="Padding"
                    Value="0"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="HorizontalAlignment"
                    Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>


    <Border Grid.Row="1"
            Margin="16,12,16,16"
            Background="White"
            CornerRadius="12"
            BorderThickness="1"
            BorderBrush="#EEEEEE">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <Grid Grid.Row="0"
                  Padding="16,16,16,12"
                  ColumnSpacing="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1"
                        HorizontalAlignment="Right"
                        Command="{x:Bind ViewModel.AddCustomerCommand}"
                        Style="{StaticResource AppPrimaryButtonStyle}"
                        Height="35"
                        Padding="20,0"
                        CornerRadius="20"
                        VerticalAlignment="Center"
                        BorderThickness="0">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <FontIcon Glyph="&#xE710;"
                                  FontSize="14"/>
                        <TextBlock Text="Add Customer"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                    <Border HorizontalAlignment="Left"
                            Background="#F0F0F0"
                            CornerRadius="20"
                            BorderThickness="1"
                            BorderBrush="Gray"
                            Padding="12,0,12,0"
                            Height="35"
                            Width="250">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <FontIcon Glyph="&#xE71E;"
                                      FontSize="14"
                                      Foreground="Gray"
                                      VerticalAlignment="Center"/>

                            <TextBox Grid.Column="1"
                                     PlaceholderText="Search everything..."
                                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     VerticalAlignment="Center"
                                     Margin="0,3,0,0">
                                <TextBox.Resources>
                                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                    <SolidColorBrush x:Key="TextControlBackground"
                                                     Color="Transparent"/>
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused"
                                                     Color="Transparent"/>
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver"
                                                     Color="Transparent"/>
                                </TextBox.Resources>
                            </TextBox>
                        </Grid>
                    </Border>

                    <!-- Advanced Sort Button -->
                    <Button Background="White"
                            Height="35"
                            CornerRadius="20"
                            BorderThickness="1"
                            BorderBrush="#E0E0E0"
                            Padding="16,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8CB;" FontSize="14" Foreground="#4A4A4A"/>
                            <TextBlock Text="Advanced Sort" Foreground="#4A4A4A" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout>
                                <StackPanel Width="360" Spacing="12" Padding="4">
                                    <TextBlock Text="Multi-Criteria Sorting" FontWeight="Bold" FontSize="16"/>
                                    <TextBlock Text="Add multiple levels of sorting logic." FontSize="12" Foreground="Gray" TextWrapping="Wrap"/>

                                    <ItemsControl ItemsSource="{x:Bind ViewModel.SortCriteriaList, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="viewModels:SortCriteriaItem">
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <ComboBox Grid.Column="0" 
                                                              ItemsSource="{x:Bind AvailableColumns, Mode=OneWay}" 
                                                              SelectedValue="{x:Bind ColumnName, Mode=TwoWay}" 
                                                              HorizontalAlignment="Stretch" Margin="0,0,8,0"/>
                                                    
                                                    <ComboBox Grid.Column="1" 
                                                              SelectedValue="{x:Bind Direction, Mode=TwoWay}"
                                                              SelectedValuePath="Content"
                                                              HorizontalAlignment="Stretch" Margin="0,0,8,0">
                                                        <ComboBoxItem Content="ASC"/>
                                                        <ComboBoxItem Content="DESC"/>
                                                    </ComboBox>

                                                    <Button Grid.Column="2" 
                                                            Background="Transparent" 
                                                            BorderThickness="0" 
                                                            Padding="4" 
                                                            Command="{Binding DataContext.RemoveSortCriteriaCommand, ElementName=PageRoot}"
                                                            CommandParameter="{x:Bind}">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="Red"/>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button Content="+ Add Level"
                                            Command="{x:Bind ViewModel.AddSortCriteriaCommand}"
                                            Background="Transparent"
                                            Foreground="#0078D7"
                                            BorderThickness="0"
                                            HorizontalAlignment="Left"/>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Clear All"
                                                Command="{x:Bind ViewModel.ClearMultiSortCommand}"
                                                HorizontalAlignment="Stretch" Margin="0,0,4,0"/>
                                        <Button Grid.Column="1" Content="Apply"
                                                Command="{x:Bind ViewModel.ApplyMultiSortCommand}"
                                                Style="{StaticResource AppPrimaryButtonStyle}"
                                                HorizontalAlignment="Stretch" Margin="4,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Table Section -->
            <Border Grid.Row="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header Row -->
                    <Border Grid.Row="0"
                            Background="#FAFAFA"
                            Padding="16,12"
                            BorderBrush="#EEEEEE"
                            BorderThickness="0,0,0,1">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="0.5*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="0.9*"/>
                                <ColumnDefinition Width="0.9*"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <!-- Name -->
                            <Button Style="{StaticResource SortHeaderButtonStyle}"
                                    Command="{x:Bind ViewModel.SortByColumnCommand}"
                                    CommandParameter="Name">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="NAME" FontSize="11" FontWeight="Bold"/>
                                    <FontIcon Glyph="{x:Bind ViewModel.SortInfo, Mode=OneWay, Converter={StaticResource SortIndicatorConverter}, ConverterParameter=Name}" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                            <!-- Email -->
                            <Button Grid.Column="1" Style="{StaticResource SortHeaderButtonStyle}"
                                    Command="{x:Bind ViewModel.SortByColumnCommand}"
                                    CommandParameter="Email">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="EMAIL" FontSize="11" FontWeight="Bold"/>
                                    <FontIcon Glyph="{x:Bind ViewModel.SortInfo, Mode=OneWay, Converter={StaticResource SortIndicatorConverter}, ConverterParameter=Email}" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                            <!-- Gender -->
                            <Button Grid.Column="2" Style="{StaticResource SortHeaderButtonStyle}"
                                    Command="{x:Bind ViewModel.SortByColumnCommand}"
                                    CommandParameter="Gender">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="GENDER" FontSize="11" FontWeight="Bold"/>
                                    <FontIcon Glyph="{x:Bind ViewModel.SortInfo, Mode=OneWay, Converter={StaticResource SortIndicatorConverter}, ConverterParameter=Gender}" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                            <!-- Birthday -->
                            <Button Grid.Column="3" Style="{StaticResource SortHeaderButtonStyle}"
                                    Command="{x:Bind ViewModel.SortByColumnCommand}"
                                    CommandParameter="Birthday">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="BIRTHDAY" FontSize="11" FontWeight="Bold"/>
                                    <FontIcon Glyph="{x:Bind ViewModel.SortInfo, Mode=OneWay, Converter={StaticResource SortIndicatorConverter}, ConverterParameter=Birthday}" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                            <!-- Total Points -->
                            <Button Grid.Column="4" Style="{StaticResource SortHeaderButtonStyle}" HorizontalAlignment="Right"
                                    Command="{x:Bind ViewModel.SortByColumnCommand}"
                                    CommandParameter="TotalAccumulatedPoints">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="POINTS" FontSize="11" FontWeight="Bold"/>
                                    <FontIcon Glyph="{x:Bind ViewModel.SortInfo, Mode=OneWay, Converter={StaticResource SortIndicatorConverter}, ConverterParameter=TotalAccumulatedPoints}" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                            <!-- Available Points -->
                            <Button Grid.Column="5" Style="{StaticResource SortHeaderButtonStyle}" HorizontalAlignment="Right"
                                    Command="{x:Bind ViewModel.SortByColumnCommand}"
                                    CommandParameter="CurrentAvailablePoints">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="AVAILABLE" FontSize="11" FontWeight="Bold"/>
                                    <FontIcon Glyph="{x:Bind ViewModel.SortInfo, Mode=OneWay, Converter={StaticResource SortIndicatorConverter}, ConverterParameter=CurrentAvailablePoints}" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                            <!-- Tier -->
                            <Button Grid.Column="6" Style="{StaticResource SortHeaderButtonStyle}"
                                    Command="{x:Bind ViewModel.SortByColumnCommand}"
                                    CommandParameter="TotalAccumulatedPoints">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="TIER" FontSize="11" FontWeight="Bold"/>
                                    <FontIcon Glyph="{x:Bind ViewModel.SortInfo, Mode=OneWay, Converter={StaticResource SortIndicatorConverter}, ConverterParameter=TotalAccumulatedPoints}" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                            <!-- Status -->
                            <Button Grid.Column="7" Style="{StaticResource SortHeaderButtonStyle}" HorizontalAlignment="Center"
                                    Command="{x:Bind ViewModel.SortByColumnCommand}"
                                    CommandParameter="Status">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="STATUS" FontSize="11" FontWeight="Bold"/>
                                    <FontIcon Glyph="{x:Bind ViewModel.SortInfo, Mode=OneWay, Converter={StaticResource SortIndicatorConverter}, ConverterParameter=Status}" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                            <!-- Visits -->
                            <Button Grid.Column="8" Style="{StaticResource SortHeaderButtonStyle}" HorizontalAlignment="Center"
                                    Command="{x:Bind ViewModel.SortByColumnCommand}"
                                    CommandParameter="TotalVisits">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="VISITS" FontSize="11" FontWeight="Bold"/>
                                    <FontIcon Glyph="{x:Bind ViewModel.SortInfo, Mode=OneWay, Converter={StaticResource SortIndicatorConverter}, ConverterParameter=TotalVisits}" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                            <!-- Actions -->
                            <TextBlock Grid.Column="9"
                                       Text="ACTIONS"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="Gray"
                                       HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Data Rows -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.DisplayCustomers, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:CustomerListItem">
                                    <Border BorderBrush="#F9F9F9"
                                            BorderThickness="0,0,0,1"
                                            Padding="16,10">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="0.5*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="0.9*"/>
                                                <ColumnDefinition Width="0.9*"/>
                                                <ColumnDefinition Width="0.8*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Name -->
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="8">
                                                <Border Width="28"
                                                        Height="28"
                                                        CornerRadius="14"
                                                        Background="#E8F3F8">
                                                    <TextBlock Text="{x:Bind Initials}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontWeight="Bold"
                                                               Foreground="#0078D4"/>
                                                </Border>
                                                <TextBlock Text="{x:Bind Name}"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"/>
                                            </StackPanel>

                                            <!-- Email -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind Email, TargetNullValue='-'}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Foreground="#555555"/>

                                            <!-- Gender -->
                                            <TextBlock Grid.Column="2"
                                                       Text="{x:Bind Gender, TargetNullValue='-'}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Foreground="#555555"/>

                                            <!-- Birthday -->
                                            <TextBlock Grid.Column="3"
                                                       Text="{x:Bind BirthdayDisplay}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Foreground="#555555"/>

                                            <!-- Total Points -->
                                            <TextBlock Grid.Column="4"
                                                       Text="{x:Bind TotalAccumulatedPoints}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Right"
                                                       Foreground="#10B981"/>

                                            <!-- Available Points -->
                                            <TextBlock Grid.Column="5"
                                                       Text="{x:Bind CurrentAvailablePoints}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Right"
                                                       Foreground="#F59E0B"/>

                                            <!-- Tier -->
                                            <Border Grid.Column="6"
                                                    Background="{x:Bind Tier, Converter={StaticResource LoyaltyTierBrushConverter}}"
                                                    CornerRadius="6"
                                                    Padding="8,4"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center">
                                                <TextBlock Text="{x:Bind Tier}"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="White"/>
                                            </Border>

                                            <!-- Status Toggle -->
                                            <ToggleSwitch Grid.Column="7"
                                                          IsOn="{x:Bind Status, Mode=TwoWay, Converter={StaticResource StringToBoolConverter}}"
                                                          OnContent="Active"
                                                          OffContent="Inactive"
                                                          FontSize="10"
                                                          MinWidth="0"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Toggled="Status_Toggled"/>

                                            <!-- Visits -->
                                            <TextBlock Grid.Column="8"
                                                       Text="{x:Bind Visits}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       HorizontalAlignment="Center"
                                                       Foreground="#666666"/>

                                            <!-- Actions -->
                                            <StackPanel Grid.Column="9"
                                                        Orientation="Horizontal"
                                                        Spacing="8"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <Button Style="{StaticResource AppIconButtonStyle}"
                                                        Click="ViewProfileButton_Click"
                                                        ToolTipService.ToolTip="View Profile"
                                                        Foreground="#0078D4">
                                                    <FontIcon Glyph="&#xE72A;"
                                                              FontSize="16"/>
                                                </Button>

                                                <Button Style="{StaticResource AppIconButtonStyle}"
                                                        Click="EditButton_Click"
                                                        ToolTipService.ToolTip="Edit Customer"
                                                        Foreground="#107C10">
                                                    <FontIcon Glyph="&#xEB7E;"
                                                              FontSize="16"/>
                                                </Button>

                                                <Button Style="{StaticResource AppIconButtonStyle}"
                                                        Click="DeleteButton_Click"
                                                        ToolTipService.ToolTip="Delete Customer"
                                                        Foreground="#E81123">
                                                    <FontIcon Glyph="&#xED62;"
                                                              FontSize="16"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Paging Controls -->
                    <Border Grid.Row="2"
                            Background="White"
                            Padding="10"
                            BorderBrush="#EEEEEE"
                            BorderThickness="0,1,0,0">
                        <Grid ColumnSpacing="12"
                              HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Previous Button -->
                            <Button Grid.Column="0"
                                    Content="←"
                                    Click="PreviousButton_Click"
                                    Height="30"
                                    Padding="16,0"
                                    CornerRadius="8"
                                    Background="#F0F0F0"
                                    Foreground="#333333"/>

                            <!-- Page Info -->
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.PageInfoDisplay, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#555555"/>

                            <!-- Next Button -->
                            <Button Grid.Column="2"
                                    Content="→"
                                    Click="NextButton_Click"
                                    Height="30"
                                    Padding="16,0"
                                    CornerRadius="8"
                                    Background="#0078D4"
                                    Foreground="White"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Page>
