<Page
    x:Class="MyShop.Views.CustomerManagement.Components.CustomerManagementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:MyShop.ViewModels"
    x:Name="PageRoot"
    Background="#F3F4F6">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,12,16,20" Spacing="16">
                
                <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="14" Padding="16">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Command="{Binding MapsToAddCommand}" Background="#BB4D00" Foreground="White" CornerRadius="12" Padding="14,8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;"/>
                                    <TextBlock Text="Add Customer" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Grid Grid.Column="2">
                                <TextBox Padding="40,10,10,10" Background="#F8FAFC" BorderBrush="#E5E7EB" CornerRadius="12" 
                                        PlaceholderText="Search by name or phone..."
                                        Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <FontIcon Glyph="&#xE721;" Foreground="#94A3B8" Margin="14,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>

                        <MenuFlyoutSeparator Background="#E5E7EB" Margin="-16,0"/>

                        <ItemsRepeater ItemsSource="{Binding DisplayCustomers}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="12"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:CustomerListItem">
                                    <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Padding="16">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Width="48" Height="48" CornerRadius="24" Background="#F1F5F9">
                                                <TextBlock Text="{x:Bind Initials}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#BB4D00" FontWeight="Bold"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" Foreground="#1E293B"/>
                                                <TextBlock Foreground="#6B7280" FontSize="12">
                                                    <Run Text="ID: "/><Run Text="{x:Bind Code}"/>
                                                    <Run Text=" • "/><Run Text="{x:Bind Phone}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Button Command="{Binding DataContext.MapsToProfileCommand, ElementName=PageRoot}" CommandParameter="{Binding}" Background="Transparent">
                                                    <FontIcon Glyph="&#xE72A;" Foreground="#6B7280" FontSize="16"/>
                                                </Button>
                                                <Button Command="{Binding DataContext.EditCustomerCommand, ElementName=PageRoot}" CommandParameter="{Binding}" Background="Transparent">
                                                    <FontIcon Glyph="&#xE70F;" Foreground="#6B7280" FontSize="16"/>
                                                </Button>
                                                <Button Click="DeleteButton_Click" Background="Transparent">
                                                    <FontIcon Glyph="&#xE74D;" Foreground="#EF4444" FontSize="16"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <MenuFlyoutSeparator Background="#E5E7EB" Margin="-16,0"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding PagingSummary}" Foreground="#64748B" VerticalAlignment="Center"/>
                            
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Command="{Binding PreviousPageCommand}" Content="&#xE76B;" FontFamily="Segoe MDL2 Assets" Background="White"/>
                                
                                <ItemsControl ItemsSource="{Binding PageNumbers}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}" 
                                                    Command="{Binding DataContext.GoToPageCommand, ElementName=PageRoot}" 
                                                    CommandParameter="{Binding}" Width="32"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Command="{Binding NextPageCommand}" Content="&#xE76C;" FontFamily="Segoe MDL2 Assets" Background="White"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>