<Page
    x:Class="MyShop.Views.CustomerManagement.Components.CustomerManagementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:MyShop.ViewModels"
    xmlns:controls="using:MyShop.Views.Controls"
    x:Name="PageRoot"
    Background="#F3F4F6">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,12,16,20"
                        Spacing="16">
                
                <Border Background="#FFFFFF"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="16">
                    <StackPanel Spacing="16">
                        
                        <!-- Actions Section -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Command="{Binding MapsToAddCommand}"
                                    Background="#BB4D00"
                                    BorderBrush="#BB4D00"
                                    Foreground="White"
                                    CornerRadius="12"
                                    Padding="14,8">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8">
                                    <FontIcon Glyph="&#xE710;"/>
                                    <TextBlock Text="Add Customer"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Grid Grid.Column="2">
                                <TextBox Padding="40,10,10,10"
                                         Background="#F8FAFC"
                                         BorderBrush="#E5E7EB"
                                         CornerRadius="12"
                                         PlaceholderText="Search by name or phone..."
                                         Text="{Binding SearchText, Mode=TwoWay}"/>
                                <FontIcon Glyph="&#xE721;"
                                          Foreground="#94A3B8"
                                          Margin="14,0,0,0"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>

                        <MenuFlyoutSeparator Background="#E5E7EB" Margin="-16,0"/>

                        <!-- Customer List -->
                        <ItemsRepeater ItemsSource="{Binding DisplayCustomers}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical"
                                             Spacing="12"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:CustomerListItem">
                                    <Border Background="White"
                                            BorderBrush="#E5E7EB"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="16">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Avatar -->
                                            <Border Grid.Column="0"
                                                    Width="48"
                                                    Height="48"
                                                    CornerRadius="24"
                                                    Background="#F1F5F9"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Initials}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="#BB4D00"
                                                           FontWeight="Bold"
                                                           FontSize="14"/>
                                            </Border>

                                            <!-- Customer Details -->
                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Spacing="4">
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="12">
                                                    <TextBlock Text="{x:Bind Name}"
                                                               Style="{StaticResource BodyTextStyle}"
                                                               FontWeight="SemiBold"
                                                               Foreground="#1E293B"/>
                                                    <Border Background="#FEF3C7"
                                                            CornerRadius="6"
                                                            Padding="8,4">
                                                        <TextBlock Text="{x:Bind Tier}"
                                                                   FontSize="12"
                                                                   FontWeight="Bold"
                                                                   Foreground="#92400E"/>
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="16">
                                                    <TextBlock Style="{StaticResource CaptionTextStyle}"
                                                               Foreground="#6B7280">
                                                        <Run Text="ID: "/><Run Text="{x:Bind Code}"/>
                                                    </TextBlock>
                                                    <TextBlock Style="{StaticResource CaptionTextStyle}"
                                                               Foreground="#6B7280">
                                                        <Run Text="Phone: "/><Run Text="{x:Bind Phone}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Stats -->
                                            <StackPanel Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        Spacing="2">
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="4">
                                                    <FontIcon Glyph="&#xE734;"
                                                              Foreground="#F59E0B"
                                                              FontSize="12"/>
                                                    <TextBlock Text="{x:Bind Points}"
                                                               Style="{StaticResource BodyTextStyle}"
                                                               FontWeight="Bold"/>
                                                    <TextBlock Text="pts"
                                                               Style="{StaticResource CaptionTextStyle}"/>
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource CaptionTextStyle}"
                                                           Foreground="#6B7280">
                                                    <Run Text="{x:Bind Visits}"/> <Run Text="visits"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Actions -->
                                            <StackPanel Grid.Column="3"
                                                        Orientation="Horizontal"
                                                        Spacing="8"
                                                        VerticalAlignment="Center">
                                                <Button Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="8"
                                                        Command="{Binding DataContext.MapsToProfileCommand, ElementName=PageRoot}"
                                                        CommandParameter="{Binding}">
                                                    <FontIcon Glyph="&#xE72A;"
                                                              FontSize="16"
                                                              Foreground="#6B7280"/>
                                                </Button>
                                                <Button Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="8"
                                                        Command="{Binding DataContext.EditCustomerCommand, ElementName=PageRoot}"
                                                        CommandParameter="{Binding}">
                                                    <FontIcon Glyph="&#xE70F;"
                                                              FontSize="16"
                                                              Foreground="#6B7280"/>
                                                </Button>
                                                <Button Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="8">
                                                    <FontIcon Glyph="&#xE74D;"
                                                              FontSize="16"
                                                              Foreground="#EF4444"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <MenuFlyoutSeparator Background="#E5E7EB" Margin="-16,0"/>

                        <!-- Paging Section -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding PagingSummary}"
                                       Foreground="#64748B"
                                       VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                <Button Command="{Binding PreviousPageCommand}"
                                        Background="#FFFFFF"
                                        BorderBrush="#E5E7EB"
                                        CornerRadius="8"
                                        Width="32"
                                        Height="32">
                                    <FontIcon Glyph="&#xE76B;"
                                              Foreground="#94A3B8"
                                              FontSize="12"/>
                                </Button>
                                <ItemsControl ItemsSource="{Binding PageNumbers}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="6"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:Int32">
                                            <Button Command="{Binding DataContext.GoToPageCommand, ElementName=PageRoot}"
                                                    CommandParameter="{Binding}"
                                                    Width="32"
                                                    Height="32"
                                                    CornerRadius="8"
                                                    Background="#FFFFFF"
                                                    BorderBrush="#E5E7EB"
                                                    Foreground="#4B5563"
                                                    Content="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Command="{Binding NextPageCommand}"
                                        Background="#FFFFFF"
                                        BorderBrush="#E5E7EB"
                                        CornerRadius="8"
                                        Width="32"
                                        Height="32">
                                    <FontIcon Glyph="&#xE76C;"
                                              Foreground="#94A3B8"
                                              FontSize="12"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
