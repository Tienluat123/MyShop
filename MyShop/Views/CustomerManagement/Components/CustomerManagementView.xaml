<Page
    x:Class="MyShop.Views.CustomerManagement.Components.CustomerManagementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:MyShop.Views.Controls"
    mc:Ignorable="d"
    Background="#F3F4F6">

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="{StaticResource SurfaceBackground}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="28,14">
                <controls:PageHeaderControl Title="Customer Management"
                                            Subtitle="View and manage your customer database"
                                            Icon="&#xE77B;">
                    <controls:PageHeaderControl.Actions>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8">
                            <Button Command="{Binding MapsToRulesCommand}"
                                    Background="#FFFFFF"
                                    BorderBrush="#E5E7EB"
                                    CornerRadius="10"
                                    Padding="14,8">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6">
                                    <FontIcon Glyph="&#xE713;"
                                              Style="{StaticResource IconBodyStyle}"/>
                                    <TextBlock Text="Rules"
                                               Style="{StaticResource BodyTextStyle}"/>
                                </StackPanel>
                            </Button>
                            <Button Click="AddCustomerButton_Click"
                                    Background="{StaticResource BrandPrimary}"
                                    Foreground="White"
                                    CornerRadius="10"
                                    Padding="14,8">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6">
                                    <FontIcon Glyph="&#xE710;"/>
                                    <TextBlock Text="Add Customer"
                                               FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </controls:PageHeaderControl.Actions>
                </controls:PageHeaderControl>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,24,28,24"
                            Spacing="16">
                    <Grid Background="#FFFFFF"
                          CornerRadius="14"
                          Padding="14"
                          BorderBrush="#E5E7EB"
                          BorderThickness="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0"
                              Background="#F8FAFC"
                              CornerRadius="10"
                              VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE721;"
                                      Foreground="#94A3B8"
                                      Margin="12,0,8,0"
                                      VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     PlaceholderText="Search by name or phone number..."
                                     Text="{Binding SearchText, Mode=TwoWay}"
                                     VerticalContentAlignment="Center"
                                     Padding="0,0,0,0"/>
                        </Grid>

                        <Button Grid.Column="2"
                                Command="{Binding SearchCommand}"
                                Background="#FFFFFF"
                                BorderBrush="#E2E8F0"
                                CornerRadius="10"
                                Padding="14,8">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="6">
                                <FontIcon Glyph="&#xE71C;"
                                          Foreground="#64748B"/>
                                <TextBlock Text="Filter"
                                           Foreground="#475569"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Background="#FFFFFF"
                            CornerRadius="14"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsRepeater ItemsSource="{Binding Customers}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Vertical"
                                                 Spacing="12"/>
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White"
                                                BorderBrush="#E5E7EB"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="16">
                                            <Grid ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Avatar -->
                                                <Border Grid.Column="0"
                                                        Width="48"
                                                        Height="48"
                                                        CornerRadius="24"
                                                        Background="#F1F5F9"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Initials}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="#BB4D00"
                                                               FontWeight="Bold"
                                                               FontSize="14"/>
                                                </Border>

                                                <!-- Customer Details -->
                                                <StackPanel Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Spacing="4">
                                                    <StackPanel Orientation="Horizontal"
                                                                Spacing="12">
                                                        <TextBlock Text="{Binding Name}"
                                                                   Style="{StaticResource BodyTextStyle}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#1E293B"/>
                                                        <Border Background="#FEF3C7"
                                                                CornerRadius="6"
                                                                Padding="8,4">
                                                            <TextBlock Text="{Binding Tier}"
                                                                       FontSize="12"
                                                                       FontWeight="Bold"
                                                                       Foreground="#92400E"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal"
                                                                Spacing="16">
                                                        <TextBlock Style="{StaticResource CaptionTextStyle}"
                                                                   Foreground="#6B7280">
                                                            <Run Text="ID: "/><Run Text="{Binding Code}"/>
                                                        </TextBlock>
                                                        <TextBlock Style="{StaticResource CaptionTextStyle}"
                                                                   Foreground="#6B7280">
                                                            <Run Text="Phone: "/><Run Text="{Binding Phone}"/>
                                                        </TextBlock>
                                                        <StackPanel Orientation="Horizontal"
                                                                    Spacing="4"
                                                                    VerticalAlignment="Center">
                                                            <FontIcon Glyph="&#xE734;"
                                                                      Foreground="#F59E0B"
                                                                      FontSize="12"/>
                                                            <TextBlock Style="{StaticResource CaptionTextStyle}"
                                                                       Foreground="#6B7280"
                                                                       Text="{Binding Points}"/>
                                                            <TextBlock Style="{StaticResource CaptionTextStyle}"
                                                                       Foreground="#6B7280"
                                                                       Text="pts"/>
                                                        </StackPanel>
                                                        <TextBlock Style="{StaticResource CaptionTextStyle}"
                                                                   Foreground="#6B7280">
                                                            <Run Text="{Binding Visits}"/> <Run Text="visits"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Spacer -->
                                                <Border Grid.Column="2"
                                                        Width="0"/>

                                                <!-- Actions -->
                                                <StackPanel Grid.Column="3"
                                                            Orientation="Horizontal"
                                                            Spacing="8"
                                                            VerticalAlignment="Center">
                                                    <Button Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="8"
                                                            Click="OpenProfileButton_Click"
                                                            Tag="{Binding}">
                                                        <FontIcon Glyph="&#xE72A;"
                                                                  FontSize="16"
                                                                  Foreground="#6B7280"/>
                                                    </Button>
                                                    <Button Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="8"
                                                            Click="EditButton_Click"
                                                            Tag="{Binding}">
                                                        <FontIcon Glyph="&#xE70F;"
                                                                  FontSize="16"
                                                                  Foreground="#6B7280"/>
                                                    </Button>
                                                    <Button Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="8">
                                                        <FontIcon Glyph="&#xE74D;"
                                                                  FontSize="16"
                                                                  Foreground="#EF4444"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
