<Page
    x:Class="MyShop.Views.CustomerManagement.Components.CustomerManagementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:MyShop.ViewModels"
    xmlns:converters="using:MyShop.Converters"
    x:Name="PageRoot"
    Background="#F3F4F6">

    <Page.Resources>
        <converters:CurrencyConverter x:Key="CurrencyConverter"/>
        <converters:StatusToBrushConverter x:Key="StatusToBrushConverter"/>
        <converters:LoyaltyTierBrushConverter x:Key="LoyaltyTierBrushConverter"/>
        <converters:StringToBoolConverter x:Key="StringToBoolConverter"/>
    </Page.Resources>


    <Border Grid.Row="1"
            Margin="16,12,16,16"
            Background="White"
            CornerRadius="12"
            BorderThickness="1"
            BorderBrush="#EEEEEE">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <Grid Grid.Row="0"
                  Padding="16,16,16,12"
                  ColumnSpacing="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1"
                        Command="{x:Bind ViewModel.AddCustomerCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Foreground="White"
                        CornerRadius="12"
                        Padding="14,8"
                        Height="36">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <FontIcon Glyph="&#xE710;"
                                  FontSize="14"/>
                        <TextBlock Text="Add Customer"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <Border Grid.Column="0"
                        Background="#F0F0F0"
                        CornerRadius="20"
                        BorderThickness="1"
                        BorderBrush="Gray"
                        Padding="12,0,12,0"
                        Height="36">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE71E;"
                                  FontSize="14"
                                  Foreground="Gray"
                                  VerticalAlignment="Center"/>

                        <TextBox Grid.Column="1"
                                 PlaceholderText="Search everything..."
                                 Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 VerticalAlignment="Center"
                                 Margin="0,3,0,0">
                            <TextBox.Resources>
                                <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                <SolidColorBrush x:Key="TextControlBackground"
                                                 Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlBackgroundFocused"
                                                 Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver"
                                                 Color="Transparent"/>
                            </TextBox.Resources>
                        </TextBox>
                    </Grid>
                </Border>
            </Grid>

            <!-- Table Section -->
            <Border Grid.Row="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header Row -->
                    <Border Grid.Row="0"
                            Background="#FAFAFA"
                            Padding="16,12"
                            BorderBrush="#EEEEEE"
                            BorderThickness="0,0,0,1">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="0.5*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="0.9*"/>
                                <ColumnDefinition Width="0.9*"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <!-- Name -->
                            <TextBlock Text="NAME"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="Gray"/>

                            <!-- Email -->
                            <TextBlock Grid.Column="1"
                                       Text="EMAIL"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="Gray"/>

                            <!-- Gender -->
                            <TextBlock Grid.Column="2"
                                       Text="GENDER"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="Gray"/>

                            <!-- Birthday -->
                            <TextBlock Grid.Column="3"
                                       Text="BIRTHDAY"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="Gray"/>

                            <!-- Total Points -->
                            <TextBlock Grid.Column="4"
                                       Text="POINTS"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="Gray"
                                       HorizontalAlignment="Right"/>

                            <!-- Available Points -->
                            <TextBlock Grid.Column="5"
                                       Text="AVAILABLE"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="Gray"
                                       HorizontalAlignment="Right"/>

                            <!-- Tier & Status -->
                            <TextBlock Grid.Column="6"
                                       Text="TIER"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="Gray"/>

                            <!-- Status -->
                            <TextBlock Grid.Column="7"
                                       Text="STATUS"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="Gray"
                                       HorizontalAlignment="Center"/>

                            <!-- Visits -->
                            <TextBlock Grid.Column="8"
                                       Text="VISITS"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="Gray"
                                       HorizontalAlignment="Center"/>

                            <!-- Actions -->
                            <TextBlock Grid.Column="9"
                                       Text="ACTIONS"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="Gray"
                                       HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Data Rows -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.DisplayCustomers, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:CustomerListItem">
                                    <Border BorderBrush="#F9F9F9"
                                            BorderThickness="0,0,0,1"
                                            Padding="16,10">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="0.5*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="0.9*"/>
                                                <ColumnDefinition Width="0.9*"/>
                                                <ColumnDefinition Width="0.8*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Name -->
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="8">
                                                <Border Width="28"
                                                        Height="28"
                                                        CornerRadius="14"
                                                        Background="#E8F3F8">
                                                    <TextBlock Text="{x:Bind Initials}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontWeight="Bold"
                                                               Foreground="#0078D4"/>
                                                </Border>
                                                <TextBlock Text="{x:Bind Name}"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"/>
                                            </StackPanel>

                                            <!-- Email -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind Email, TargetNullValue='-'}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Foreground="#555555"/>

                                            <!-- Gender -->
                                            <TextBlock Grid.Column="2"
                                                       Text="{x:Bind Gender, TargetNullValue='-'}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Foreground="#555555"/>

                                            <!-- Birthday -->
                                            <TextBlock Grid.Column="3"
                                                       Text="{x:Bind BirthdayDisplay}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Foreground="#555555"/>

                                            <!-- Total Points -->
                                            <TextBlock Grid.Column="4"
                                                       Text="{x:Bind TotalAccumulatedPoints}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Right"
                                                       Foreground="#10B981"/>

                                            <!-- Available Points -->
                                            <TextBlock Grid.Column="5"
                                                       Text="{x:Bind CurrentAvailablePoints}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Right"
                                                       Foreground="#F59E0B"/>

                                            <!-- Tier -->
                                            <Border Grid.Column="6"
                                                    Background="{x:Bind Tier, Converter={StaticResource LoyaltyTierBrushConverter}}"
                                                    CornerRadius="6"
                                                    Padding="8,4"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center">
                                                <TextBlock Text="{x:Bind Tier}"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="White"/>
                                            </Border>

                                            <!-- Status Toggle -->
                                            <ToggleSwitch Grid.Column="7"
                                                          IsOn="{x:Bind Status, Mode=TwoWay, Converter={StaticResource StringToBoolConverter}}"
                                                          OnContent="Active"
                                                          OffContent="Inactive"
                                                          FontSize="10"
                                                          MinWidth="0"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Toggled="Status_Toggled"/>

                                            <!-- Visits -->
                                            <TextBlock Grid.Column="8"
                                                       Text="{x:Bind Visits}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       HorizontalAlignment="Center"
                                                       Foreground="#666666"/>

                                            <!-- Actions -->
                                            <StackPanel Grid.Column="9"
                                                        Orientation="Horizontal"
                                                        Spacing="8"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <Button Style="{StaticResource AppIconButtonStyle}"
                                                        Click="ViewProfileButton_Click"
                                                        ToolTipService.ToolTip="View Profile"
                                                        Foreground="#0078D4">
                                                    <FontIcon Glyph="&#xE72A;"
                                                              FontSize="16"/>
                                                </Button>

                                                <Button Style="{StaticResource AppIconButtonStyle}"
                                                        Click="EditButton_Click"
                                                        ToolTipService.ToolTip="Edit Customer"
                                                        Foreground="#107C10">
                                                    <FontIcon Glyph="&#xEB7E;"
                                                              FontSize="16"/>
                                                </Button>

                                                <Button Style="{StaticResource AppIconButtonStyle}"
                                                        Click="DeleteButton_Click"
                                                        ToolTipService.ToolTip="Delete Customer"
                                                        Foreground="#E81123">
                                                    <FontIcon Glyph="&#xED62;"
                                                              FontSize="16"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Paging Controls -->
                    <Border Grid.Row="2"
                            Background="White"
                            Padding="10"
                            BorderBrush="#EEEEEE"
                            BorderThickness="0,1,0,0">
                        <Grid ColumnSpacing="12"
                              HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Previous Button -->
                            <Button Grid.Column="0"
                                    Content="←"
                                    Click="PreviousButton_Click"
                                    Height="30"
                                    Padding="16,0"
                                    CornerRadius="8"
                                    Background="#F0F0F0"
                                    Foreground="#333333"/>

                            <!-- Page Info -->
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.PageInfoDisplay, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#555555"/>

                            <!-- Next Button -->
                            <Button Grid.Column="2"
                                    Content="→"
                                    Click="NextButton_Click"
                                    Height="30"
                                    Padding="16,0"
                                    CornerRadius="8"
                                    Background="#0078D4"
                                    Foreground="White"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Page>
