<Page
    x:Class="MyShop.Views.CustomerManagement.Components.CustomerManagementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:MyShop.ViewModels"
    x:Name="PageRoot"
    Background="#F3F4F6">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,12,16,20" Spacing="16">
                <Border Background="#FFFFFF" CornerRadius="14" Padding="16" BorderBrush="#E5E7EB" BorderThickness="1">
                    <StackPanel Spacing="16">
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Command="{Binding MapsToAddCommand}" Background="#BB4D00" Foreground="White" CornerRadius="12" Padding="14,8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;"/>
                                    <TextBlock Text="Add Customer" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Grid Grid.Column="2"> <TextBox Padding="40,10,10,10" PlaceholderText="Search..." 
                                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" CornerRadius="12"/>
                                <FontIcon Glyph="&#xE721;" Foreground="#94A3B8" Margin="14,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid> <MenuFlyoutSeparator Background="#E5E7EB" Margin="-16,0"/>

                        <ItemsRepeater ItemsSource="{Binding DisplayCustomers}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="12"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:CustomerListItem">
                                    <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Padding="16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/> <ColumnDefinition Width="*"/>    <ColumnDefinition Width="Auto"/> </Grid.ColumnDefinitions>

                                            <Border Width="40" Height="40" CornerRadius="20" Background="#F1F5F9">
                                                <TextBlock Text="{x:Bind Initials}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{x:Bind Phone}" Foreground="#6B7280" FontSize="12"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                                <Button Command="{Binding DataContext.MapsToProfileCommand, ElementName=PageRoot}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" BorderThickness="0">
                                                    <FontIcon Glyph="&#xE72A;" Foreground="#6B7280"/>
                                                </Button>
                                                
                                                <Button Command="{Binding DataContext.EditCustomerCommand, ElementName=PageRoot}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" BorderThickness="0">
                                                    <FontIcon Glyph="&#xE70F;" Foreground="#6B7280"/>
                                                </Button>

                                                <Button Click="DeleteButton_Click" Background="Transparent" BorderThickness="0">
                                                    <FontIcon Glyph="&#xE74D;" Foreground="#EF4444"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        
                        </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>