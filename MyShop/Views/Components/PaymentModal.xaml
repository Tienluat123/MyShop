<ContentDialog
    x:Class="MyShop.Views.Components.PaymentModal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MyShop.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    MinWidth="1000"
    MinHeight="800"
    DefaultButton="Primary"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1200</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">900</x:Double>
        <Thickness x:Key="ContentDialogPadding">0</Thickness>
        <Thickness x:Key="ContentDialogBorderThickness">0</Thickness>

        <SolidColorBrush x:Key="Amber600" Color="#D97706" />
        <SolidColorBrush x:Key="Amber50" Color="#FFFBEB" />

        <converters:CurrencyConverter x:Key="CurrencyConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <converters:EqualityToBrushConverter x:Key="EqualityToBrushConverter" />
        <converters:EqualityToBrushConverter
            x:Key="ActiveTabBackgroundConverter"
            FalseBrush="Transparent"
            TrueBrush="{StaticResource Amber600}" />
        <converters:EqualityToBrushConverter
            x:Key="ActiveTabForegroundConverter"
            FalseBrush="#4B5563"
            TrueBrush="White" />
        <converters:EqualityToBrushConverter
            x:Key="ActiveTabBorderConverter"
            FalseBrush="#E5E7EB"
            TrueBrush="{StaticResource Amber600}" />

        <Style x:Key="KeypadButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#F3F4F6" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="QuickAmountButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Background" Value="#F9FAFB" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#4B5563" />
        </Style>

        <Style
            x:Key="PaymentPrimaryButtonStyle"
            BasedOn="{StaticResource DefaultButtonStyle}"
            TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Amber600}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="48,14" />
            <Setter Property="CornerRadius" Value="24" />
        </Style>
        <Style
            x:Key="PaymentSecondaryButtonStyle"
            BasedOn="{StaticResource DefaultButtonStyle}"
            TargetType="Button">
            <Setter Property="Background" Value="#F3F4F6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#4B5563" />
            <Setter Property="Padding" Value="48,14" />
            <Setter Property="CornerRadius" Value="24" />
        </Style>
    </ContentDialog.Resources>

    <ContentDialog.Title>
        <Grid HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon
                    FontSize="20"
                    Foreground="{StaticResource Amber600}"
                    Glyph="&#xE8FB;" />
                <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="Payment Checkout" />
            </StackPanel>
            <TextBlock
                Grid.Column="1"
                Margin="24,0,0,0"
                VerticalAlignment="Center"
                FontSize="16"
                FontWeight="Medium"
                Foreground="#9CA3AF"
                Text="{Binding OrderIdentifier}" />
        </Grid>
    </ContentDialog.Title>

    <Grid
        Width="800"
        Height="680"
        Margin="0,24,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  TOP: PAYMENT METHODS  -->
        <Grid
            Grid.Row="0"
            Margin="0,0,0,32"
            ColumnDefinitions="*,*,*">
            <Button
                Grid.Column="0"
                Height="100"
                Margin="0,0,8,0"
                Padding="16"
                HorizontalAlignment="Stretch"
                Background="{Binding PaymentMethods[0].IsSelected, Converter={StaticResource ActiveTabBackgroundConverter}, ConverterParameter=True}"
                BorderBrush="{Binding PaymentMethods[0].IsSelected, Converter={StaticResource ActiveTabBorderConverter}, ConverterParameter=True}"
                BorderThickness="2"
                Command="{Binding SelectMethodCommand}"
                CommandParameter="Cash"
                CornerRadius="16">
                <StackPanel Spacing="8">
                    <FontIcon
                        FontSize="28"
                        Foreground="{Binding PaymentMethods[0].IsSelected, Converter={StaticResource ActiveTabForegroundConverter}, ConverterParameter=True}"
                        Glyph="{Binding PaymentMethods[0].Glyph}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="{Binding PaymentMethods[0].IsSelected, Converter={StaticResource ActiveTabForegroundConverter}, ConverterParameter=True}"
                        Text="{Binding PaymentMethods[0].Label}" />
                </StackPanel>
            </Button>

            <Button
                Grid.Column="1"
                Height="100"
                Margin="4,0,4,0"
                Padding="16"
                HorizontalAlignment="Stretch"
                Background="{Binding PaymentMethods[1].IsSelected, Converter={StaticResource ActiveTabBackgroundConverter}, ConverterParameter=True}"
                BorderBrush="{Binding PaymentMethods[1].IsSelected, Converter={StaticResource ActiveTabBorderConverter}, ConverterParameter=True}"
                BorderThickness="2"
                Command="{Binding SelectMethodCommand}"
                CommandParameter="Card"
                CornerRadius="16">
                <StackPanel Spacing="8">
                    <FontIcon
                        FontSize="28"
                        Foreground="{Binding PaymentMethods[1].IsSelected, Converter={StaticResource ActiveTabForegroundConverter}, ConverterParameter=True}"
                        Glyph="{Binding PaymentMethods[1].Glyph}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="{Binding PaymentMethods[1].IsSelected, Converter={StaticResource ActiveTabForegroundConverter}, ConverterParameter=True}"
                        Text="{Binding PaymentMethods[1].Label}" />
                </StackPanel>
            </Button>

            <Button
                Grid.Column="2"
                Height="100"
                Margin="8,0,0,0"
                Padding="16"
                HorizontalAlignment="Stretch"
                Background="{Binding PaymentMethods[2].IsSelected, Converter={StaticResource ActiveTabBackgroundConverter}, ConverterParameter=True}"
                BorderBrush="{Binding PaymentMethods[2].IsSelected, Converter={StaticResource ActiveTabBorderConverter}, ConverterParameter=True}"
                BorderThickness="2"
                Command="{Binding SelectMethodCommand}"
                CommandParameter="Digital"
                CornerRadius="16">
                <StackPanel Spacing="8">
                    <FontIcon
                        FontSize="28"
                        Foreground="{Binding PaymentMethods[2].IsSelected, Converter={StaticResource ActiveTabForegroundConverter}, ConverterParameter=True}"
                        Glyph="{Binding PaymentMethods[2].Glyph}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="{Binding PaymentMethods[2].IsSelected, Converter={StaticResource ActiveTabForegroundConverter}, ConverterParameter=True}"
                        Text="{Binding PaymentMethods[2].Label}" />
                </StackPanel>
            </Button>
        </Grid>

        <!--  MIDDLE: CONTENT  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Padding="0,0,32,0"
                BorderBrush="#F3F4F6"
                BorderThickness="0,0,1,0">
                <StackPanel Spacing="24">
                    <Border
                        Padding="24"
                        Background="#FFF7ED"
                        CornerRadius="16">
                        <StackPanel Spacing="8">
                            <TextBlock
                                CharacterSpacing="100"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="#92400E"
                                Text="TOTAL TO PAY" />
                            <TextBlock
                                FontSize="36"
                                FontWeight="Black"
                                Foreground="#B45309"
                                Text="{Binding Total, Converter={StaticResource CurrencyConverter}}" />
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="20"
                        Background="#F3F4F6"
                        CornerRadius="16"
                        Visibility="{Binding Method, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='Cash'}">
                        <StackPanel Spacing="8">
                            <TextBlock
                                CharacterSpacing="50"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="#6B7280"
                                Text="CHANGE DUE" />
                            <TextBlock
                                FontSize="24"
                                FontWeight="Bold"
                                Foreground="{StaticResource Amber600}"
                                Text="{Binding Change, Converter={StaticResource CurrencyConverter}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Padding="32,0,0,0">
                <!--  CASH  -->
                <Grid Visibility="{Binding Method, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='Cash'}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="16">
                        <TextBlock
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="#374151"
                            Text="Enter Cash Amount" />
                        <Border
                            Padding="20"
                            Background="White"
                            BorderBrush="#F3F4F6"
                            BorderThickness="2"
                            CornerRadius="16">
                            <Grid>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="24"
                                    FontWeight="Bold"
                                    Foreground="#9CA3AF"
                                    Text="$" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    FontSize="40"
                                    FontWeight="Black"
                                    Foreground="#111827"
                                    Text="{Binding CashInput}" />
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button
                                Command="{Binding AddQuickAmountCommand}"
                                CommandParameter="1.0"
                                Content="+$1"
                                Style="{StaticResource QuickAmountButtonStyle}" />
                            <Button
                                Command="{Binding AddQuickAmountCommand}"
                                CommandParameter="5.0"
                                Content="+$5"
                                Style="{StaticResource QuickAmountButtonStyle}" />
                            <Button
                                Command="{Binding AddQuickAmountCommand}"
                                CommandParameter="10.0"
                                Content="+$10"
                                Style="{StaticResource QuickAmountButtonStyle}" />
                            <Button
                                Command="{Binding AddQuickAmountCommand}"
                                CommandParameter="20.0"
                                Content="+$20"
                                Style="{StaticResource QuickAmountButtonStyle}" />
                            <Button
                                Command="{Binding AddQuickAmountCommand}"
                                CommandParameter="50.0"
                                Content="+$50"
                                Style="{StaticResource QuickAmountButtonStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <Grid
                        Grid.Row="1"
                        Margin="0,32,0,0"
                        ColumnDefinitions="*,*,*"
                        RowDefinitions="*,*,*,*">
                        <Button
                            Grid.Row="0"
                            Grid.Column="0"
                            Command="{Binding HandleKeypadCommand}"
                            CommandParameter="1"
                            Content="1"
                            Style="{StaticResource KeypadButtonStyle}" />
                        <Button
                            Grid.Row="0"
                            Grid.Column="1"
                            Command="{Binding HandleKeypadCommand}"
                            CommandParameter="2"
                            Content="2"
                            Style="{StaticResource KeypadButtonStyle}" />
                        <Button
                            Grid.Row="0"
                            Grid.Column="2"
                            Command="{Binding HandleKeypadCommand}"
                            CommandParameter="3"
                            Content="3"
                            Style="{StaticResource KeypadButtonStyle}" />

                        <Button
                            Grid.Row="1"
                            Grid.Column="0"
                            Command="{Binding HandleKeypadCommand}"
                            CommandParameter="4"
                            Content="4"
                            Style="{StaticResource KeypadButtonStyle}" />
                        <Button
                            Grid.Row="1"
                            Grid.Column="1"
                            Command="{Binding HandleKeypadCommand}"
                            CommandParameter="5"
                            Content="5"
                            Style="{StaticResource KeypadButtonStyle}" />
                        <Button
                            Grid.Row="1"
                            Grid.Column="2"
                            Command="{Binding HandleKeypadCommand}"
                            CommandParameter="6"
                            Content="6"
                            Style="{StaticResource KeypadButtonStyle}" />

                        <Button
                            Grid.Row="2"
                            Grid.Column="0"
                            Command="{Binding HandleKeypadCommand}"
                            CommandParameter="7"
                            Content="7"
                            Style="{StaticResource KeypadButtonStyle}" />
                        <Button
                            Grid.Row="2"
                            Grid.Column="1"
                            Command="{Binding HandleKeypadCommand}"
                            CommandParameter="8"
                            Content="8"
                            Style="{StaticResource KeypadButtonStyle}" />
                        <Button
                            Grid.Row="2"
                            Grid.Column="2"
                            Command="{Binding HandleKeypadCommand}"
                            CommandParameter="9"
                            Content="9"
                            Style="{StaticResource KeypadButtonStyle}" />

                        <Button
                            Grid.Row="3"
                            Grid.Column="0"
                            Command="{Binding HandleKeypadCommand}"
                            CommandParameter="."
                            Content="."
                            Style="{StaticResource KeypadButtonStyle}" />
                        <Button
                            Grid.Row="3"
                            Grid.Column="1"
                            Command="{Binding HandleKeypadCommand}"
                            CommandParameter="0"
                            Content="0"
                            Style="{StaticResource KeypadButtonStyle}" />
                        <Button
                            Grid.Row="3"
                            Grid.Column="2"
                            Background="#FEF2F2"
                            Command="{Binding HandleKeypadCommand}"
                            CommandParameter="C"
                            Content="C"
                            Foreground="#EF4444"
                            Style="{StaticResource KeypadButtonStyle}" />
                    </Grid>
                </Grid>

                <!--  CARD  -->
                <Grid Visibility="{Binding Method, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='Card'}">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="24">
                        <Border
                            Width="120"
                            Height="120"
                            Background="#F3F4F6"
                            CornerRadius="60">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="48"
                                Foreground="#9CA3AF"
                                Glyph="{Binding PaymentMethods[1].Glyph}" />
                        </Border>
                        <StackPanel Spacing="8">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="#111827"
                                Text="Ready for Card Payment" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="15"
                                Foreground="#6B7280"
                                Text="Insert, swipe, or tap your card on the terminal" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!--  DIGITAL  -->
                <Grid Visibility="{Binding Method, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='Digital'}">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="24">
                        <Border
                            Padding="20"
                            Background="White"
                            BorderBrush="#F3F4F6"
                            BorderThickness="1"
                            CornerRadius="20">
                            <FontIcon
                                FontSize="120"
                                Foreground="#111827"
                                Glyph="{Binding PaymentMethods[2].Glyph}" />
                        </Border>
                        <StackPanel Spacing="8">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="#111827"
                                Text="Scan QR to Pay" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="15"
                                Foreground="#6B7280"
                                Text="Present this QR code to the customer terminal" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!--  BOTTOM: ACTIONS  -->
        <StackPanel
            Grid.Row="2"
            Margin="0,32,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="12">
            <Button
                Click="CloseButton_Click"
                Content="Back to Order"
                Style="{StaticResource PaymentSecondaryButtonStyle}" />
            <Button
                Command="{Binding ConfirmCommand}"
                Content="Complete Payment"
                Style="{StaticResource PaymentPrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</ContentDialog>
