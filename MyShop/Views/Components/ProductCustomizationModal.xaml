<ContentDialog
    x:Class="MyShop.Views.Components.ProductCustomizationModal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MyShop.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <converters:StringToDoubleConverter x:Key="StringToDoubleConverter" />
        <converters:CurrencyConverter x:Key="CurrencyConverter" />
        <converters:CollectionContainsToBoolConverter x:Key="CollectionContainsToBoolConverter" />
        <converters:EqualityToBrushConverter
            x:Key="SizeSelectedBackgroundConverter"
            FalseBrush="#F9FAFB"
            TrueBrush="#FFF7ED" />
        <converters:EqualityToBrushConverter
            x:Key="SizeSelectedBorderConverter"
            FalseBrush="#F3F4F6"
            TrueBrush="#D97706" />
        <converters:EqualityToBrushConverter
            x:Key="IceSelectedBackgroundConverter"
            FalseBrush="#F9FAFB"
            TrueBrush="#ECFEFF" />
        <converters:EqualityToBrushConverter
            x:Key="IceSelectedBorderConverter"
            FalseBrush="#F3F4F6"
            TrueBrush="#0E7490" />

        <Style x:Key="SectionHeaderStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Spacing" Value="8" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="CharacterSpacing" Value="50" />
        </Style>

        <Style x:Key="SelectionButtonStyle" TargetType="Button">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="AddOnToggleStyle" TargetType="ToggleButton">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#F3F4F6" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
    </ContentDialog.Resources>

    <Grid Width="450" Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="180" />
            <!--  Header  -->
            <RowDefinition Height="*" />
            <!--  Content  -->
            <RowDefinition Height="Auto" />
            <!--  Footer  -->
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid Grid.Row="0">
            <Image Source="{Binding Product.ImageUrl}" Stretch="UniformToFill" />
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#00000000" />
                        <GradientStop Offset="1" Color="#CC000000" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <StackPanel Margin="24,0,24,16" VerticalAlignment="Bottom">
                <TextBlock
                    FontSize="24"
                    FontWeight="Black"
                    Foreground="White"
                    Text="{Binding Product.Name}" />
                <TextBlock
                    FontSize="12"
                    FontWeight="Medium"
                    Foreground="White"
                    Opacity="0.6"
                    Text="Customize your selection" />
            </StackPanel>

            <Button
                Margin="24"
                Padding="8"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="#40000000"
                BorderThickness="0"
                Click="CloseBtn_Click"
                Content="&#xE711;"
                CornerRadius="20"
                FontFamily="Segoe MDL2 Assets"
                FontSize="16"
                Foreground="White" />

            <Border
                Margin="0,0,24,16"
                Padding="16,8"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="#20FFFFFF"
                BorderBrush="#40FFFFFF"
                BorderThickness="1"
                CornerRadius="16">
                <StackPanel>
                    <TextBlock
                        CharacterSpacing="100"
                        FontSize="10"
                        FontWeight="Bold"
                        Foreground="White"
                        Opacity="0.5"
                        Text="PRICE" />
                    <TextBlock
                        FontSize="20"
                        FontWeight="Black"
                        Foreground="#FBBF24"
                        Text="{Binding UnitTotalPrice, Converter={StaticResource CurrencyConverter}}" />
                </StackPanel>
            </Border>
        </Grid>

        <!--  Content  -->
        <ScrollViewer
            Grid.Row="1"
            MaxHeight="450"
            Padding="24">
            <StackPanel Spacing="32">
                <StackPanel x:Name="BeverageOptions" Spacing="32">
                    <!--  Size  -->
                    <StackPanel>
                        <StackPanel Style="{StaticResource SectionHeaderStyle}">
                            <Border
                                Padding="6"
                                Background="#FFF7ED"
                                CornerRadius="8">
                                <FontIcon
                                    FontSize="14"
                                    Foreground="#B45309"
                                    Glyph="&#xE93E;" />
                            </Border>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource SectionTitleStyle}"
                                Text="SELECT SIZE" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,*,*">
                            <Button
                                Margin="0,0,4,0"
                                HorizontalAlignment="Stretch"
                                Background="{Binding Size, Converter={StaticResource SizeSelectedBackgroundConverter}, ConverterParameter=S}"
                                BorderBrush="{Binding Size, Converter={StaticResource SizeSelectedBorderConverter}, ConverterParameter=S}"
                                Command="{Binding SetSizeCommand}"
                                CommandParameter="S"
                                Style="{StaticResource SelectionButtonStyle}">
                                <StackPanel>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="20"
                                        FontWeight="Black"
                                        Text="S" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Foreground="Gray"
                                        Text="8 oz" />
                                </StackPanel>
                            </Button>
                            <Button
                                Grid.Column="1"
                                Margin="4,0,4,0"
                                HorizontalAlignment="Stretch"
                                Background="{Binding Size, Converter={StaticResource SizeSelectedBackgroundConverter}, ConverterParameter=M}"
                                BorderBrush="{Binding Size, Converter={StaticResource SizeSelectedBorderConverter}, ConverterParameter=M}"
                                Command="{Binding SetSizeCommand}"
                                CommandParameter="M"
                                Style="{StaticResource SelectionButtonStyle}">
                                <StackPanel>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="20"
                                        FontWeight="Black"
                                        Text="M" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Foreground="Gray"
                                        Text="12 oz" />
                                </StackPanel>
                            </Button>
                            <Button
                                Grid.Column="2"
                                Margin="4,0,0,0"
                                HorizontalAlignment="Stretch"
                                Background="{Binding Size, Converter={StaticResource SizeSelectedBackgroundConverter}, ConverterParameter=L}"
                                BorderBrush="{Binding Size, Converter={StaticResource SizeSelectedBorderConverter}, ConverterParameter=L}"
                                Command="{Binding SetSizeCommand}"
                                CommandParameter="L"
                                Style="{StaticResource SelectionButtonStyle}">
                                <StackPanel>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="20"
                                        FontWeight="Black"
                                        Text="L" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Foreground="Gray"
                                        Text="16 oz" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!--  Sugar  -->
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel Style="{StaticResource SectionHeaderStyle}">
                                <Border
                                    Padding="6"
                                    Background="#EFF6FF"
                                    CornerRadius="8">
                                    <FontIcon
                                        FontSize="14"
                                        Foreground="#1D4ED8"
                                        Glyph="&#xE93C;" />
                                </Border>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SectionTitleStyle}"
                                    Text="SUGAR" />
                            </StackPanel>
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="Black"
                                Foreground="#B45309"
                                Text="{Binding Sugar}" />
                        </Grid>
                        <Slider
                            Maximum="100"
                            Minimum="0"
                            StepFrequency="50"
                            TickPlacement="None"
                            Value="{Binding Sugar, Mode=TwoWay, Converter={StaticResource StringToDoubleConverter}}" />
                    </StackPanel>

                    <!--  Ice  -->
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel Style="{StaticResource SectionHeaderStyle}">
                                <Border
                                    Padding="6"
                                    Background="#ECFEFF"
                                    CornerRadius="8">
                                    <FontIcon
                                        FontSize="14"
                                        Foreground="#0E7490"
                                        Glyph="&#xE9F3;" />
                                </Border>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SectionTitleStyle}"
                                    Text="ICE" />
                            </StackPanel>
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="Black"
                                Foreground="#B45309"
                                Text="{Binding Ice}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*,*,*">
                            <Button
                                Margin="0,0,4,0"
                                HorizontalAlignment="Stretch"
                                Background="{Binding Ice, Converter={StaticResource IceSelectedBackgroundConverter}, ConverterParameter='No Ice'}"
                                BorderBrush="{Binding Ice, Converter={StaticResource IceSelectedBorderConverter}, ConverterParameter='No Ice'}"
                                Command="{Binding SetIceCommand}"
                                CommandParameter="No Ice"
                                Content="None"
                                Style="{StaticResource SelectionButtonStyle}" />
                            <Button
                                Grid.Column="1"
                                Margin="4,0,4,0"
                                HorizontalAlignment="Stretch"
                                Background="{Binding Ice, Converter={StaticResource IceSelectedBackgroundConverter}, ConverterParameter='Less Ice'}"
                                BorderBrush="{Binding Ice, Converter={StaticResource IceSelectedBorderConverter}, ConverterParameter='Less Ice'}"
                                Command="{Binding SetIceCommand}"
                                CommandParameter="Less Ice"
                                Content="Less"
                                Style="{StaticResource SelectionButtonStyle}" />
                            <Button
                                Grid.Column="2"
                                Margin="4,0,4,0"
                                HorizontalAlignment="Stretch"
                                Background="{Binding Ice, Converter={StaticResource IceSelectedBackgroundConverter}, ConverterParameter='Regular'}"
                                BorderBrush="{Binding Ice, Converter={StaticResource IceSelectedBorderConverter}, ConverterParameter='Regular'}"
                                Command="{Binding SetIceCommand}"
                                CommandParameter="Regular"
                                Content="Regular"
                                Style="{StaticResource SelectionButtonStyle}" />
                            <Button
                                Grid.Column="3"
                                Margin="4,0,0,0"
                                HorizontalAlignment="Stretch"
                                Background="{Binding Ice, Converter={StaticResource IceSelectedBackgroundConverter}, ConverterParameter='Extra Ice'}"
                                BorderBrush="{Binding Ice, Converter={StaticResource IceSelectedBorderConverter}, ConverterParameter='Extra Ice'}"
                                Command="{Binding SetIceCommand}"
                                CommandParameter="Extra Ice"
                                Content="Extra"
                                Style="{StaticResource SelectionButtonStyle}" />
                        </Grid>
                    </StackPanel>

                    <!--  Add-ons  -->
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,12"
                            Style="{StaticResource SectionTitleStyle}"
                            Text="ADD-ONS (+$0.75 EACH)" />
                        <ItemsRepeater ItemsSource="{Binding AvailableAddOns}">
                            <ItemsRepeater.Layout>
                                <FlowLayout
                                    MinColumnSpacing="8"
                                    MinRowSpacing="8"
                                    Orientation="Horizontal" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton
                                        MinWidth="60"
                                        Padding="16,8"
                                        HorizontalAlignment="Left"
                                        Command="{Binding DataContext.ToggleAddOnCommand, ElementName=BeverageOptions}"
                                        CommandParameter="{Binding}"
                                        Content="{Binding}"
                                        Style="{StaticResource AddOnToggleStyle}" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>

                    <!--  Notes  -->
                    <StackPanel>
                        <StackPanel Style="{StaticResource SectionHeaderStyle}">
                            <FontIcon
                                FontSize="16"
                                Foreground="#9CA3AF"
                                Glyph="&#xE70F;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource SectionTitleStyle}"
                                Text="SPECIAL NOTES" />
                        </StackPanel>
                        <TextBox
                            Padding="16,12"
                            Background="#F9FAFB"
                            BorderBrush="#F3F4F6"
                            BorderThickness="1"
                            CornerRadius="16"
                            PlaceholderText="E.g. Extra hot, no lid..."
                            Text="{Binding Notes, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>

                <!--  Quantity  -->
                <Border
                    Margin="-24,0"
                    Padding="24"
                    Background="#F9FAFB"
                    BorderBrush="#F3F4F6"
                    BorderThickness="0,1">
                    <Grid>
                        <StackPanel>
                            <TextBlock
                                FontSize="14"
                                FontWeight="Black"
                                Foreground="#111827"
                                Text="QUANTITY" />
                            <TextBlock
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="#9CA3AF"
                                Text="ADJUST NUMBER OF ITEMS" />
                        </StackPanel>
                        <StackPanel
                            Padding="8"
                            HorizontalAlignment="Right"
                            Background="White"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="16"
                            Orientation="Horizontal"
                            Spacing="24">
                            <Button
                                Width="40"
                                Height="40"
                                Padding="0"
                                Background="#F9FAFB"
                                BorderThickness="0"
                                Command="{Binding UpdateQuantityCommand}"
                                CommandParameter="-1"
                                CornerRadius="12">
                                <FontIcon FontSize="16" Glyph="&#xE738;" />
                            </Button>
                            <TextBlock
                                MinWidth="24"
                                VerticalAlignment="Center"
                                FontSize="24"
                                FontWeight="Black"
                                Text="{Binding Quantity}"
                                TextAlignment="Center" />
                            <Button
                                Width="40"
                                Height="40"
                                Padding="0"
                                Background="#F9FAFB"
                                BorderThickness="0"
                                Command="{Binding UpdateQuantityCommand}"
                                CommandParameter="1"
                                CornerRadius="12">
                                <FontIcon FontSize="16" Glyph="&#xE710;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!--  Footer  -->
        <Border
            Grid.Row="2"
            Padding="24"
            Background="White"
            BorderBrush="#F3F4F6"
            BorderThickness="0,1,0,0">
            <Button
                Padding="0,18"
                HorizontalAlignment="Stretch"
                Background="{StaticResource IconSelectedBgBrush}"
                Command="{Binding ConfirmCommand}"
                CornerRadius="16"
                FontSize="16"
                FontWeight="Black"
                Foreground="White">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE7BF;" />
                    <TextBlock Text="ADD TO ORDER · " />
                    <TextBlock Text="{Binding TotalPrice, Converter={StaticResource CurrencyConverter}}" />
                </StackPanel>
            </Button>
        </Border>
    </Grid>
</ContentDialog>
