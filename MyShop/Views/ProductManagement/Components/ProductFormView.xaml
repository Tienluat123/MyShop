<ContentDialog
    x:Class="MyShop.Views.ProductManagement.Components.ProductFormView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:MyShop.Views.Controls"
    CornerRadius="24"
    BorderThickness="0">

    <Grid Width="500"
          Margin="-24">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PriceGrid.ColumnDefinitions[0].Width"
                                Value="*"/>
                        <Setter Target="PriceGrid.ColumnDefinitions[1].Width"
                                Value="0"/>
                        <Setter Target="SellingSection.(Grid.Column)"
                                Value="0"/>
                        <Setter Target="SellingSection.(Grid.Row)"
                                Value="1"/>
                        <Setter Target="CostSection.Margin"
                                Value="0"/>
                        <Setter Target="SellingSection.Margin"
                                Value="0,12,0,0"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="600"/>
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:ModalHeader Grid.Row="0"
                        Padding="32,24,32,12"
                        Title="{Binding FormTitle}"
                        Subtitle="{Binding Subtitle}"
                        CancelClicked="CancelButton_Click"/>

        <ScrollViewer Grid.Row="1"
                      Padding="32,8,32,24"
                      MaxHeight="550">
            <StackPanel Spacing="18">

                <StackPanel Spacing="6">
                    <TextBlock Text="PRODUCT NAME"
                               Foreground="#94A3B8"
                               FontWeight="Bold"
                               FontSize="11"/>
                    <TextBox Text="{Binding ProductData.Name, Mode=TwoWay}"
                             PlaceholderText="Enter product name..."
                             CornerRadius="12"
                             Padding="14,10"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="CATEGORY"
                               Foreground="#94A3B8"
                               FontWeight="Bold"
                               FontSize="11"/>
                    <Grid ColumnSpacing="10"
                          RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ComboBox Grid.ColumnSpan="2"
                                  ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding ProductData.Category, Mode=TwoWay}"
                                  PlaceholderText="Select category"
                                  HorizontalAlignment="Stretch"
                                  CornerRadius="12"/>

                        <TextBox Grid.Row="1"
                                 Text="{Binding NewCategoryName, Mode=TwoWay}"
                                 PlaceholderText="New category name..."
                                 CornerRadius="12"/>
                        <Button Grid.Row="1"
                                Grid.Column="1"
                                Command="{Binding AddCategoryCommand}"
                                CornerRadius="12"
                                MinWidth="50">
                            <FontIcon Glyph="&#xE710;"
                                      FontSize="16"/>
                        </Button>
                    </Grid>
                </StackPanel>

                <Grid x:Name="PriceGrid"
                      ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="CostSection"
                                Spacing="6">
                        <TextBlock Text="COST PRICE"
                                   Foreground="#94A3B8"
                                   FontWeight="Bold"
                                   FontSize="11"/>
                        <TextBox Text="{Binding ProductData.CostPrice, Mode=TwoWay}"
                                 PlaceholderText="0.00"
                                 CornerRadius="12"
                                 Padding="14,10"/>
                    </StackPanel>

                    <StackPanel x:Name="SellingSection"
                                Grid.Column="1"
                                Spacing="6">
                        <TextBlock Text="SELLING PRICE"
                                   Foreground="#94A3B8"
                                   FontWeight="Bold"
                                   FontSize="11"/>
                        <TextBox Text="{Binding ProductData.SellingPrice, Mode=TwoWay}"
                                 PlaceholderText="0.00"
                                 CornerRadius="12"
                                 Padding="14,10"/>
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="6">
                    <TextBlock Text="PRODUCT IMAGE"
                               Foreground="#94A3B8"
                               FontWeight="Bold"
                               FontSize="11"/>

                    <TextBox Text="{Binding ProductData.ImageUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             x:Name="ImageUrlTextBox"
                             TextChanged="ImageUrlTextBox_TextChanged"
                             PlaceholderText="Paste image URL or choose image file..."
                             CornerRadius="12"
                             Padding="14,10"/>

                    <StackPanel Orientation="Horizontal"
                                Spacing="10">
                        <Button Content="Choose File"
                                Click="ChooseImageFile_Click"
                                CornerRadius="12"
                                MinWidth="110"/>
                    </StackPanel>

                    <Border Background="#F8FAFC"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10">
                        <Grid>
                            <StackPanel x:Name="ImagePreviewPlaceholder"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xEB9F;"
                                          Foreground="#94A3B8"/>
                                <TextBlock Text="Image preview"
                                           Foreground="#94A3B8"
                                           FontSize="12"/>
                            </StackPanel>

                            <Image x:Name="ImagePreview"
                                   Height="140"
                                   Stretch="Uniform"
                                   Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <TextBlock Text="{Binding ValidationMessage}"
                           Foreground="#DC2626"
                           FontSize="12"
                           TextWrapping="WrapWholeWords"/>
            </StackPanel>
        </ScrollViewer>

        <ui:ModalFooter Grid.Row="2"
                        CancelText="Cancel"
                        SubmitText="{Binding SubmitButtonText}"
                        CancelClicked="CancelButton_Click"
                        SubmitClicked="SubmitButton_Click"/>
    </Grid>
</ContentDialog>