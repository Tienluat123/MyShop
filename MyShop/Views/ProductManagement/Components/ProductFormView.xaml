<ContentDialog
    x:Class="MyShop.Views.ProductManagement.Components.ProductFormView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:MyShop.Views.Controls"
    CornerRadius="24"
    BorderThickness="0">

    <Grid Width="500"
          Margin="-24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:ModalHeader Grid.Row="0"
                        Title="{Binding FormTitle}"
                        Subtitle="Update product information in the system"
                        CancelClicked="CancelButton_Click"/>

        <ScrollViewer Grid.Row="1"
                      Padding="32,8,32,24"
                      MaxHeight="550">
            <StackPanel Spacing="20">

                <ui:LabeledInputControl Label="PRODUCT NAME">
                    <ui:LabeledInputControl.InputContent>
                        <TextBox Text="{Binding ProductData.Name, Mode=TwoWay}"
                                 PlaceholderText="Enter product name..."
                                 CornerRadius="12"
                                 Padding="14,10"/>
                    </ui:LabeledInputControl.InputContent>
                </ui:LabeledInputControl>

                <ui:LabeledInputControl Label="CATEGORY">
                    <ui:LabeledInputControl.InputContent>
                        <Grid ColumnSpacing="10" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ComboBox Grid.ColumnSpan="2"
                                      ItemsSource="{Binding Categories}"
                                      SelectedItem="{Binding ProductData.Category, Mode=TwoWay}"
                                      PlaceholderText="Select category"
                                      HorizontalAlignment="Stretch"
                                      CornerRadius="12"/>

                            <TextBox Grid.Row="1"
                                     Text="{Binding NewCategoryName, Mode=TwoWay}"
                                     PlaceholderText="New category name..."
                                     CornerRadius="12"
                                     Padding="14,10"/>
                            <Button Grid.Row="1"
                                    Grid.Column="1"
                                    Command="{Binding AddCategoryCommand}"
                                    CornerRadius="12"
                                    MinWidth="50"
                                    Height="42">
                                <FontIcon Glyph="&#xE710;" FontSize="16"/>
                            </Button>
                        </Grid>
                    </ui:LabeledInputControl.InputContent>
                </ui:LabeledInputControl>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ui:LabeledInputControl Label="COST PRICE">
                        <ui:LabeledInputControl.InputContent>
                            <TextBox Text="{Binding ProductData.CostPrice, Mode=TwoWay}"
                                     PlaceholderText="0.00"
                                     CornerRadius="12"
                                     Padding="14,10"/>
                        </ui:LabeledInputControl.InputContent>
                    </ui:LabeledInputControl>

                    <ui:LabeledInputControl Grid.Column="1" Label="SELLING PRICE">
                        <ui:LabeledInputControl.InputContent>
                            <TextBox Text="{Binding ProductData.SellingPrice, Mode=TwoWay}"
                                     PlaceholderText="0.00"
                                     CornerRadius="12"
                                     Padding="14,10"/>
                        </ui:LabeledInputControl.InputContent>
                    </ui:LabeledInputControl>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <ui:ModalFooter Grid.Row="2"
                        CancelText="Cancel"
                        SubmitText="{Binding SubmitButtonText}"
                        CancelClicked="CancelButton_Click"
                        SubmitClicked="SubmitButton_Click"/>
    </Grid>
</ContentDialog>