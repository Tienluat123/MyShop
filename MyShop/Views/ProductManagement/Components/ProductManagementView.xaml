<Page
    x:Class="MyShop.Views.ProductManagement.Components.ProductManagementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:MyShop.ViewModels"
    xmlns:controls="using:MyShop.Views.Controls"
    x:Name="PageRoot"
    Background="#F3F4F6">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,12,16,20"
                        Spacing="16">
                <Border Background="#FFFFFF"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="16">
                    <StackPanel Spacing="16">
                        <!-- Categories and Actions -->
                        <StackPanel Spacing="12">
                            <ItemsControl ItemsSource="{Binding Categories}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="8"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Button Command="{Binding DataContext.SelectCategoryCommand, ElementName=PageRoot}"
                                                CommandParameter="{Binding}"
                                                Padding="16,8"
                                                CornerRadius="16"
                                                BorderBrush="#E5E7EB"
                                                Background="#FFFFFF">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="8">
                                                <FontIcon Glyph="&#xE719;"
                                                          Foreground="#64748B"
                                                          FontSize="12"/>
                                                <TextBlock Text="{Binding}"
                                                           Foreground="#475569"
                                                           FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Command="{Binding AddProductCommand}"
                                        Background="#BB4D00"
                                        BorderBrush="#BB4D00"
                                        Foreground="White"
                                        CornerRadius="12"
                                        Padding="14,8">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="8">
                                        <FontIcon Glyph="&#xE710;"/>
                                        <TextBlock Text="Add a Product"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="2"
                                        Background="#FFFFFF"
                                        BorderBrush="#D97706"
                                        Foreground="#D97706"
                                        CornerRadius="12"
                                        Padding="14,8">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="8">
                                        <FontIcon Glyph="&#xE898;"/>
                                        <TextBlock Text="Import Excel/Access"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <Grid Grid.Column="3"
                                      Margin="18,0,0,0">
                                    <TextBox Padding="40,10,10,10"
                                             Background="#F8FAFC"
                                             BorderBrush="#E5E7EB"
                                             CornerRadius="12"
                                             PlaceholderText="Search menu..."
                                             Text="{Binding SearchText, Mode=TwoWay}"/>
                                    <FontIcon Glyph="&#xE721;"
                                              Foreground="#94A3B8"
                                              Margin="14,0,0,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </StackPanel>

                        <MenuFlyoutSeparator Background="#E5E7EB" Margin="-16,0"/>

                        <ItemsRepeater ItemsSource="{Binding DisplayProducts}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical"
                                             Spacing="12"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:ProductListEntry">
                                    <Border Background="White"
                                            BorderBrush="#E5E7EB"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="16">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Product Image/Icon -->
                                            <Border Grid.Column="0"
                                                    Width="48"
                                                    Height="48"
                                                    CornerRadius="10"
                                                    Background="#F3F4F6"
                                                    VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xEB9F;"
                                                          Foreground="#D1D5DB"
                                                          FontSize="20"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Center"/>
                                            </Border>

                                            <!-- Product Details -->
                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Spacing="4">
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="12">
                                                    <TextBlock Text="{x:Bind Name}"
                                                               Style="{StaticResource BodyTextStyle}"
                                                               FontWeight="SemiBold"
                                                               Foreground="#1F2937"/>
                                                    <Border Background="#E0E7FF"
                                                            CornerRadius="6"
                                                            Padding="8,4">
                                                        <TextBlock Text="{x:Bind Category}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#4F46E5"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind Code}"
                                                           Style="{StaticResource CaptionTextStyle}"
                                                           Foreground="#9CA3AF"/>
                                            </StackPanel>

                                            <!-- Selling Price -->
                                            <StackPanel Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        Orientation="Vertical"
                                                        Spacing="2">
                                                <TextBlock Text="Selling Price"
                                                           Style="{StaticResource CaptionTextStyle}"
                                                           Foreground="#6B7280"/>
                                                <TextBlock Text="{x:Bind SellingPriceText}"
                                                           Style="{StaticResource BodyTextStyle}"
                                                           FontWeight="Bold"
                                                           Foreground="#1F2937"/>
                                            </StackPanel>

                                            <!-- Actions -->
                                            <StackPanel Grid.Column="3"
                                                        Orientation="Horizontal"
                                                        Spacing="8"
                                                        VerticalAlignment="Center">
                                                <Button Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="8">
                                                    <FontIcon Glyph="&#xE72A;"
                                                              FontSize="16"
                                                              Foreground="#6B7280"/>
                                                </Button>
                                                <Button Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="8"
                                                        Command="{Binding DataContext.EditProductCommand, ElementName=PageRoot}"
                                                        CommandParameter="{Binding}">
                                                    <FontIcon Glyph="&#xE70F;"
                                                              FontSize="16"
                                                              Foreground="#6B7280"/>
                                                </Button>
                                                <Button Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="8">
                                                    <FontIcon Glyph="&#xE74D;"
                                                              FontSize="16"
                                                              Foreground="#EF4444"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <MenuFlyoutSeparator Background="#E5E7EB" Margin="-16,0"/>

                        <!-- Paging section -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding PagingSummary}"
                                       Foreground="#64748B"
                                       VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                <Button Command="{Binding PreviousPageCommand}"
                                        Background="#FFFFFF"
                                        BorderBrush="#E5E7EB"
                                        CornerRadius="8"
                                        Width="32"
                                        Height="32">
                                    <FontIcon Glyph="&#xE76B;"
                                              Foreground="#94A3B8"
                                              FontSize="12"/>
                                </Button>
                                <ItemsControl ItemsSource="{Binding PageNumbers}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="6"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:Int32">
                                            <Button Command="{Binding DataContext.GoToPageCommand, ElementName=PageRoot}"
                                                    CommandParameter="{Binding}"
                                                    Width="32"
                                                    Height="32"
                                                    CornerRadius="8"
                                                    Background="#FFFFFF"
                                                    BorderBrush="#E5E7EB"
                                                    Foreground="#4B5563"
                                                    Content="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Command="{Binding NextPageCommand}"
                                        Background="#FFFFFF"
                                        BorderBrush="#E5E7EB"
                                        CornerRadius="8"
                                        Width="32"
                                        Height="32">
                                    <FontIcon Glyph="&#xE76C;"
                                              Foreground="#94A3B8"
                                              FontSize="12"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
