<Page
    x:Class="MyShop.Views.ProductManagement.Components.ProductManagementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:MyShop.ViewModels"
    xmlns:controls="using:MyShop.Views.Controls"
    xmlns:converters="using:MyShop.Converters"
    x:Name="PageRoot"
    Background="#F3F4F6">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:CurrencyConverter x:Key="CurrencyConverter"/>
        <converters:SortIndicatorConverter x:Key="SortIndicatorConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>

        <Style x:Key="SortHeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Border Margin="16,12,16,16"
            Background="White"
            CornerRadius="12"
            BorderThickness="1"
            BorderBrush="#EEEEEE">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Action Bar -->
            <Grid Grid.Row="0"
                  Padding="16,16,16,12"
                  ColumnSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Search -->
                    <ColumnDefinition Width="Auto"/> <!-- Category Filter -->
                                        <ColumnDefinition Width="Auto"/> <!-- Price Range -->
                                        <ColumnDefinition Width="Auto"/> <!-- Advanced Sort -->
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/> <!-- Import -->
                    <ColumnDefinition Width="Auto"/> <!-- Add Product -->
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        HorizontalAlignment="Left"
                        Background="#F0F0F0"
                        CornerRadius="20"
                        BorderThickness="1"
                        BorderBrush="Gray"
                        Padding="12,0,12,0"
                        Height="35"
                        Width="250">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE71E;"
                                  FontSize="14"
                                  Foreground="Gray"
                                  VerticalAlignment="Center"/>

                        <TextBox Grid.Column="1"
                                 PlaceholderText="Search product..."
                                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 VerticalAlignment="Center"
                                 Margin="0,3,0,0">
                            <TextBox.Resources>
                                <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                            </TextBox.Resources>
                        </TextBox>
                    </Grid>
                </Border>

                <ComboBox Grid.Column="1"
                          Width="160"
                          ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                          PlaceholderText="Filter by category"
                          Height="35"
                          CornerRadius="18"
                          VerticalAlignment="Center"/>

                <Button Grid.Column="2"
                        Background="White"
                        Height="35"
                        CornerRadius="20"
                        BorderThickness="1"
                        BorderBrush="#E0E0E0"
                        Padding="16,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE9D2;" FontSize="14" Foreground="#4A4A4A"/>
                        <TextBlock Text="Price Range" Foreground="#4A4A4A" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel Width="320" Spacing="12" Padding="4">
                                <TextBlock Text="Filter by price range" FontWeight="Bold" FontSize="16"/>

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0"
                                             PlaceholderText="Min"
                                             Text="{Binding MinPriceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             InputScope="Number"
                                             HorizontalAlignment="Stretch"/>

                                    <TextBox Grid.Column="1"
                                             PlaceholderText="Max"
                                             Text="{Binding MaxPriceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             InputScope="Number"
                                             HorizontalAlignment="Stretch"/>
                                </Grid>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Content="Clear"
                                            Command="{Binding ClearPriceRangeCommand}"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,0,4,0"/>

                                    <Button Grid.Column="1"
                                            Content="Apply"
                                            Command="{Binding FilterByPriceRangeCommand}"
                                            Style="{StaticResource AppPrimaryButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Margin="4,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- Advanced Sort Button -->
                <Button Grid.Column="3"
                        Background="White"
                        Height="35"
                        CornerRadius="20"
                        BorderThickness="1"
                        BorderBrush="#E0E0E0"
                        Padding="16,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8CB;" FontSize="14" Foreground="#4A4A4A"/>
                        <TextBlock Text="Advanced Sort" Foreground="#4A4A4A" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel Width="360" Spacing="12" Padding="4">
                                <TextBlock Text="Multi-Criteria Sorting" FontWeight="Bold" FontSize="16"/>
                                <TextBlock Text="Add multiple levels of sorting logic." FontSize="12" Foreground="Gray" TextWrapping="Wrap"/>

                                <ItemsControl ItemsSource="{Binding SortCriteriaList, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:SortCriteriaItem">
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <ComboBox Grid.Column="0" 
                                                          ItemsSource="{Binding AvailableColumns, Mode=OneWay}" 
                                                          SelectedValue="{Binding ColumnName, Mode=TwoWay}" 
                                                          HorizontalAlignment="Stretch" Margin="0,0,8,0"/>
                                                
                                                <ComboBox Grid.Column="1" 
                                                          SelectedValue="{Binding Direction, Mode=TwoWay}"
                                                          SelectedValuePath="Content"
                                                          HorizontalAlignment="Stretch" Margin="0,0,8,0">
                                                    <ComboBoxItem Content="ASC"/>
                                                    <ComboBoxItem Content="DESC"/>
                                                </ComboBox>

                                                <Button Grid.Column="2" 
                                                        Background="Transparent" 
                                                        BorderThickness="0" 
                                                        Padding="4" 
                                                        Command="{Binding DataContext.RemoveSortCriteriaCommand, ElementName=PageRoot}"
                                                        CommandParameter="{Binding}">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="Red"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Content="+ Add Level"
                                        Command="{Binding AddSortCriteriaCommand}"
                                        Background="Transparent"
                                        Foreground="#0078D7"
                                        BorderThickness="0"
                                        HorizontalAlignment="Left"/>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Clear All"
                                            Command="{Binding ClearMultiSortCommand}"
                                            HorizontalAlignment="Stretch" Margin="0,0,4,0"/>
                                    <Button Grid.Column="1" Content="Apply"
                                            Command="{Binding ApplyMultiSortCommand}"
                                            Style="{StaticResource AppPrimaryButtonStyle}"
                                            HorizontalAlignment="Stretch" Margin="4,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button Grid.Column="5"
                        Click="ImportButton_Click"
                        Background="#FFFFFF"
                        BorderBrush="#D97706"
                        Foreground="#D97706"
                        Height="35"
                        CornerRadius="18"
                        Padding="14,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE898;" FontSize="14"/>
                        <TextBlock Text="Import Excel" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="6"
                        Command="{Binding AddProductCommand}"
                        Background="#D97706"
                        BorderBrush="#D97706"
                        Foreground="White"
                        Height="35"
                        CornerRadius="18"
                        Padding="14,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14"/>
                        <TextBlock Text="Add Product" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <Border Grid.Row="1"
                        Grid.ColumnSpan="7"
                        Margin="0,12,0,0"
                        Background="#FFFBEB"
                        BorderBrush="#FDE68A"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,10"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='NotNull'}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#92400E"
                               FontSize="13"
                               TextWrapping="Wrap"/>
                </Border>
            </Grid>

            <!-- Table Section -->
            <Border Grid.Row="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header Row -->
                    <Border Grid.Row="0"
                            Background="#FAFAFA"
                            Padding="16,12"
                            BorderBrush="#EEEEEE"
                            BorderThickness="0,0,0,1">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/> <!-- Name -->
                                <ColumnDefinition Width="1*"/> <!-- Category -->
                                <ColumnDefinition Width="1*"/> <!-- Price -->
                                <ColumnDefinition Width="100"/> <!-- Actions -->
                            </Grid.ColumnDefinitions>

                            <!-- Name -->
                            <Button Grid.Column="0" Style="{StaticResource SortHeaderButtonStyle}"
                                    Command="{Binding SortByColumnCommand}"
                                    CommandParameter="Name">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="NAME" FontSize="11" FontWeight="Bold"/>
                                    <FontIcon Glyph="{Binding SortInfo, Mode=OneWay, Converter={StaticResource SortIndicatorConverter}, ConverterParameter=Name}" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                            <!-- Category -->
                            <Button Grid.Column="1" Style="{StaticResource SortHeaderButtonStyle}"
                                    Command="{Binding SortByColumnCommand}"
                                    CommandParameter="Category">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="CATEGORY" FontSize="11" FontWeight="Bold"/>
                                    <FontIcon Glyph="{Binding SortInfo, Mode=OneWay, Converter={StaticResource SortIndicatorConverter}, ConverterParameter=Category}" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                            <!-- Price -->
                            <Button Grid.Column="2" Style="{StaticResource SortHeaderButtonStyle}"
                                    Command="{Binding SortByColumnCommand}"
                                    CommandParameter="Price">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="PRICE" FontSize="11" FontWeight="Bold"/>
                                    <FontIcon Glyph="{Binding SortInfo, Mode=OneWay, Converter={StaticResource SortIndicatorConverter}, ConverterParameter=Price}" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                            <!-- Actions -->
                            <TextBlock Grid.Column="3"
                                       Text="ACTIONS"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="Gray"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Data Rows -->
                    <ListView Grid.Row="1" 
                              ItemsSource="{Binding DisplayProducts, Mode=OneWay}"
                              SelectionMode="None"
                              IsItemClickEnabled="True">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="MinHeight" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.Header>
                            <Border Background="#FFFBEB"
                                    BorderBrush="#FDE68A"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Margin="16"
                                    Padding="14,10"
                                    Visibility="{Binding HasNoData, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="No products found."
                                           Foreground="#92400E"
                                           FontSize="13"/>
                            </Border>
                        </ListView.Header>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:ProductListEntry">
                                <Border BorderBrush="#F9F9F9"
                                        BorderThickness="0,0,0,1"
                                        Padding="16,10">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Name -->
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>

                                        <!-- Category -->
                                        <Border Grid.Column="1" Background="#E0E7FF" CornerRadius="6" Padding="8,4" VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Category}" FontSize="12" FontWeight="SemiBold" Foreground="#4F46E5"/>
                                        </Border>

                                        <!-- Price -->
                                        <TextBlock Grid.Column="2" Text="{Binding SellingPriceText}" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="#1F2937"/>

                                        <!-- Actions -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Button Background="Transparent" BorderThickness="0" Padding="8"
                                                    Command="{Binding DataContext.GoToProductDetailCommand, ElementName=PageRoot}" CommandParameter="{Binding}">
                                                <FontIcon Glyph="&#xE72A;" FontSize="16" Foreground="#6B7280"/>
                                            </Button>
                                            <Button Background="Transparent" BorderThickness="0" Padding="8"
                                                    Command="{Binding DataContext.EditProductCommand, ElementName=PageRoot}" CommandParameter="{Binding}">
                                                <FontIcon Glyph="&#xE70F;" FontSize="16" Foreground="#107C10"/>
                                            </Button>
                                            <Button Background="Transparent" BorderThickness="0" Padding="8"
                                                    Click="DeleteButton_Click">
                                                <FontIcon Glyph="&#xE74D;" FontSize="16" Foreground="#E81123"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Paging Controls -->
                    <Border Grid.Row="2" Background="White" Padding="10" BorderBrush="#EEEEEE" BorderThickness="0,1,0,0">
                        <Grid ColumnSpacing="12" HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="←" Click="PreviousButton_Click" Height="30" Padding="16,0" CornerRadius="8" Background="#F0F0F0" Foreground="#333333"/>
                            
                            <TextBlock Grid.Column="1" Text="{Binding PageInfoDisplay, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#555555"/>
                            
                            <Button Grid.Column="2" Content="→" Click="NextButton_Click" Height="30" Padding="16,0" CornerRadius="8" Background="#0078D4" Foreground="White"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Page>
