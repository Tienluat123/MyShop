<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MyShop.Views.AppConfig.Components.ShopInfoCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- ===================== CARD CONTAINER ===================== -->
        <Style x:Key="CardStyle"
                TargetType="Border">
            <Setter Property="Background"
                    Value="White"/>
            <Setter Property="CornerRadius"
                    Value="12"/>
            <Setter Property="Padding"
                    Value="28"/>
            <Setter Property="BorderBrush"
                    Value="#E5E7EB"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
        </Style>

        <!-- ===================== SECTION HEADER ===================== -->
        <Style x:Key="SectionTitleStyle"
                TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="15"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Foreground"
                    Value="#1F2937"/>
        </Style>

        <Style x:Key="SectionDescStyle"
                TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="12"/>
            <Setter Property="Foreground"
                    Value="#6B7280"/>
            <Setter Property="TextWrapping"
                    Value="Wrap"/>
        </Style>

        <!-- ===================== LABEL ===================== -->
        <Style x:Key="FieldLabelStyle"
                TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="13"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Foreground"
                    Value="#374151"/>
            <Setter Property="Margin"
                    Value="0,0,0,6"/>
        </Style>

        <!-- ===================== TEXTBOX ===================== -->
        <Style x:Key="ConfigTextBoxStyle"
                TargetType="TextBox">
            <Setter Property="Height"
                    Value="42"/>
            <Setter Property="CornerRadius"
                    Value="8"/>
            <Setter Property="Background"
                    Value="#F9FAFB"/>
            <Setter Property="BorderBrush"
                    Value="#D1D5DB"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Padding"
                    Value="12,0"/>
            <Setter Property="FontSize"
                    Value="13"/>
            <Setter Property="Foreground"
                    Value="#1F2937"/>
            <Setter Property="HorizontalAlignment"
                    Value="Stretch"/>
        </Style>

        <!-- ===================== DIVIDER ===================== -->
        <Style x:Key="DividerStyle"
                TargetType="Border">
            <Setter Property="BorderBrush"
                    Value="#F3F4F6"/>
            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>
            <Setter Property="Margin"
                    Value="0,4,0,16"/>
        </Style>
    </UserControl.Resources>

        <Border Style="{StaticResource CardStyle}">
        <StackPanel>
            <!-- Header -->
            <StackPanel Orientation="Horizontal"
                    Spacing="10"
                    Margin="0,0,0,4">
                <Border Width="28"
                        Height="28"
                        Background="#EFF6FF"
                        CornerRadius="7">
                    <FontIcon Glyph="&#xE825;"
                            FontFamily="Segoe MDL2 Assets"
                              Foreground="#3B82F6"
                            FontSize="14"
                              HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Shop Information"
                        Style="{StaticResource SectionTitleStyle}"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Update shop name, address and contact information."
                       Style="{StaticResource SectionDescStyle}"
                    Margin="0,0,0,20"/>
            <Border Style="{StaticResource DividerStyle}"/>

                        <!-- Fields Grid -->
                        <Grid x:Name="FieldsGrid">
                                <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="ShopInfoResponsiveStates">
                                                <VisualState x:Name="ShopInfoMobileState">
                                                        <VisualState.StateTriggers>
                                                                <AdaptiveTrigger MinWindowWidth="0"/>
                                                        </VisualState.StateTriggers>
                                                        <VisualState.Setters>
                                                                <Setter Target="FieldsGrid.(Grid.ColumnDefinitions)[1].Width" Value="0"/>
                                                                <Setter Target="FieldsGrid.(Grid.ColumnDefinitions)[2].Width" Value="0"/>
                                                                <Setter Target="ShopCodePanel.(Grid.Row)" Value="2"/>
                                                                <Setter Target="ShopCodePanel.(Grid.Column)" Value="0"/>
                                                                <Setter Target="AddressPanel.(Grid.ColumnSpan)" Value="1"/>
                                                                <Setter Target="PhonePanel.(Grid.Row)" Value="6"/>
                                                                <Setter Target="PhonePanel.(Grid.Column)" Value="0"/>
                                                                <Setter Target="EmailPanel.(Grid.Row)" Value="8"/>
                                                                <Setter Target="EmailPanel.(Grid.Column)" Value="0"/>
                                                        </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="ShopInfoWideState">
                                                        <VisualState.StateTriggers>
                                                                <AdaptiveTrigger MinWindowWidth="{StaticResource BreakpointTablet}"/>
                                                        </VisualState.StateTriggers>
                                                        <VisualState.Setters>
                                                                <Setter Target="FieldsGrid.(Grid.ColumnDefinitions)[1].Width" Value="20"/>
                                                                <Setter Target="FieldsGrid.(Grid.ColumnDefinitions)[2].Width" Value="*"/>
                                                                <Setter Target="ShopCodePanel.(Grid.Row)" Value="0"/>
                                                                <Setter Target="ShopCodePanel.(Grid.Column)" Value="2"/>
                                                                <Setter Target="AddressPanel.(Grid.ColumnSpan)" Value="3"/>
                                                                <Setter Target="PhonePanel.(Grid.Row)" Value="6"/>
                                                                <Setter Target="PhonePanel.(Grid.Column)" Value="0"/>
                                                                <Setter Target="EmailPanel.(Grid.Row)" Value="6"/>
                                                                <Setter Target="EmailPanel.(Grid.Column)" Value="2"/>
                                                        </VisualState.Setters>
                                                </VisualState>
                                        </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                <!-- Shop Name -->
                                <StackPanel x:Name="ShopNamePanel"
                                                        Grid.Row="0"
                                                        Grid.Column="0">
                    <TextBlock Text="Shop Name"
                            Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Style="{StaticResource ConfigTextBoxStyle}"
                             Text="{Binding ShopName, Mode=TwoWay}"/>
                </StackPanel>

                <!-- Shop Code -->
                                <StackPanel x:Name="ShopCodePanel"
                                                        Grid.Row="0"
                                                        Grid.Column="2">
                    <TextBlock Text="Shop Code"
                            Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Style="{StaticResource ConfigTextBoxStyle}"
                            Text="{Binding ShopCode, Mode=TwoWay}"/>
                </StackPanel>

                <!-- Address -->
                                <StackPanel x:Name="AddressPanel"
                                                        Grid.Row="4"
                                                        Grid.Column="0"
                                                        Grid.ColumnSpan="3">
                    <TextBlock Text="Address"
                            Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Style="{StaticResource ConfigTextBoxStyle}"
                             Text="{Binding Address, Mode=TwoWay}"/>
                </StackPanel>

                <!-- Phone -->
                                <StackPanel x:Name="PhonePanel"
                                                        Grid.Row="6"
                                                        Grid.Column="0">
                    <TextBlock Text="Phone Number"
                            Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Style="{StaticResource ConfigTextBoxStyle}"
                            Text="{Binding Phone, Mode=TwoWay}"/>
                </StackPanel>

                <!-- Email -->
                                <StackPanel x:Name="EmailPanel"
                                                        Grid.Row="6"
                                                        Grid.Column="2">
                    <TextBlock Text="Contact Email"
                            Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Style="{StaticResource ConfigTextBoxStyle}"
                            Text="{Binding ContactEmail, Mode=TwoWay}"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
